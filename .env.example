# Google Analytics 4 measurement ID (Site settings → Environment variables in
# Netlify for the real deploy; a local .env if testing `pnpm build && pnpm preview`).
PUBLIC_GA_MEASUREMENT_ID=

# Intercom workspace ("app") ID for the Messenger. Set this on BOTH Netlify sites —
# the marketing site and the Help Center site — since each build reads its own env.
# Leaving it unset simply omits the Messenger, so previews stay chat-free.
PUBLIC_INTERCOM_APP_ID=
