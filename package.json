{
  "name": "inner-explorer-website-v2",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "dev:help": "astro dev --config astro.help.config.mjs --port 4322",
    "build:help": "astro build --config astro.help.config.mjs",
    "preview:help": "astro preview --config astro.help.config.mjs --port 4322",
    "astro": "astro",
    "typecheck": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:drift": "node scripts/check-drift.mjs",
    "lint:mirrors": "node scripts/check-mirrors.mjs",
    "check:dist": "node scripts/check-dist.mjs",
    "compare:builds": "node scripts/compare-builds.mjs",
    "lint:editables": "node scripts/check-editables.mjs",
    "test:editables": "node --test scripts/check-editables.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:drift && pnpm lint:mirrors && pnpm format:check",
    "validate:cloudcannon": "cloudcannon validate",
    "verify": "pnpm check && pnpm build && pnpm check:dist dist --classes",
    "verify:help": "pnpm validate:cloudcannon && pnpm build:help && pnpm lint:editables && pnpm check:dist dist-help"
  },
  "dependencies": {
    "@amplitude/unified": "^1.1.24",
    "@astrojs/mdx": "^5.0.6",
    "@astrojs/sitemap": "^3.7.3",
    "@cloudcannon/editable-regions": "0.0.19",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.8",
    "astro-auto-import": "0.5.1",
    "clsx": "^2.1.1",
    "satori": "^0.29.0",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.3.0",
    "wawoff2": "^2.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@cloudcannon/cli": "0.0.19",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/typography": "^0.5.19",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.0",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "yaml": "2.9.0"
  }
}
