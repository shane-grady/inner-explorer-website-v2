# build output (dist-help = the Help Center subdomain build, astro.help.config.mjs).
# The glob also covers scratch comparison builds (dist-help-baseline/ etc.) — those
# otherwise get typechecked by `astro check`, which OOMs on minified bundles.
dist/
dist-*/
# transient extraction/scratch dirs used when diffing builds
.tmp-*/
# generated types
.astro/
# generated CloudCannon configuration schemas (migration reference only)
.cloudcannon/migration/*.schema.json
# netlify
.netlify/
# test artifacts
playwright-report/
test-results/
coverage/

# dependencies
node_modules/
.pnpm-store/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# local screenshots
.screenshots/

# skill-creator eval scaffolding (transient: review viewers, logs, run outputs)
.claude/skills/*-workspace/
