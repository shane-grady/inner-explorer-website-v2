{
  "plugins": ["prettier-plugin-astro", "prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "./src/styles/site.css",
  "tailwindFunctions": ["tv", "cn"],
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "overrides": [
    { "files": "*.astro", "options": { "parser": "astro" } },
    { "files": "src-help/**", "options": { "tailwindStylesheet": "./src-help/styles/help.css" } }
  ]
}
