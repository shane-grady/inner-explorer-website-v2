---
// Standard marketing-page shell: document, site header, <main>, site footer. Pages
// build their content from Section and the shared components (DESIGN.md).
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '../components/layout/SiteHeader.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  /** Page-specific social-share image (path or URL); falls back to the site default. */
  image?: string;
  /** Alt text for the share image (og:image:alt / twitter:image:alt). */
  imageAlt?: string;
  /** Intrinsic size of the share image; forwarded to og:image:width/height. */
  imageWidth?: number;
  imageHeight?: number;
  /** Hide the page from search engines. */
  noindex?: boolean;
  /** `dark`: the transparent header laid over a Forest hero, which clears it (Research). */
  header?: 'light' | 'dark';
}
const { header = 'light', ...props }: Props = Astro.props;
const dark = header === 'dark';
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <div class:list={['flex min-h-dvh flex-col', dark && 'relative']}>
    <SiteHeader dark={dark} overlay={dark} />
    <main id="main" class="grow">
      <slot />
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
