---
// Standard marketing-page shell: document + skip link + header nav + <main> + footer.
// Unstyled semantic HTML until the design-foundation PR replaces the header and footer
// with SiteHeader / SiteFooter (tasks/rebuild-plan.md).
import BaseLayout from './BaseLayout.astro';
import { contactCta, footerNav, primaryNav, signIn } from '../data/navigation';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  /** Page-specific social-share image (path or URL); falls back to the site default. */
  image?: string;
  /** Alt text for the share image (og:image:alt / twitter:image:alt). */
  imageAlt?: string;
  /** Intrinsic size of the share image; forwarded to og:image:width/height. */
  imageWidth?: number;
  imageHeight?: number;
  /** Hide the page from search engines. */
  noindex?: boolean;
}
const props: Props = Astro.props;
const year = new Date().getFullYear();
---

<BaseLayout {...props}>
  <slot name="head" slot="head" />
  <a href="#main" class="sr-only focus:not-sr-only">Skip to content</a>
  <header>
    <a href="/">Inner Explorer</a>
    <nav aria-label="Primary">
      <ul>
        {
          primaryNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={signIn.href}>{signIn.label}</a>
    <a href={contactCta.href}>{contactCta.label}</a>
  </header>
  <main id="main">
    <slot />
  </main>
  <footer>
    <nav aria-label="Footer">
      <ul>
        {
          footerNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p>© 2011–{year} Inner Explorer, Inc.</p>
  </footer>
</BaseLayout>
