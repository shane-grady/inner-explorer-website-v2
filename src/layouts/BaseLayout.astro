---
// Document shell. Imports the design tokens once; every page renders inside this.
// Centralized SEO + Organization structured data; pages add their own via the `head` slot.
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SEO from '../components/seo/SEO.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Analytics from '../components/seo/Analytics.astro';
import Intercom from '../components/integrations/Intercom.astro';
import { organizationSchema } from '../lib/schema';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  type?: 'website' | 'article';
  /** Page-specific social-share image (path or URL); falls back to the site default. */
  image?: string;
  /** Alt text for the share image (og:image:alt / twitter:image:alt). */
  imageAlt?: string;
  /** Intrinsic size of the share image. Scrapers render the FIRST share from these,
   *  so a wrong ratio crops the card — pass the real dimensions with `image`. */
  imageWidth?: number;
  imageHeight?: number;
  /** Hide the page from search engines (e.g. the internal styleguide). */
  noindex?: boolean;
  /**
   * Absolute URL to declare as canonical instead of this page's own URL. Only for
   * a page that is a secondary rendering of a document that lives elsewhere (the
   * Help Center's privacy-policy article, whose canonical home is the marketing
   * site's /privacy-policy). Leave unset on every ordinary page.
   */
  canonical?: string;
  /**
   * Which Inner Explorer surface this page belongs to. Stamped on the Intercom visitor
   * so support can tell website chats from Help Center chats (and from the platform's
   * own Messenger) in one shared inbox. Defaults to the marketing site; the Help Center
   * build overrides it in src-help/layouts/HelpSiteLayout.astro.
   */
  surface?: 'Website' | 'Help Center';
}

const {
  title,
  description,
  lang = 'en',
  type = 'website',
  image,
  imageAlt,
  imageWidth,
  imageHeight,
  noindex = false,
  canonical,
  surface = 'Website',
}: Props = Astro.props;
const org = organizationSchema(Astro.site);

// GA4 ships only for the real production build: skips `pnpm dev` and Netlify's
// deploy-preview/branch-deploy contexts entirely (the script tag never renders for
// those). See src/components/seo/Analytics.astro for the *.netlify.app runtime guard.
const gaMeasurementId = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const isProductionBuild =
  import.meta.env.PROD && (!import.meta.env.CONTEXT || import.meta.env.CONTEXT === 'production');

// Intercom Messenger ships on the same terms as GA4: real production builds only, so
// `pnpm dev` and Netlify's deploy-preview / branch-deploy contexts never open a live
// support channel. The env var is set per Netlify site, so each site (marketing + Help
// Center) opts in independently. Unlike GA there is no *.netlify.app runtime guard —
// see src/components/integrations/Intercom.astro for why.
const intercomAppId = import.meta.env.PUBLIC_INTERCOM_APP_ID;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {isProductionBuild && gaMeasurementId && <Analytics measurementId={gaMeasurementId} />}
    {isProductionBuild && intercomAppId && <Intercom appId={intercomAppId} surface={surface} />}
    {/* No-flash theme init: set .dark before first paint (system pref unless overridden). */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const dark = stored
            ? stored === 'dark'
            : matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.classList.toggle('dark', dark);
        } catch (_) {
          /* no stored preference; fall back to system */
        }
      })();
    </script>
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <SEO
      title={title}
      description={description}
      type={type}
      image={image}
      imageAlt={imageAlt}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      canonical={canonical}
    />
    <JsonLd schema={org} />
    {
      /* Astro 6 view transitions: enables cross-page FLIP morphs for elements
        that share a `transition:name`. Auto-respects prefers-reduced-motion. */
    }
    <ClientRouter />
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <slot />
    <script>
      // Amplitude Analytics + Session Replay. Bundled module scripts run in the
      // browser only and execute once per hard load (modules are cached across
      // ClientRouter navigations); the window guard makes the init-once
      // invariant explicit.
      import * as amplitude from '@amplitude/unified';

      const w = window as Window & { __amplitudeInitialized?: boolean };
      if (!w.__amplitudeInitialized) {
        w.__amplitudeInitialized = true;
        amplitude.initAll('9eb782590a25fba8c96b5de6fd50bd73', {
          analytics: { autocapture: true },
          sessionReplay: { sampleRate: 1 },
        });
      }
    </script>
    <script>
      // Component renderers add no production bundle work beyond this tiny guard:
      // the heavier registration module is fetched only by CloudCannon's iframe.
      if ('inEditorMode' in window && window.inEditorMode) {
        import('../cloudcannon/registerComponents').catch((error) => {
          console.warn('Failed to load CloudCannon component registration:', error);
        });
      }
    </script>
  </body>
</html>
