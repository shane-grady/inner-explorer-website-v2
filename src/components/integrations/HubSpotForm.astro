---
// The /contact form, rendered natively by HubSpot so submissions land in the CRM and fire
// its workflows. Replaces a hand-rolled form that posted to Netlify Forms.
//
// The field set is NOT defined here — it lives on the HubSpot form and is built from
// scripts/hubspot-contact-form.mjs. This component owns the loader only, so adding or
// reordering a field is a HubSpot change with no deploy. Styling for the injected fields
// (HubSpot's .hs-* classes) belongs in the site stylesheet (components.css, [data-hsform]).
//
// Slots: the default slot (a heading) renders above the form and `after` (a note) below
// it; both are hidden by CSS once the form is submitted. `success` is the confirmation
// that replaces the form, cloned from a <template> by the loader below.
//
// -- Why `css: ''` is load-bearing -------------------------------------------------------
//
// Do NOT remove it. By default HubSpot renders this form inside an <iframe class=
// "hs-form-iframe">, which our CSS and design tokens cannot reach — the form would appear
// completely unstyled. Reading the embed script (js.hsforms.net/forms/embed/v2.js), the
// iframe decision comes down to `css === undefined`: passing ANY string, including '',
// makes HubSpot render the form inline in this document instead. Verified live: with the
// option, zero HubSpot stylesheets are injected and we own the styling completely.
//
// `cssRequired: ''` suppresses HubSpot's base sheet as well. Safe because its only load-
// bearing rule is `box-sizing: border-box`, which Tailwind's preflight already sets globally.
//
// The equivalent form-level setting (`displayOptions.renderRawHtml`) is deliberately NOT
// used: it would change rendering for every other embed of this form, whereas `css` is
// scoped to this one call.
interface Props {
  /** HubSpot portal ("hub") id. Public, like Intercom's app_id. */
  portalId: string;
  /** Form GUID. The field set and its labels live on this form in HubSpot. */
  formId: string;
  /** HubSpot data-residency region, e.g. 'na1'. */
  region: string;
  /** Fallback contact address used when the embed cannot run. */
  supportEmail: string;
  /** Fallback Help Center URL used when the embed cannot run. */
  helpCenterHref: string;
  class?: string;
}
const {
  portalId,
  formId,
  region,
  supportEmail,
  helpCenterHref,
  class: className,
}: Props = Astro.props;

// The fallback note, shown when the embed cannot run: a flat Tint panel.
const NOTE = 'm-0 rounded-sm bg-tint p-card-padding type-body text-foreground-body';

// Deterministic, so the markup is stable across builds.
const targetId = `hsform-${formId}`;
---

<div class={className} data-hsform>
  {
    Astro.slots.has('default') && (
      <div data-hsform-chrome>
        <slot />
      </div>
    )
  }
  <div id={targetId}></div>
  {
    /* The fallback copy is rendered twice on purpose. <noscript> covers JavaScript being
       off; the hidden twin covers JavaScript being ON but js.hsforms.net never arriving —
       ad blockers and school-network filters do block it, and /contact is the only
       conversion path on the site, so an empty form is not an acceptable failure mode. */
  }
  <noscript>
    <p class={NOTE}>
      This form needs JavaScript. Email <a href={`mailto:${supportEmail}`}>{supportEmail}</a> and someone
      on our team will follow up, or browse the <a href={helpCenterHref}>Help Center</a>.
    </p>
  </noscript>
  <p class={NOTE} data-hsform-fallback hidden>
    This form could not load. Email <a href={`mailto:${supportEmail}`}>{supportEmail}</a> and someone
    on our team will follow up, or browse the <a href={helpCenterHref}>Help Center</a>.
  </p>
  {
    Astro.slots.has('after') && (
      <div data-hsform-chrome>
        <slot name="after" />
      </div>
    )
  }
  <template data-hsform-success>
    <div role="status" aria-live="polite">
      <slot name="success" />
    </div>
  </template>
</div>

<script is:inline define:vars={{ portalId, formId, region, targetId }}>
  (function () {
    const SRC = 'https://js.hsforms.net/forms/embed/v2.js';

    function showFallback() {
      const el = document.querySelector('[data-hsform-fallback]');
      if (el) el.removeAttribute('hidden');
    }

    // The confirmation card is appended as a SIBLING and the embed is hidden, rather than
    // replacing the target's contents — the target is HubSpot's own React root, and tearing
    // it out from under React is asking for trouble.
    function showConfirmation(target) {
      if (target.dataset.hsformDone) return;
      target.dataset.hsformDone = 'true';
      const tpl = document.querySelector('template[data-hsform-success]');
      if (!tpl || !target.parentElement) return;
      target.setAttribute('hidden', '');
      target.parentElement.appendChild(tpl.content.cloneNode(true));
    }

    function create() {
      const target = document.getElementById(targetId);
      if (!target || target.childElementCount > 0) return;
      window.hbspt.forms.create({
        portalId: portalId,
        formId: formId,
        region: region,
        target: '#' + targetId,
        // Load-bearing. See this component's frontmatter comment before touching either.
        css: '',
        cssRequired: '',
        onFormSubmitted: function () {
          showConfirmation(target);
        },
        onFormDefinitionFetchError: showFallback,
      });
    }

    function init() {
      if (!document.getElementById(targetId)) return;
      if (window.hbspt && window.hbspt.forms) return create();

      if (!document.querySelector('script[src="' + SRC + '"]')) {
        const s = document.createElement('script');
        s.async = true;
        s.src = SRC;
        s.addEventListener('load', create);
        s.addEventListener('error', showFallback);
        document.head.appendChild(s);
      }
    }

    init();
  })();
</script>
