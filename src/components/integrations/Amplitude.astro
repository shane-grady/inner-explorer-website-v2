---
// Amplitude Analytics + Session Replay. Rendered once from BaseLayout, only for a real
// production build (the same gate as GA4 and Intercom), so `pnpm dev`, deploy previews
// and branch deploys are never recorded. Bundled module scripts run in the browser
// only, once per page load; the window guard makes the init-once invariant explicit.
---

<script>
  import * as amplitude from '@amplitude/unified';

  const w = window as Window & { __amplitudeInitialized?: boolean };
  if (!w.__amplitudeInitialized) {
    w.__amplitudeInitialized = true;
    amplitude.initAll('9eb782590a25fba8c96b5de6fd50bd73', {
      analytics: { autocapture: true },
      sessionReplay: { sampleRate: 1 },
    });
  }
</script>
