---
// A video as its poster frame: a 16:9 link with the play disc and a caption line ("Watch the
// video · 2 min · CC"). Nothing loads until it's asked for. A YouTube video plays in place: the
// script swaps the poster for a youtube-nocookie player on click. Without JavaScript, or for
// another host, the link opens the video on its host.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  href: string;
  /** The video's title, for the link's accessible name. */
  title: string;
  poster: ImageMetadata;
  /** The caption line, e.g. ["Watch the video", "2 min"]. */
  caption: readonly string[];
  /** Closed captions available: shows the CC mark. */
  captions?: boolean;
  class?: string;
}
const { href, title, poster, caption, captions = false, class: className }: Props = Astro.props;
const youtubeId = href.match(
  /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/,
)?.[1];
---

<a
  class:list={[
    'ie-video relative block aspect-video overflow-hidden rounded-sm bg-black',
    className,
  ]}
  href={href}
  target="_blank"
  rel="noopener"
  aria-label={`Play video: ${title} (opens in a new tab)`}
  data-video-embed={youtubeId}
  data-video-title={title}
>
  <Image
    class="absolute inset-0 size-full object-cover"
    src={poster}
    alt=""
    widths={[640, 1120, 1280]}
    sizes="(min-width: 1440px) 1120px, 100vw"
  />
  <span class="ie-video-scrim absolute inset-0" aria-hidden="true"></span>
  <span
    class="ie-video-play absolute top-1/2 left-1/2 flex size-16 -translate-1/2 items-center justify-center rounded-full md:size-24"
    aria-hidden="true"
  >
    <Icon name="play" size={24} class="ml-1 md:size-8.5" />
  </span>
  <span
    class="absolute bottom-3.5 left-4 flex items-center gap-2 type-label font-bold text-on-brand md:bottom-6 md:left-7 md:gap-3 md:type-small md:font-bold"
    aria-hidden="true"
  >
    {
      caption.map((part, i) => (
        <>
          {i > 0 && <span class="opacity-60">·</span>}
          <span class:list={[i > 0 && 'font-medium']}>{part}</span>
        </>
      ))
    }
    {
      captions && (
        <>
          <span class="opacity-60">·</span>
          <span class="inline-flex h-5 items-center rounded-sm border-2 border-on-brand px-1.5 type-tag md:h-5.5 md:px-2">
            CC
          </span>
        </>
      )
    }
  </span>
</a>

<script>
  // Play in place: swap the poster link for the player, autoplaying, and move focus into it.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-video-embed]')) {
    const title = link.dataset.videoTitle ?? '';
    link.removeAttribute('target');
    link.setAttribute('aria-label', `Play video: ${title}`);
    link.addEventListener('click', (event) => {
      if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
      event.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${link.dataset.videoEmbed}?autoplay=1&rel=0&playsinline=1`;
      frame.title = title;
      frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      frame.allowFullscreen = true;
      frame.className = 'absolute inset-0 size-full border-0';
      const player = document.createElement('div');
      player.className = link.className;
      player.append(frame);
      link.replaceWith(player);
      frame.focus();
    });
  }
</script>
