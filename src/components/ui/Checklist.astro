---
// A list of claims, each led by the 22px outline check circle in icon-accent.
import Icon from './Icon.astro';

interface Props {
  items: readonly string[];
  /** Columns from md up; one column below. */
  columns?: 1 | 2 | 3;
  class?: string;
}
const { items, columns = 1, class: className }: Props = Astro.props;
const COLUMNS = { 1: '', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3' } as const;
---

<ul class:list={['m-0 grid list-none gap-3 p-0 md:gap-x-6', COLUMNS[columns], className]}>
  {
    items.map((item) => (
      <li class="flex gap-3 type-body text-foreground-body">
        <Icon name="check-circle" size={22} class="mt-0.5 text-icon-accent" />
        <span>{item}</span>
      </li>
    ))
  }
</ul>
