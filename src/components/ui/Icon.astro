---
// An interface icon from the registry in src/lib/icons.ts. Decorative unless `label` is set.
import { ICONS, type IconName, type IconSize } from '../../lib/icons';

interface Props {
  name: IconName;
  size?: IconSize;
  /** Accessible name when the icon is the only content; omit for decorative icons. */
  label?: string;
  class?: string;
}
const { name, size = 20, label, class: className }: Props = Astro.props;
---

<svg
  class:list={['shrink-0', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  set:html={ICONS[name]}
/>
