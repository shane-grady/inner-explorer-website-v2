---
// Plain stand-in for any Help Center MDX snippet in the privacy policy that has no
// dedicated stand-in (Accordion, ActionLinks, Card, CardGrid, HelpFigure, HelpVideo,
// LinkCards, Steps, Step, or one added later). The policy file is shared with the Help
// Center and edited in CloudCannon, where all of those are on offer. This renders the text any of them carries (heading, body, slot,
// every item) so such an edit can neither break this build nor hide legal text. Media
// renders as its label and caption only; item links resolve like the article's own.
import { resolveHelpArticleHref } from '../../lib/help-links';

interface Item {
  q?: string;
  a?: string;
  aHtml?: string;
  title?: string;
  label?: string;
  badge?: string;
  sub?: string;
  content?: string;
  contentHtml?: string;
  href?: string;
}
interface Props {
  title?: string;
  label?: string;
  badge?: string;
  content?: string;
  contentHtml?: string;
  caption?: string;
  items?: Item[];
}
const { title, label, badge, content, contentHtml, caption, items = [] }: Props = Astro.props;
const heading = [badge, title ?? label].filter(Boolean).join(' ');
---

<div>
  {
    heading && (
      <p>
        <strong>{heading}</strong>
      </p>
    )
  }
  {contentHtml ? <Fragment set:html={contentHtml} /> : content && <p>{content}</p>}
  <slot />
  {
    items.length > 0 && (
      <ul>
        {items.map((item) => {
          const name = [item.badge, item.q ?? item.title ?? item.label].filter(Boolean).join(' ');
          return (
            <li>
              {item.href ? (
                <a href={resolveHelpArticleHref(item.href)}>{name}</a>
              ) : (
                name && <strong>{name}</strong>
              )}
              {item.sub && <p>{item.sub}</p>}
              {item.aHtml ? <Fragment set:html={item.aHtml} /> : item.a && <p>{item.a}</p>}
              {item.contentHtml ? (
                <Fragment set:html={item.contentHtml} />
              ) : (
                item.content && <p>{item.content}</p>
              )}
            </li>
          );
        })}
      </ul>
    )
  }
  {caption && <p>{caption}</p>}
</div>
