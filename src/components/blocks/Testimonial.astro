---
// One quote style for every educator quote: the green mark, the quote in Libre Caslon
// Text, and the name and place under a rule. `card` (Raised) for a row of quotes,
// `panel` (Tint) for a single quote beside other content, `accent` (Mist, Emerald top
// border and mark) for Home's row, `closing` (Emerald ground, white ink, centered) for the
// one quote that closes a case study. A `portrait` leads the name where a headshot exists.
// No typed quotation marks.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
const VARIANT = {
  card: 'ie-card-raised',
  panel: 'ie-card-tint',
  accent: 'ie-card-accent',
  closing: 'ie-card-closing items-center text-center',
} as const satisfies Record<string, string>;

interface Props {
  name: string;
  place?: string;
  variant?: keyof typeof VARIANT;
  /** The speaker's headshot beside the name (decorative: the name sits beside it). */
  portrait?: ImageMetadata;
  class?: string;
}
const { name, place, variant = 'card', portrait, class: className }: Props = Astro.props;
const closing = variant === 'closing';
---

<figure
  class:list={['ie-card m-0 flex flex-col gap-5 p-6 md:gap-6 md:p-8', VARIANT[variant], className]}
  data-on-brand={closing || undefined}
>
  <svg
    class="ie-quote-mark text-icon-accent"
    width="32"
    height="24"
    viewBox="0 0 32 24"
    aria-hidden="true"
  >
    <path
      fill="currentColor"
      d="M0 24V14c0-7.7 4.4-12.5 12-14l1.6 3.4C9.2 5 7 7.8 6.8 11H12v13H0zm18 0V14c0-7.7 4.4-12.5 12-14l1.6 3.4C27.2 5 25 7.8 24.8 11H30v13H18z"
    ></path>
  </svg>
  <blockquote class="m-0 grow type-quote text-foreground"><slot /></blockquote>
  <figcaption
    class:list={[
      'flex items-center gap-3 border-t border-border pt-5',
      closing && 'justify-center self-stretch',
    ]}
  >
    {
      portrait && (
        <Image
          class="size-10 shrink-0 rounded-full object-cover md:size-12"
          src={portrait}
          alt=""
          widths={[48, 96]}
          sizes="48px"
        />
      )
    }
    <span class="flex min-w-0 grow flex-col gap-1">
      <span class="type-card-title-sm text-foreground">{name}</span>
      {place && <span class="type-label text-foreground-muted">{place}</span>}
    </span>
  </figcaption>
</figure>
