---
// A story: media, kicker ("Article · Leadership"), title, excerpt and meta, the title a link
// that covers the card. Newsroom and Article boards:
// - `featured`: the Raised lead card (16/9 media, a "Featured" badge, the 44 → 32 title, a
//   "Read the article" line); unboxed below lg, its media 16/10 (Newsroom).
// - `compact`: a Raised card with 16/9 media from lg; below, a ruled row with a 104 × 80 thumb
//   (Newsroom's "Also worth reading").
// - `plain`: unboxed, 3/2 media (Newsroom's story grid); the `media` slot replaces the image
//   (stat tiles, press logos).
// - `tint`: a Tint card with a 224px image from lg; below, a row with an 88px thumb (Article's
//   "Keep reading").
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

const VARIANT = {
  featured:
    'ie-card bg-transparent lg:border lg:border-border lg:bg-surface lg:shadow-raised flex flex-col',
  compact:
    'ie-card rounded-none bg-transparent border-t border-border flex gap-4 py-4 lg:flex-col lg:gap-0 lg:rounded-sm lg:border lg:bg-surface lg:p-0 lg:shadow-raised',
  plain: 'relative flex flex-col gap-5',
  tint: 'ie-card ie-card-tint flex items-center gap-4 p-3 lg:flex-col lg:items-stretch lg:gap-0 lg:p-0',
} as const satisfies Record<string, string>;
const MEDIA = {
  featured:
    'relative aspect-16/10 overflow-hidden rounded-sm bg-tint lg:aspect-video lg:rounded-none lg:border-b lg:border-border',
  compact:
    'h-20 w-26 shrink-0 overflow-hidden rounded-sm bg-tint lg:aspect-video lg:h-auto lg:w-auto lg:rounded-none lg:border-b lg:border-border',
  plain: 'relative aspect-3/2 overflow-hidden rounded-sm',
  tint: 'size-22 shrink-0 overflow-hidden rounded-sm lg:h-56 lg:w-auto lg:rounded-none',
} as const satisfies Record<string, string>;
const BODY = {
  featured: 'flex grow flex-col gap-4 pt-4 lg:px-10 lg:pt-8 lg:pb-9',
  compact: 'flex min-w-0 grow flex-col gap-2 lg:gap-3 lg:px-6 lg:pt-5 lg:pb-6',
  plain: 'flex grow flex-col gap-3',
  tint: 'flex min-w-0 flex-col gap-2 lg:gap-3 lg:p-6',
} as const satisfies Record<string, string>;
const TITLE = {
  featured: 'type-section-title text-pretty lg:text-balance',
  compact: 'type-card-title-md text-pretty',
  plain: 'type-card-title-md text-pretty',
  tint: 'type-card-title-md text-pretty',
} as const satisfies Record<string, string>;

interface Props {
  variant?: keyof typeof VARIANT;
  title: string;
  href: string;
  /** Opens in a new tab, announced to screen readers (press coverage). */
  external?: boolean;
  /** Kicker parts, joined with a dot: ["Article", "Leadership"]. */
  kicker?: readonly string[];
  excerpt?: string;
  /** Meta parts, joined with a dot: ["8 min read", "Jul 1, 2026"]. */
  meta?: readonly string[];
  /** The line under the copy: "Read the article" (arrow) or "Read on NPR" (external). */
  action?: string;
  /** Without the `media` slot. Decorative: the title names the story. */
  image?: { src: ImageMetadata; fit?: 'cover' | 'contain'; position?: string };
  /** The "Featured" badge over the media. */
  badge?: string;
  /** Plain: 4/3 media below lg, for a tile with copy in it (the Newsroom's stat tiles). */
  tallMedia?: boolean;
  headingLevel?: 'h2' | 'h3';
  class?: string;
}
const {
  variant = 'plain',
  title,
  href,
  external = false,
  kicker = [],
  excerpt,
  meta = [],
  action,
  image,
  badge,
  tallMedia = false,
  headingLevel: Heading = variant === 'featured' ? 'h2' : 'h3',
  class: className,
}: Props = Astro.props;
const framed = variant !== 'plain';
const IMAGE_WIDTH = { featured: 800, compact: 400, plain: 400, tint: 400 } as const;
---

<article class:list={[VARIANT[variant], className]}>
  {
    (Astro.slots.has('media') || image) && (
      <div
        class:list={[
          tallMedia
            ? MEDIA[variant].replace('aspect-3/2', 'aspect-4/3 lg:aspect-3/2')
            : MEDIA[variant],
        ]}
      >
        {Astro.slots.has('media') ? (
          <slot name="media" />
        ) : (
          image && (
            <Image
              src={image.src}
              alt=""
              width={IMAGE_WIDTH[variant]}
              densities={[1, 2]}
              class:list={[
                'block size-full',
                image.fit === 'contain' ? 'object-contain' : 'object-cover',
              ]}
              style={image.position ? `object-position: ${image.position}` : undefined}
            />
          )
        )}
        {badge && (
          <span class="absolute top-3 left-3 inline-flex h-7 items-center rounded-sm bg-surface px-2 type-eyebrow text-foreground lg:top-4 lg:left-4 lg:h-8 lg:px-3">
            {badge}
          </span>
        )}
      </div>
    )
  }
  <div class:list={[BODY[variant]]}>
    {
      kicker.length > 0 && (
        <p class="m-0 flex flex-wrap items-center gap-2 type-eyebrow text-foreground">
          {kicker.map((part, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{part}</span>
            </>
          ))}
        </p>
      )
    }
    <Heading class:list={['m-0 text-foreground', TITLE[variant]]}>
      <a
        class:list={[
          framed ? 'ie-card-link' : 'text-inherit no-underline after:absolute after:inset-0',
        ]}
        href={href}
        target={external ? '_blank' : undefined}
        rel={external ? 'noopener' : undefined}
        >{title}{external && <span class="sr-only"> (opens in a new tab)</span>}</a
      >
    </Heading>
    {
      excerpt && (
        <p
          class:list={['m-0 type-body text-foreground-body', variant === 'featured' && 'max-w-160']}
        >
          {excerpt}
        </p>
      )
    }
    {
      (action || meta.length > 0) && (
        <div
          class:list={[
            'mt-auto flex flex-wrap items-center gap-x-6 gap-y-2',
            variant === 'featured' ? 'pt-1 lg:pt-2' : variant === 'plain' && 'pt-1',
          ]}
        >
          {action && (
            <span class="inline-flex items-center gap-2 type-label font-bold text-foreground">
              {action}
              <Icon
                name={external ? 'arrow-up-right' : 'arrow-right'}
                size={16}
                class="text-icon-accent"
              />
            </span>
          )}
          {meta.length > 0 && (
            <p class="m-0 flex flex-wrap items-center gap-2 type-label text-foreground-muted">
              {meta.map((part, i) => (
                <>
                  {i > 0 && <span aria-hidden="true">·</span>}
                  <span>{part}</span>
                </>
              ))}
            </p>
          )}
        </div>
      )
    }
  </div>
</article>
