---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Audiences — "one practice, two ways in." A pill toggle swaps between the educator
// panel (immersive practice card) and the district panel (dashboard mock). Both panels
// are in the DOM; the toggle is a tiny vanilla script. Without JS the default panel
// (district) stays visible and the rest is reachable — progressive enhancement.
interface Cta {
  label: string;
  href: string;
}
interface PracticeCard {
  title: string;
  meta: string;
  image: ImageMetadata;
  imageAlt: string;
}
interface FunnelRow {
  label: string;
  value: string;
  /** Bar fill, 0–1. */
  fill: number;
}
interface DashStat {
  value: string;
  label: string;
}
interface EducatorPanel {
  heading: string;
  body: string;
  points: string[];
  cta: Cta;
  card: PracticeCard;
}
interface DistrictPanel {
  heading: string;
  body: string;
  points: string[];
  cta: Cta;
  dashboard: {
    title: string;
    delta: string;
    funnelLabel: string;
    rows: FunnelRow[];
    stats: DashStat[];
  };
}
interface Props {
  eyebrow: string;
  headingLead: string;
  headingAccent: string;
  educator: EducatorPanel;
  district: DistrictPanel;
}
const { eyebrow, headingLead, headingAccent, educator, district }: Props = Astro.props;

// Deterministic waveform for the practice card (build-time; stable across builds).
const wave = Array.from({ length: 28 }, (_, i) => ({
  h: 22 + Math.round(Math.abs(Math.sin(i * 1.7) * 0.6 + Math.sin(i * 0.5) * 0.4) * 78),
  dur: (1 + (i % 5) * 0.18).toFixed(2),
  delay: ((i % 7) * 0.09).toFixed(2),
}));
---

<section id="audiences" class="aud" data-audience="district" aria-labelledby="aud-heading">
  <div class="inner">
    <header class="head" data-home-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="aud-heading" class="h">
        {headingLead}{' '}
        <em>{headingAccent}</em>
      </h2>
    </header>

    <div class="toggle-wrap" data-home-reveal>
      <div class="toggle" role="group" aria-label="Choose your role">
        <span class="indicator" aria-hidden="true"></span>
        <button class="t-btn" type="button" data-aud="educator" aria-pressed="false">
          For educators
        </button>
        <button class="t-btn" type="button" data-aud="district" aria-pressed="true">
          For district leaders
        </button>
      </div>
    </div>

    {/* EDUCATOR PANEL */}
    <div class="panel" data-panel="educator" hidden>
      <div class="col-copy">
        <h3 class="sub">{educator.heading}</h3>
        <p class="lead">{educator.body}</p>
        <ul class="checks">
          {
            educator.points.map((p) => (
              <li>
                <span class="check" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={educator.cta.href}>
          {educator.cta.label}
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="practice-card">
        <Image
          class="practice-photo"
          src={educator.card.image}
          alt={educator.card.imageAlt}
          widths={[480, 800]}
          sizes="(max-width: 920px) 90vw, 520px"
          loading="lazy"
        />
        <div class="practice-scrim" aria-hidden="true"></div>
        <div class="practice-body">
          <span class="play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"
              ><path d="M8 5v14l11-7z"></path></svg
            >
          </span>
          <div class="practice-meta">
            <div class="practice-title">{educator.card.title}</div>
            <div class="practice-sub">{educator.card.meta}</div>
            <div class="wave" aria-hidden="true">
              {
                wave.map((b) => (
                  <span class="bar" style={`--h:${b.h}%;--dur:${b.dur}s;--delay:${b.delay}s`} />
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* DISTRICT PANEL */}
    <div class="panel" data-panel="district">
      <div class="col-copy">
        <h3 class="sub">{district.heading}</h3>
        <p class="lead">{district.body}</p>
        <ul class="checks">
          {
            district.points.map((p) => (
              <li>
                <span class="check" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <polyline points="20 6 9 17 4 12" />
                  </svg>
                </span>
                <span>{p}</span>
              </li>
            ))
          }
        </ul>
        <a class="text-link" href={district.cta.href}>
          {district.cta.label}
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="dash">
        <div class="dash-top">
          <div class="dash-title">{district.dashboard.title}</div>
          <span class="dash-delta">
            <svg
              viewBox="0 0 24 24"
              width="13"
              height="13"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="m18 15-6-6-6 6"></path>
            </svg>
            {district.dashboard.delta}
          </span>
        </div>
        <div class="dash-label">{district.dashboard.funnelLabel}</div>
        <div class="funnel">
          {
            district.dashboard.rows.map((r) => (
              <div class="frow">
                <div class="ffill" style={`--fill:${r.fill}`} aria-hidden="true" />
                <span class="flabel">{r.label}</span>
                <span class="fvalue">{r.value}</span>
              </div>
            ))
          }
        </div>
        <div class="dash-stats">
          {
            district.dashboard.stats.map((s) => (
              <div>
                <div class="ds-num">{s.value}</div>
                <div class="ds-lbl">{s.label}</div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .aud {
    padding: clamp(5.5rem, 4rem + 6vw, 7.5rem) clamp(20px, 5vw, 34px);
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .head {
    margin-bottom: 18px;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .h {
    margin: 0 0 30px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(30px, 4vw, 50px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
  }
  .h em {
    font-style: normal;
    color: var(--color-brand-emphasis);
  }

  /* Toggle */
  .toggle-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 50px;
  }
  .toggle {
    position: relative;
    display: inline-flex;
    padding: 5px;
    border-radius: 9999px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }
  .indicator {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: 5px;
    width: calc(50% - 5px);
    border-radius: 9999px;
    background: var(--color-foreground);
    transition: transform 0.45s var(--ease-out);
  }
  [data-audience='district'] .indicator {
    transform: translateX(100%);
  }
  .t-btn {
    position: relative;
    z-index: 2;
    height: 46px;
    padding: 0 26px;
    border: 0;
    background: none;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-muted-foreground);
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
  }
  [data-audience='educator'] .t-btn[data-aud='educator'],
  [data-audience='district'] .t-btn[data-aud='district'] {
    color: var(--color-card);
  }

  /* Panels */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px;
    align-items: center;
  }
  .panel[hidden] {
    display: none;
  }
  .sub {
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .lead {
    margin: 0 0 28px;
    font-size: 17px;
    line-height: 1.62;
    color: var(--color-muted-foreground);
  }
  .checks {
    margin: 0 0 32px;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .checks li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-foreground);
  }
  .check {
    flex-shrink: 0;
    margin-top: 1px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in oklab, var(--color-brand) 12%, transparent);
    color: var(--color-brand);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
    color: var(--color-brand);
    transition: gap 0.3s var(--ease-out);
  }
  .text-link:hover {
    gap: 12px;
  }

  /* Educator: immersive practice card */
  .practice-card {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-2xl);
    background: radial-gradient(120% 100% at 50% 0%, var(--brand-800), var(--home-night-2));
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .practice-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.55;
  }
  .practice-scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(80% 90% at 50% 35%, transparent 30%, var(--home-night) 100%);
  }
  .practice-body {
    position: relative;
    z-index: 2;
    padding: 28px;
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--color-white);
  }
  .play {
    flex-shrink: 0;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--home-night);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-left: 3px;
    box-shadow: var(--shadow-md);
  }
  .practice-meta {
    min-width: 0;
  }
  .practice-title {
    font-weight: 600;
    font-size: 17px;
  }
  .practice-sub {
    margin-top: 2px;
    font-size: 13px;
    color: color-mix(in oklab, var(--color-white) 65%, transparent);
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 22px;
    margin-top: 12px;
  }
  .bar {
    flex: 1 1 auto;
    min-width: 2px;
    max-width: 6px;
    height: var(--h);
    border-radius: 3px;
    transform-origin: center;
    background: color-mix(in oklab, var(--color-white) 80%, transparent);
    animation: home-wave var(--dur) ease-in-out var(--delay) infinite;
  }
  @keyframes home-wave {
    0%,
    100% {
      transform: scaleY(0.22);
    }
    50% {
      transform: scaleY(1);
    }
  }

  /* District: dashboard mock */
  .dash {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-2xl);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    padding: 26px;
    display: flex;
    flex-direction: column;
  }
  .dash-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }
  .dash-title {
    font-weight: 600;
    font-size: 15px;
    color: var(--color-foreground);
  }
  .dash-delta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-success);
  }
  .dash-label {
    margin-bottom: 10px;
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted-foreground);
  }
  .funnel {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-bottom: 22px;
  }
  .frow {
    position: relative;
    height: 26px;
    border-radius: 7px;
    overflow: hidden;
    background: var(--color-background);
    display: flex;
    align-items: center;
    padding: 0 12px;
  }
  .ffill {
    position: absolute;
    inset: 0;
    width: calc(var(--fill) * 100%);
    background: linear-gradient(
      to right,
      color-mix(in oklab, var(--color-brand) 20%, transparent),
      color-mix(in oklab, var(--color-brand) 6%, transparent)
    );
    border-right: 3px solid var(--color-brand);
  }
  .flabel {
    position: relative;
    font-size: 12px;
    font-weight: 500;
    color: var(--color-foreground);
  }
  .fvalue {
    position: relative;
    margin-left: auto;
    font-size: 12px;
    font-weight: 600;
    color: var(--color-foreground);
  }
  .dash-stats {
    margin-top: auto;
    display: flex;
    gap: 20px;
  }
  .ds-num {
    font-weight: 600;
    font-size: 24px;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .ds-lbl {
    font-size: 11.5px;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 920px) {
    .panel {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .col-copy {
      order: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .indicator,
    .text-link {
      transition: none;
    }
  }
</style>

<script>
  // Audience toggle — swaps panels + slides the indicator. The section ships with the
  // district panel visible, so no-JS users still get a full panel.
  const root = document.querySelector<HTMLElement>('.aud');
  if (root) {
    const btns = Array.from(root.querySelectorAll<HTMLButtonElement>('.t-btn'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('.panel'));
    const select = (aud: string) => {
      root.dataset.audience = aud;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.aud === aud)));
      panels.forEach((p) => p.toggleAttribute('hidden', p.dataset.panel !== aud));
    };
    btns.forEach((b) => b.addEventListener('click', () => b.dataset.aud && select(b.dataset.aud)));
  }
</script>
