---
// Funding — a split header over a four-card row of funding streams. Light surface.
import {
  editableText,
  editableArray,
  editableItem,
  type EditablePrefix,
  itemPrefix,
} from '../../../lib/editable';

interface Card {
  title: string;
  body: string;
}
interface Props {
  eyebrow: string;
  headingLead: string;
  headingAccent: string;
  intro: string;
  cards: Card[];
  /** CloudCannon path prefix for this block's fields (e.g. 'funding'). */
  editablePrefix?: EditablePrefix;
}
const { eyebrow, headingLead, headingAccent, intro, cards, editablePrefix }: Props = Astro.props;
const rowPrefix = itemPrefix(editablePrefix);
---

<section id="bring" class="funding" aria-labelledby="funding-heading">
  <div class="inner">
    <header class="head" data-home-reveal>
      <div>
        <p class="eyebrow" {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</p>
        <h2 id="funding-heading" class="h">
          <span {...editableText(editablePrefix, 'headingLead')}>{headingLead}</span>{' '}
          <em {...editableText(editablePrefix, 'headingAccent')}>{headingAccent}</em>
        </h2>
      </div>
      <p class="intro" {...editableText(editablePrefix, 'intro', 'text')}>{intro}</p>
    </header>

    <div class="cards" data-home-reveal {...editableArray(editablePrefix, 'cards')}>
      {
        cards.map((c) => (
          <div class="card" {...editableItem(editablePrefix)}>
            <div class="card-title" {...editableText(rowPrefix, 'title')}>
              {c.title}
            </div>
            <p class="card-body" {...editableText(rowPrefix, 'body', 'text')}>
              {c.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .funding {
    padding: clamp(5rem, 4rem + 5vw, 7.5rem) clamp(20px, 5vw, 34px);
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
  }
  .head {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 40px;
    align-items: center;
    margin-bottom: 50px;
  }
  .eyebrow {
    margin: 0 0 16px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .h {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 46px);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
  }
  .h em {
    font-style: normal;
    color: var(--color-brand-emphasis);
  }
  .intro {
    margin: 0;
    font-size: 16px;
    line-height: 1.62;
    color: var(--color-muted-foreground);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
  }
  .card {
    padding: 28px 26px;
    border-radius: var(--radius-xl);
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }
  .card-title {
    margin-bottom: 8px;
    font-weight: 600;
    font-size: 16px;
    color: var(--color-foreground);
  }
  .card-body {
    margin: 0;
    font-size: 14px;
    line-height: 1.55;
    color: var(--color-muted-foreground);
  }
</style>
