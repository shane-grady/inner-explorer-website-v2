---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Live-now — the immersive dark "scale" section. A field of circular "dots" — most are
// students mid-practice (photos clipped to circles, gently fading in and out on
// staggered timers), woven with brighter flashing green dots — stands in for the
// classrooms practicing right now. A rotating live caption names one; a four-figure stat
// row anchors the claim. First section on the page (the splash/hero is added separately),
// so the header paints immediately and is never gated behind scroll-reveal (protects the
// LCP). The dots are decorative + lazy-loaded.
interface Stat {
  value: string;
  /** Accent suffix rendered in brand green, e.g. "+", "min". */
  sup?: string;
  label: string;
}
interface Props {
  eyebrow: string;
  /** Heading lead, e.g. "A class is taking a breath". */
  headingLead: string;
  /** Serif-italic accent word that closes the heading, e.g. "together." */
  headingAccent: string;
  /** Rotating "right now, somewhere" captions; the first is server-rendered. */
  captions: string[];
  stats: Stat[];
}
const { eyebrow, headingLead, headingAccent, captions, stats }: Props = Astro.props;

// Student/classroom photos for the field (all of src/assets/images/home/mosaic).
const mosaic = import.meta.glob<{ default: ImageMetadata }>(
  '../../../assets/images/home/mosaic/*.{jpg,jpeg,png}',
  { eager: true },
);
const photos = Object.keys(mosaic)
  .sort()
  .map((k) => mosaic[k].default);

// Build the field: mostly student/classroom dots, with a flashing green dot woven in
// after roughly every third photo. Each dot gets a staggered delay + varied duration so
// the wall fades organically (deterministic — no Math.random, stable across builds).
interface Cell {
  photo: ImageMetadata | null;
  delay: string;
  dur: string;
}
// A dense field of small circular "dots": mostly student photos (cycled to fill the
// grid), with flashing green dots woven in on an irregular period (19 — coprime with
// common column counts) so they scatter instead of lining up. Each dot gets a randomised
// delay + duration (large coprime multipliers → pseudo-random, but deterministic — no
// Math.random) so the faces fade in and out independently rather than in unison.
const SLOTS = 56;
const cells: Cell[] = [];
let p = 0;
// Seeded LCG → deterministic but statistically random (no Math.random, so builds stay
// stable). Index-based modular patterns align the green dots into a column at some grid
// widths (e.g. multiples of 8 on mobile); a pseudo-random stream scatters them — and
// randomises each face's fade delay/duration — at any column count.
let seed = 1337;
const rand = () => {
  seed = (seed * 1103515245 + 12345) & 0x7fffffff;
  return seed / 0x7fffffff;
};
for (let s = 0; s < SLOTS; s++) {
  if (rand() < 0.26) {
    cells.push({
      photo: null,
      delay: (rand() * 3).toFixed(2),
      dur: (2.6 + rand() * 1.6).toFixed(2),
    });
  } else {
    cells.push({
      photo: photos[p++ % photos.length],
      delay: (rand() * 6).toFixed(2),
      dur: (3.6 + rand() * 3.4).toFixed(2),
    });
  }
}

const firstCaption = captions[0] ?? '';
---

<section
  id="now"
  class="live"
  aria-labelledby="live-heading"
  data-captions={JSON.stringify(captions)}
>
  <div class="inner">
    <header class="head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id="live-heading" class="h">
        {headingLead}{' '}
        <em>{headingAccent}</em>
      </h2>
    </header>

    <div class="field-wrap">
      <div class="field" aria-hidden="true">
        {
          cells.map((c) =>
            c.photo ? (
              <div class="tile tile-photo" style={`--d:${c.delay}s;--dur:${c.dur}s`}>
                <Image src={c.photo} alt="" widths={[120, 240]} sizes="96px" loading="lazy" />
              </div>
            ) : (
              <div class="tile tile-dot" style={`--d:${c.delay}s;--dur:${c.dur}s`} />
            ),
          )
        }
      </div>
      <div class="field-vignette" aria-hidden="true"></div>
    </div>

    <p class="caption" data-home-reveal>
      <span class="caption-dot" aria-hidden="true"></span>
      <span class="caption-text" data-live-caption>{firstCaption}</span>
    </p>

    <div class="stats" data-home-reveal>
      {
        stats.map((s) => (
          <div class="stat">
            <div class="stat-num">
              {s.value}
              {s.sup && <span class="sup">{s.sup}</span>}
            </div>
            <div class="stat-lbl">{s.label}</div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .live {
    position: relative;
    padding: clamp(7rem, 6rem + 5vw, 8.5rem) clamp(20px, 5vw, 34px) clamp(5rem, 4rem + 5vw, 8rem);
    background: radial-gradient(
      120% 90% at 50% 0%,
      var(--home-night-3) 0%,
      var(--home-night-2) 60%,
      var(--home-night) 100%
    );
    color: var(--color-white);
  }
  .inner {
    max-width: 1340px;
    margin: 0 auto;
  }

  .head {
    max-width: 720px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .eyebrow {
    margin: 0 0 20px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--brand-300);
  }
  .h {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(28px, 3.6vw, 46px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--color-white);
    text-wrap: balance;
  }
  .h em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--brand-200);
  }

  /* Field — circular "dots" of students + flashing green dots, fading in and out. */
  .field-wrap {
    position: relative;
    max-width: 1080px;
    margin: 0 auto;
  }
  .field {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 8px;
  }
  .tile {
    flex: 0 0 auto;
    width: clamp(30px, 3.6vw, 46px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
  }
  .tile :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  /* Faces fade in and out independently. The animation sits on the tile (a scoped
     selector), not the :global(img), so the scoped @keyframes name resolves cleanly. */
  .tile-photo {
    animation: tile-fade var(--dur, 5s) ease-in-out var(--d, 0s) infinite;
  }
  /* Green dot — same size as the face dots, brighter "flash", keeps the original motif. */
  .tile-dot {
    background: var(--brand-400);
    box-shadow: 0 0 8px 1px color-mix(in oklab, var(--brand-400) 45%, transparent);
    animation: dot-pulse var(--dur, 3s) ease-in-out var(--d, 0s) infinite;
  }
  .field-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(75% 130% at 50% 50%, transparent 52%, var(--home-night-2) 100%);
  }
  /* Faces fade nearly out then back in (rest at full so reduced-motion / no-anim shows
     them). A gentle scale adds the "in and out" feel. */
  @keyframes tile-fade {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.15;
      transform: scale(0.9);
    }
  }
  @keyframes dot-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.28;
      transform: scale(0.72);
    }
  }

  .caption {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 40px auto 0;
    min-height: 26px;
  }
  .caption-dot {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--brand-400);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand-400) 18%, transparent);
  }
  .caption-text {
    font-size: 15px;
    color: color-mix(in oklab, var(--color-white) 82%, transparent);
    transition: opacity 0.42s var(--ease-out);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
    margin-top: 80px;
    padding-top: 46px;
    border-top: 1px solid color-mix(in oklab, var(--color-white) 12%, transparent);
  }
  .stat-num {
    font-family: var(--font-sans);
    font-weight: 300;
    font-size: clamp(40px, 4.4vw, 58px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-white);
  }
  .stat-num .sup {
    color: var(--brand-300);
  }
  .stat-lbl {
    margin-top: 12px;
    font-size: 14px;
    color: color-mix(in oklab, var(--color-white) 60%, transparent);
  }

  @media (max-width: 640px) {
    .field {
      gap: 8px;
    }
    .stats {
      margin-top: 56px;
    }
  }
</style>

<script>
  // Rotating live caption — vanilla, reduced-motion aware. Without JS the first
  // caption is server-rendered and simply stays put.
  const root = document.querySelector<HTMLElement>('.live');
  const el = root?.querySelector<HTMLElement>('[data-live-caption]');
  if (root && el && root.dataset.captions) {
    let caps: string[] = [];
    try {
      caps = JSON.parse(root.dataset.captions);
    } catch {
      caps = [];
    }
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (caps.length > 1 && !reduce) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % caps.length;
        el.style.opacity = '0';
        setTimeout(() => {
          el.textContent = caps[i];
          el.style.opacity = '1';
        }, 420);
      }, 3400);
    }
  }
</script>
