---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../../primitives/Button.astro';

// Bring-it-to-your-school — the closing CTA as a light photographic split: a photo
// card with a glass "now playing" chip on the left, and the headline + CTAs + trust
// pills on the right. (Distinct from the shared dark EditorialCTA used elsewhere — this
// reproduces the home design's lighter split treatment.)
interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow: string;
  headingTop: string;
  headingBottom: string;
  body: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  pills: string[];
  chip: { title: string; sub: string };
  image: ImageMetadata;
  imageAlt: string;
}
const {
  eyebrow,
  headingTop,
  headingBottom,
  body,
  primaryCta,
  secondaryCta,
  pills,
  chip,
  image,
  imageAlt,
} = Astro.props as Props;
const wave = Array.from({ length: 12 }, (_, i) => ({
  h: 30 + Math.round(Math.abs(Math.sin(i * 1.6)) * 60),
  dur: (0.9 + (i % 4) * 0.16).toFixed(2),
  delay: ((i % 5) * 0.08).toFixed(2),
}));
---

<section id="demo" class="demo" aria-labelledby="demo-heading">
  <div class="inner" data-home-reveal>
    <div class="media">
      <Image
        class="media-photo"
        src={image}
        alt={imageAlt}
        widths={[480, 768, 1100]}
        sizes="(max-width: 860px) 92vw, 520px"
        loading="lazy"
      />
      <div class="media-scrim" aria-hidden="true"></div>
      <div class="chip">
        <span class="chip-play" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"
            ><path d="M8 5v14l11-7z"></path></svg
          >
        </span>
        <div class="chip-meta">
          <div class="chip-title">{chip.title}</div>
          <div class="chip-sub">{chip.sub}</div>
        </div>
        <div class="chip-wave" aria-hidden="true">
          {
            wave.map((b) => (
              <span class="cbar" style={`--h:${b.h}%;--dur:${b.dur}s;--delay:${b.delay}s`} />
            ))
          }
        </div>
      </div>
    </div>

    <div class="copy">
      <p class="eyebrow"><span class="rule" aria-hidden="true"></span>{eyebrow}</p>
      <h2 id="demo-heading" class="h">
        <span class="h-top">{headingTop}</span>
        <span class="h-bottom">{headingBottom}</span>
      </h2>
      <p class="lead">{body}</p>
      <div class="actions">
        <Button href={primaryCta.href} tone="brand" shape="pill" size="lg" class="primary">
          {primaryCta.label}
          <svg
            viewBox="0 0 24 24"
            width="17"
            height="17"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>
          </svg>
        </Button>
        {
          secondaryCta && (
            <a class="text-link" href={secondaryCta.href}>
              {secondaryCta.label}
              <svg
                viewBox="0 0 24 24"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <>
                  <path d="M5 12h14" />
                  <path d="m12 5 7 7-7 7" />
                </>
              </svg>
            </a>
          )
        }
      </div>
      <ul class="pills">
        {
          pills.map((p) => (
            <li>
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="20 6 9 17 4 12" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .demo {
    padding: clamp(5rem, 4rem + 5vw, 7.5rem) clamp(20px, 5vw, 34px);
    background: var(--color-background);
    color: var(--color-foreground);
  }
  .inner {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 52px;
    align-items: stretch;
  }

  .media {
    position: relative;
    overflow: hidden;
    min-height: 460px;
    border-radius: 24px;
    background: radial-gradient(120% 100% at 30% 20%, var(--brand-800), var(--home-night-2));
    box-shadow: var(--shadow-lg);
  }
  .media-photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.92;
  }
  .media-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in oklab, var(--home-night) 60%, transparent) 0%,
      transparent 45%
    );
  }
  .chip {
    position: absolute;
    left: 22px;
    right: 22px;
    bottom: 22px;
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 12px 16px;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-white) 16%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-white) 28%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .chip-play {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--home-night);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-left: 2px;
  }
  .chip-meta {
    flex: 1;
    min-width: 0;
    color: var(--color-white);
  }
  .chip-title {
    font-weight: 600;
    font-size: 13px;
  }
  .chip-sub {
    font-size: 11.5px;
    color: color-mix(in oklab, var(--color-white) 70%, transparent);
  }
  .chip-wave {
    display: flex;
    align-items: center;
    gap: 2px;
    width: 60px;
    height: 18px;
  }
  .cbar {
    flex: 1;
    min-width: 2px;
    height: var(--h);
    border-radius: 3px;
    transform-origin: center;
    background: color-mix(in oklab, var(--color-white) 85%, transparent);
    animation: demo-wave var(--dur) ease-in-out var(--delay) infinite;
  }
  @keyframes demo-wave {
    0%,
    100% {
      transform: scaleY(0.3);
    }
    50% {
      transform: scaleY(1);
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 14px 4px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 26px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .eyebrow .rule {
    width: 26px;
    height: 1px;
    background: var(--color-brand);
  }
  .h {
    margin: 0 0 22px;
  }
  .h-top {
    display: block;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(38px, 4.4vw, 60px);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-foreground);
  }
  .h-bottom {
    display: block;
    margin-top: 4px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(40px, 4.6vw, 64px);
    line-height: 1.02;
    color: var(--color-brand);
  }
  .lead {
    margin: 0 0 32px;
    max-width: 440px;
    font-size: 17px;
    line-height: 1.62;
    color: var(--color-muted-foreground);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-bottom: 30px;
  }
  .primary {
    gap: 10px;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    font-size: 15px;
    color: var(--color-foreground);
    transition: gap 0.3s var(--ease-out);
  }
  .text-link:hover {
    gap: 12px;
  }
  .pills {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pills li {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 8px 14px;
    border-radius: 9999px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-foreground);
  }
  .pills li svg {
    color: var(--color-brand);
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .media {
      min-height: 320px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cbar {
      animation: none;
    }
    .text-link {
      transition: none;
    }
  }
</style>
