---
// Contact form body. Sits inside a primary ContactCard.
//
// Submission target: Netlify Forms (the host platform). `data-netlify="true"`,
// `name="demo"`, and a hidden `form-name` input let Netlify pick it up at build
// time, so there is no backend code. A honeypot `bot-field` blocks naive spam bots.
//
// Progressive enhancement: native HTML5 validation (`required`, `type="email"`)
// is the floor. A small vanilla <script> intercepts submit on success, fetches
// to "/" with the form data (Netlify's accepted endpoint for AJAX submissions),
// and swaps the form for the in-page confirmation card. If JS fails, the form
// submits normally and Netlify shows its default thank-you page.

import { editableText, type EditablePrefix } from '../../../lib/editable';

interface Option {
  value: string;
  label: string;
}

interface Props {
  /** "Job role" dropdown options. */
  roles: Option[];
  /** "State or region" dropdown options. */
  states: Option[];
  /** Submit button label. */
  submitLabel: string;
  /** Copy shown in place of the form after a successful submit. */
  confirmation: string;
  /** CloudCannon path prefix for this form's copy (e.g. 'form'). Omit on routes not
   *  backed by a `pages` collection entry. See lib/editable.ts.
   *
   *  `confirmation` is deliberately NOT an editable region: it lives inside a
   *  <template>, whose contents are a detached fragment the Visual Editor cannot
   *  reach. Edit it from the sidebar. */
  editablePrefix?: EditablePrefix;
}
const { roles, states, submitLabel, confirmation, editablePrefix }: Props = Astro.props;
---

<form
  class="demo-form"
  name="demo"
  method="POST"
  action="/"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
  novalidate
>
  <input type="hidden" name="form-name" value="demo" />
  <p class="visually-hidden" aria-hidden="true">
    <label>Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label
    >
  </p>

  <div class="grid">
    <div class="field">
      <label for="demo-first">First name<span class="req" aria-hidden="true">*</span></label>
      <input
        id="demo-first"
        name="firstName"
        class="input"
        type="text"
        autocomplete="given-name"
        required
        aria-required="true"
      />
    </div>

    <div class="field">
      <label for="demo-last">Last name<span class="req" aria-hidden="true">*</span></label>
      <input
        id="demo-last"
        name="lastName"
        class="input"
        type="text"
        autocomplete="family-name"
        required
        aria-required="true"
      />
    </div>

    <div class="field">
      <label for="demo-email">Email<span class="req" aria-hidden="true">*</span></label>
      <input
        id="demo-email"
        name="email"
        class="input"
        type="email"
        autocomplete="email"
        required
        aria-required="true"
      />
    </div>

    <div class="field">
      <label for="demo-role">Job role<span class="req" aria-hidden="true">*</span></label>
      <select id="demo-role" name="role" class="select" required aria-required="true">
        <option value="">Select one</option>
        {roles.map((r) => <option value={r.value}>{r.label}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="demo-state">State or region<span class="req" aria-hidden="true">*</span></label>
      <select id="demo-state" name="state" class="select" required aria-required="true">
        <option value="">Select one</option>
        {states.map((s) => <option value={s.value}>{s.label}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="demo-district">District name<span class="req" aria-hidden="true">*</span></label>
      <input
        id="demo-district"
        name="district"
        class="input"
        type="text"
        autocomplete="organization"
        required
        aria-required="true"
      />
    </div>

    <div class="field">
      <label for="demo-school">School name</label>
      <input id="demo-school" name="school" class="input" type="text" />
    </div>

    <div class="field field-wide">
      <label for="demo-message">Message for our team</label>
      <textarea id="demo-message" name="message" class="textarea" rows="4"></textarea>
    </div>
  </div>

  <div class="footer-row">
    <button type="submit" class="btn-submit">
      <span class="label" {...editableText(editablePrefix, 'submitLabel')}>{submitLabel}</span>
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </button>
  </div>
</form>

<template id="demo-success-template">
  <div class="success" role="status" aria-live="polite">
    <div class="success-check" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.6"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
    </div>
    <p class="success-body">{confirmation}</p>
  </div>
</template>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    border: 0;
  }

  .demo-form {
    margin-top: 28px;
  }
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-wide {
    grid-column: 1 / -1;
  }
  .field label {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-foreground);
  }
  .req {
    margin-left: 2px;
    color: var(--color-brand-emphasis);
  }
  .input,
  .select,
  .textarea {
    width: 100%;
    height: 48px;
    padding: 0 16px;
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 400;
    line-height: 1;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    outline: none;
    appearance: none;
    -webkit-appearance: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .textarea {
    height: auto;
    min-height: 108px;
    padding: 14px 16px;
    line-height: 1.5;
    resize: vertical;
  }
  .select {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%2364748b' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><polyline points='6 9 12 15 18 9'/></svg>");
    background-repeat: no-repeat;
    background-position: right 14px center;
    padding-right: 40px;
  }
  .input::placeholder,
  .textarea::placeholder {
    color: var(--color-muted-foreground);
  }
  .input:focus,
  .select:focus,
  .textarea:focus {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--color-brand) 18%, transparent);
  }
  .input[aria-invalid='true'],
  .select[aria-invalid='true'] {
    border-color: var(--color-danger);
  }

  /* The submit button is the only child, so align to the end rather than
     `space-between`, which would push a lone child to the start edge. */
  .footer-row {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 20px;
    margin-top: 24px;
    flex-wrap: wrap;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 52px;
    padding: 0 28px;
    border: 0;
    border-radius: 9999px;
    background: var(--color-brand);
    color: var(--color-brand-foreground);
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    box-shadow: 0 10px 24px -10px color-mix(in oklab, var(--color-brand) 60%, transparent);
    transition:
      transform var(--dur-fast) var(--ease-out),
      filter var(--dur-fast) var(--ease-out);
  }
  .btn-submit:hover {
    filter: brightness(0.94);
    transform: translateY(-1px);
  }
  .btn-submit:active {
    transform: scale(0.98);
  }
  .btn-submit svg {
    width: 16px;
    height: 16px;
  }

  /* Confirmation state, swapped in by JS after a valid submit. */
  :global(.success) {
    padding: 24px 4px 4px;
    display: flex;
    align-items: flex-start;
    gap: 18px;
    animation: fadeUp var(--dur-slow) var(--ease-out) both;
  }
  :global(.success-check) {
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    background: var(--brand-300);
    color: var(--brand-900);
    box-shadow: 0 4px 12px color-mix(in oklab, var(--color-brand) 32%, transparent);
  }
  :global(.success-check svg) {
    width: 22px;
    height: 22px;
  }
  :global(.success-body) {
    margin: 0;
    max-width: 520px;
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.55;
    color: var(--color-foreground);
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .footer-row {
      flex-direction: column;
      align-items: flex-start;
    }
    .btn-submit {
      width: 100%;
    }
  }
</style>

<script>
  // Vanilla progressive enhancement for the contact form. Without JS the form
  // submits normally to Netlify; with JS we intercept, validate, ship the data
  // in the background, and render the confirmation in place.
  const form = document.querySelector<HTMLFormElement>('form.demo-form');
  const template = document.getElementById('demo-success-template') as HTMLTemplateElement | null;
  if (form && template) {
    const validate = () => {
      let firstInvalid: HTMLElement | null = null;
      form
        .querySelectorAll<HTMLInputElement | HTMLSelectElement>('[aria-required="true"]')
        .forEach((el) => {
          const ok =
            el.value.trim().length > 0 &&
            (el.type !== 'email' || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value));
          el.setAttribute('aria-invalid', ok ? 'false' : 'true');
          if (!ok && !firstInvalid) firstInvalid = el;
        });
      return firstInvalid;
    };

    form.addEventListener('submit', async (event) => {
      const invalid = validate();
      if (invalid) {
        event.preventDefault();
        (invalid as HTMLElement).focus();
        return;
      }
      event.preventDefault();

      const data = new FormData(form);

      // Best-effort background submit; failure falls back to a real submit.
      try {
        await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
        });
      } catch {
        form.submit();
        return;
      }

      const node = template.content.cloneNode(true) as DocumentFragment;
      form.replaceWith(node);
    });
  }
</script>
