---
// Feature-by-feature plan comparison for /pricing.
//
// Rows are grouped into labelled categories (Overview, Programming, …). Each row
// carries one cell per plan, in plan order. Cells are either an availability
// token ('yes' | 'no' | 'na'), a priced add-on ({ price, note }), or free text
// ("1 included"). The highlighted plan's column carries a brand frame end to end
// (through the full-width group bands) plus a "Recommended" tab on its header.
//
// Behaviour, cheapest mechanism first:
//   • "Show only differences" — a native checkbox switch; CSS `:has()` hides every
//     row whose cells are all 'yes' and swaps the counts. No JS.
//   • Collapsible groups, the compact sticky plan header (desktop + mobile) and the
//     mobile bottom CTA bar — one small vanilla script at the end. Without JS every
//     group stays open and the sticky chrome never appears; the table still works.
//
// Layout: one <table> for every width. ≥ 768px it is a fixed-layout table (40% /
// 20% / 20% / 20%). Below 768px each row becomes a grid: the feature name spans the
// width with the three plan values underneath, so all plans stay visible on a
// phone with no sideways scroll.
//
// The compact sticky header is a separate, presentational element (aria-hidden,
// links out of the tab order): the real <thead> and <tfoot> carry the semantics
// and the CTAs, and Chromium still mispaints `position: sticky` table headers.

import type { Plan } from './PlanCards.astro';
import Button from '../../primitives/Button.astro';
import { editableText, type EditablePrefix } from '../../../lib/editable';

/** A priced add-on cell: the figure plus an optional license note. */
export interface PriceCell {
  price: string;
  note?: string;
}
export type Cell = 'yes' | 'no' | 'na' | PriceCell | string;

export interface Row {
  feat: string;
  /** Small qualifier under the feature name (e.g. "Not available for single schools"). */
  note?: string;
  /** One cell per plan, in the same order as `plans`. */
  cells: readonly Cell[];
}
export interface Group {
  title: string;
  rows: readonly Row[];
}

interface Props {
  eyebrow: string;
  titleHtml: string;
  intro: string;
  plans: readonly Plan[];
  groups: readonly Group[];
  /** Footnote under the table (funding, taxes, quotes). */
  footnote?: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'compare'). Omit on
   *  routes that are not backed by a `pages` collection entry. See lib/editable.ts.
   *
   *  `groups` is bound with INDEXED paths, not `editableArray`: an array container
   *  may hold only its own rows, and neither the <table> (which also holds
   *  <thead>/<tfoot>) nor a <tbody> (which also holds its group band) qualifies.
   *  Text editing works; add/remove stays in the sidebar. */
  editablePrefix?: EditablePrefix;
}
const { eyebrow, titleHtml, intro, plans, groups, footnote, editablePrefix }: Props = Astro.props;

function isPrice(v: Cell): v is PriceCell {
  return typeof v === 'object' && v !== null && 'price' in v;
}
/** A row every plan includes — hidden by "Show only differences". */
const isSame = (r: Row) => r.cells.every((c) => c === 'yes');

const total = groups.reduce((n, g) => n + g.rows.length, 0);
const differing = groups.reduce((n, g) => n + g.rows.filter((r) => !isSame(r)).length, 0);

// Column geometry, shared by the table, the full-width band stripes and the sticky
// header so all three line up. The feature column takes 40%; plans split the rest.
const planPct = 60 / Math.max(plans.length, 1);
const hlIndex = plans.findIndex((p) => p.highlight);
const hlStart = hlIndex < 0 ? null : 40 + planPct * hlIndex;
const geometry =
  `--cmp-plans: ${plans.length}; --cmp-plan-w: ${planPct}%;` +
  (hlStart === null ? '' : ` --cmp-hl-start: ${hlStart}%; --cmp-hl-end: ${hlStart + planPct}%;`);
const primary = plans[hlIndex] ?? plans[0];
---

<section
  class="cmp"
  id="compare"
  aria-labelledby="compare-head"
  data-cmp
  data-has-hl={hlStart !== null ? '' : undefined}
  style={geometry}
>
  <div class="cmp-inner">
    <div class="cmp-head">
      <p class="eyebrow" {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</p>
      {/* An HTML field cannot back a plain-text region — it stays sidebar-editable. */}
      <h2 id="compare-head" class="head-h" set:html={titleHtml} />
      <p class="head-p" {...editableText(editablePrefix, 'intro', 'text')}>{intro}</p>
    </div>

    <div class="cmp-card">
      {/* Compact plan header that pins under the fixed nav while the table scrolls. */}
      <div class="cmp-sticky" aria-hidden="true">
        <div class="sticky-bar">
          <div class="sticky-now">
            <span class="sticky-kicker">Now viewing</span>
            <span class="sticky-group" data-cmp-now>{groups[0]?.title}</span>
          </div>
          {
            plans.map((p) => (
              <div class:list={['sticky-plan', { hl: p.highlight }]}>
                <span class="sticky-name">{p.name}</span>
                <span class="sticky-price">
                  {p.price}
                  <span class="sticky-unit"> {p.unit}</span>
                </span>
                <a class="sticky-link" href={p.ctaHref} tabindex="-1">
                  Contact for pricing
                </a>
              </div>
            ))
          }
        </div>
      </div>

      <table role="table">
        <caption class="sr-only">Inner Explorer plans compared feature by feature.</caption>
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader" class="th-key">
              <span class="key-label">What&rsquo;s included</span>
              <ul class="key" aria-label="Key">
                <li>
                  <span class="glyph yes" aria-hidden="true">
                    <svg viewBox="0 0 256 256" width="20" height="20" fill="currentColor">
                      <path
                        d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z"
                      ></path>
                    </svg>
                  </span>
                  Included
                </li>
                <li>
                  <span class="key-dollar" aria-hidden="true">$</span> Optional add-on, priced per site
                </li>
                <li><span class="dash" aria-hidden="true"></span> Not included</li>
              </ul>
              <label class="switch">
                <input type="checkbox" role="switch" class="switch-input" data-cmp-diff />
                <span class="switch-track" aria-hidden="true"
                  ><span class="switch-knob"></span></span
                >
                <span class="switch-label">Show only differences</span>
              </label>
              <p class="switch-count" aria-live="polite">
                <span class="when-all">Showing {total} of {total} features</span>
                <span class="when-diff">Showing {differing} of {total} features</span>
              </p>
            </th>
            {
              plans.map((p) => (
                <th scope="col" role="columnheader" class:list={['th-plan', { hl: p.highlight }]}>
                  {p.highlight && <span class="rec-tab">Recommended</span>}
                  <div class="plan-inner">
                    <div class="plan-top">
                      <span class="plan-name">{p.name}</span>
                      <span class="plan-price">{p.price}</span>
                      <span class="plan-unit">{p.unit}</span>
                    </div>
                    <Button
                      href={p.ctaHref}
                      variant={p.highlight ? 'solid' : 'outline'}
                      tone={p.highlight ? 'brand' : 'neutral'}
                      block
                      class="plan-cta"
                    >
                      Contact for pricing
                      <span class="sr-only"> for the {p.name} plan</span>
                    </Button>
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        {
          groups.map((g, gi) => {
            const diffCount = g.rows.filter((r) => !isSame(r)).length;
            return (
              <tbody class="grp" id={`cmp-group-${gi}`} data-cmp-group={g.title}>
                <tr class="grp-row" role="row">
                  <th scope="rowgroup" role="rowheader" colspan={plans.length + 1}>
                    <button
                      type="button"
                      class="grp-toggle"
                      aria-expanded="true"
                      aria-controls={`cmp-group-${gi}`}
                      data-cmp-toggle
                    >
                      <svg
                        class="caret"
                        viewBox="0 0 256 256"
                        width="20"
                        height="20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z" />
                      </svg>
                      <span
                        class="grp-title"
                        {...editableText(editablePrefix, `groups.${gi}.title`)}
                      >
                        {g.title}
                      </span>
                      <span class="grp-count">
                        <span class="when-all">{g.rows.length} features</span>
                        <span class="when-diff">
                          {diffCount} of {g.rows.length} features
                        </span>
                      </span>
                    </button>
                  </th>
                </tr>
                {g.rows.map((r, ri) => (
                  <tr class="row" role="row" data-same={isSame(r) ? '' : undefined}>
                    <th scope="row" role="rowheader" class="td-feat">
                      <span
                        class="feat-name"
                        {...editableText(editablePrefix, `groups.${gi}.rows.${ri}.feat`)}
                      >
                        {r.feat}
                      </span>
                      {r.note && (
                        <span
                          class="feat-note"
                          {...editableText(editablePrefix, `groups.${gi}.rows.${ri}.note`)}
                        >
                          {r.note}
                        </span>
                      )}
                    </th>
                    {/* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role -- explicit table roles survive the phone layout's display: grid (Safari drops the implicit ones); the rule's 'td is interactive' is a false positive. */}
                    {r.cells.map((v, i) => (
                      <td role="cell" class:list={['td-cell', { hl: plans[i]?.highlight }]}>
                        {v === 'yes' && (
                          <span class="glyph yes">
                            <svg
                              viewBox="0 0 256 256"
                              width="20"
                              height="20"
                              fill="currentColor"
                              aria-hidden="true"
                            >
                              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z" />
                            </svg>
                            <span class="sr-only">Included</span>
                          </span>
                        )}
                        {v === 'no' && (
                          <>
                            <span class="dash" aria-hidden="true" />
                            <span class="sr-only">Not included</span>
                          </>
                        )}
                        {v === 'na' && <span class="na">Not applicable</span>}
                        {isPrice(v) && (
                          <span class="addon">
                            <span class="addon-price">
                              {v.price} <span class="addon-tag">add-on</span>
                            </span>
                            {v.note && <span class="addon-note">{v.note}</span>}
                          </span>
                        )}
                        {/* Only the free-text branch resolves to a string an editor
                            should retype. The 'yes'/'no'/'na' tokens render as glyphs
                            and the priced add-on is an object — both would be wrong
                            (or an error card) as text regions, so they stay in the
                            sidebar. */}
                        {typeof v === 'string' && !['yes', 'no', 'na'].includes(v) && (
                          <span
                            class="text"
                            {...editableText(editablePrefix, `groups.${gi}.rows.${ri}.cells.${i}`)}
                          >
                            {v}
                          </span>
                        )}
                      </td>
                    ))}
                    {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
                  </tr>
                ))}
              </tbody>
            );
          })
        }
        <tfoot>
          <tr role="row">
            <th scope="row" role="rowheader" class="foot-feat">
              <span class="foot-title">Ready when you are</span>
              <span class="foot-sub">Our team replies within 1 business day.</span>
            </th>
            {
              /* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role -- explicit table roles survive the phone layout's display: grid (Safari drops the implicit ones); the rule's 'td is interactive' is a false positive. */
            }
            {
              plans.map((p) => (
                <td role="cell" class:list={['foot-cell', { hl: p.highlight }]}>
                  <span class="foot-plan">
                    <span class="foot-plan-name">{p.name}</span>
                    <span class="foot-plan-price">
                      {p.price} {p.unit}
                    </span>
                  </span>
                  <Button
                    href={p.ctaHref}
                    variant={p.highlight ? 'solid' : 'outline'}
                    tone={p.highlight ? 'brand' : 'neutral'}
                    block
                    class="plan-cta"
                  >
                    Contact for pricing
                    <span class="sr-only"> for the {p.name} plan</span>
                  </Button>
                </td>
              ))
            }
            {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
          </tr>
        </tfoot>
      </table>
    </div>

    {
      footnote && (
        <p class="footnote" {...editableText(editablePrefix, 'footnote', 'text')}>
          {footnote}
        </p>
      )
    }
  </div>

  {/* Phone only: slides up while the table is on screen, away once its own CTAs show. */}
  {
    primary && (
      <div class="cmp-bar">
        <Button href={primary.ctaHref} block class="bar-cta">
          Contact for pricing
        </Button>
      </div>
    )
  }
</section>

<script>
  // Progressive enhancement for every comparison table on the page: group
  // collapse, the compact sticky header and the phone bottom bar.
  for (const root of document.querySelectorAll<HTMLElement>('[data-cmp]')) {
    for (const btn of root.querySelectorAll<HTMLButtonElement>('[data-cmp-toggle]')) {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!open));
        btn.closest('tbody')?.toggleAttribute('data-collapsed', open);
      });
    }

    const head = root.querySelector('thead');
    const foot = root.querySelector('tfoot');
    const sticky = root.querySelector<HTMLElement>('.sticky-bar');
    const now = root.querySelector<HTMLElement>('[data-cmp-now]');
    const groups = [...root.querySelectorAll<HTMLElement>('[data-cmp-group]')];
    if (!head || !foot || !sticky) continue;

    let queued = false;
    const update = () => {
      queued = false;
      const top = parseFloat(getComputedStyle(root).getPropertyValue('--cmp-sticky-top')) || 0;
      const barH = sticky.offsetHeight;
      const headGone = head.getBoundingClientRect().bottom < top;
      const footTop = foot.getBoundingClientRect().top;
      root.toggleAttribute('data-stuck', headGone && footTop > top + barH);
      root.toggleAttribute('data-bar', headGone && footTop > window.innerHeight);
      if (now) {
        const line = top + barH;
        const current = groups.filter((g) => g.getBoundingClientRect().top <= line).pop();
        now.textContent = current?.dataset.cmpGroup ?? groups[0]?.dataset.cmpGroup ?? '';
      }
    };
    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .cmp {
    /* Clears the fixed nav pill (16px inset + ~64px pill + 16px gap). */
    --cmp-sticky-top: 96px;
    --cmp-band: color-mix(in oklab, var(--color-muted) 55%, var(--color-card));
    --cmp-hl: var(--color-brand);
    background: var(--color-background);
    padding: var(--spacing-section-md) 0;
    border-top: 1px solid var(--color-border);
  }
  .cmp-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Section head --------------------------------------------------------- */
  .cmp-head {
    max-width: 760px;
    margin-bottom: 32px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--color-border);
  }
  .head-h {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-wrap: balance;
  }
  .head-h :global(em) {
    font-style: normal;
    font-weight: 700;
    color: var(--color-brand-emphasis);
  }
  .head-p {
    margin: 20px 0 0;
    max-width: 720px;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    color: var(--color-muted-foreground);
    text-wrap: balance;
  }

  /* Card + table --------------------------------------------------------- */
  .cmp-card {
    position: relative;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }
  th,
  td {
    font-weight: 400;
  }

  /* The recommended column's frame: two 2px brand rules down every cell of that
     column, closed at the header top and the footer bottom. */
  .hl {
    box-shadow:
      inset 2px 0 0 var(--cmp-hl),
      inset -2px 0 0 var(--cmp-hl);
  }

  /* Header row */
  thead th {
    vertical-align: bottom;
    border-bottom: 1px solid var(--color-border);
  }
  .th-key {
    width: 40%;
    padding: 24px 24px 20px;
    text-align: left;
  }
  .th-plan {
    position: relative;
    width: var(--cmp-plan-w);
    /* The 1px height lets .plan-inner resolve height: 100% against the row, whose
       height the key cell sets. */
    height: 1px;
    padding: 0 20px 20px;
    text-align: center;
  }
  thead th:first-child {
    border-top-left-radius: var(--radius-sm);
  }
  thead th:last-child {
    border-top-right-radius: var(--radius-sm);
  }
  .th-plan.hl {
    border-top-left-radius: var(--radius-sm);
    border-top-right-radius: var(--radius-sm);
    box-shadow:
      inset 2px 0 0 var(--cmp-hl),
      inset -2px 0 0 var(--cmp-hl),
      inset 0 2px 0 var(--cmp-hl);
  }
  .rec-tab {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 2px 12px;
    border-radius: 9999px;
    background: var(--color-brand);
    color: var(--color-brand-foreground);
    font-size: var(--text-sm);
    line-height: 20px;
    font-weight: 700;
    white-space: nowrap;
  }
  /* Name/price centred in the space between the header's top edge and its button:
     the key cell sets the row height, this block grows to fill it. */
  .plan-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  .plan-top {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 16px 0;
  }
  .plan-name {
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: 700;
    color: var(--color-foreground);
  }
  .plan-price {
    margin-top: 4px;
    font-size: var(--text-2xl);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .plan-unit {
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-muted-foreground);
  }
  :global(.plan-cta) {
    white-space: nowrap;
  }

  .key-label {
    display: block;
    margin-bottom: 12px;
    font-size: var(--text-sm);
    line-height: 1.15;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .key {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .key li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-foreground);
  }
  .key-dollar {
    width: 20px;
    text-align: center;
    font-weight: 700;
    color: var(--color-foreground);
  }

  /* "Show only differences" switch (a styled native checkbox) */
  .switch {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    margin-top: 12px;
    cursor: pointer;
  }
  .switch-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .switch-track {
    position: relative;
    flex: none;
    width: 40px;
    height: 24px;
    border-radius: 9999px;
    background: var(--color-border);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .switch-knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    border-radius: 9999px;
    background: var(--color-card);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-fast) var(--ease-out);
  }
  .switch-input:checked + .switch-track {
    background: var(--color-brand);
  }
  .switch-input:checked + .switch-track .switch-knob {
    transform: translateX(16px);
  }
  .switch-input:focus-visible + .switch-track {
    outline: 2px solid var(--color-ring);
    outline-offset: 2px;
  }
  .switch-label {
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    font-weight: 500;
    color: var(--color-foreground);
  }
  .switch-count {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    color: var(--color-muted-foreground);
  }

  /* Differences-only mode: swap every count, hide rows every plan includes. */
  .when-diff {
    display: none;
  }
  .cmp:has(.switch-input:checked) .when-all {
    display: none;
  }
  .cmp:has(.switch-input:checked) .when-diff {
    display: inline;
  }
  .cmp:has(.switch-input:checked) .row[data-same] {
    display: none;
  }

  /* Group bands: one full-width bar per category. Two background stripes carry the
     recommended column's frame straight through it. */
  .grp-row th {
    padding: 0;
    text-align: left;
    border-top: 1px solid var(--color-border);
    background: var(--cmp-band);
  }
  .cmp[data-has-hl] .grp-row th {
    background:
      linear-gradient(
        to right,
        transparent var(--cmp-hl-start),
