---
// Feature-by-feature plan comparison for /pricing — the shared ComparisonTable with
// plans as its columns. This wrapper only maps the page's data (plans + grouped
// rows) onto the component and names each field's CloudCannon path.

import type { Plan } from './PlanCards.astro';
import ComparisonTable, { type Cell as TableCell, type Column } from '../ComparisonTable.astro';
import type { EditablePrefix } from '../../../lib/editable';

export type { PriceCell } from '../ComparisonTable.astro';
/** Pricing cells: 'yes' | 'no' | 'na', a priced add-on, or free text. */
export type Cell = TableCell;
export interface Row {
  feat: string;
  /** Small qualifier under the feature name (e.g. "Not available for single schools"). */
  note?: string;
  /** One cell per plan, in the same order as `plans`. */
  cells: readonly Cell[];
}
export interface Group {
  title: string;
  rows: readonly Row[];
}

interface Props {
  eyebrow: string;
  titleHtml: string;
  intro: string;
  plans: readonly Plan[];
  groups: readonly Group[];
  /** Footnote under the table (funding, taxes, quotes). */
  footnote?: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'compare'). See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
}
const { eyebrow, titleHtml, intro, plans, groups, footnote, editablePrefix }: Props = Astro.props;

const columns: Column[] = plans.map((p) => ({
  name: p.name,
  price: p.price,
  unit: p.unit,
  highlight: p.highlight,
  cta: { label: 'Contact for pricing', href: p.ctaHref, for: `the ${p.name} plan` },
}));
const tableGroups = groups.map((g, gi) => ({
  title: g.title,
  titlePath: `groups.${gi}.title`,
  rows: g.rows.map((r, ri) => ({
    ...r,
    featPath: `groups.${gi}.rows.${ri}.feat`,
    notePath: `groups.${gi}.rows.${ri}.note`,
    cellPaths: r.cells.map((_, i) => `groups.${gi}.rows.${ri}.cells.${i}`),
  })),
}));
---

<ComparisonTable
  eyebrow={eyebrow}
  titleHtml={titleHtml}
  intro={intro}
  caption="Inner Explorer plans compared feature by feature."
  columns={columns}
  groups={tableGroups}
  highlightTag="Recommended"
  footer={{ title: 'Ready when you are', sub: 'Our team replies within 1 business day.' }}
  footnote={footnote}
  editablePrefix={editablePrefix}
/>
