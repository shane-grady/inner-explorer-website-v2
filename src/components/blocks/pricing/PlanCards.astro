---
// Three-up plan cards for /pricing. One card per subscription: name, price,
// billing unit, the license description, and the plan's CTA. The `highlight`
// column gets the brand-tinted treatment so the standard school license reads
// as the anchor of the row.
//
// Shares its Plan type with PricingTable so the page declares each plan once.

import {
  editableArray,
  editableItem,
  editableText,
  itemPrefix,
  type EditablePrefix,
} from '../../../lib/editable';

export interface Plan {
  /** Machine id — also used to key the comparison table's columns. */
  id: string;
  /** Plan name (e.g. "Community"). */
  name: string;
  /** Big price figure (e.g. "$2,800"). */
  price: string;
  /** Billing unit under the price (e.g. "per school, per year"). */
  unit: string;
  /** One-line license description. */
  blurb: string;
  ctaLabel: string;
  ctaHref: string;
  /** Brand-tint this plan across the cards and the comparison table. */
  highlight?: boolean;
}

interface Props {
  plans: readonly Plan[];
  /** Small reassurance line under the row of cards. */
  note?: string;
  /** CloudCannon path prefix for the object holding `{ note, items }` (e.g.
   *  'plans'). Omit on routes that are not backed by a `pages` collection entry.
   *  See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
}
const { plans, note, editablePrefix }: Props = Astro.props;
const cardPrefix = itemPrefix(editablePrefix);
---

<section class="plans" aria-label="Subscription plans">
  <div class="plans-inner">
    {/* Container holds ONLY array rows, as CloudCannon's array regions require. */}
    <ul class="grid" {...editableArray(editablePrefix, 'items')}>
      {
        plans.map((p) => (
          <li class:list={['card', { hl: p.highlight }]} {...editableItem(editablePrefix)}>
            {/* Inside an array row, paths are relative to the row. */}
            <div class="name" {...editableText(cardPrefix, 'name')}>
              {p.name}
            </div>
            <div class="price-row">
              <span class="price" {...editableText(cardPrefix, 'price')}>
                {p.price}
              </span>
            </div>
            <div class="unit" {...editableText(cardPrefix, 'unit')}>
              {p.unit}
            </div>
            <p class="blurb" {...editableText(cardPrefix, 'blurb', 'text')}>
              {p.blurb}
            </p>
            <a class:list={['cta', { solid: p.highlight }]} href={p.ctaHref}>
              <span {...editableText(cardPrefix, 'ctaLabel')}>{p.ctaLabel}</span>
              <svg
                viewBox="0 0 24 24"
                width="15"
                height="15"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="13 6 19 12 13 18" />
              </svg>
            </a>
          </li>
        ))
      }
    </ul>
    {
      note && (
        <p class="note" {...editableText(editablePrefix, 'note', 'text')}>
          {note}
        </p>
      )
    }
  </div>
</section>

<style>
  .plans {
    background: var(--color-background);
    padding: 0 0 clamp(48px, 6vw, 80px);
  }
  .plans-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
  }

  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    align-items: stretch;
  }

  .card {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    background: var(--color-card);
    color: var(--color-card-foreground);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .card.hl {
    background: color-mix(in oklab, var(--color-brand) 7%, var(--color-card));
    border-color: color-mix(in oklab, var(--color-brand) 34%, transparent);
    box-shadow: var(--shadow-md);
  }

  .name {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .card.hl .name {
    color: var(--color-brand-emphasis);
  }

  .price-row {
    margin-top: 22px;
    display: flex;
    align-items: baseline;
  }
  .price {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(44px, 4.4vw, 60px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
  }
  .unit {
    margin-top: 10px;
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-muted-foreground);
  }

  .blurb {
    margin: 18px 0 28px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    font-size: 15px;
    line-height: 1.5;
    color: var(--color-foreground);
    flex: 1;
    text-wrap: pretty;
  }
  .card.hl .blurb {
    border-top-color: color-mix(in oklab, var(--color-brand) 26%, transparent);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 20px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-sans);
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.2;
    text-align: center;
    transition:
      background var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .cta:hover {
    background: var(--color-muted);
  }
  .cta.solid {
    border-color: transparent;
    background: var(--color-brand);
    color: var(--color-brand-foreground);
  }
  .cta.solid:hover {
    background: var(--color-brand-emphasis);
  }
  .cta svg {
    flex: 0 0 auto;
  }

  .note {
    margin: 28px 0 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }

  @media (max-width: 1000px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .plans-inner {
      padding: 0 24px;
    }
    .blurb {
      flex: 0 1 auto;
    }
  }
</style>
