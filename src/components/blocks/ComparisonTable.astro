---
// The comparison table — one component for every feature-by-feature comparison on the
// site (plans on /pricing, the alternatives on /districts). It is the PricingTable
// component of the design system; see that card for the anatomy and the rules.
//
// Rows are grouped into labelled, collapsible categories. Each row carries one cell
// per column, in column order. A cell is an availability token ('yes' | 'no' | 'na'
// | 'partial' | 'limited' | 'varies'), a priced add-on ({ price, note }), or free
// text ("1 included", "Med-High"). The highlighted column carries a brand frame end
// to end, optionally tagged ("Recommended").
//
// Columns are plans or competitors: `price`/`unit` and `cta` are optional. Only when
// columns carry CTAs does the table get its footer CTA row, the sticky header's links
// and the phone bottom bar.
//
// Behaviour, cheapest mechanism first:
//   • "Show only differences" — a native checkbox switch; CSS `:has()` hides every
//     row whose cells are all 'yes' and swaps the counts. No JS. Rendered only when
//     some rows are identical across columns.
//   • Collapsible groups, the compact sticky header and the phone bottom CTA bar —
//     one small vanilla script at the end. Without JS every group stays open and the
//     sticky chrome never appears; the table still works.
//
// Layout: one <table> for every width. ≥ 768px it is a fixed-layout table (40% for
// the feature column, the rest split evenly). Below 768px each row becomes a grid:
// the feature name spans the width with the column values underneath, so every
// column stays visible on a phone with no sideways scroll.
//
// The compact sticky header is a separate, presentational element (aria-hidden,
// links out of the tab order): the real <thead> and <tfoot> carry the semantics
// and the CTAs, and Chromium still mispaints `position: sticky` table headers.

import Button from '../primitives/Button.astro';
import { editableText, type EditablePrefix } from '../../lib/editable';

/** A priced add-on cell: the figure plus an optional license note. */
export interface PriceCell {
  price: string;
  note?: string;
}
export type Cell = 'yes' | 'no' | 'na' | 'partial' | 'limited' | 'varies' | PriceCell | string;

export interface Column {
  name: string;
  /** Small qualifier under the name ("Headspace, Calm, etc."). */
  note?: string;
  price?: string;
  unit?: string;
  highlight?: boolean;
  /** `for` completes the hidden button text "… for <for>" (default: the name). */
  cta?: { label: string; href: string; for?: string };
  /** CloudCannon paths (relative to `editablePrefix`) for the name and note. */
  namePath?: string;
  notePath?: string;
}
export interface Row {
  feat: string;
  /** Small qualifier under the feature name (e.g. "Middle and high school"). */
  note?: string;
  /** One cell per column, in the same order as `columns`. */
  cells: readonly Cell[];
  featPath?: string;
  notePath?: string;
  /** Per-cell paths; used only by free-text cells (tokens and add-ons stay in the sidebar). */
  cellPaths?: readonly (string | undefined)[];
}
export interface Group {
  title: string;
  rows: readonly Row[];
  titlePath?: string;
}

interface Props {
  /** Section id and the prefix for every internal id. */
  id?: string;
  eyebrow: string;
  titleHtml: string;
  intro: string;
  /** Label above the legend in the feature column's header. */
  keyLabel?: string;
  /** Visually hidden table caption. */
  caption: string;
  columns: readonly Column[];
  groups: readonly Group[];
  /** Words for the check and the dash — in the legend and for screen readers. */
  labels?: { yes: string; no: string };
  /** Legend entry for priced add-on cells. */
  addonLabel?: string;
  /** What a row is, for the counts ("4 features", "Showing 25 of 47 features"). */
  noun?: { one: string; other: string };
  /** Tab on the highlighted column's header ("Recommended"). */
  highlightTag?: string;
  /** Footer row beside the column CTAs. Shown only when columns carry CTAs. */
  footer?: { title: string; sub?: string };
  /** Footnote under the table (funding, taxes, quotes). */
  footnote?: string;
  /** CloudCannon path prefix for this block's fields. `eyebrow`, `intro` and
   *  `footnote` bind to those keys under it; rows, groups and columns carry their own
   *  paths. Omit on routes that are not backed by a `pages` collection entry. See
   *  lib/editable.ts.
   *
   *  Rows are bound with INDEXED paths, not `editableArray`: an array container may
   *  hold only its own rows, and neither the <table> (which also holds <thead>/
   *  <tfoot>) nor a <tbody> (which also holds its group band) qualifies. Text
   *  editing works; add/remove stays in the sidebar. */
  editablePrefix?: EditablePrefix;
}
const {
  id = 'compare',
  eyebrow,
  titleHtml,
  intro,
  keyLabel = 'What’s included',
  caption,
  columns,
  groups,
  labels = { yes: 'Included', no: 'Not included' },
  addonLabel = 'Optional add-on, priced per site',
  noun = { one: 'feature', other: 'features' },
  highlightTag,
  footer,
  footnote,
  editablePrefix,
}: Props = Astro.props;

const TOKENS = ['yes', 'no', 'na', 'partial', 'limited', 'varies'];
function isPrice(v: Cell): v is PriceCell {
  return typeof v === 'object' && v !== null && 'price' in v;
}
const isText = (v: Cell): v is string => typeof v === 'string' && !TOKENS.includes(v);
/** A row every column includes — hidden by "Show only differences". */
const isSame = (r: Row) => r.cells.every((c) => c === 'yes');
const edit = (path: string | undefined, type?: 'span' | 'text') =>
  path === undefined ? {} : editableText(editablePrefix, path, type);

const allCells = groups.flatMap((g) => g.rows.flatMap((r) => r.cells));
const has = (test: (c: Cell) => boolean) => allCells.some(test);
const legend = {
  yes: has((c) => c === 'yes'),
  addon: has(isPrice),
  partial: has((c) => c === 'partial' || c === 'limited'),
  no: has((c) => c === 'no'),
};

const total = groups.reduce((n, g) => n + g.rows.length, 0);
const differing = groups.reduce((n, g) => n + g.rows.filter((r) => !isSame(r)).length, 0);
const showSwitch = differing < total;

// Column geometry, shared by the table, the highlight frame and the sticky header so
// all three line up. The feature column takes 40%; the columns split the rest.
const colPct = 60 / Math.max(columns.length, 1);
const hlIndex = columns.findIndex((c) => c.highlight);
const geometry =
  `--cmp-cols: ${columns.length}; --cmp-col-w: ${colPct}%;` +
  (hlIndex < 0 ? '' : ` --cmp-hl-start: ${40 + colPct * hlIndex}%;`);
const hasCta = columns.some((c) => c.cta);
const primary = (columns[hlIndex]?.cta ? columns[hlIndex] : columns.find((c) => c.cta))?.cta;
---

<section class="cmp" id={id} aria-labelledby={`${id}-head`} data-cmp style={geometry}>
  <div class="cmp-inner">
    <div class="cmp-head">
      <p class="eyebrow" {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</p>
      {/* An HTML field cannot back a plain-text region — it stays sidebar-editable. */}
      <h2 id={`${id}-head`} class="head-h" set:html={titleHtml} />
      <p class="head-p" {...editableText(editablePrefix, 'intro', 'text')}>{intro}</p>
    </div>

    <div class="cmp-card">
      {hlIndex >= 0 && <div class="cmp-frame" aria-hidden="true" />}

      {/* Compact column header that pins under the fixed nav while the table scrolls. */}
      <div class="cmp-sticky" aria-hidden="true">
        <div class="sticky-bar">
          <div class="sticky-now">
            <span class="sticky-kicker">Now viewing</span>
            <span class="sticky-group" data-cmp-now>{groups[0]?.title}</span>
          </div>
          {
            columns.map((c) => (
              <div class:list={['sticky-plan', { hl: c.highlight }]}>
                <span class="sticky-name">{c.name}</span>
                {c.price && (
                  <span class="sticky-price">
                    {c.price}
                    {c.unit && <span class="sticky-unit"> {c.unit}</span>}
                  </span>
                )}
                {c.cta && (
                  <a class="sticky-link" href={c.cta.href} tabindex="-1">
                    {c.cta.label}
                  </a>
                )}
              </div>
            ))
          }
        </div>
      </div>

      <table role="table">
        <caption class="sr-only">{caption}</caption>
        <thead>
          <tr role="row">
            <th scope="col" role="columnheader" class="th-key">
              <span class="key-label">{keyLabel}</span>
              <ul class="key" aria-label="Key">
                {
                  legend.yes && (
                    <li>
                      <span class="glyph yes" aria-hidden="true">
                        <svg viewBox="0 0 256 256" width="20" height="20" fill="currentColor">
                          <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z" />
                        </svg>
                      </span>
                      {labels.yes}
                    </li>
                  )
                }
                {
                  legend.addon && (
                    <li>
                      <span class="key-dollar" aria-hidden="true">
                        $
                      </span>
                      {addonLabel}
                    </li>
                  )
                }
                {
                  legend.partial && (
                    <li>
                      <span class="glyph part" aria-hidden="true">
                        <svg viewBox="0 0 20 20" width="20" height="20">
                          <circle
                            cx="10"
                            cy="10"
                            r="7.75"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <path d="M10 2.25a7.75 7.75 0 0 1 0 15.5z" fill="currentColor" />
                        </svg>
                      </span>
                      Partial or limited
                    </li>
                  )
                }
                {
                  legend.no && (
                    <li>
                      <span class="dash" aria-hidden="true" /> {labels.no}
                    </li>
                  )
                }
              </ul>
              {
                showSwitch && (
                  <>
                    <label class="switch">
                      <input type="checkbox" role="switch" class="switch-input" />
                      <span class="switch-track" aria-hidden="true">
                        <span class="switch-knob" />
                      </span>
                      <span class="switch-label">Show only differences</span>
                    </label>
                    <p class="switch-count" aria-live="polite">
                      <span class="when-all">
                        Showing {total} of {total} {noun.other}
                      </span>
                      <span class="when-diff">
                        Showing {differing} of {total} {noun.other}
                      </span>
                    </p>
                  </>
                )
              }
            </th>
            {
              columns.map((c) => (
                <th scope="col" role="columnheader" class:list={['th-plan', { hl: c.highlight }]}>
                  {c.highlight && highlightTag && <span class="rec-tab">{highlightTag}</span>}
                  <div class="plan-inner">
                    <div class:list={['plan-top', { 'is-label': !c.price }]}>
                      <span class="plan-name" {...edit(c.namePath)}>
                        {c.name}
                      </span>
                      {c.note && (
                        <span class="plan-note" {...edit(c.notePath)}>
                          {c.note}
                        </span>
                      )}
                      {c.price && <span class="plan-price">{c.price}</span>}
                      {c.unit && <span class="plan-unit">{c.unit}</span>}
                    </div>
                    {c.cta && (
                      <Button
                        href={c.cta.href}
                        variant={c.highlight ? 'solid' : 'outline'}
                        tone={c.highlight ? 'brand' : 'neutral'}
                        block
                        class="plan-cta"
                      >
                        {c.cta.label}
                        <span class="sr-only"> for {c.cta.for ?? c.name}</span>
                      </Button>
                    )}
                  </div>
                </th>
              ))
            }
          </tr>
        </thead>
        {
          groups.map((g, gi) => {
            const gid = `${id}-group-${gi}`;
            const diffCount = g.rows.filter((r) => !isSame(r)).length;
            return (
              <tbody class="grp" id={gid} data-cmp-group={g.title}>
                <tr class="grp-row" role="row">
                  <th scope="rowgroup" role="rowheader" colspan={columns.length + 1}>
                    <button
                      type="button"
                      class="grp-toggle"
                      aria-expanded="true"
                      aria-controls={gid}
                      data-cmp-toggle
                    >
                      <svg
                        class="caret"
                        viewBox="0 0 256 256"
                        width="20"
                        height="20"
                        fill="currentColor"
                        aria-hidden="true"
                      >
                        <path d="M213.66,101.66l-80,80a8,8,0,0,1-11.32,0l-80-80A8,8,0,0,1,53.66,90.34L128,164.69l74.34-74.35a8,8,0,0,1,11.32,11.32Z" />
                      </svg>
                      <span class="grp-title" {...edit(g.titlePath)}>
                        {g.title}
                      </span>
                      <span class="grp-count">
                        <span class="when-all">
                          {g.rows.length} {g.rows.length === 1 ? noun.one : noun.other}
                        </span>
                        <span class="when-diff">
                          {diffCount} of {g.rows.length} {noun.other}
                        </span>
                      </span>
                    </button>
                  </th>
                </tr>
                {g.rows.map((r) => (
                  <tr class="row" role="row" data-same={isSame(r) ? '' : undefined}>
                    <th scope="row" role="rowheader" class="td-feat">
                      <span class="feat-name" {...edit(r.featPath)}>
                        {r.feat}
                      </span>
                      {r.note && (
                        <span class="feat-note" {...edit(r.notePath)}>
                          {r.note}
                        </span>
                      )}
                    </th>
                    {/* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role -- explicit table roles survive the phone layout's display: grid (Safari drops the implicit ones); the rule's 'td is interactive' is a false positive. */}
                    {r.cells.map((v, i) => (
                      <td role="cell" class:list={['td-cell', { hl: columns[i]?.highlight }]}>
                        {v === 'yes' && (
                          <span class="glyph yes">
                            <svg
                              viewBox="0 0 256 256"
                              width="20"
                              height="20"
                              fill="currentColor"
                              aria-hidden="true"
                            >
                              <path d="M128,24A104,104,0,1,0,232,128,104.11,104.11,0,0,0,128,24Zm45.66,85.66-56,56a8,8,0,0,1-11.32,0l-24-24a8,8,0,0,1,11.32-11.32L112,148.69l50.34-50.35a8,8,0,0,1,11.32,11.32Z" />
                            </svg>
                            <span class="sr-only">{labels.yes}</span>
                          </span>
                        )}
                        {v === 'no' && (
                          <>
                            <span class="dash" aria-hidden="true" />
                            <span class="sr-only">{labels.no}</span>
                          </>
                        )}
                        {(v === 'partial' || v === 'limited') && (
                          <span class="part-mark">
                            <span class="glyph part" aria-hidden="true">
                              <svg viewBox="0 0 20 20" width="20" height="20">
                                <circle
                                  cx="10"
                                  cy="10"
                                  r="7.75"
                                  fill="none"
                                  stroke="currentColor"
                                  stroke-width="1.5"
                                />
                                <path d="M10 2.25a7.75 7.75 0 0 1 0 15.5z" fill="currentColor" />
                              </svg>
                            </span>
                            <span class="part-label">
                              {v === 'partial' ? 'Partial' : 'Limited'}
                            </span>
                          </span>
                        )}
                        {v === 'varies' && <span class="na">Varies</span>}
                        {v === 'na' && <span class="na">Not applicable</span>}
                        {isPrice(v) && (
                          <span class="addon">
                            <span class="addon-price">
                              {v.price} <span class="addon-tag">add-on</span>
                            </span>
                            {v.note && <span class="addon-note">{v.note}</span>}
                          </span>
                        )}
                        {/* Only the free-text branch resolves to a string an editor
                            should retype. The tokens render as glyphs and the priced
                            add-on is an object — both would be wrong (or an error
                            card) as text regions, so they stay in the sidebar. */}
                        {isText(v) && (
                          <span class="text" {...edit(r.cellPaths?.[i])}>
                            {v}
                          </span>
                        )}
                      </td>
                    ))}
                    {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
                  </tr>
                ))}
              </tbody>
            );
          })
        }
        {
          hasCta && (
            <tfoot>
              <tr role="row">
                <th scope="row" role="rowheader" class="foot-feat">
                  {footer && <span class="foot-title">{footer.title}</span>}
                  {footer?.sub && <span class="foot-sub">{footer.sub}</span>}
                </th>
                {/* eslint-disable astro/jsx-a11y/no-interactive-element-to-noninteractive-role -- explicit table roles survive the phone layout's display: grid (Safari drops the implicit ones); the rule's 'td is interactive' is a false positive. */}
                {columns.map((c) => (
                  <td role="cell" class:list={['foot-cell', { hl: c.highlight }]}>
                    <span class="foot-plan">
                      <span class="foot-plan-name">{c.name}</span>
                      {c.price && (
                        <span class="foot-plan-price">
                          {c.price} {c.unit}
                        </span>
                      )}
                    </span>
                    {c.cta && (
                      <Button
                        href={c.cta.href}
                        variant={c.highlight ? 'solid' : 'outline'}
                        tone={c.highlight ? 'brand' : 'neutral'}
                        block
                        class="plan-cta"
                      >
                        {c.cta.label}
                        <span class="sr-only"> for {c.cta.for ?? c.name}</span>
                      </Button>
                    )}
                  </td>
                ))}
                {/* eslint-enable astro/jsx-a11y/no-interactive-element-to-noninteractive-role */}
              </tr>
            </tfoot>
          )
        }
      </table>
    </div>

    {
      footnote && (
        <p class="footnote" {...editableText(editablePrefix, 'footnote', 'text')}>
          {footnote}
        </p>
      )
    }
    <slot />
  </div>

  {/* Phone only: slides up while the table is on screen, away once its own CTAs show. */}
  {
    primary && (
      <div class="cmp-bar">
        <Button href={primary.href} block class="bar-cta">
          {primary.label}
        </Button>
      </div>
    )
  }
</section>

<script>
  // Progressive enhancement for every comparison table on the page: group collapse,
  // the compact sticky header and the phone bottom bar. Delegated and re-queried on
  // every frame, so a block re-rendered in place (CloudCannon's live editing) keeps
  // working without re-binding.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element | null)?.closest?.('[data-cmp-toggle]');
    if (!btn) return;
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.closest('tbody')?.toggleAttribute('data-collapsed', open);
  });

  let queued = false;
  const update = () => {
    queued = false;
    for (const root of document.querySelectorAll<HTMLElement>('[data-cmp]')) {
      const head = root.querySelector('thead');
      const sticky = root.querySelector<HTMLElement>('.sticky-bar');
      if (!head || !sticky) continue;
      // Without a footer the table's own bottom edge is where the sticky chrome ends.
      const end = root.querySelector('tfoot') ?? root.querySelector('table');
      const top = parseFloat(getComputedStyle(root).getPropertyValue('--cmp-sticky-top')) || 0;
      const barH = sticky.offsetHeight;
      const headGone = head.getBoundingClientRect().bottom < top;
      const endRect = end?.getBoundingClientRect();
      const endY = end?.tagName === 'TFOOT' ? (endRect?.top ?? 0) : (endRect?.bottom ?? 0);
      root.toggleAttribute('data-stuck', headGone && endY > top + barH);
      root.toggleAttribute('data-bar', headGone && endY > window.innerHeight);
      const now = root.querySelector<HTMLElement>('[data-cmp-now]');
      if (now) {
        const line = top + barH;
        const groups = [...root.querySelectorAll<HTMLElement>('[data-cmp-group]')];
        const current = groups.filter((g) => g.getBoundingClientRect().top <= line).pop();
        now.textContent = current?.dataset.cmpGroup ?? groups[0]?.dataset.cmpGroup ?? '';
      }
    }
  };
  const schedule = () => {
    if (!queued) {
      queued = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule);
  update();
</script>

<style>
  .cmp {
    /* Clears the fixed nav pill (16px inset + ~64px pill + 16px gap). */
    --cmp-sticky-top: 96px;
    --cmp-band: color-mix(in oklab, var(--color-muted) 55%, var(--color-card));
    --cmp-hl: var(--color-brand);
    background: var(--color-background);
    padding: var(--spacing-section-md) 0;
    border-top: 1px solid var(--color-border);
  }
  .cmp-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* Section head --------------------------------------------------------- */
  .cmp-head {
    max-width: 760px;
    margin-bottom: 32px;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 0 0 20px;
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background: var(--color-border);
  }
  .head-h {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: var(--text-4xl);
    line-height: var(--text-4xl--line-height);
    letter-spacing: -0.03em;
    color: var(--color-foreground);
    text-wrap: balance;
  }
  .head-h :global(em) {
    font-style: normal;
    font-weight: 700;
    color: var(--color-brand-emphasis);
  }
  .head-p {
    margin: 20px 0 0;
    max-width: 720px;
    font-size: var(--text-lg);
    line-height: var(--text-lg--line-height);
    color: var(--color-muted-foreground);
    text-wrap: balance;
  }

  /* Card + table --------------------------------------------------------- */
  .cmp-card {
    position: relative;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    table-layout: fixed;
  }
  th,
  td {
    font-weight: 400;
  }

  /* Bottom corners follow the card's; the top stays open for the highlight tab. */
  table {
    clip-path: inset(
      -16px 0 0 0 round 0 0 calc(var(--radius-sm) - 1px) calc(var(--radius-sm) - 1px)
    );
  }

  /* The highlighted column's frame: one overlay from the header top to the table's
     bottom edge, above every cell and band background, so it stays closed whether or
     not there is a footer and whatever is collapsed. */
  .cmp-frame {
    position: absolute;
    z-index: 1;
    top: 0;
    bottom: 0;
    left: var(--cmp-hl-start);
    width: var(--cmp-col-w);
    border: 2px solid var(--cmp-hl);
    border-radius: var(--radius-sm);
    pointer-events: none;
  }

  /* Header row */
  thead th {
    vertical-align: bottom;
    border-bottom: 1px solid var(--color-border);
  }
  .th-key {
    width: 40%;
    padding: 24px 24px 20px;
    text-align: left;
  }
  .th-plan {
    position: relative;
    width: var(--cmp-col-w);
    /* The 1px height lets .plan-inner resolve height: 100% against the row, whose
       height the key cell sets. */
    height: 1px;
    padding: 0 20px 20px;
    text-align: center;
  }
