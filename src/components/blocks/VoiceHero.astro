---
// The voice-led hero (Case Studies, Hero D): a practitioner's words over a full-bleed photo
// under a Forest scrim, then a Floating card that rises out of the photo with the page's
// title, results and actions (the default slot, which holds the H1). The quote comes first,
// as the boards order it. From xl the quote sits top left over a scrim from the left and the
// card rises 112px; below, the quote sits at the foot over a scrim from the bottom and the
// card rises 64px. (At lg the 640px quote outran the left scrim: white fell under 3:1.)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { emphasize } from '../../lib/emphasize';

interface Props {
  image: { src: ImageMetadata; alt: string; position?: string };
  /** Names the quote band ("In their words"). */
  eyebrow: string;
  /** `*words*` are set bold. */
  quote: string;
  name: string;
  /** Their role and school, under the name. */
  place: string;
  /** Two letters in a Spring disc beside the name, where no portrait exists. */
  initials?: string;
}
const { image, eyebrow, quote, name, place, initials }: Props = Astro.props;
---

<section
  class="relative overflow-hidden bg-brand-surface-deep px-section-x"
  aria-labelledby="voice-eyebrow"
  data-on-brand
>
  <Image
    class="ie-photo-tone absolute inset-0 size-full object-cover"
    style={image.position ? `object-position: ${image.position}` : undefined}
    src={image.src}
    alt={image.alt}
    widths={[640, 960, 1440, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="ie-voice-scrim absolute inset-0" aria-hidden="true"></div>
  <div
    class="relative mx-auto flex min-h-hero-voice max-w-page flex-col justify-end pt-16 pb-22 xl:justify-start xl:pb-36"
  >
    <figure class="m-0 flex flex-col gap-4.5 xl:max-w-measure-wide xl:gap-6">
      <p id="voice-eyebrow" class="m-0 type-eyebrow text-foreground">{eyebrow}</p>
      <svg class="h-auto w-8 text-green-300 xl:w-10" viewBox="0 0 32 24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M0 24V14c0-7.7 4.4-12.5 12-14l1.6 3.4C9.2 5 7 7.8 6.8 11H12v13H0zm18 0V14c0-7.7 4.4-12.5 12-14l1.6 3.4C27.2 5 25 7.8 24.8 11H30v13H18z"
        ></path>
      </svg>
      <blockquote
        class="m-0 type-quote text-foreground not-italic xl:type-pull-quote"
        set:html={emphasize(quote, 'font-bold not-italic')}
      />
      <figcaption class="flex items-center gap-3">
        {
          initials && (
            <span
              class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand-subtle type-label font-bold text-on-brand-subtle lg:size-12 lg:type-card-title-sm"
              aria-hidden="true"
            >
              {initials}
            </span>
          )
        }
        <span class="flex min-w-0 flex-col gap-0.5">
          <span class="type-card-title-sm text-foreground">{name}</span>
          <span class="type-label text-foreground-muted">{place}</span>
        </span>
      </figcaption>
    </figure>
  </div>
</section>
<div class="px-section-x">
  <div class="relative mx-auto -mt-16 max-w-page xl:-mt-28">
    <div class="ie-card ie-card-floating -mx-2 px-6 py-7 md:mx-0 lg:px-14 lg:py-12">
      <slot />
    </div>
  </div>
</div>
