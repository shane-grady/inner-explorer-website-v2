---
import SeriesIcon from './SeriesIcon.astro';

// "How it works" — three numbered steps: icon chip + serif-italic number word,
// title, and supporting copy.

interface Step {
  icon: string;
  title: string;
  body: string;
}
interface Props {
  steps: Step[];
}
const { steps }: Props = Astro.props;
const NUMS = ['One', 'Two', 'Three', 'Four'];
---

<ol class="how">
  {
    steps.map((st, i) => (
      <li class="step" data-sr data-sr-delay={`${i + 1}`}>
        <div class="n">
          <span class="ic">
            <SeriesIcon name={st.icon} />
          </span>
          <span class="word">{NUMS[i] ?? i + 1}</span>
        </div>
        <h3>{st.title}</h3>
        <p>{st.body}</p>
      </li>
    ))
  }
</ol>

<style>
  .how {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .step {
    padding: 4px 8px;
  }
  .n {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 18px;
  }
  .ic {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: 18px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    color: var(--series-accent-deep, var(--color-brand-emphasis));
    display: grid;
    place-items: center;
    box-shadow: var(--shadow-sm);
  }
  .ic :global(svg) {
    width: 26px;
    height: 26px;
  }
  .word {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 22px;
    line-height: 1;
    color: var(--series-accent, var(--color-brand));
  }
  h3 {
    margin: 22px 0 10px;
    font-family: var(--font-sans);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  p {
    margin: 0;
    max-width: 320px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }

  @media (max-width: 920px) {
    .how {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .how {
      grid-template-columns: 1fr;
    }
  }
</style>
