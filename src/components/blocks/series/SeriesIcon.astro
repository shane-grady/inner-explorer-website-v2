  },
  heart: {
    body: '<path d="M19 6.6a4.5 4.5 0 0 0-6.4 0L12 7.2l-.6-.6a4.5 4.5 0 1 0-6.4 6.4l.6.6 6.4 6.4 6.4-6.4.6-.6a4.5 4.5 0 0 0 0-6.4Z"/>',
  },
  'message-circle': {
    body: '<path d="M21 11.5a8.5 8.5 0 0 1-12.5 7.5L3 21l2-5.5A8.5 8.5 0 1 1 21 11.5Z"/>',
  },
  rewind: {
    body: '<polygon points="11 19 2 12 11 5 11 19"/><polygon points="22 19 13 12 22 5 22 19"/>',
