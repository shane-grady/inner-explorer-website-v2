---
// Shared inline-SVG icon set for the series template (glance bar, audience/
// benefit cards, how-steps, player chrome). Lucide-style stroke glyphs from the
// Claude Design handoff; names mirror the `seriesIcon` enum in content.config.ts
// so content files are schema-validated against this registry. Same conventions
// as PlatformIcon: stroke icons inherit `currentColor`; size via parent CSS, or
// the `size` prop where no parent rule applies (e.g. inside a Button slot).

interface Props {
  name: string;
  strokeWidth?: number;
  /** Intrinsic px size — only needed where no parent CSS sizes the <svg>. */
  size?: number;
  class?: string;
}

const ICONS: Record<string, { fill?: boolean; body: string }> = {
