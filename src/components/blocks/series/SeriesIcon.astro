    body: '<path d="M19 6.6a4.5 4.5 0 0 0-6.4 0L12 7.2l-.6-.6a4.5 4.5 0 1 0-6.4 6.4l6.9 6.9a.7.7 0 0 0 1 0l6.5-6.5a4.5 4.5 0 0 0 0-6.4Z"/><path d="m12 7 1.8 1.8a1.5 1.5 0 0 0 2.1 0"/>',
  },
  sprout: {
    body: '<path d="M7 20h10"/><path d="M12 20V9"/><path d="M12 9C12 6 10 4 6 4c0 4 2 5 6 5Z"/><path d="M12 11c0-2.5 1.8-4.5 5-4.5 0 3.2-1.8 4.5-5 4.5Z"/>',
  },
  sun: {
    body: '<circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  },
  tent: { body: '<path d="M3.5 20 12 5l8.5 15"/><path d="M12 5v15"/><path d="M9 20l3-4 3 4"/>' },
  palette: {
    body: '<path d="M12 3a9 9 0 0 0 0 18c1.1 0 2-.9 2-2 0-.5-.2-1-.5-1.3-.3-.4-.5-.8-.5-1.2 0-1 .8-1.7 1.7-1.7H17a4 4 0 0 0 4-4c0-4.4-4-8-9-8Z"/><circle cx="7.5" cy="11" r="1"/><circle cx="11" cy="7.5" r="1"/><circle cx="15.5" cy="9" r="1"/>',
  },
  'arrow-right': { body: '<path d="M5 12h14"/><polyline points="12 5 19 12 12 19"/>' },
  pause: {
    body: '<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>',
  },
  quote: {
    body: '<path d="M7 7H4a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2v2a2 2 0 0 1-2 2"/><path d="M19 7h-3a1 1 0 0 0-1 1v4a1 1 0 0 0 1 1h2v2a2 2 0 0 1-2 2"/>',
  },
  star: {
    body: '<polygon points="12 3 14.6 8.6 21 9.3 16.3 13.6 17.6 20 12 16.8 6.4 20 7.7 13.6 3 9.3 9.4 8.6 12 3"/>',
  },
  flask: {
    body: '<path d="M9 3h6"/><path d="M10 3v6.5L5 18a2 2 0 0 0 1.7 3h10.6A2 2 0 0 0 19 18l-5-8.5V3"/><path d="M7.5 14h9"/>',
  },
  award: { body: '<circle cx="12" cy="9" r="6"/><path d="m8.5 14-1.5 7 5-3 5 3-1.5-7"/>' },
};

const { name, strokeWidth = 2, size, class: className }: Props = Astro.props;
const icon = ICONS[name] ?? ICONS.play;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill={icon.fill ? 'currentColor' : 'none'}
  stroke={icon.fill ? undefined : 'currentColor'}
  stroke-width={icon.fill ? undefined : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={icon.body}
/>
