---
import { Image } from 'astro:assets';
import Button from '../../primitives/Button.astro';
import mark from '../../../assets/brand/inner-explorer-mark.png';

// Closing CTA band — deep tone gradient panel with the compass mark, a duet
// headline (bold sans over serif-italic in a light tint of the series accent),
// supporting copy, and a light button pair.

interface Cta {
  label: string;
  href: string;
}
interface Props {
  duetTop: string;
  duetBottom: string;
  body: string;
  primary: Cta;
  secondary?: Cta;
}
const { duetTop, duetBottom, body, primary, secondary }: Props = Astro.props;
---

<section class="band" data-sr>
  <span class="mark">
    <Image src={mark} alt="" width={40} height={40} />
  </span>
  <h2>
    <span class="l1">{duetTop}</span>
    <span class="l2">{duetBottom}</span>
  </h2>
  <p>{body}</p>
  <div class="cta">
    <Button href={primary.href} tone="light" size="lg" shape="pill">{primary.label}</Button>
    {
      secondary && (
        <Button href={secondary.href} tone="light" variant="outline" size="lg" shape="pill">
          {secondary.label}
        </Button>
      )
    }
  </div>
</section>

<style>
  .band {
    position: relative;
    overflow: hidden;
    border-radius: 40px;
    padding: 76px clamp(24px, 4vw, 40px);
    text-align: center;
    background: linear-gradient(
      150deg,
      var(--series-accent-deep, var(--color-brand-emphasis)),
      color-mix(
        in oklab,
        var(--series-accent-deep, var(--color-brand-emphasis)) 60%,
        var(--brand-950)
      )
    );
  }
  .band::before {
    content: '';
    position: absolute;
    left: -100px;
    bottom: -140px;
    width: 380px;
    height: 380px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-white) 12%, transparent),
      transparent 70%
    );
  }
  .mark {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 0 auto 24px;
    border-radius: 50%;
    background: color-mix(in oklab, var(--color-white) 14%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    display: grid;
    place-items: center;
  }
  h2 {
    position: relative;
    margin: 0;
    color: var(--color-white);
  }
  h2 .l1 {
    display: block;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(30px, 3.6vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  h2 .l2 {
    display: block;
    margin-top: 4px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(34px, 4.2vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    color: color-mix(in oklab, var(--series-accent, var(--color-brand)) 35%, var(--color-white));
  }
  p {
    position: relative;
    margin: 22px auto 0;
    max-width: 540px;
    font-size: 16px;
    line-height: 1.6;
    color: color-mix(in oklab, var(--color-white) 85%, transparent);
    text-wrap: pretty;
  }
  .cta {
    position: relative;
    margin-top: 34px;
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  @media (max-width: 640px) {
    .band {
      border-radius: 28px;
    }
  }
</style>
