---
import SeriesIcon from './SeriesIcon.astro';

// Icon-chip cards in the series template's two arrangements:
//   - `grid`  — N-up cards under a (separately rendered) centered section head;
//               larger cards with gradient icon chips (the audience section).
//   - `split` — side heading left, compact 2×2 card grid right (the benefits
//               section). `eyebrow`/`heading` are required for this layout.

interface Card {
  icon: string;
  title: string;
  body: string;
}
interface Props {
  items: Card[];
  layout?: 'grid' | 'split';
  /** Side-heading copy — `split` layout only. */
  eyebrow?: string;
  heading?: string;
}
const { items, layout = 'grid', eyebrow, heading }: Props = Astro.props;
---

{
  layout === 'grid' ? (
    <div class="cards is-grid">
      {items.map((c, i) => (
        <article class="card" data-sr data-sr-delay={`${(i % 3) + 1}`}>
          <span class="ic">
            <SeriesIcon name={c.icon} />
          </span>
          <h3>{c.title}</h3>
          <p>{c.body}</p>
        </article>
      ))}
    </div>
  ) : (
    <div class="split">
      <div class="side" data-sr>
        <span class="eyebrow">
          <span class="dot" aria-hidden="true" /> {eyebrow}
        </span>
        <h2>{heading}</h2>
      </div>
      <div class="cards is-split">
        {items.map((c, i) => (
          <article class="card is-compact" data-sr data-sr-delay={`${(i % 2) + 1}`}>
            <span class="ic is-flat">
              <SeriesIcon name={c.icon} />
            </span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </article>
        ))}
      </div>
    </div>
  )
}

<style>
  .cards {
    display: grid;
    gap: 22px;
  }
  .is-grid {
    grid-template-columns: repeat(3, 1fr);
    margin-top: 56px;
  }
  .card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    padding: 32px 30px;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: color-mix(in oklab, var(--series-accent) 28%, var(--color-border));
  }
  .ic {
    width: 52px;
    height: 52px;
    border-radius: 16px;
    background: linear-gradient(
      160deg,
      var(--series-tint-a, var(--color-brand-subtle)),
      var(--series-tint-b, var(--color-brand-subtle))
    );
    color: var(--series-accent-deep, var(--color-brand-emphasis));
    display: grid;
    place-items: center;
    margin-bottom: 22px;
  }
  .ic :global(svg) {
    width: 25px;
    height: 25px;
  }
  .card h3 {
    margin: 0 0 10px;
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .card p {
    margin: 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }

  /* split layout — side heading + compact 2×2 */
  .split {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 48px;
    align-items: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--series-accent-deep, var(--color-brand-emphasis));
  }
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--series-accent, var(--color-brand));
  }
  .side h2 {
    margin: 0;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(32px, 4vw, 46px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--color-foreground);
    text-wrap: balance;
  }
  .is-split {
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }
  .card.is-compact {
    border-radius: var(--radius-xl);
    padding: 26px 24px;
  }
  .card.is-compact:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }
  .ic.is-flat {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--series-tint-a, var(--color-brand-subtle));
    margin-bottom: 18px;
  }
  .ic.is-flat :global(svg) {
    width: 22px;
    height: 22px;
  }
  .card.is-compact h3 {
    margin-bottom: 8px;
    font-size: 17px;
    line-height: 1.25;
  }
  .card.is-compact p {
    font-size: 14px;
    line-height: 1.55;
  }

  @media (max-width: 1080px) {
    .split {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .side h2 {
      max-width: 560px;
    }
  }
  @media (max-width: 920px) {
    .is-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .is-grid,
    .is-split {
      grid-template-columns: 1fr;
    }
  }
</style>
