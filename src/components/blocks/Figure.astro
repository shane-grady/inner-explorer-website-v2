---
// Captioned figure — a photo with an optional subheading/credit caption. Used as an
// in-article module (the blog "Article" body) but generic enough to reuse anywhere.
// Takes an imported image so Astro optimizes + serves responsive sources.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { resolveContentImage } from '../../lib/content-images';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  /** Subheading / credit shown beneath the image. */
  caption?: string;
}
const { src, alt, caption }: Props = Astro.props;
const image = await resolveContentImage(src);
---

<figure class="ie-figure">
  <Image
    src={image}
    alt={alt}
    widths={[480, 768, 1024]}
    sizes="(max-width: 760px) 92vw, 700px"
    loading="lazy"
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .ie-figure {
    margin: 3rem 0;
  }
  .ie-figure :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius-xl);
    background: var(--color-muted);
  }
  .ie-figure figcaption {
    margin-top: 12px;
    padding-left: 16px;
    border-left: 2px solid var(--color-border);
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
</style>
