---
// The one objection every evaluator arrives with, answered before they go searching.
// A quiet, bordered aside — set apart from the spreads above, not a chapter.
import { editableText, type EditablePrefix } from '../../../lib/editable';

interface Props {
  heading: string;
  body: string;
  closing: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'objection'). Omit on
   *  routes not backed by a `pages` collection entry. See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
}
const { heading, body, closing, editablePrefix }: Props = Astro.props;
---

<section class="objection-band" id="objection" aria-labelledby="objection-heading">
  <aside class="objection reveal">
    <div class="ask">
      <h2 class="h" id="objection-heading" {...editableText(editablePrefix, 'heading')}>
        {heading}
      </h2>
      <p class="body" {...editableText(editablePrefix, 'body', 'text')}>{body}</p>
    </div>
    <p class="closing" {...editableText(editablePrefix, 'closing', 'text')}>{closing}</p>
  </aside>
</section>

<style>
  .objection-band {
    padding: 0 32px 120px;
    background: var(--editorial-paper);
    color: var(--editorial-ink);
  }
  /* Section-wide (matches the 1280px wrap minus its 32px gutters), two columns:
     the question and answer on the left, the takeaway on the right. */
  .objection {
    max-width: 1216px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 48px;
    align-items: center;
    padding: 44px 48px;
    border-radius: 24px;
    background: var(--editorial-paper-soft);
    border: 1px solid color-mix(in oklab, var(--editorial-ink) 10%, transparent);
  }
  .h {
    margin: 0 0 20px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(24px, 2.6vw, 34px);
    line-height: 1.2;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  .body {
    margin: 0;
    font-size: 17px;
    line-height: 1.65;
    color: color-mix(in oklab, var(--editorial-ink) 85%, transparent);
    text-wrap: pretty;
  }
  .closing {
    margin: 0;
    padding-left: 48px;
    border-left: 1px solid color-mix(in oklab, var(--editorial-ink) 12%, transparent);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(18px, 1.8vw, 21px);
    line-height: 1.5;
    color: var(--editorial-ink);
    text-wrap: pretty;
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition:
      opacity 900ms var(--ease-out),
      transform 900ms var(--ease-out);
  }
  :global([data-js-ready]) .reveal:not(.in) {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (max-width: 820px) {
    .objection {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 32px 28px;
      border-radius: 18px;
    }
    .closing {
      padding: 24px 0 0;
      border-left: 0;
      border-top: 1px solid color-mix(in oklab, var(--editorial-ink) 12%, transparent);
    }
    .body {
      font-size: 16px;
    }
  }
</style>

<script>
  import { observe } from '../../../lib/intersect';
  observe('.objection-band .reveal');
</script>
