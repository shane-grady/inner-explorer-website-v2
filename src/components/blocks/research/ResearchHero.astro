---
interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow: string;
  /** Line objects: text + optional `face` ('sans' for the upright weight-300 line; default is italic display). `em` colors the line with the brand accent. */
  lines: Array<{ text: string; face?: 'sans' | 'display'; em?: boolean }>;
  subtitle: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
}
const { eyebrow, lines, subtitle, primaryCta, secondaryCta }: Props = Astro.props;

// Pre-split the headline into words and give each a slice of the pinned-scroll
// progress (0–100). Words resolve in reading order, their windows overlapping so
// the soft blur reads as a mask sweeping across the text. The scrub script reads
// these data attributes — one source of truth.
const REVEAL_FROM = 4; // first word starts here
const LAST_START = 66; // last word starts here
const WORD_LEN = 20; // each word's own fade length
const totalWords = lines.reduce((n, l) => n + l.text.trim().split(/\s+/).length, 0);
let gi = 0;
const wordLines = lines.map((l) => {
  const parts = l.text.trim().split(/\s+/);
  const words = parts.map((t, i) => {
    const frac = totalWords > 1 ? gi / (totalWords - 1) : 0;
    const start = Math.round(REVEAL_FROM + frac * (LAST_START - REVEAL_FROM));
    gi += 1;
    return { t, start, end: start + WORD_LEN, last: i === parts.length - 1 };
  });
  return { face: l.face === 'sans' ? 'sans' : 'display', em: !!l.em, words };
});
---

<section class="hero" id="hero" data-screen-label="Hero">
  <div class="hero-sticky">
    <div class="hero-inner">
      <span class="hero-eyebrow">
        <span class="rule" aria-hidden="true"></span>
        {eyebrow}
        <span class="rule" aria-hidden="true"></span>
      </span>
      <h1 class="hero-h">
        {
          wordLines.map((l) => (
            <span class:list={['stk', l.face, { em: l.em }]}>
              {l.words.map((w) => (
                <span class="word" data-s={w.start} data-e={w.end}>
                  {w.last ? w.t : w.t + ' '}
                </span>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="hero-sub">{subtitle}</p>
      <div class="hero-cta">
        <a href={primaryCta.href} class="btn btn-solid-ink btn-lg">
          {primaryCta.label}
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M12 5v14"></path>
            <path d="M5 12l7 7 7-7"></path>
          </svg>
        </a>
        {
          secondaryCta && (
            <a href={secondaryCta.href} class="btn btn-ghost-paper btn-lg">
              {secondaryCta.label}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Tall section → its inner content pins (sticky) while the headline resolves,
     then releases into the receipts below. The reveal is scrubbed to the pinned
     scroll distance by the script; CSS owns only the pin + the static fallbacks. */
  .hero {
    position: relative;
    min-height: 200vh;
    background: var(--editorial-paper);
    color: var(--editorial-ink);
  }
  .hero-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .hero-eyebrow .rule {
    width: 28px;
    height: 1px;
    background: color-mix(in oklab, var(--color-brand) 50%, transparent);
  }

  .hero-h {
    margin: 0 0 32px;
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .stk {
    display: block;
  }
  .display {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
  }
  .sans {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .em {
    color: var(--color-brand);
  }
  /* Each word resolves from a soft blur — the moving blur edge reads as a mask
     sweeping across the line. (Opacity/blur are driven inline by the script.) */
  .word {
    display: inline;
    will-change: filter, opacity;
  }

  .hero-sub {
    margin: 0 auto 36px;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--editorial-ink-muted);
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    transition: all 250ms var(--ease-out);
    white-space: nowrap;
  }
  .btn-lg {
    padding: 18px 30px;
    font-size: 15px;
  }
  .btn-solid-ink {
    background: var(--editorial-ink);
    color: var(--editorial-paper);
  }
  .btn-solid-ink:hover {
    background: color-mix(in oklab, var(--editorial-ink) 80%, var(--color-black));
    transform: translateY(-2px);
  }
  .btn-ghost-paper {
    color: var(--editorial-ink);
    border: 1px solid color-mix(in oklab, var(--editorial-ink) 18%, transparent);
  }
  .btn-ghost-paper:hover {
    background: color-mix(in oklab, var(--editorial-ink) 6%, transparent);
  }

  /* The script adds .hero--scrub (only when motion is allowed) and then drives
     opacity/filter/transform inline. This rule sets the pre-scrub hidden state so
     nothing flashes before the first frame. Without JS, text stays fully visible
     (SEO / no-JS safe). */
  @media (prefers-reduced-motion: no-preference) {
    .hero--scrub .word {
      opacity: 0.1;
      filter: blur(10px);
    }
    .hero--scrub .hero-eyebrow,
    .hero--scrub .hero-sub,
    .hero--scrub .hero-cta {
      opacity: 0;
    }
  }

  /* Reduced motion → a normal, static, fully-visible centered hero (no pin). */
  @media (prefers-reduced-motion: reduce) {
    .hero {
      min-height: 100vh;
    }
    .hero-sticky {
      position: static;
      height: auto;
      min-height: 100vh;
    }
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding: 0 24px;
    }
    .hero-eyebrow {
      margin-bottom: 22px;
    }
  }
</style>

<script>
  const hero = document.getElementById('hero');
  // Scrub the reveal to the pinned scroll distance. Skipped for reduced-motion
  // readers, who keep the static, fully-resolved hero (no pin).
  if (hero && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const words = Array.from(hero.querySelectorAll<HTMLElement>('.word'));
    const blocks: Array<[HTMLElement | null, number, number]> = [
      [hero.querySelector('.hero-eyebrow'), 0, 12],
      [hero.querySelector('.hero-sub'), 82, 92],
      [hero.querySelector('.hero-cta'), 88, 100],
    ];
    const clamp = (n: number) => Math.max(0, Math.min(1, n));
    const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);

    let raf = 0;
    const paint = () => {
      raf = 0;
      const vh = window.innerHeight;
      const denom = Math.max(1, hero.offsetHeight - vh);
      // Progress through the pinned range: 0 as the pin engages, 1 as it releases.
      const p = clamp(-hero.getBoundingClientRect().top / denom) * 100;
      words.forEach((el) => {
        const s = Number(el.dataset.s);
        const e = Number(el.dataset.e);
        const t = easeOut(clamp((p - s) / (e - s)));
        el.style.opacity = String(0.1 + 0.9 * t);
        el.style.filter = `blur(${(1 - t) * 10}px)`;
      });
      blocks.forEach(([el, s, e]) => {
        if (!el) return;
        const t = easeOut(clamp((p - s) / (e - s)));
        el.style.opacity = String(t);
        el.style.filter = `blur(${(1 - t) * 6}px)`;
        el.style.transform = `translateY(${(1 - t) * 12}px)`;
      });
    };
    // Paint immediately on scroll (cheap — 12 elements) and also coalesce a
    // trailing frame via rAF, mirroring the repo's passive-scroll idiom.
    const onScroll = () => {
      paint();
      if (!raf) raf = requestAnimationFrame(paint);
    };

    hero.classList.add('hero--scrub');
    paint();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }
</script>
