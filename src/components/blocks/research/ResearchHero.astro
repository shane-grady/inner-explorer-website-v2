---
import { childPrefix, editableText, type EditablePrefix } from '../../../lib/editable';

interface Cta {
  label: string;
  href: string;
}
interface Props {
  eyebrow: string;
  /** Line objects: text + optional `face` ('sans' for the upright weight-300 line; default is italic display). `em` colors the line with the brand accent. */
  lines: Array<{ text: string; face?: 'sans' | 'display'; em?: boolean }>;
  subtitle: string;
  /** A short emphasized line of its own under the subtitle. */
  proof?: string;
  /** A quieter supporting line under the subtitle. */
  note?: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  /** CloudCannon path prefix for this block's fields (e.g. 'hero'). Omit on routes
   *  not backed by a `pages` collection entry. See lib/editable.ts.
   *
   *  `lines` is deliberately NOT editable: an editable region must resolve to a
   *  string, and a row of this array is an object, whose own value cannot be
   *  addressed. Edit the headline from the sidebar. */
  editablePrefix?: EditablePrefix;
}
const { eyebrow, lines, subtitle, proof, note, primaryCta, secondaryCta, editablePrefix }: Props =
  Astro.props;

// One fade per element, 80ms apart, in render order: the eyebrow leads at 0, then one
// slot per headline line, then the subtitle, then whichever of proof / note are set,
// then the CTAs. Absent optional lines take no slot, so the cadence never leaves a gap.
const STEP = 80;
let slot = lines.length;
const subtitleDelay = (slot += 1) * STEP;
const proofDelay = proof ? (slot += 1) * STEP : 0;
const noteDelay = note ? (slot += 1) * STEP : 0;
const ctaDelay = (slot + 1) * STEP;
---

<section class="hero" id="hero" data-screen-label="Hero">
  <div class="hero-inner">
    <span class="hero-eyebrow reveal">
      <span class="rule" aria-hidden="true"></span>
      <span {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</span>
      <span class="rule" aria-hidden="true"></span>
    </span>
    <h1 class="hero-h">
      {
        lines.map((l, i) => (
          <span
            class:list={['stk', 'reveal', l.face === 'sans' ? 'sans' : 'display', { em: l.em }]}
            style={`--reveal-delay:${(i + 1) * STEP}ms`}
          >
            {l.text}
          </span>
        ))
      }
    </h1>
    <p
      class="hero-sub reveal"
      style={`--reveal-delay:${subtitleDelay}ms`}
      {...editableText(editablePrefix, 'subtitle', 'text')}
    >
      {subtitle}
    </p>
    {
      proof && (
        <p
          class="hero-proof reveal"
          style={`--reveal-delay:${proofDelay}ms`}
          {...editableText(editablePrefix, 'proof')}
        >
          {proof}
        </p>
      )
    }
    {
      note && (
        <p
          class="hero-note reveal"
          style={`--reveal-delay:${noteDelay}ms`}
          {...editableText(editablePrefix, 'note', 'text')}
        >
          {note}
        </p>
      )
    }
    <div class="hero-cta reveal" style={`--reveal-delay:${ctaDelay}ms`}>
      <a href={primaryCta.href} class="btn btn-solid-ink btn-lg">
        <span {...editableText(childPrefix(editablePrefix, 'primaryCta'), 'label')}>
          {primaryCta.label}
        </span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 5v14"></path>
          <path d="M5 12l7 7 7-7"></path>
        </svg>
      </a>
      {
        secondaryCta && (
          <a
            href={secondaryCta.href}
            class="btn btn-ghost-paper btn-lg"
            {...editableText(childPrefix(editablePrefix, 'secondaryCta'), 'label')}
          >
            {secondaryCta.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  /* A single centered screen. The headline used to resolve word by word across a
     200vh sticky pin; it now fades in as one staggered run when the section scrolls
     into view, so the page never stops moving for the reader. */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--editorial-paper);
    color: var(--editorial-ink);
  }
  .hero-inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 28px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .hero-eyebrow .rule {
    width: 28px;
    height: 1px;
    background: color-mix(in oklab, var(--color-brand) 50%, transparent);
  }

  .hero-h {
    margin: 0 0 32px;
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .stk {
    display: block;
  }
  .display {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
  }
  .sans {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.02em;
  }
  .em {
    color: var(--color-brand);
  }

  .hero-sub {
    margin: 0 auto 36px;
    max-width: 540px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--editorial-ink-muted);
  }
  .hero-proof {
    margin: -20px auto 24px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 24px;
    line-height: 1.3;
    color: var(--editorial-ink);
  }
  .hero-note {
    margin: 0 auto 36px;
    max-width: 560px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--editorial-ink-muted);
    text-wrap: pretty;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    transition: all 250ms var(--ease-out);
    white-space: nowrap;
  }
  .btn-lg {
    padding: 18px 30px;
    font-size: 15px;
  }
  .btn-solid-ink {
    background: var(--editorial-ink);
    color: var(--editorial-paper);
  }
  .btn-solid-ink:hover {
    background: color-mix(in oklab, var(--editorial-ink) 80%, var(--color-black));
    transform: translateY(-2px);
  }
  .btn-ghost-paper {
    color: var(--editorial-ink);
    border: 1px solid color-mix(in oklab, var(--editorial-ink) 18%, transparent);
  }
  .btn-ghost-paper:hover {
    background: color-mix(in oklab, var(--editorial-ink) 6%, transparent);
  }

  /* Reveal-on-scroll — content is fully visible by default, so no-JS and SEO
     readers get the finished hero. Once JS is ready (intersect.ts sets
     data-js-ready on <html>) anything not yet revealed drops to the hidden state,
     and .in resolves it, line by line via --reveal-delay.

     The transition lives on .in, not on .reveal: only the reveal should animate.
     Were it on the base rule, the initial visible -> hidden drop would animate too,
     so the hero would fade OUT for 700ms on load before it could ever fade in.

     Gated on no-preference rather than left to the global reduced-motion rule,
     which squashes transition-duration but NOT transition-delay — without the gate
     a reduced-motion reader would still get the staggered pop. */
  @media (prefers-reduced-motion: no-preference) {
    :global([data-js-ready]) .reveal:not(.in) {
      opacity: 0;
      transform: translateY(20px);
      filter: blur(6px);
    }
    .reveal.in {
      transition:
        opacity 700ms var(--ease-out) var(--reveal-delay, 0ms),
        transform 700ms var(--ease-out) var(--reveal-delay, 0ms),
        filter 700ms var(--ease-out) var(--reveal-delay, 0ms);
    }
  }

  @media (max-width: 768px) {
    .hero-inner {
      padding: 0 24px;
    }
    .hero-eyebrow {
      margin-bottom: 22px;
    }
  }
</style>

<script>
  import { observe } from '../../../lib/intersect';
  // BaseLayout ships <ClientRouter />, so a module script runs once and would not
  // re-arm after a soft nav back to /research. astro:page-load fires on first load
  // and after every swap (same pattern as Header.astro, IntroScroll.astro).
  document.addEventListener('astro:page-load', () => observe('.hero .reveal'));
</script>
