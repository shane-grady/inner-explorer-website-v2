---
import { Image } from 'astro:assets';
import brainStressed from '../../../assets/images/research/brain-stressed.webp';
import brainMindful from '../../../assets/images/research/brain-mindful.webp';

interface Props {
  chapterLabel: string;
  chapterNumber: string;
  headingHtml: string;
  paragraphs: string[];
  pullQuoteHtml: string;
  toggleStressedLabel?: string;
  toggleMindfulLabel?: string;
}
const {
  chapterLabel,
  chapterNumber,
  headingHtml,
  paragraphs,
  pullQuoteHtml,
  toggleStressedLabel = 'Stressed',
  toggleMindfulLabel = 'Mindful',
}: Props = Astro.props;
---

<section class="brain" id="brain" data-screen-label={chapterLabel} aria-labelledby="brain-heading">
  <div class="wrap">
    <div class="chap-mark reveal">
      <span class="chap-num">{chapterNumber}</span>
      <span class="chap-rule" aria-hidden="true"></span>
      <span class="chap-label">{chapterLabel}</span>
    </div>
    <h2 class="chap-title reveal" id="brain-heading" set:html={headingHtml} />

    <div class="grid" data-brain-grid>
      <div class="viz" data-brain-viz data-state="stressed" style="--p: 0">
        <div
          class="brain-stage"
          role="img"
          aria-label="A brain shifting from a stressed, red state to a calm, mindful, green state as you read"
        >
          <span class="brain-glow brain-glow--stressed" aria-hidden="true"></span>
          <span class="brain-glow brain-glow--mindful" aria-hidden="true"></span>
          <Image
            class="brain-img brain-img--stressed"
            src={brainStressed}
            alt=""
            widths={[349, 524, 698]}
            sizes="(max-width: 820px) 68vw, 460px"
            loading="lazy"
            draggable={false}
          />
          <Image
            class="brain-img brain-img--mindful"
            src={brainMindful}
            alt=""
            widths={[349, 524, 698]}
            sizes="(max-width: 820px) 68vw, 460px"
            loading="lazy"
            draggable={false}
          />
        </div>
        <div class="viz-toggle" role="group" aria-label="Brain state">
          <span class="viz-knob" aria-hidden="true"></span>
          <button type="button" role="switch" aria-checked="true" data-state-toggle="stressed">
            {toggleStressedLabel}
          </button>
          <button type="button" role="switch" aria-checked="false" data-state-toggle="mindful">
            {toggleMindfulLabel}
          </button>
        </div>
      </div>

      <div class="copy">
        <div class="copy-block reveal">
          {paragraphs.slice(0, 2).map((p) => <p set:html={p} />)}
        </div>
        <blockquote class="pull reveal" set:html={pullQuoteHtml} />
        <div class="copy-block reveal">
          {paragraphs.slice(2).map((p) => <p set:html={p} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .brain {
    padding: 140px 0 120px;
    /* Deep forest-green proof palette — matches the case-study ResultsBand. */
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in oklab, var(--color-white) 10%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 80% at 0% 100%,
        color-mix(in oklab, var(--color-black) 22%, transparent),
        transparent 60%
      ),
      linear-gradient(165deg, var(--brand-800), var(--brand-950));
    color: var(--editorial-paper);
  }
  .wrap {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .chap-mark {
    display: flex;
    align-items: baseline;
    gap: 18px;
    margin-bottom: 28px;
  }
  .chap-num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 36px;
    line-height: 1;
    color: var(--editorial-glow);
  }
  .chap-rule {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.18;
    align-self: center;
  }
  .chap-label {
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  .chap-title {
    margin: 0 0 56px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .chap-title :global(em) {
    font-style: italic;
    color: var(--editorial-glow);
    font-weight: 500;
  }
  .chap-title :global(.sans) {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.025em;
  }
  .chap-title :global(.stk) {
    display: block;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 80px;
    align-items: start;
  }
  .viz {
    position: sticky;
    top: 140px;
    aspect-ratio: 1 / 1.1;
    border-radius: 28px;
    padding: 32px;
    /* Raised card — a darker brand-900 panel, mirroring ResultsBand metrics. */
    background:
      linear-gradient(
        160deg,
        color-mix(in oklab, var(--color-white) 6%, transparent),
        transparent 60%
      ),
      var(--brand-900);
    border: 1px solid color-mix(in oklab, var(--editorial-paper) 12%, transparent);
    overflow: hidden;
  }

  /* ── Brain crossfade ──────────────────────────────────────────────────────
     Both renders are pixel-aligned (same outline, only the fill differs), so a
     simple opacity crossfade reads as one brain changing colour. --p (0 → 1) is
     driven by scroll progress while the panel is pinned: 0 = stressed (red),
     1 = mindful (green). */
  .brain-stage {
    position: relative;
    width: 100%;
    height: 100%;
    padding-bottom: 52px; /* clear the toggle pill at the bottom */
  }
  .brain-glow {
    position: absolute;
    inset: -6% -6% 40%;
    border-radius: 50%;
    transition: opacity 320ms var(--ease-out);
    pointer-events: none;
  }
  .brain-glow--stressed {
    background: radial-gradient(
      circle at 50% 48%,
      color-mix(in oklab, var(--danger) 55%, transparent) 0%,
      transparent 62%
    );
    opacity: calc(1 - var(--p));
  }
  .brain-glow--mindful {
    background: radial-gradient(
      circle at 50% 48%,
      color-mix(in oklab, var(--editorial-glow) 42%, transparent) 0%,
      transparent 62%
    );
    opacity: var(--p);
  }
  .brain-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center 44%;
    filter: drop-shadow(0 18px 40px color-mix(in oklab, var(--editorial-night) 70%, transparent));
    transition: opacity 260ms var(--ease-out);
    user-select: none;
  }
  .brain-img--stressed {
    opacity: calc(1 - var(--p));
  }
  .brain-img--mindful {
    opacity: var(--p);
  }
  @media (prefers-reduced-motion: reduce) {
    .brain-glow,
    .brain-img {
      transition: none;
    }
  }

  .viz-toggle {
    position: absolute;
    bottom: 24px;
    left: 24px;
    right: 24px;
    display: flex;
    padding: 4px;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--editorial-paper) 6%, transparent);
    border: 1px solid color-mix(in oklab, var(--editorial-paper) 10%, transparent);
    z-index: 2;
  }
  /* Sliding knob — tracks --p continuously and shifts danger → glow with it. */
  .viz-knob {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 4px;
    width: calc(50% - 4px);
    border-radius: 9999px;
    background: color-mix(in oklab, var(--editorial-glow) calc(var(--p) * 100%), var(--danger));
    transform: translateX(calc(var(--p) * 100%));
    transition:
      transform 260ms var(--ease-out),
      background 260ms var(--ease-out);
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .viz-knob {
      transition: none;
    }
  }
  .viz-toggle button {
    position: relative;
    z-index: 1;
    flex: 1;
    padding: 10px 16px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    color: color-mix(in oklab, var(--editorial-paper) 60%, transparent);
    cursor: pointer;
    transition: color 260ms var(--ease-out);
  }
  .viz[data-state='stressed'] button[data-state-toggle='stressed'] {
    color: var(--editorial-paper);
  }
  .viz[data-state='mindful'] button[data-state-toggle='mindful'] {
    color: var(--editorial-night);
  }
  .viz-toggle button:focus-visible {
    outline: 2px solid var(--editorial-glow);
    outline-offset: 2px;
  }

  .copy {
    font-size: 18px;
    line-height: 1.7;
    color: color-mix(in oklab, var(--editorial-paper) 85%, transparent);
  }
  .copy p {
    margin: 0 0 22px;
    max-width: 580px;
  }
  .copy-block:first-child p:first-of-type::first-letter {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: 110px;
    line-height: 0.85;
    float: left;
    color: var(--editorial-glow);
    padding-right: 14px;
    padding-top: 8px;
    margin-bottom: -10px;
  }
  .copy :global(.inline-stat) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    color: var(--editorial-glow);
    font-size: 1.15em;
  }
  .pull {
    margin: 32px 0;
    max-width: 580px;
    padding: 28px 0;
    border-top: 1px solid color-mix(in oklab, var(--editorial-paper) 12%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--editorial-paper) 12%, transparent);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--editorial-paper);
  }
  .pull :global(em) {
    color: var(--editorial-glow);
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition:
      opacity 900ms var(--ease-out),
      transform 900ms var(--ease-out);
  }
  :global([data-js-ready]) .reveal:not(.in) {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .viz {
      position: relative;
      top: 0;
    }
  }
</style>

<script>
  import { observe } from '../../../lib/intersect';
  observe('.brain .reveal');

  // Brain state crossfade. --p (0 → 1) maps stressed (red) → mindful (green).
  // It's driven primarily by scroll progress while the sticky panel is pinned:
  // as the reader scrolls the chapter, the brain warms from red to green and the
  // toggle knob slides across. The pill buttons remain a manual override — a
  // click previews a state until the next scroll re-syncs to scroll position.
  const viz = document.querySelector<HTMLElement>('[data-brain-viz]');
  const grid = document.querySelector<HTMLElement>('[data-brain-grid]');

  if (viz && grid) {
    const buttons = Array.from(viz.querySelectorAll<HTMLButtonElement>('[data-state-toggle]'));

    const apply = (p: number) => {
      const clamped = Math.min(1, Math.max(0, p));
      viz.style.setProperty('--p', clamped.toFixed(3));
      const state = clamped >= 0.5 ? 'mindful' : 'stressed';
      if (viz.dataset.state !== state) {
        viz.dataset.state = state;
        buttons.forEach((b) =>
          b.setAttribute('aria-checked', b.dataset.stateToggle === state ? 'true' : 'false'),
        );
      }
    };

    // Progress = how far the pinned panel has travelled through the grid.
    // Works in both layouts: on desktop the sticky `top` offsets the start;
    // on mobile (top: 0, not sticky) it degrades to the grid's viewport position.
    const progress = () => {
      const travel = grid.offsetHeight - viz.offsetHeight;
      if (travel <= 0) return 0;
      const stickyTop = parseFloat(getComputedStyle(viz).top) || 0;
      const passed = stickyTop - grid.getBoundingClientRect().top;
      return passed / travel;
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        apply(progress());
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.stateToggle === 'mindful' ? 1 : 0));
    });

    apply(progress());
  }
</script>
