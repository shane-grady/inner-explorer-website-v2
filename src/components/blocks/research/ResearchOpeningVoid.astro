---
import { editableText, type EditablePrefix } from '../../../lib/editable';

interface Props {
  eyebrow: string;
  lines: string[];
  emphasisIndex?: number;
  /** Public path to a decorative looping background clip (e.g. "/videos/research/neurons.mp4").
   *  Omit for the flat night-and-glow background. */
  video?: string;
  /** Public path to the poster frame — a plain frame from the clip. It renders through
   *  the same blur/opacity filter as the video, so reduced-motion and no-JS visitors get
   *  the identical still and playback starts with no visible seam. */
  poster?: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'opening'). Omit on
   *  routes not backed by a `pages` collection entry. See lib/editable.ts.
   *
   *  `lines` is a plain string array, which has no per-row field to bind — an
   *  editable region must resolve to a string, and an array row's own value cannot
   *  be addressed. Edit the statement from the sidebar. */
  editablePrefix?: EditablePrefix;
}
const {
  eyebrow,
  lines,
  emphasisIndex = lines.length - 1,
  video,
  poster,
  editablePrefix,
}: Props = Astro.props;
---

<section class="void" id="open" data-screen-label="Opening" aria-labelledby="void-statement">
  {
    video && (
      <div class="void-media" aria-hidden="true">
        {/* No `autoplay` attribute: playback is started from the script below only when
            the visitor allows motion, so everyone else keeps the still poster. */}
        <video
          class="void-video"
          data-void-video
          loop
          muted
          playsinline
          preload="metadata"
          poster={poster}
        >
          <source src={video} type="video/mp4" />
        </video>
        <div class="void-scrim" />
      </div>
    )
  }
  <span class="void-eyebrow" {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</span>
  <p class="void-statement" id="void-statement">
    {lines.map((line, i) => <span class:list={['stk', { em: i === emphasisIndex }]}>{line}</span>)}
  </p>
  <div class="void-scroll" aria-hidden="true">
    <span>Scroll</span>
    <span class="void-scroll-line"></span>
  </div>
  {
    video && (
      <button
        type="button"
        class="void-motion"
        data-void-motion
        data-state="paused"
        aria-label="Play background video"
      >
        <svg
          class="icon-pause"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          aria-hidden="true"
          focusable="false"
        >
          <rect x="4" y="3" width="3" height="10" rx="1" fill="currentColor" />
          <rect x="9" y="3" width="3" height="10" rx="1" fill="currentColor" />
        </svg>
        <svg
          class="icon-play"
          viewBox="0 0 16 16"
          width="14"
          height="14"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M5 3.5v9l8-4.5-8-4.5Z" fill="currentColor" />
        </svg>
      </button>
    )
  }
</section>

<script>
  // The clip is ambience, not content: it never autoplays by attribute, it pauses
  // once the splash leaves the viewport, and the toggle gives everyone an explicit
  // stop/start control (WCAG 2.2.2) on top of the reduced-motion default.
  const video = document.querySelector<HTMLVideoElement>('[data-void-video]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-void-motion]');

  if (video && toggle) {
    // Set by the toggle: an explicit choice outranks the scroll-driven pausing below.
    let pausedByVisitor = !window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    const play = () => void video.play().catch(() => {});

    video.addEventListener('play', () => {
      toggle.dataset.state = 'playing';
      toggle.setAttribute('aria-label', 'Pause background video');
    });
    video.addEventListener('pause', () => {
      toggle.dataset.state = 'paused';
      toggle.setAttribute('aria-label', 'Play background video');
    });

    toggle.addEventListener('click', () => {
      pausedByVisitor = !video.paused;
      if (pausedByVisitor) video.pause();
      else play();
    });

    // Decoding a background clip nobody can see is pure battery cost — the hero below
    // pins for 200vh, so the splash is off screen for a long while.
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) video.pause();
        else if (!pausedByVisitor) play();
      },
      { threshold: 0.01 },
    );
    observer.observe(video);
  }
</script>

<style>
  .void {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 140px 32px 80px;
    text-align: center;
    background: var(--editorial-night);
    color: var(--editorial-paper);
    overflow: hidden;
  }
  .void::before,
  .void::after {
    content: '';
    position: absolute;
    width: 70%;
    height: 70%;
    pointer-events: none;
  }
  .void::before {
    inset: -20% -20% auto auto;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--editorial-glow) 18%, transparent),
      transparent 60%
    );
  }
  .void::after {
    inset: auto auto -20% -20%;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--brand-700) 30%, transparent),
      transparent 60%
    );
  }
  .void-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .void-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Overscaled so the blur radius never exposes a soft edge at the frame. */
    transform: scale(1.16);
    filter: blur(7px) saturate(0.9);
    opacity: 0.5;
  }
  .void-scrim {
    position: absolute;
    inset: 0;
    /* Keeps the statement well clear of AA contrast on the clip's brightest frames. */
    background:
      radial-gradient(
        ellipse 70% 55% at 50% 50%,
        color-mix(in oklab, var(--editorial-night) 70%, transparent),
        transparent 75%
      ),
      linear-gradient(
        180deg,
        color-mix(in oklab, var(--editorial-night) 64%, transparent) 0%,
        color-mix(in oklab, var(--editorial-night) 40%, transparent) 45%,
        color-mix(in oklab, var(--editorial-night) 80%, transparent) 100%
      );
  }
  .void-eyebrow {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--editorial-glow);
  }
  .void-eyebrow::before,
  .void-eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: color-mix(in oklab, var(--editorial-glow) 50%, transparent);
  }
  .void-statement {
    position: relative;
    z-index: 1;
    margin: 0;
    max-width: 1000px;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(40px, 6vw, 88px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--editorial-paper);
    text-wrap: balance;
  }
  .stk {
    display: block;
  }
  .em {
    color: var(--editorial-glow);
  }
  .void-scroll {
    position: absolute;
    z-index: 1;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    font-size: 10px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--editorial-paper) 45%, transparent);
  }
  .void-scroll-line {
    width: 1px;
    height: 36px;
    background: linear-gradient(
      to bottom,
      transparent,
      color-mix(in oklab, var(--editorial-paper) 40%, transparent),
      transparent
    );
    animation: voidPulse 2s ease-in-out infinite;
  }
  @keyframes voidPulse {
    0%,
    100% {
      opacity: 0.4;
      transform: scaleY(1);
    }
    50% {
      opacity: 1;
      transform: scaleY(1.2);
    }
  }
  .void-motion {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 0;
    border: 1px solid color-mix(in oklab, var(--editorial-paper) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--editorial-night) 55%, transparent);
    color: color-mix(in oklab, var(--editorial-paper) 55%, transparent);
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .void-motion:hover,
  .void-motion:focus-visible {
    color: var(--editorial-paper);
    border-color: color-mix(in oklab, var(--editorial-paper) 45%, transparent);
  }
  .void-motion .icon-play {
    display: none;
  }
  .void-motion[data-state='paused'] .icon-pause {
    display: none;
  }
  .void-motion[data-state='paused'] .icon-play {
    display: block;
  }
</style>
