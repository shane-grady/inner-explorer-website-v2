---
import {
  editableArray,
  editableItem,
  editableText,
  itemPrefix,
  type EditablePrefix,
} from '../../../lib/editable';

export interface CtaAction {
  label: string;
  href: string;
  /** Who this step is for — the card's kicker. */
  audience: string;
  /** One supporting line under the link. */
  line: string;
}
interface Props {
  eyebrow: string;
  /** Headline lines. `face: 'sans'` switches to the sans-300 face; default is italic display. `em` colors brand. */
  lines: Array<{ text: string; face?: 'sans' | 'display'; em?: boolean }>;
  subtitle: string;
  /** Three next steps; the first renders as the solid button. */
  actions: CtaAction[];
  /** The last words on the page, under the actions. */
  closing: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'cta'). Omit on routes
   *  not backed by a `pages` collection entry. See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
}
const { eyebrow, lines, subtitle, actions, closing, editablePrefix }: Props = Astro.props;
const linePrefix = itemPrefix(editablePrefix);
---

<section class="cta" id="cta" data-screen-label="Begin" aria-labelledby="cta-heading">
  <div class="wrap reveal">
    <span class="eyebrow">
      <span class="rule" aria-hidden="true"></span>
      <span {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</span>
      <span class="rule" aria-hidden="true"></span>
    </span>
    <h2 class="h" id="cta-heading" {...editableArray(editablePrefix, 'lines')}>
      {
        lines.map((l) => (
          <span
            class:list={['stk', l.face === 'sans' ? 'sans' : 'display', { em: l.em }]}
            {...editableItem(editablePrefix)}
          >
            <span {...editableText(linePrefix, 'text')}>{l.text}</span>
          </span>
        ))
      }
    </h2>
    <p class="sub" {...editableText(editablePrefix, 'subtitle', 'text')}>{subtitle}</p>
    <ul class="actions" {...editableArray(editablePrefix, 'actions')}>
      {
        actions.map((a, i) => (
          <li class="action" {...editableItem(editablePrefix)}>
            <span class="action-for" {...editableText(linePrefix, 'audience')}>
              {a.audience}
            </span>
            <a
              href={a.href}
              class:list={['btn', 'btn-lg', i === 0 ? 'btn-solid-ink' : 'btn-ghost-paper']}
            >
              <span {...editableText(linePrefix, 'label')}>{a.label}</span>
              {i === 0 && (
                <svg
                  width="14"
                  height="14"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14" />
                  <path d="M12 5l7 7-7 7" />
                </svg>
              )}
            </a>
            <p class="action-line" {...editableText(linePrefix, 'line', 'text')}>
              {a.line}
            </p>
          </li>
        ))
      }
    </ul>
    <p class="closing" {...editableText(editablePrefix, 'closing', 'text')}>{closing}</p>
  </div>
</section>

<style>
  .cta {
    padding: 120px 0 60px;
    background: var(--editorial-paper);
    color: var(--editorial-ink);
  }
  .wrap {
    position: relative;
    /* Wide enough that the headline's longest line ("Five minutes a day,")
       stays on a single line even at the capped display size, so the heading
       reads as the two intended lines rather than wrapping to three. */
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 32px;
    text-align: center;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 32px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .rule {
    width: 28px;
    height: 1px;
    background: color-mix(in oklab, var(--color-brand) 50%, transparent);
  }
  .h {
    margin: 0 0 28px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(56px, 8vw, 132px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .stk {
    display: block;
  }
  .display {
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
  }
  .sans {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.025em;
  }
  .em {
    color: var(--color-brand);
  }
  .sub {
    margin: 0 auto 56px;
    max-width: 580px;
    font-size: 18px;
    line-height: 1.55;
    color: var(--editorial-ink-muted);
    text-wrap: pretty;
  }

  /* Three next steps, one card each: who it's for → the link → one line. */
  .actions {
    list-style: none;
    margin: 0 auto;
    padding: 0;
    max-width: 1040px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    text-align: left;
  }
  .action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding: 28px 28px 30px;
    border-radius: 20px;
    background: var(--editorial-paper-soft);
    border: 1px solid color-mix(in oklab, var(--editorial-ink) 8%, transparent);
  }
  .action-for {
    min-height: 2.6em;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--editorial-ink-muted);
    text-wrap: balance;
  }
  .action-line {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: var(--editorial-ink-muted);
    text-wrap: pretty;
  }
  .closing {
    margin: 56px auto 0;
    max-width: 920px;
    padding-top: 36px;
    border-top: 1px solid color-mix(in oklab, var(--editorial-ink) 12%, transparent);
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(20px, 2vw, 24px);
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--editorial-ink);
    text-wrap: pretty;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    transition: all 250ms var(--ease-out);
    white-space: nowrap;
  }
  .btn-lg {
    padding: 18px 30px;
    font-size: 15px;
  }
  .btn-solid-ink {
    background: var(--editorial-ink);
    color: var(--editorial-paper);
  }
  .btn-solid-ink:hover {
    background: color-mix(in oklab, var(--editorial-ink) 80%, var(--color-black));
    transform: translateY(-2px);
  }
  .btn-ghost-paper {
    color: var(--editorial-ink);
    border: 1px solid color-mix(in oklab, var(--editorial-ink) 18%, transparent);
  }
  .btn-ghost-paper:hover {
    background: color-mix(in oklab, var(--editorial-ink) 6%, transparent);
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition:
      opacity 900ms var(--ease-out),
      transform 900ms var(--ease-out);
  }
  :global([data-js-ready]) .reveal:not(.in) {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (max-width: 820px) {
    .actions {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .action-for {
      min-height: 0;
    }
  }
</style>

<script>
  import { observe } from '../../../lib/intersect';
  observe('.cta .reveal');
</script>
