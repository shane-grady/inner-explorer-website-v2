---
// Independent research on AI and cognition, set against what daily practice builds.
// A different kind of argument from the outcome spreads, so it sits on the night
// ground the splash and Voices use. Every figure here is the wider field's, not Inner
// Explorer's — the eyebrow says so on the page, not just in the citations.
import {
  editableArray,
  editableItem,
  editableText,
  itemPrefix,
  type EditablePrefix,
} from '../../../lib/editable';

interface StatTile {
  stat: string;
  label: string;
}
interface Row {
  risk: string;
  build: string;
}
interface Props {
  label: string;
  headingHtml: string;
  paragraphs: string[];
  stats: StatTile[];
  transitionHeading: string;
  riskHead: string;
  buildHead: string;
  rows: Row[];
  closingHtml: string;
  linkLabel: string;
  linkHref: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'aiMoment'). Omit on
   *  routes not backed by a `pages` collection entry. See lib/editable.ts.
   *
   *  `headingHtml` and `closingHtml` render through `set:html` and stay sidebar-only. */
  editablePrefix?: EditablePrefix;
}
const {
  label,
  headingHtml,
  paragraphs,
  stats,
  transitionHeading,
  riskHead,
  buildHead,
  rows,
  closingHtml,
  linkLabel,
  linkHref,
  editablePrefix,
}: Props = Astro.props;
const rowPrefix = itemPrefix(editablePrefix);
---

<section class="ai" id="ai-moment" data-screen-label="The AI moment" aria-labelledby="ai-heading">
  <div class="wrap">
    <p class="label reveal">
      <span class="rule" aria-hidden="true"></span>
      <span {...editableText(editablePrefix, 'label')}>{label}</span>
    </p>
    <h2 class="h reveal" id="ai-heading" set:html={headingHtml} />
    {/* A string array has no per-row field to bind, so the paragraphs stay sidebar-only. */}
    <div class="body reveal">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>

    <ul class="stats reveal" {...editableArray(editablePrefix, 'stats')}>
      {
        stats.map((s) => (
          <li class="stat" {...editableItem(editablePrefix)}>
            <span class="stat-n" {...editableText(rowPrefix, 'stat')}>
              {s.stat}
            </span>
            <span class="stat-l" {...editableText(rowPrefix, 'label')}>
              {s.label}
            </span>
          </li>
        ))
      }
    </ul>

    <h3 class="reveal transition" {...editableText(editablePrefix, 'transitionHeading')}>
      {transitionHeading}
    </h3>

    <table class="pairs reveal">
      <thead>
        <tr>
          <th scope="col" {...editableText(editablePrefix, 'riskHead')}>{riskHead}</th>
          <th scope="col" {...editableText(editablePrefix, 'buildHead')}>{buildHead}</th>
        </tr>
      </thead>
      <tbody {...editableArray(editablePrefix, 'rows')}>
        {
          rows.map((r) => (
            <tr {...editableItem(editablePrefix)}>
              <td class="risk">
                <span class="kicker" aria-hidden="true">
                  {riskHead}
                </span>
                <span {...editableText(rowPrefix, 'risk')}>{r.risk}</span>
              </td>
              <td class="build">
                <span class="kicker" aria-hidden="true">
                  {buildHead}
                </span>
                <span {...editableText(rowPrefix, 'build')}>{r.build}</span>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="closing reveal" set:html={closingHtml} />
    <p class="more reveal">
      <a href={linkHref} class="link">
        <span {...editableText(editablePrefix, 'linkLabel')}>{linkLabel}</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14"></path>
          <path d="M12 5l7 7-7 7"></path>
        </svg>
      </a>
    </p>
  </div>
</section>

<style>
  .ai {
    position: relative;
    padding: 140px 0 120px;
    background: var(--editorial-night);
    color: var(--editorial-paper);
    overflow: hidden;
  }
  .ai::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 15% 20%,
        color-mix(in oklab, var(--editorial-glow) 14%, transparent),
        transparent 45%
      ),
      radial-gradient(
        circle at 85% 80%,
        color-mix(in oklab, var(--brand-700) 22%, transparent),
        transparent 50%
      );
    pointer-events: none;
  }
  .wrap {
    position: relative;
    z-index: 1;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 32px;
  }
  .label {
    display: flex;
    align-items: center;
    gap: 18px;
    margin: 0 0 32px;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.6;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--editorial-glow);
    text-wrap: pretty;
  }
  .rule {
    flex: none;
    width: 36px;
    height: 1px;
    background: color-mix(in oklab, var(--editorial-glow) 50%, transparent);
  }
  .h {
    margin: 0 0 48px;
    max-width: 1000px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(44px, 6vw, 88px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .h :global(em) {
    font-style: normal;
    color: var(--editorial-glow);
    font-weight: 500;
  }
  .h :global(.sans) {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 300;
    letter-spacing: -0.025em;
  }
  .h :global(.stk) {
    display: block;
  }
  /* Body runs the full section width in two columns rather than a left-hung block. */
  .body {
    columns: 2;
    column-gap: 64px;
    font-size: 18px;
    line-height: 1.7;
    color: color-mix(in oklab, var(--editorial-paper) 85%, transparent);
  }
  .body p {
    margin: 0 0 22px;
    break-inside: avoid;
    text-wrap: pretty;
  }
  .body p:last-child {
    margin-bottom: 0;
  }

  .stats {
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  .stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 28px 30px;
    border-radius: 20px;
    background: color-mix(in oklab, var(--editorial-paper) 5%, transparent);
    border: 1px solid color-mix(in oklab, var(--editorial-paper) 10%, transparent);
  }
  .stat-n {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(48px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--editorial-glow);
  }
  .stat-l {
    font-size: 14px;
    line-height: 1.5;
    color: color-mix(in oklab, var(--editorial-paper) 70%, transparent);
    text-wrap: pretty;
  }

  .transition {
    margin: 96px 0 32px;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(28px, 3.2vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  /* The centrepiece: a real two-column table, the problem on the left and the answer
     on the right, row by row. */
  .pairs {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
  }
  .pairs th {
    padding: 0 24px 16px 0;
    width: 50%;
    font-size: 11px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--editorial-paper) 55%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--editorial-paper) 18%, transparent);
  }
  .pairs th:last-child {
    color: var(--editorial-glow);
    padding-right: 0;
  }
  .pairs td {
    padding: 26px 24px 26px 0;
    vertical-align: top;
    font-size: 17px;
    line-height: 1.55;
    border-bottom: 1px solid color-mix(in oklab, var(--editorial-paper) 10%, transparent);
    text-wrap: pretty;
  }
  .pairs td:last-child {
    padding-right: 0;
  }
  .risk {
    color: color-mix(in oklab, var(--editorial-paper) 62%, transparent);
  }
  .build {
    color: var(--editorial-paper);
    font-weight: 500;
  }
  .kicker {
    display: none;
  }

  .closing {
    margin: 96px 0 0;
    max-width: 1100px;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(28px, 3.4vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .closing :global(em) {
    color: var(--editorial-glow);
  }
  .more {
    margin: 36px 0 0;
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 4px;
    border-bottom: 1px solid color-mix(in oklab, var(--editorial-paper) 30%, transparent);
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--editorial-paper);
    transition:
      color 200ms var(--ease-out),
      border-color 200ms var(--ease-out);
  }
  .link:hover,
  .link:focus-visible {
    color: var(--editorial-glow);
    border-color: var(--editorial-glow);
  }
  .link:focus-visible {
    outline: 2px solid var(--editorial-glow);
    outline-offset: 4px;
  }

  .reveal {
    opacity: 1;
    transform: none;
    transition:
      opacity 900ms var(--ease-out),
      transform 900ms var(--ease-out);
  }
  :global([data-js-ready]) .reveal:not(.in) {
    opacity: 0;
    transform: translateY(28px);
  }

  @media (max-width: 820px) {
    .body {
      columns: 1;
    }
    .stats {
      grid-template-columns: 1fr;
      margin-top: 40px;
    }
    .transition {
      margin-top: 72px;
    }
    .closing {
      margin-top: 72px;
    }
  }
  /* Phones: each row stacks risk over build, each cell naming its column. */
  @media (max-width: 720px) {
    .pairs thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      border: 0;
    }
    .pairs tr,
    .pairs td {
      display: block;
      width: 100%;
    }
    .pairs tr {
      padding: 22px 0;
      border-bottom: 1px solid color-mix(in oklab, var(--editorial-paper) 10%, transparent);
    }
    .pairs td {
      padding: 0;
      border: 0;
      font-size: 16px;
    }
    .pairs td + td {
      margin-top: 14px;
    }
    .kicker {
      display: block;
      margin-bottom: 6px;
      font-size: 10px;
      font-weight: 500;
      line-height: 1;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: color-mix(in oklab, var(--editorial-paper) 45%, transparent);
    }
    .build .kicker {
      color: var(--editorial-glow);
    }
  }
</style>

<script>
  import { observe } from '../../../lib/intersect';
  observe('.ai .reveal');
</script>
