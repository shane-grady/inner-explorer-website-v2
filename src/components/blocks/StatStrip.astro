---
import {
  editableText,
  editableArray,
  editableItem,
  type EditablePrefix,
  itemPrefix,
} from '../../lib/editable';

interface Stat {
  value: string; // e.g. "2.4M", "35,000", "487M", "94"
  sup?: string; // e.g. "+", "%"
  label: string;
  /** Optional italic qualifier set beneath the label (e.g. "in 41 U.S. states"). */
  sub?: string;
}
interface Props {
  stats: Stat[];
  /** Inner content width (any CSS length). About uses the wide 1440 column. */
  maxWidth?: string;
  /** Label casing — `upper` gives the editorial tracked-caps treatment. */
  labelCase?: 'sentence' | 'upper';
  /** `false` (default) is the full-bleed card band (About). `true` keeps the
   *  rules within the content column on the page background (detail pages). */
  contained?: boolean;
  /** Figure scale. `display` (default) is the big About-page hero figure;
   *  `compact` is a denser figure for snapshot bands with more columns (e.g. a
   *  5-up case-study "at a glance" where the display size would overflow). */
  size?: 'display' | 'compact';
  /** Number typeface. `serif` (default) is the brand's italic display figure;
   *  `sans` gives the in-article editorial treatment — a sans number with the
   *  unit (`sup`) set in the serif italic (blog "Article" stat row);
   *  `bold-sans` is the cinematic figure — a heavy Inter numeral with tight
   *  tracking and tabular figures (About hero band, mirrors `CinematicHero`). */
  numStyle?: 'serif' | 'sans' | 'bold-sans';
  ariaLabel?: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'stats'). Omit on routes
   *  that are not backed by a `pages` collection entry. See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
  /** The array field these cells come from, relative to `editablePrefix`. Defaults to
   *  `stats`; collection entries that name it differently pass a dotted path (e.g.
   *  `district.snapshot` on a case study, `facts` on a narrator). Row-relative field
   *  names (`value`/`sup`/`label`/`sub`) are unaffected. */
  statsKey?: string;
}
const {
  stats,
  maxWidth = '1440px',
  labelCase = 'sentence',
  contained = false,
  size = 'display',
  numStyle = 'serif',
  ariaLabel = 'Inner Explorer by the numbers',
  editablePrefix,
  statsKey = 'stats',
}: Props = Astro.props;
/** Inside an array row, paths are relative to the row — hence ''. */
const rowPrefix = itemPrefix(editablePrefix);
---

<section
  class:list={[
    'stats',
    {
      contained,
      compact: size === 'compact',
      'num-sans': numStyle === 'sans',
      'num-bold': numStyle === 'bold-sans',
    },
  ]}
  aria-label={ariaLabel}
  style={`--mw: ${maxWidth}; --cols: ${stats.length}`}
>
  {/* Container holds ONLY array rows, as CloudCannon's array regions require. */}
  <div class="stats-row" {...editableArray(editablePrefix, statsKey)}>
    {
      stats.map((s) => (
        <div class="stat-cell" {...editableItem(editablePrefix)}>
          <div class="num" data-value={s.value}>
            {/* `sup` is a sibling field, so the value needs its own host element. The
                wrapper is added only in editable mode, leaving other call sites' markup
                untouched — a text region may not contain another field's region. */}
            {editablePrefix === undefined ? (
              s.value
            ) : (
              <span {...editableText(rowPrefix, 'value')}>{s.value}</span>
            )}
            {s.sup && <sup {...editableText(rowPrefix, 'sup')}>{s.sup}</sup>}
          </div>
          <div
            class:list={['lbl', { upper: labelCase === 'upper' }]}
            {...editableText(rowPrefix, 'label')}
          >
            {s.label}
          </div>
          {s.sub && (
            <div class="sub" {...editableText(rowPrefix, 'sub')}>
              {s.sub}
            </div>
          )}
        </div>
      ))
    }
  </div>
</section>

<style>
  .stats {
    background: var(--color-card);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  /* In-column variant: rules hug the content width, no full-bleed card band. */
  .stats.contained {
    background: transparent;
    border-top: 0;
    border-bottom: 0;
  }
  .stats.contained .stats-row {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }
  .stats-row {
    max-width: var(--mw);
    margin: 0 auto;
    display: grid;
    /* Column count follows the data — 4-up for About, 5-up for a case-study snapshot. */
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    align-items: start;
  }
  .stat-cell {
    padding: 56px 32px;
    border-right: 1px solid var(--color-border);
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .stat-cell:last-child {
    border-right: 0;
  }
  /* Compact: denser figure + padding so a 5-up band reads as a tidy snapshot
     bar rather than the oversized hero stat. */
  .compact .stat-cell {
    padding: clamp(28px, 3vw, 38px) clamp(18px, 2vw, 26px);
  }
  .num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(48px, 5.2vw, 76px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .compact .num {
    font-size: clamp(30px, 3.2vw, 46px);
  }
  .num sup {
    font-size: 0.4em;
    font-style: normal;
    font-weight: 500;
    color: var(--color-brand);
    margin-left: 4px;
    vertical-align: top;
    top: 0.6em;
    position: relative;
  }
  /* In-article editorial figure: sans number, serif-italic unit in the foreground
     ink (matches the handoff's stat row). */
  .num-sans .num {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 500;
    letter-spacing: -0.03em;
  }
  .num-sans .num sup {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--color-foreground);
  }
  /* Cinematic figure: heavy Inter numeral, tight tracking, tabular figures —
     mirrors the `CinematicHero` stat band (About hero). */
  .num-bold .num {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 700;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
  }
  .num-bold .num sup {
    font-weight: 600;
  }
  .lbl {
    font-size: 14px;
    line-height: 1.4;
    color: var(--color-muted-foreground);
    white-space: nowrap;
  }
  /* In the cinematic figure the label carries the weight and the sub recedes. */
  .num-bold .lbl {
    color: var(--color-foreground);
    font-weight: 500;
  }
  .sub {
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 400;
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-muted-foreground);
    max-width: 220px;
  }
  .lbl.upper {
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  @media (max-width: 920px) {
    .stats-row {
      grid-template-columns: repeat(2, 1fr);
    }
    /* Drop the rule on the right column for any column count (was hardcoded to
       the 2nd cell, which broke for non-4-up bands). */
    .stat-cell:nth-child(even) {
      border-right: 0;
    }
  }
</style>

<script>
  // Count-up on first scroll-in. Animates the numeric part, preserves suffix
  // letters (M) and the <sup> symbol. Skipped entirely under reduced motion.
  // Observes every `.stats` on the page so multiple bands each animate.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('.stats').forEach((root) => {
    if (reduce) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          root.querySelectorAll<HTMLElement>('.num').forEach((el) => {
            const raw = el.dataset.value ?? '';
            // Anchored: only count up values that START with digits ("253K", "4 yrs",
            // "2.4M"). Letter-leading values ("PreK–12") have no numeric lead and stay
            // static rather than animating a stripped fragment.
            const m = raw.match(/^([\d.,]+)(.*)$/);
            if (!m) return;
            const target = parseFloat(m[1].replace(/,/g, ''));
            const tail = m[2]; // letters like "M" or " yrs"
            const sup = el.querySelector('sup')?.outerHTML ?? '';
            const decimals = (m[1].split('.')[1] || '').length;
            const start = performance.now();
            const dur = 1400;
            const tick = (t: number) => {
              const p = Math.min(1, (t - start) / dur);
              const eased = 1 - Math.pow(1 - p, 3);
              const v = target * eased;
              const shown =
                decimals > 0 ? v.toFixed(decimals) : Math.round(v).toLocaleString('en-US');
              el.innerHTML = shown + tail + sup;
              if (p < 1) requestAnimationFrame(tick);
              else el.innerHTML = raw + sup; // restore exact label
            };
            requestAnimationFrame(tick);
            // Guarantee the final value even if rAF is throttled/paused (e.g. the
            // tab is backgrounded mid-animation) — timers still fire, so the figure
            // never gets stuck on a partial count. Idempotent with normal completion.
            setTimeout(() => {
              el.innerHTML = raw + sup;
            }, dur + 250);
          });
          io.unobserve(entry.target);
        });
      },
      { threshold: 0.4 },
    );
    io.observe(root);
  });
</script>
