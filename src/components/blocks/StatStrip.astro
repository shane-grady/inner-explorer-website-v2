---
// A row of headline numbers: the numeral over its label, hairlines between them from lg up
// (two columns below). On a green Section the ink and hairlines follow the ground.
interface Stat {
  value: string;
  /** A trailing sign ("+") set in icon-accent. */
  sign?: string;
  label: string;
}
interface Props {
  stats: readonly Stat[];
  class?: string;
}
const { stats, class: className }: Props = Astro.props;
---

<dl class:list={['m-0 grid grid-cols-2 gap-x-4 gap-y-6 lg:grid-cols-4', className]}>
  {
    stats.map((stat) => (
      <div class="flex flex-col-reverse justify-end gap-1 lg:border-l lg:border-border lg:pl-8 lg:first:border-l-0 lg:first:pl-0">
        <dt class="type-stat-label text-foreground">{stat.label}</dt>
        <dd class="m-0 font-sans type-stat-sm font-bold text-foreground">
          {[stat.value, stat.sign && <span class="text-icon-accent">{stat.sign}</span>]}
        </dd>
      </div>
    ))
  }
</dl>
