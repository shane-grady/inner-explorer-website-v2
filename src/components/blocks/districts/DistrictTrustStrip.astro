---
// "Partnered with" — a deep brand-green band whose district wordmarks scroll slowly
// in a seamless, zero-JS carousel with soft left/right edge fades. The names list is
// rendered twice (second copy aria-hidden) so the loop is seamless and screen readers
// read the names once. Reduced-motion readers get a static, centered, wrapped row.

interface Props {
  caption: string;
  districts: string[];
}
const { caption, districts }: Props = Astro.props;
---

<section class="trust">
  <div class="head">
    <div class="eyebrow">Partnered with</div>
    <p class="caption">{caption}</p>
  </div>

  <div class="marquee">
    <ul class="track" aria-label="Partner districts">
      {districts.map((d) => <li>{d}</li>)}
    </ul>
    <ul class="track" aria-hidden="true">
      {districts.map((d) => <li>{d}</li>)}
    </ul>
  </div>
</section>

<style>
  .trust {
    background: var(--brand-800);
    color: var(--color-white);
    padding: clamp(36px, 5vw, 52px) 0;
    overflow: hidden;
  }

  .head {
    max-width: 1360px;
    margin: 0 auto clamp(24px, 3vw, 34px);
    padding: 0 40px;
    text-align: center;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--brand-200);
    margin-bottom: 10px;
  }
  .caption {
    margin: 0 auto;
    max-width: 60ch;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(14px, 1.6vw, 16px);
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-white) 88%, transparent);
  }

  /* Edge fades: a horizontal alpha mask (black = opaque) softens both ends. */
  .marquee {
    display: flex;
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }
  /* Two identical tracks, each exactly one container wide (min-width: 100%) with the
     names evenly distributed — translating both by -100% loops seamlessly regardless
     of how few names there are. */
  .track {
    flex: 0 0 auto;
    min-width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-around;
    animation: marquee 50s linear infinite;
  }
  .track li {
    flex: none;
    padding-inline: 28px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-white);
  }
  .marquee:hover .track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  /* No motion: drop the animation + duplicate, show a static centered wrapped row. */
  @media (prefers-reduced-motion: reduce) {
    .track {
      animation: none;
      min-width: 0;
      flex-wrap: wrap;
      justify-content: center;
      gap: 14px 0;
    }
    .track[aria-hidden='true'] {
      display: none;
    }
  }
</style>
