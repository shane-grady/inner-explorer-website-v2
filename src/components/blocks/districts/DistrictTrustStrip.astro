---
// "Partnered with" — a green band of partner-district names that scroll slowly in a
// seamless marquee, with soft left/right edge fades. Pure CSS (zero JS): the list is
// rendered twice (the second copy aria-hidden) and the track translates by -50% on a
// loop, so the two identical halves splice together with no visible seam. Pauses on
// hover so a reader can stop on a name; honors prefers-reduced-motion (static).

import { editableText, type EditablePrefix } from '../../../lib/editable';

interface Props {
  caption: string;
  districts: string[];
  /** CloudCannon path prefix for this block's fields (e.g. 'trustStrip'). Omit on
   *  routes that are not backed by a `pages` collection entry. See lib/editable.ts.
   *
   *  `districts` is bound with INDEXED paths, not `editableArray`: the marquee
   *  renders the list TWICE inside one <ul> (the second copy aria-hidden, so the
   *  loop has no seam), and an array container may hold only its own rows. Text
   *  editing works; add/remove stays in the sidebar. */
  editablePrefix?: EditablePrefix;
}
const { caption, districts, editablePrefix }: Props = Astro.props;
---

<section class="trust">
  <div class="trust-inner">
    <div class="trust-meta">
      <div class="eyebrow">Partnered with</div>
      <p class="caption" {...editableText(editablePrefix, 'caption', 'text')}>{caption}</p>
    </div>
    <div class="trust-marquee">
      <ul class="trust-track" aria-label="Partner districts">
        {districts.map((d, i) => <li {...editableText(editablePrefix, `districts.${i}`)}>{d}</li>)}
        {districts.map((d) => <li aria-hidden="true">{d}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .trust {
    background: var(--brand-700);
    color: var(--color-white);
    padding: 44px 0;
  }
  .trust-inner {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 40px;
    align-items: center;
  }
  .trust-meta .eyebrow {
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-white) 72%, transparent);
    margin-bottom: 8px;
  }
  .trust-meta .caption {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: 13.5px;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-white) 80%, transparent);
    margin: 0;
  }

  /* Marquee viewport: clip the overflowing track and fade both edges. */
  .trust-marquee {
    position: relative;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
    mask-image: linear-gradient(to right, transparent, black 7%, black 93%, transparent);
  }
  .trust-track {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    align-items: center;
    animation: trust-scroll 42s linear infinite;
    will-change: transform;
  }
  .trust-marquee:hover .trust-track {
    animation-play-state: paused;
  }
  .trust-track li {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 17px;
    line-height: 1;
    letter-spacing: -0.01em;
    color: color-mix(in oklab, var(--color-white) 92%, transparent);
  }
  /* Dot separator centered in the gap — applied to every item (including across the
     splice point) so spacing stays uniform and the loop is seamless. */
  .trust-track li::after {
    content: '';
    flex: none;
    width: 4px;
    height: 4px;
    margin: 0 30px;
    border-radius: 9999px;
    background: color-mix(in oklab, var(--color-white) 42%, transparent);
  }

  @keyframes trust-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-track {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .trust-inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>
