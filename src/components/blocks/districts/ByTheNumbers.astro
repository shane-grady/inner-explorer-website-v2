---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  childPrefix,
  editableArray,
  editableImage,
  editableItem,
  editableText,
  itemPrefix,
  type EditablePrefix,
} from '../../../lib/editable';

// Part Two — "By the Numbers." Dark editorial centerfold: 3-col asymmetric grid
// (big primary number, anchor photograph, stacked secondary numbers), then a
// 3-column citation row beneath a hairline.

interface PrimaryStat {
  label: string;
  value: string; // e.g. "11"
  unit?: string; // e.g. "pts"
  caption: string;
  source: string;
}
interface SmallStat {
  label: string;
  value: string;
  unit?: string;
  caption: string;
  source: string;
}
interface Citation {
  label: string;
  emphasis: string;
  body: string;
  cite: string;
}
interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  primary: PrimaryStat;
  small: SmallStat[];
  image: ImageMetadata;
  imageAlt: string;
  imageCaption: string;
  citations: Citation[];
  /** CloudCannon path prefix for this block's fields (e.g. 'byTheNumbers'). Omit on
   *  routes that are not backed by a `pages` collection entry. See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
}
const {
  eyebrow,
  title,
  intro,
  primary,
  small,
  image,
  imageAlt,
  imageCaption,
  citations,
  editablePrefix,
}: Props = Astro.props;
const primaryPrefix = childPrefix(editablePrefix, 'primary');
const smallPrefix = itemPrefix(editablePrefix);
const citePrefix = itemPrefix(editablePrefix);
---

<section class="btn" id="outcomes" aria-label="By the numbers">
  <div class="btn-glow-a" aria-hidden="true"></div>
  <div class="btn-glow-b" aria-hidden="true"></div>

  <div class="btn-inner">
    <div class="btn-head">
      <div>
        <div class="eyebrow" {...editableText(editablePrefix, 'eyebrow')}>{eyebrow}</div>
        {/* An HTML field cannot back a plain-text region — it stays sidebar-editable. */}
        <h2 class="head-h" set:html={title} />
      </div>
      <p class="head-p" {...editableText(editablePrefix, 'intro', 'text')}>{intro}</p>
    </div>

    <div class="btn-spread">
      <div class="primary-col">
        <div class="lbl" {...editableText(primaryPrefix, 'label')}>
          {primary.label}
        </div>
        <div class="primary-num" data-value={primary.value}>
          {
            /* `unit` is a sibling field, so the figure needs its own host element.
              `data-count` also tells the count-up script to animate THIS span rather
              than the leading text node, which would blow the region away. */
          }
          <span data-count {...editableText(primaryPrefix, 'value')}>{primary.value}</span>
          {
            primary.unit && (
              <span class="unit" {...editableText(primaryPrefix, 'unit')}>
                {primary.unit}
              </span>
            )
          }
        </div>
        <div class="primary-caption" {...editableText(primaryPrefix, 'caption', 'text')}>
          {primary.caption}
        </div>
        <div class="primary-cite" {...editableText(primaryPrefix, 'source')}>
          {primary.source}
        </div>
      </div>

      <div class="photo-col">
        <div class="frame">
          {
            /* The region sits on the <img> itself: `imageCaption` is a sibling field,
              and a caption nested inside an image region would resolve against that
              region's own value and fail. */
          }
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 900, 1400]}
            sizes="(max-width: 920px) 100vw, 30vw"
            loading="lazy"
            {...editableImage(editablePrefix, 'image', 'imageAlt')}
          />
          <div class="cap" {...editableText(editablePrefix, 'imageCaption')}>
            {imageCaption}
          </div>
        </div>
      </div>

      {/* Container holds ONLY array rows, as CloudCannon's array regions require. */}
      <div class="small-col" {...editableArray(editablePrefix, 'small')}>
        {
          small.map((s) => (
            <div class="small-item" {...editableItem(editablePrefix)}>
              {/* Inside an array row, paths are relative to the row. */}
              <div class="lbl" {...editableText(smallPrefix, 'label')}>
                {s.label}
              </div>
              <div class="small-num" data-value={s.value}>
                <span data-count {...editableText(smallPrefix, 'value')}>
                  {s.value}
                </span>
                {s.unit && (
                  <span class="unit" {...editableText(smallPrefix, 'unit')}>
                    {s.unit}
                  </span>
                )}
              </div>
              <div class="small-caption" {...editableText(smallPrefix, 'caption', 'text')}>
                {s.caption}
              </div>
              <div class="small-cite" {...editableText(smallPrefix, 'source')}>
                {s.source}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/* Container holds ONLY array rows, as CloudCannon's array regions require. */}
    <div class="btn-cites" {...editableArray(editablePrefix, 'citations')}>
      {
        citations.map((c) => (
          <div class="cite-cell" {...editableItem(editablePrefix)}>
            <div class="lbl" {...editableText(citePrefix, 'label')}>
              {c.label}
            </div>
            <p class="cite-body">
              <em {...editableText(citePrefix, 'emphasis')}>{c.emphasis}</em>{' '}
              <span {...editableText(citePrefix, 'body', 'text')}>{c.body}</span>
            </p>
            <div class="cite-source" {...editableText(citePrefix, 'cite')}>
              {c.cite}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .btn {
    background: var(--neutral-950);
    color: var(--color-white);
    padding: 140px 0;
    position: relative;
    overflow: hidden;
  }
  .btn-glow-a {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 70% 60% at 25% 30%,
      color-mix(in oklab, var(--brand-600) 22%, transparent),
      transparent 65%
    );
    pointer-events: none;
  }
  .btn-glow-b {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 50% 40% at 85% 80%,
      color-mix(in oklab, var(--brand-500) 18%, transparent),
      transparent 65%
    );
    pointer-events: none;
  }
  .btn-inner {
    position: relative;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
  }
  .btn-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: end;
    margin-bottom: 96px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-white) 70%, transparent);
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .eyebrow::before {
    content: '';
    width: 24px;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .head-h {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(48px, 6.5vw, 92px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin: 28px 0 0;
    text-wrap: balance;
  }
  .head-h :global(em) {
    font-style: normal;
    color: var(--brand-300);
  }
  .head-p {
    font-size: 18px;
    line-height: 1.65;
    color: color-mix(in oklab, var(--color-white) 72%, transparent);
    max-width: 480px;
    justify-self: end;
    margin: 0;
  }

  .btn-spread {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr;
    gap: 48px;
    margin-bottom: 96px;
  }
  .primary-col {
    border-top: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
    padding-top: 28px;
  }
  .lbl {
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-white) 60%, transparent);
  }
  .primary-num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(120px, 18vw, 208px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--color-white);
    margin-top: 8px;
    font-variant-numeric: tabular-nums;
  }
  .primary-num .unit {
    font-size: 0.42em;
    margin-left: 8px;
  }
  .primary-caption {
    margin-top: 12px;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-white);
    max-width: 320px;
  }
  .primary-cite {
    margin-top: 14px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-white) 50%, transparent);
  }

  .photo-col .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    align-self: stretch;
    min-height: 360px;
    background: var(--neutral-800);
  }
  .photo-col .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo-col .cap {
    position: absolute;
    bottom: 14px;
    left: 14px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 11.5px;
    line-height: 1.3;
    color: var(--color-white);
    background: color-mix(in oklab, var(--neutral-950) 50%, transparent);
    padding: 6px 10px;
    border-radius: 4px;
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  .small-col {
    display: grid;
    gap: 36px;
    align-content: start;
  }
  .small-item {
    border-top: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
    padding-top: 24px;
  }
  .small-num {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(64px, 7vw, 88px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--color-white);
    margin-top: 6px;
    font-variant-numeric: tabular-nums;
  }
  .small-num .unit {
    margin-left: 4px;
  }
  .small-caption {
    margin-top: 10px;
    font-size: 14.5px;
    font-weight: 500;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-white) 92%, transparent);
  }
  .small-cite {
    margin-top: 8px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-white) 50%, transparent);
  }

  .btn-cites {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
    padding-top: 32px;
  }
  .cite-cell {
    padding: 0 32px;
  }
  .cite-cell + .cite-cell {
    border-left: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
  }
  .cite-body {
    margin: 16px 0 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-white);
  }
  .cite-body em {
    font-style: italic;
  }
  .cite-body span {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 400;
    font-size: 0.7em;
    line-height: 1.4;
    color: color-mix(in oklab, var(--color-white) 88%, transparent);
  }
  .cite-source {
    margin-top: 16px;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 13px;
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-white) 50%, transparent);
  }

  @media (max-width: 920px) {
    .btn-head {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .head-p {
      justify-self: start;
    }
    .btn-spread {
      grid-template-columns: 1fr;
      gap: 64px;
    }
    .btn-cites {
      grid-template-columns: 1fr;
    }
    .cite-cell {
      padding: 24px 0;
    }
    .cite-cell + .cite-cell {
      border-left: 0;
      border-top: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
    }
  }
</style>

<script>
  // Count-up shared logic — runs on primary + small numbers.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const cells = document.querySelectorAll<HTMLElement>('.btn [data-value]');
  if (cells.length && !reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const raw = el.dataset.value ?? '';
          const m = raw.match(/([\d.,]+)(.*)$/);
          if (!m) return;
          const target = parseFloat(m[1].replace(/,/g, ''));
          // In CloudCannon-editable mode the figure has its own [data-count] span.
          // Animate that and nothing else — rewriting the cell's innerHTML would
          // destroy the Visual Editor's text region.
          const host = el.querySelector<HTMLElement>('[data-count]');
          // Preserve the existing unit span markup; restore on finish.
          const html = el.innerHTML;
          const start = performance.now();
          const dur = 1400;
          const tick = (t: number) => {
            const p = Math.min(1, (t - start) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            const v = target * eased;
            const decimals = (m[1].split('.')[1] || '').length;
            const shown =
              decimals > 0 ? v.toFixed(decimals) : Math.round(v).toLocaleString('en-US');
            // Re-render: replace the leading text before any nested element (or the
            // dedicated [data-count] host when the page is CloudCannon-editable).
            if (host) host.textContent = shown;
            else if (el.firstChild) el.firstChild.nodeValue = shown;
            if (p < 1) requestAnimationFrame(tick);
            else if (host) host.textContent = raw;
            else el.innerHTML = html;
          };
          requestAnimationFrame(tick);
          io.unobserve(el);
        });
      },
      { threshold: 0.4 },
    );
    cells.forEach((c) => io.observe(c));
  }
</script>
