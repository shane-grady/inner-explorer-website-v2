---
// Compare programs — Inner Explorer against the alternatives districts evaluate,
// rendered by the shared ComparisonTable (the same component as /pricing). This
// wrapper maps the page's data onto it: each criterion joins the group of its first
// category (the categories the old filter chips offered), 'n/a' becomes the
// component's 'na', and every text field keeps its CloudCannon path.

import ComparisonTable, {
  type Column,
  type Group,
  type Row as TableRow,
} from '../ComparisonTable.astro';
import { editableText, type EditablePrefix } from '../../../lib/editable';

type Cell = 'yes' | 'no' | 'partial' | 'limited' | 'varies' | 'n/a' | string;
type ColumnId = 'ie' | 'apps' | 'sel' | 'free';
interface CompareColumn {
  id: ColumnId;
  label: string;
  note?: string;
  highlight?: boolean;
}
interface Row {
  feat: string;
  ie: Cell;
  apps: Cell;
  sel: Cell;
  free: Cell;
  // The criterion's categories; the first one picks its group. Readonly so call
  // sites can pass `as const` arrays without a copy.
  cats: readonly string[];
}
interface Props {
  eyebrow: string;
  titleHtml: string;
  intro: string;
  shortVersion: string;
  columns: readonly CompareColumn[];
  rows: readonly Row[];
  /** CloudCannon path prefix for this block's fields (e.g. 'compare'). Omit on
   *  routes that are not backed by a `pages` collection entry. See lib/editable.ts.
   *  Rows and columns bind with INDEXED paths (`rows.3.feat`), as the table groups
   *  rows and an array container may hold only its own rows. */
  editablePrefix?: EditablePrefix;
}
const { eyebrow, titleHtml, intro, shortVersion, columns, rows, editablePrefix }: Props =
  Astro.props;

// Group order and titles. A category not listed here still gets a group, titled by its id.
const categories: Record<string, string> = {
  classroom: 'Classroom fit',
  privacy: 'Privacy & funding',
  impact: 'Impact evidence',
};

const tableColumns: Column[] = columns.map((c, ci) => ({
  name: c.label,
  note: c.note,
  highlight: c.highlight,
  namePath: `columns.${ci}.label`,
  notePath: `columns.${ci}.note`,
}));

const byCat = new Map<string, TableRow[]>(Object.keys(categories).map((k) => [k, []]));
rows.forEach((r, i) => {
  const cat = r.cats[0] ?? 'other';
  if (!byCat.has(cat)) byCat.set(cat, []);
  byCat.get(cat)?.push({
    feat: r.feat,
    featPath: `rows.${i}.feat`,
    cells: columns.map((c) => (r[c.id] === 'n/a' ? 'na' : r[c.id])),
    cellPaths: columns.map((c) => `rows.${i}.${c.id}`),
  });
});
const groups: Group[] = [...byCat]
  .filter(([, groupRows]) => groupRows.length > 0)
  .map(([cat, groupRows]) => ({ title: categories[cat] ?? cat, rows: groupRows }));
---

<ComparisonTable
  eyebrow={eyebrow}
  titleHtml={titleHtml}
  intro={intro}
  keyLabel="Criteria"
  caption="Inner Explorer compared with the alternatives districts evaluate, criterion by criterion."
  columns={tableColumns}
  groups={groups}
  labels={{ yes: 'Yes', no: 'No' }}
  noun={{ one: 'criterion', other: 'criteria' }}
  editablePrefix={editablePrefix}
>
  <div class="cmp-summary">
    <span class="sparkle" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        width="24"
        height="24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z"></path>
        <path d="M19 14l.8 2.2L22 17l-2.2.8L19 20l-.8-2.2L16 17l2.2-.8L19 14z"></path>
      </svg>
    </span>
    <p>
      <strong>The short version:</strong>{' '}
      <span {...editableText(editablePrefix, 'shortVersion', 'text')}>{shortVersion}</span>
    </p>
  </div>
</ComparisonTable>

<style>
  .cmp-summary {
    margin-top: 24px;
    padding: 24px;
    background: var(--color-muted);
    border-radius: var(--radius-sm);
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .sparkle {
    color: var(--color-brand);
    flex-shrink: 0;
  }
  .cmp-summary p {
    margin: 0;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-foreground);
  }
  .cmp-summary strong {
    font-weight: 700;
  }
</style>
