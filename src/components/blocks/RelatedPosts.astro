---
// "Keep reading" — a 3-up grid of related post cards. Data-driven so it can feed
// off the blog collection (latest siblings) or any curated list. Cards link to the
// post; the category renders as a pill over the thumbnail.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item {
  title: string;
  href: string;
  category?: string;
  meta?: string[];
  image?: ImageMetadata;
  imageAlt?: string;
}
interface Props {
  heading?: string;
  allHref?: string;
  allLabel?: string;
  items: Item[];
  maxWidth?: string;
}
const {
  heading = 'Keep reading',
  allHref,
  allLabel = 'All articles',
  items,
  maxWidth = '1200px',
}: Props = Astro.props;
---

<section class="related" style={`--mw: ${maxWidth}`}>
  <div class="wrap">
    <div class="head">
      <h2>{heading}<em>.</em></h2>
      {
        allHref && (
          <a class="all" href={allHref}>
            {allLabel}
            <svg
              viewBox="0 0 24 24"
              width="14"
              height="14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        )
      }
    </div>

    <div class="grid">
      {
        items.map((it) => (
          <a class="card" href={it.href}>
            <div class="img">
              {it.image ? (
                <Image
                  src={it.image}
                  alt={it.imageAlt ?? ''}
                  widths={[320, 480]}
                  sizes="(max-width: 900px) 92vw, 380px"
                  loading="lazy"
                />
              ) : (
                <span class="img-fallback" aria-hidden="true" />
              )}
              {it.category && <span class="pill">{it.category}</span>}
            </div>
            <div class="body">
              <h3>{it.title}</h3>
              {it.meta && it.meta.length > 0 && (
                <div class="meta">
                  {it.meta.map((m, i) => (
                    <>
                      {i > 0 && <span class="dot" aria-hidden="true" />}
                      <span>{m}</span>
                    </>
                  ))}
                </div>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .related {
    padding: 40px 0 0;
  }
  .wrap {
    max-width: var(--mw);
    margin: 0 auto;
    padding: 0 32px;
  }
  .head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 32px;
  }
  .head h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .head h2 em {
    font-style: normal;
    color: var(--color-brand-emphasis);
  }
  .all {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-muted-foreground);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .all:hover {
    color: var(--color-foreground);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-foreground);
    text-decoration: none;
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  .img {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--color-muted);
  }
  .img :global(img),
  .img-fallback {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .img-fallback {
    background:
      radial-gradient(ellipse 90% 80% at 30% 20%, var(--brand-700), transparent 70%),
      linear-gradient(150deg, var(--brand-900), var(--brand-950));
  }
  .pill {
    position: absolute;
    left: 16px;
    top: 16px;
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-white);
    background: color-mix(in oklab, var(--neutral-950) 82%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-white) 14%, transparent);
    backdrop-filter: blur(8px);
  }
  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 22px 24px;
  }
  .body h3 {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 19px;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .meta {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--color-muted-foreground);
  }
  .meta .dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
