---
// The photo hero: a full-bleed photo under a Forest scrim with the eyebrow, the display H1
// and the accent bar, then the intro and the actions on the page ground. Two or more
// slides make it a carousel (previous, next, dots and a count; no autoplay). The H1 is
// the page's one H1. Actions go in the `actions` slot (a primary and a secondary Button).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';
import { emphasize } from '../../lib/emphasize';

interface Slide {
  src: ImageMetadata;
  alt: string;
  /** object-position, to keep the subject in frame as the band crops. */
  position?: string;
}
interface Props {
  eyebrow?: string;
  /** `*words*` set in the italic display face; "\n" breaks the line. */
  title: string;
  slides: readonly Slide[];
  /** The carousel's accessible name. */
  label: string;
  lead?: string;
}
const { eyebrow, title, slides, label, lead }: Props = Astro.props;
const carousel = slides.length > 1;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section
  class="relative h-hero-photo overflow-hidden bg-brand-surface-deep"
  aria-roledescription={carousel ? 'carousel' : undefined}
  aria-label={label}
  data-on-brand
  data-carousel={carousel ? '' : undefined}
>
  {
    slides.map((slide, i) => (
      <Image
        class:list={[
          'ie-photo-tone absolute inset-0 size-full object-cover',
          carousel && 'ie-slide',
        ]}
        style={slide.position ? `object-position: ${slide.position}` : undefined}
        src={slide.src}
        alt={slide.alt}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        loading={i === 0 ? 'eager' : 'lazy'}
        fetchpriority={i === 0 ? 'high' : undefined}
        aria-hidden={carousel && i > 0 ? 'true' : undefined}
        data-slide={carousel ? '' : undefined}
        data-active={carousel && i === 0 ? '' : undefined}
      />
    ))
  }
  <div class="ie-photo-scrim absolute inset-0" aria-hidden="true"></div>
  <div class="absolute inset-x-section-x bottom-6 md:bottom-16">
    <div
      class="mx-auto flex max-w-page flex-col gap-6 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
    >
      <div class="inline-flex flex-col self-start">
        {eyebrow && <p class="m-0 type-eyebrow text-foreground">{eyebrow}</p>}
        <h1
          class="ie-display m-0 mt-4 type-display text-foreground md:mt-5"
          set:html={emphasize(title, '')}
        />
        <div class="ie-accent-bar mt-3 md:mt-4" aria-hidden="true"></div>
      </div>
      {
        carousel && (
          <div
            class="flex flex-row-reverse items-center justify-between gap-4 lg:shrink-0 lg:flex-col lg:items-end"
            data-carousel-controls
          >
            <div class="flex items-center gap-3">
              <button type="button" class="ie-carousel-btn" aria-label="Previous photo" data-prev>
                <Icon name="chevron-left" />
              </button>
              <button type="button" class="ie-carousel-btn" aria-label="Next photo" data-next>
                <Icon name="chevron-right" />
              </button>
            </div>
            <div class="flex items-center gap-2">
              <span
                class="type-tag tracking-wider text-foreground"
                aria-live="polite"
                data-count
              >{`${pad(1)} / ${pad(slides.length)}`}</span>
              <div class="flex items-center">
                {slides.map((_, i) => (
                  <button
                    type="button"
                    class="ie-dot"
                    aria-label={`Show photo ${i + 1} of ${slides.length}`}
                    aria-current={i === 0 ? 'true' : 'false'}
                    data-dot
                  />
                ))}
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>
</section>
{
  (lead || Astro.slots.has('actions')) && (
    <div class="bg-background px-section-x pt-8 pb-12 md:pt-16 md:pb-20">
      <div class="mx-auto grid max-w-page gap-7 lg:grid-cols-12 lg:items-center lg:gap-18">
        {lead && (
          <p class="m-0 max-w-measure-article type-lead-lg text-foreground lg:col-span-7">{lead}</p>
        )}
        <div
          class="flex flex-col gap-3 lg:col-span-5 lg:flex-row lg:flex-wrap lg:justify-end"
          data-hero-actions
        >
          <slot name="actions" />
        </div>
      </div>
    </div>
  )
}

<script>
  // Carousel: previous, next and the dots move one photo; the count reads the position.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const count = root.querySelector('[data-count]');
    const pad = (n: number) => String(n).padStart(2, '0');
    let current = 0;
    const show = (index: number) => {
      current = (index + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.toggleAttribute('data-active', i === current);
        slide.setAttribute('aria-hidden', String(i !== current));
      });
      dots.forEach((dot, i) => dot.setAttribute('aria-current', String(i === current)));
      if (count) count.textContent = `${pad(current + 1)} / ${pad(slides.length)}`;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(current - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
    root.dataset.ready = '';
  });
</script>
