---
// Stat row in two sizes:
//   - `dense`   — small italic serif numerals (~28px) + uppercase labels, used as
//                 studio metadata on the narrators collection page.
//   - `feature` — large italic serif numerals (~56px), used as per-narrator quick
//                 facts on the detail page.

import { editableText, type EditablePrefix } from '../../lib/editable';

interface MetaItem {
  value: string;
  label: string;
  /** Optional italic qualifier set beneath the label (e.g. "at our Boston studio"). */
  sub?: string;
  /** CloudCannon path of THIS row's object (e.g. 'metaStrip.narrators'). Per-row
   *  rather than per-block because a strip legitimately mixes authored rows with
   *  rows whose figure is computed at build time — those have no field to bind.
   *  Omit to leave the row untouched. See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
  /** Bind `value` too. Only for rows whose figure is authored copy: a derived figure
   *  has no field behind it, and the region would fail to resolve. */
  valueEditable?: boolean;
}
interface Props {
  items: MetaItem[];
  cols?: number;
  size?: 'dense' | 'feature';
  ariaLabel?: string;
}
const { items, cols = 5, size = 'dense', ariaLabel }: Props = Astro.props;
---

<section class:list={['meta', `is-${size}`]} style={`--cols:${cols}`} aria-label={ariaLabel}>
  <ul class="meta-row">
    {
      items.map((it) => (
        <li class="meta-item">
          {it.valueEditable ? (
            <b class="num" {...editableText(it.editablePrefix, 'value')}>
              {it.value}
            </b>
          ) : (
            <b class="num">{it.value}</b>
          )}
          <span class="lbl" {...editableText(it.editablePrefix, 'label')}>
            {it.label}
          </span>
          {it.sub && (
            <span class="sub" {...editableText(it.editablePrefix, 'sub')}>
              {it.sub}
            </span>
          )}
        </li>
      ))
    }
  </ul>
</section>

<style>
  .meta {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    background: var(--color-background);
  }
  .meta.is-dense {
    border-top: 0;
  }
  .meta-row {
    list-style: none;
    margin: 0 auto;
    max-width: 1440px;
    display: grid;
    grid-template-columns: repeat(var(--cols, 5), 1fr);
    align-items: center;
  }
  .meta-item {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--color-border);
    min-width: 0;
  }
  .meta-item:first-child {
    border-left: 0;
  }
  .num {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
  }
  .lbl {
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted-foreground);
    font-weight: 500;
  }
  .sub {
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    line-height: 1.4;
    color: var(--color-muted-foreground);
  }

  /* dense — collection-page studio metadata */
  .is-dense .meta-row {
    padding: 22px 32px;
    gap: 24px;
  }
  .is-dense .meta-item {
    padding-left: 20px;
    gap: 5px;
  }
  .is-dense .meta-item:first-child {
    padding-left: 0;
  }
  .is-dense .num {
    font-size: 28px;
    letter-spacing: -0.02em;
  }
  .is-dense .lbl {
    font-size: 10.5px;
    line-height: 1.3;
  }
  .is-dense .sub {
    font-size: 12px;
    margin-top: 2px;
  }

  /* feature — per-narrator quick-facts on detail pages */
  .is-feature .meta-row {
    padding: 36px 32px;
    gap: 0;
  }
  .is-feature .meta-item {
    padding: 0 32px;
    gap: 6px;
  }
  .is-feature .meta-item:first-child {
    padding-left: 0;
  }
  .is-feature .meta-item:last-child {
    padding-right: 0;
  }
  .is-feature .num {
    font-size: clamp(40px, 4vw, 56px);
    line-height: 0.95;
  }
  .is-feature .lbl {
    font-size: 12px;
    line-height: 1.3;
    letter-spacing: 0.1em;
  }
  .is-feature .sub {
    font-size: 13px;
    margin-top: 3px;
  }

  @media (max-width: 920px) {
    .meta-row {
      grid-template-columns: repeat(2, 1fr) !important;
      padding: 22px 24px !important;
      gap: 18px 24px !important;
    }
    .meta-item:nth-child(odd) {
      border-left: 0;
      padding-left: 0 !important;
    }
    .is-feature .meta-item:nth-child(even) {
      padding-right: 0;
    }
    .is-feature .num {
      font-size: 40px;
    }
  }
</style>
