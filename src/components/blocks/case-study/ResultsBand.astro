---
import type { Metric, ResultsChartData, Source } from './types';
import ResultsChart from './ResultsChart.astro';
import {
  editableText,
  editableArray,
  editableItem,
  childPrefix,
  itemPrefix,
  type EditablePrefix,
} from '../../../lib/editable';

// The results "proof" band — a deep forest-green full-bleed section carrying one
// oversized featured stat, a cited metric grid (units + ↑/↓ trend + footnote refs),
// an optional grouped bar chart, and a numbered sources list. White type over the
// brand-dark gradient (AA-checked). The narrative lead-in (eyebrow + heading + note)
// lives in the StoryBlock above this band, so the band opens straight on the
// featured number. Distinct from StatStrip (the light editorial by-the-numbers
// band); reusable wherever a results/impact proof block is needed.
interface Props {
  featured: Metric;
  metrics: Metric[];
  chart?: ResultsChartData;
  charts?: ResultsChartData[];
  sources?: Source[];
  id?: string;
  /** CloudCannon path prefix for the metrics object holding `featured` + `grid`
   *  (e.g. 'metrics'). Omit on call sites not backed by a collection entry. */
  editablePrefix?: EditablePrefix;
  /** Prefix of the object that OWNS `sources`, `chart` and `charts` — they sit beside
   *  the metrics object on the entry, not inside it, so on a case study this is the
   *  entry root (`''`). Omit to leave those parts unbound. */
  siblingsPrefix?: EditablePrefix;
}
const {
  featured,
  metrics,
  chart,
  charts = [],
  sources = [],
  id,
  editablePrefix,
  siblingsPrefix,
}: Props = Astro.props;

const arrow = (trend?: Metric['trend']) =>
  trend === 'up-good' ? '↑' : trend === 'down-good' ? '↓' : '';

const featuredPrefix = childPrefix(editablePrefix, 'featured');
const metricPrefix = itemPrefix(editablePrefix);
const sourcePrefix = itemPrefix(siblingsPrefix);
const chartPrefix = childPrefix(siblingsPrefix, 'chart');
const chartsPrefix = childPrefix(siblingsPrefix, 'charts');
---

<section class="results" id={id}>
  <div class="wrap">
    <div class="featured" data-cs-reveal>
      <div class="feat-num">
        <span class="num" data-value={featured.value} {...editableText(featuredPrefix, 'value')}>
          {featured.value}
        </span>
        {featured.trend && <span class="arrow">{arrow(featured.trend)}</span>}
      </div>
      <div class="feat-label">
        {
          /* `sourceId` is a NUMBER, so it is never a text region; the label therefore
            needs its own host once that sibling <sup> can appear. */
        }
        {
          editablePrefix === undefined ? (
            featured.label
          ) : (
            <span {...editableText(featuredPrefix, 'label', 'text')}>{featured.label}</span>
          )
        }
        {featured.sourceId && <sup>{featured.sourceId}</sup>}
      </div>
    </div>

    {/* Container holds ONLY metric rows. */}
    <div class="grid" data-cs-reveal {...editableArray(editablePrefix, 'grid')}>
      {
        metrics.map((m) => (
          <div class="metric" {...editableItem(editablePrefix)}>
            <div class="metric-v">
              <span class="num" data-value={m.value} {...editableText(metricPrefix, 'value')}>
                {m.value}
              </span>
              {m.unit && (
                <span class="unit" {...editableText(metricPrefix, 'unit')}>
                  {m.unit}
                </span>
              )}
              {m.trend && <span class="trend">{arrow(m.trend)}</span>}
            </div>
            <div class="metric-l">
              {editablePrefix === undefined ? (
                m.label
              ) : (
                <span {...editableText(metricPrefix, 'label', 'text')}>{m.label}</span>
              )}
              {m.sourceId && <sup>{m.sourceId}</sup>}
            </div>
          </div>
        ))
      }
    </div>

    {chart && <ResultsChart {...chart} editablePrefix={chartPrefix} />}
    {
      charts.map((c, i) => (
        <ResultsChart
          {...c}
          editablePrefix={chartsPrefix === undefined ? undefined : `${chartsPrefix}.${i}`}
        />
      ))
    }

    {
      sources.length > 0 && (
        <div class="sources" data-cs-reveal>
          <div class="sources-title">Sources</div>
          {/* The rows get their own container so the array region wraps rows ONLY —
              the "Sources" heading is not an item of the array. */}
          <div class="source-rows" {...editableArray(siblingsPrefix, 'sources')}>
            {sources.map((s) => (
              <div class="source" {...editableItem(siblingsPrefix)}>
                {/* `id` is a NUMBER — footnote numbering, not editable text. */}
                <b>{s.id}</b>
                {s.href ? (
                  <a href={s.href} rel="noopener" {...editableText(sourcePrefix, 'text', 'text')}>
                    {s.text}
                  </a>
                ) : (
                  <span {...editableText(sourcePrefix, 'text', 'text')}>{s.text}</span>
                )}
              </div>
            ))}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .results {
    margin-top: clamp(72px, 9vw, 132px);
    padding: clamp(56px, 7vw, 104px) 0;
    position: relative;
    color: var(--color-white);
    background:
      radial-gradient(
        120% 90% at 100% 0%,
        color-mix(in oklab, var(--color-white) 10%, transparent),
        transparent 55%
      ),
      radial-gradient(
        90% 80% at 0% 100%,
        color-mix(in oklab, var(--color-black) 22%, transparent),
        transparent 60%
      ),
      linear-gradient(165deg, var(--brand-800), var(--brand-950));
  }
  .wrap {
    max-width: 1340px;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 64px);
  }

  .featured {
    padding-bottom: clamp(30px, 4vw, 46px);
    border-bottom: 1px solid color-mix(in oklab, var(--color-white) 18%, transparent);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
  }
  .feat-num {
    display: flex;
    align-items: flex-start;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(86px, 15vw, 184px);
    line-height: 0.86;
    letter-spacing: -0.02em;
    color: var(--color-white);
  }
  .feat-num .arrow {
    font-size: 0.32em;
    margin: 0.35em 0 0 0.1em;
    font-style: normal;
    color: var(--brand-300);
  }
  .feat-label {
    max-width: 18ch;
    font-size: clamp(19px, 2.3vw, 28px);
    line-height: 1.4;
    color: color-mix(in oklab, var(--color-white) 92%, transparent);
  }
  .feat-label sup {
    font-size: 0.6em;
    font-weight: 600;
    color: var(--brand-300);
  }

  .grid {
    margin-top: clamp(34px, 4vw, 52px);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: color-mix(in oklab, var(--color-white) 14%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-white) 14%, transparent);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .metric {
    padding: clamp(24px, 3vw, 34px);
    background:
      linear-gradient(
        160deg,
        color-mix(in oklab, var(--color-white) 5%, transparent),
        transparent 60%
      ),
      var(--brand-900);
  }
  .metric-v {
    display: flex;
    align-items: baseline;
    gap: 2px;
    font-weight: 500;
    font-size: clamp(40px, 5vw, 60px);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .metric-v .unit {
    font-size: 0.5em;
    font-weight: 600;
    color: var(--brand-300);
  }
  .metric-v .trend {
    margin-left: 8px;
    align-self: center;
    font-size: 16px;
    color: var(--brand-300);
  }
  .metric-l {
    margin-top: 12px;
    max-width: 22ch;
    font-size: 15px;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-white) 82%, transparent);
  }
  .metric-l sup {
    margin-left: 1px;
    font-size: 0.72em;
    font-weight: 600;
    color: var(--brand-300);
  }

  .sources {
    margin-top: clamp(30px, 4vw, 46px);
    display: grid;
    gap: 8px;
  }
  /* Wrapper around the source rows (the array region's container). Repeats the
     parent grid's gap so the rows keep the exact rhythm they had as direct children. */
  .source-rows {
    display: grid;
    gap: 8px;
  }
  .sources-title {
    margin-bottom: 4px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in oklab, var(--color-white) 55%, transparent);
  }
  .source {
    display: flex;
    gap: 10px;
    font-size: 12.5px;
    line-height: 1.5;
    color: color-mix(in oklab, var(--color-white) 70%, transparent);
  }
  .source b {
    flex: none;
    font-weight: 600;
    color: var(--brand-300);
  }
  .source a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: color-mix(in oklab, var(--color-white) 40%, transparent);
  }
  .source a:hover {
    color: color-mix(in oklab, var(--color-white) 92%, transparent);
    text-decoration-color: var(--brand-300);
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 700px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
  @media (max-width: 520px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Count-up on first scroll-in for the featured + metric numbers. Animates the
  // numeric part, preserves any letter/symbol tail (e.g. "%", "×", "K"). Skipped
  // under reduced motion. Mirrors the shared StatStrip/CinematicHero pattern.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('.results .num');
  if (nums.length && !reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const raw = el.dataset.value ?? '';
          const m = raw.match(/([\d.,]+)(.*)$/);
          if (!m) return;
          const target = parseFloat(m[1].replace(/,/g, ''));
          const tail = m[2];
          const decimals = (m[1].split('.')[1] || '').length;
          const start = performance.now();
          const dur = 1400;
          const tick = (t: number) => {
            const p = Math.min(1, (t - start) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            const v = target * eased;
            const shown =
              decimals > 0 ? v.toFixed(decimals) : Math.round(v).toLocaleString('en-US');
            el.textContent = shown + tail;
            if (p < 1) requestAnimationFrame(tick);
            else el.textContent = raw;
          };
          requestAnimationFrame(tick);
          io.unobserve(el);
        });
      },
      { threshold: 0.4 },
    );
    nums.forEach((n) => io.observe(n));
  }
</script>
