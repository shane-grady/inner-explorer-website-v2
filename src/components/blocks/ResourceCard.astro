---
// Embedded resource card — a brand-tinted callout with a faux document cover, an
// eyebrow, title, meta line, and a download action. Built for the in-article module
// (most articles attach a resource) but reusable on the future Resource content type.
import Button from '../primitives/Button.astro';

interface Props {
  title: string;
  /** e.g. "PDF · 28 pages · Updated Apr 2026". */
  meta?: string;
  href?: string;
  eyebrow?: string;
  cta?: string;
  /** Open the download in a new tab (for external/hosted files). */
  newTab?: boolean;
}
const {
  title,
  meta,
  href = '#',
  eyebrow = 'Free resource',
  cta = 'Download',
  newTab = false,
}: Props = Astro.props;
---

<aside class="ie-resource">
  <div class="cover" aria-hidden="true">
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="bar"></span>
    <span class="mark"></span>
  </div>
  <div class="body">
    <p class="eyebrow">{eyebrow}</p>
    <h4>{title}</h4>
    {meta && <p class="meta">{meta}</p>}
  </div>
  <Button
    href={href}
    tone="brand"
    shape="pill"
    class="dl"
    target={newTab ? '_blank' : undefined}
    rel={newTab ? 'noopener noreferrer' : undefined}
  >
    <svg
      viewBox="0 0 24 24"
      width="16"
      height="16"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
      <polyline points="7 10 12 15 17 10"></polyline>
      <line x1="12" y1="15" x2="12" y2="3"></line>
    </svg>
    {cta}
  </Button>
</aside>

<style>
  .ie-resource {
    margin: 3.5rem 0;
    padding: 28px;
    display: grid;
    grid-template-columns: 88px 1fr auto;
    gap: 24px;
    align-items: center;
    border-radius: var(--radius-2xl);
    border: 1px solid color-mix(in oklab, var(--color-brand) 20%, transparent);
    background: linear-gradient(
      135deg,
      color-mix(in oklab, var(--color-brand) 5%, var(--color-card)),
      color-mix(in oklab, var(--color-brand) 11%, var(--color-card))
    );
  }
  .cover {
    position: relative;
    width: 88px;
    height: 112px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 10px;
    border: 1px solid var(--color-border);
    background: linear-gradient(
      155deg,
      var(--color-card),
      color-mix(in oklab, var(--color-brand) 6%, var(--color-card))
    );
    box-shadow: var(--shadow-md);
  }
  .cover .bar {
    height: 3px;
    margin-bottom: 6px;
    border-radius: 2px;
    background: var(--brand-300);
  }
  .cover .bar:nth-child(2) {
    width: 70%;
    background: var(--brand-200);
  }
  .cover .bar:nth-child(3) {
    width: 50%;
    background: var(--color-border);
  }
  .cover .mark {
    position: absolute;
    left: 8px;
    bottom: 8px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--color-brand);
  }
  .body {
    min-width: 0;
  }
  .body .eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-emphasis);
  }
  .body h4 {
    margin: 0 0 4px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    color: var(--color-foreground);
  }
  .body .meta {
    margin: 0;
    font-size: 13px;
    color: var(--color-muted-foreground);
  }
  @media (max-width: 600px) {
    .ie-resource {
      grid-template-columns: 64px 1fr;
      gap: 18px;
    }
    .cover {
      width: 64px;
      height: 82px;
    }
    .ie-resource .dl {
      grid-column: 1 / -1;
      justify-content: center;
    }
  }
</style>
