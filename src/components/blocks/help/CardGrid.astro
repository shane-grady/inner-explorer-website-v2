---
// A responsive grid of info <Card>s — used for option grids (e.g. "Ways to sign in")
// and numbered trios (e.g. Choose / Press play / Reflect). `columns` is the desktop
// column count; it collapses to one column on narrow screens.
interface Props {
  columns?: 2 | 3;
  items?: Array<{ title: string; badge?: string; content: string }>;
}
import Card from './Card.astro';

const { columns = 2, items }: Props = Astro.props;
---

<div class="help-cards" data-columns={columns}>
  {items?.length ? items.map((item) => <Card {...item} />) : <slot />}
</div>

<style>
  .help-cards {
    margin: 1.75rem 0;
    display: grid;
    gap: 14px;
  }
  .help-cards[data-columns='2'] {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  /* With an odd number of cards, let the last one span both columns so the
     grid ends flush instead of with a dangling half-width card. */
  .help-cards[data-columns='2'] > :global(:last-child:nth-child(odd)) {
    grid-column: 1 / -1;
  }
  .help-cards[data-columns='3'] {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  @media (max-width: 560px) {
    .help-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
