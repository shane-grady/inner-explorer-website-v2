---
// A captioned figure for help articles. When a real `src` image is provided it's
// optimized + served responsively; otherwise it renders a calm branded placeholder
// labelled with what the screenshot will show (real screenshots are a follow-up).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Placeholder label / a11y description of the eventual screenshot. */
  label: string;
  /** Caption shown beneath the figure. */
  caption?: string;
  /** Aspect ratio, e.g. "16 / 9". */
  ratio?: string;
  /** Optional real image — when set, replaces the placeholder. */
  src?: ImageMetadata;
  alt?: string;
}
const { label, caption, ratio = '16 / 9', src, alt }: Props = Astro.props;
---

<figure class="help-figure">
  {
    src ? (
      <Image
        class="help-figure-img"
        src={src}
        alt={alt ?? label}
        widths={[480, 768, 1024]}
        sizes="(max-width: 820px) 92vw, 760px"
        loading="lazy"
        style={`aspect-ratio:${ratio}`}
      />
    ) : (
      <div class="help-figure-ph" style={`aspect-ratio:${ratio}`} role="img" aria-label={label}>
        <svg
          width="42"
          height="42"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2" />
          <circle cx="9" cy="9" r="2" />
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21" />
        </svg>
        <span>{label}</span>
      </div>
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .help-figure {
    margin: 1.75rem 0;
  }
  .help-figure-img {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius-lg);
    background: var(--color-muted);
  }
  .help-figure-ph {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    border-radius: var(--radius-lg);
    background: var(--color-muted);
    color: color-mix(in oklab, var(--color-muted-foreground) 80%, transparent);
    box-shadow: var(--shadow-md);
  }
  .help-figure-ph span {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
  }
  .help-figure figcaption {
    margin-top: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
</style>
