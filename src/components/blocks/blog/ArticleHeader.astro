---
// Blog article hero — the type-led masthead for the "Article — long-form" template.
// Pills (category + read time) → duet headline (sans with an inline serif-italic em)
// → standfirst → meta row (date · read time · tags, NO personal byline; attribution
// is the Inner Explorer brand) → full-bleed hero photo with a caption pill.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Headline with an optional serif-italic <em> fragment; falls back to `title`. */
  titleHtml?: string;
  title: string;
  category?: string;
  readingTime?: string;
  /** Standfirst / dek under the headline. */
  dek?: string;
  pubDate: Date;
  tags?: string[];
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  heroCaption?: string;
}
const {
  titleHtml,
  title,
  category,
  readingTime,
  dek,
  pubDate,
  tags = [],
  heroImage,
  heroImageAlt = '',
  heroCaption,
}: Props = Astro.props;

// Format in UTC so a date-only frontmatter value (parsed as UTC midnight) shows the
// intended calendar day rather than slipping back a day in western timezones.
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const metaParts: { icon?: 'clock' | 'tag'; text: string }[] = [];
if (readingTime) metaParts.push({ icon: 'clock', text: readingTime });
if (tags.length) metaParts.push({ icon: 'tag', text: tags.join(' · ') });
---

<header class="article-hero">
  {
    (category || readingTime) && (
      <div class="pills">
        {category && (
          <span class="pill tone-green">
            <span class="dot" aria-hidden="true" />
            {category}
          </span>
        )}
        {readingTime && <span class="pill">{readingTime} read</span>}
      </div>
    )
  }

  <h1 class="display" set:html={titleHtml ?? title} />

  {dek && <p class="dek">{dek}</p>}

  <div class="meta-row">
    <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}</time>
    {
      metaParts.map((p) => (
        <>
          <span class="sep" aria-hidden="true" />
          <span class="mi">
            {p.icon === 'clock' && (
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <polyline points="12 7 12 12 15 14" />
              </svg>
            )}
            {p.icon === 'tag' && (
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L3 13V3h10l7.59 7.59a2 2 0 0 1 0 2.82Z" />
                <line x1="7" y1="7" x2="7.01" y2="7" />
              </svg>
            )}
            {p.text}
          </span>
        </>
      ))
    }
  </div>
</header>

{
  heroImage && (
    <div class="hero-image">
      <Image
        src={heroImage}
        alt={heroImageAlt}
        widths={[640, 960, 1280, 1600]}
        sizes="(max-width: 1264px) 100vw, 1200px"
        loading="eager"
        fetchpriority="high"
      />
      {heroCaption && <span class="cap">{heroCaption}</span>}
    </div>
  )
}

<style>
  .article-hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 880px;
  }
  .pills {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }
  .pill.tone-green {
    color: var(--color-brand-emphasis);
    background: var(--color-brand-subtle);
    border-color: color-mix(in oklab, var(--color-brand) 18%, transparent);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand);
  }
  .display {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
    text-wrap: balance;
  }
  .display :global(em) {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    letter-spacing: -0.015em;
  }
  .dek {
    margin: 0;
    max-width: 680px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--color-muted-foreground);
  }
  .meta-row .mi {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .meta-row .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .hero-image {
    position: relative;
    margin-top: 24px;
    aspect-ratio: 16 / 8;
    border-radius: 28px;
    overflow: hidden;
    background: var(--color-muted);
  }
  .hero-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 68%,
      color-mix(in oklab, var(--neutral-950) 28%, transparent)
    );
    pointer-events: none;
  }
  .hero-image .cap {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-white);
    background: color-mix(in oklab, var(--neutral-950) 62%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
    backdrop-filter: blur(12px);
  }

  @media (max-width: 720px) {
    .hero-image {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-xl);
    }
    .hero-image .cap {
      left: 16px;
      bottom: 16px;
    }
  }
</style>
