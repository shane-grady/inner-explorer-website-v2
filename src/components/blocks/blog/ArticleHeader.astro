---
// Blog article hero — the type-led masthead for the "Article — long-form" template.
// Pills (category + read time) → duet headline (sans with an inline serif-italic em)
// → standfirst → byline (optional named author + role) → meta row (date · read time ·
// tags) → full-bleed hero photo with a caption pill. When no `authorRole` is given
// the byline is omitted and attribution stays the Inner Explorer brand.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Headline with an optional serif-italic <em> fragment; falls back to `title`. */
  titleHtml?: string;
  title: string;
  category?: string;
  readingTime?: string;
  /** Standfirst / dek under the headline. */
  dek?: string;
  pubDate: Date;
  tags?: string[];
  /** Named author for a visible byline (paired with `authorRole`). */
  author?: string;
  authorRole?: string;
  authorImage?: ImageMetadata;
  heroImage?: ImageMetadata;
  heroImageAlt?: string;
  heroCaption?: string;
}
const {
  titleHtml,
  title,
  category,
  readingTime,
  dek,
  pubDate,
  tags = [],
  author,
  authorRole,
  authorImage,
  heroImage,
  heroImageAlt = '',
  heroCaption,
}: Props = Astro.props;

// A byline renders only when a person is named (author + role).
const hasByline = Boolean(author && authorRole);

// Format in UTC so a date-only frontmatter value (parsed as UTC midnight) shows the
// intended calendar day rather than slipping back a day in western timezones.
const dateFmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
const metaParts: { icon?: 'clock' | 'tag'; text: string }[] = [];
if (readingTime) metaParts.push({ icon: 'clock', text: readingTime });
if (tags.length) metaParts.push({ icon: 'tag', text: tags.join(' · ') });
---

<header class="article-hero">
  {
    (category || readingTime) && (
      <div class="pills">
        {category && (
          <span class="pill tone-green">
            <span class="dot" aria-hidden="true" />
            <editable-text data-prop="category">{category}</editable-text>
          </span>
        )}
        {readingTime && <span class="pill">{readingTime} read</span>}
      </div>
    )
  }

  {
    titleHtml ? (
      // CloudCannon's HTML input remains editable in the sidebar. It cannot be
      // bound to a plain-text visual region without losing its inline markup.
      <h1 class="display" set:html={titleHtml} />
    ) : (
      <h1 class="display" data-editable="text" data-prop="title">
        {title}
      </h1>
    )
  }

  {
    dek && (
      <p class="dek" data-editable="text" data-prop="description">
        {dek}
      </p>
    )
  }

  {
    hasByline && (
      <div class="byline">
        {authorImage && (
          /* Decorative — the author's name is announced by the adjacent text. */
          <Image class="avatar" src={authorImage} alt="" width={44} height={44} />
        )}
        <span class="byline-text">
          <span class="byline-name">
            By <editable-text data-prop="author">{author}</editable-text>
          </span>
          <span class="byline-role" data-editable="text" data-prop="authorRole">
            {authorRole}
          </span>
        </span>
      </div>
    )
  }

  <div class="meta-row">
    <time datetime={pubDate.toISOString()}>{dateFmt.format(pubDate)}</time>
    {
      metaParts.map((p) => (
        <>
          <span class="sep" aria-hidden="true" />
          <span class="mi">
            {p.icon === 'clock' && (
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="9" />
                <polyline points="12 7 12 12 15 14" />
              </svg>
            )}
            {p.icon === 'tag' && (
              <svg
                viewBox="0 0 24 24"
                width="13"
                height="13"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20.59 13.41 13.42 20.6a2 2 0 0 1-2.83 0L3 13V3h10l7.59 7.59a2 2 0 0 1 0 2.82Z" />
                <line x1="7" y1="7" x2="7.01" y2="7" />
              </svg>
            )}
            {p.text}
          </span>
        </>
      ))
    }
  </div>
</header>

{
  heroImage && (
    <div class="hero-image">
      {/* The caption must NOT be a descendant of the image region: a relative
          `data-prop` binds to its nearest editable ancestor, so nested inside the
          image it would resolve against that region's {src, alt} value instead of
          the frontmatter, and the Visual Editor would render an error card. */}
      <div
        class="hero-image-media"
        data-editable="image"
        data-prop-src="heroImage"
        data-prop-alt="heroImageAlt"
      >
        <Image
          src={heroImage}
          alt={heroImageAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 1264px) 100vw, 1200px"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      {heroCaption && (
        <span class="cap" data-editable="text" data-prop="heroCaption">
          {heroCaption}
        </span>
      )}
    </div>
  )
}

<style>
  .article-hero {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 880px;
  }
  .pills {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    color: var(--color-foreground);
    background: var(--color-card);
    border: 1px solid var(--color-border);
  }
  .pill.tone-green {
    color: var(--color-brand-emphasis);
    background: var(--color-brand-subtle);
    border-color: color-mix(in oklab, var(--color-brand) 18%, transparent);
  }
  .pill .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-brand);
  }
  .display {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
    text-wrap: balance;
  }
  .display :global(em) {
    font-style: normal;
    color: var(--color-brand-emphasis);
  }
  .dek {
    margin: 0;
    max-width: 680px;
    font-size: clamp(18px, 2vw, 21px);
    line-height: 1.55;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .byline .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--color-muted);
  }
  .byline-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.3;
  }
  .byline-name {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-foreground);
  }
  .byline-role {
    font-size: 13px;
    color: var(--color-muted-foreground);
  }
  .meta-row {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--color-muted-foreground);
  }
  .meta-row .mi {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .meta-row .sep {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .hero-image {
    position: relative;
    margin-top: 24px;
    aspect-ratio: 16 / 8;
    border-radius: 28px;
    overflow: hidden;
    background: var(--color-muted);
  }
  .hero-image-media {
    position: absolute;
    inset: 0;
  }
  .hero-image :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 68%,
      color-mix(in oklab, var(--neutral-950) 28%, transparent)
    );
    pointer-events: none;
  }
  .hero-image .cap {
    position: absolute;
    left: 24px;
    bottom: 24px;
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 12px;
    border-radius: 9999px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-white);
    background: color-mix(in oklab, var(--neutral-950) 62%, transparent);
    border: 1px solid color-mix(in oklab, var(--color-white) 16%, transparent);
    backdrop-filter: blur(12px);
  }

  @media (max-width: 720px) {
    .hero-image {
      aspect-ratio: 4 / 3;
      border-radius: var(--radius-xl);
    }
    .hero-image .cap {
      left: 16px;
      bottom: 16px;
    }
  }
</style>
