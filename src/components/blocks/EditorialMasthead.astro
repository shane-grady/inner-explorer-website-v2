---
// Centered editorial masthead — the brand "duet" headline.
//
// Three layouts share the same component:
//   stacked (default) — sans lead line above an oversized serif-italic display line
//                       (used by /narrators/[slug] and similar long-form pages).
//   inline            — a single-line sentence with the serif word painted brand-green.
//                       Give it a `maxWidth` wide enough for the sentence; it wraps
//                       rather than overflowing if the container is too narrow.
//                       Used by the Contact page hero.
//   display           — display-only: just the serif-italic line (no lead). Used by the
//                       Support page hero ("FAQs.").
//   uniform           — one sentence at a single size in a single color, wrapping
//                       naturally. No two-tone duet. Used by the Pricing hero, where
//                       a mixed grey/green headline read as an accident.
//
// Carries the page's single <h1>.
interface Props {
  /** Optional centered eyebrow text between the two hairline rules. */
  eyebrow?: string;
  /** Sans lead text. Optional in `display` layout; required for `stacked`/`inline`. */
  lead?: string;
  /** Serif-italic display text (e.g. "Maya Castellanos." or "FAQs."). */
  display: string;
  /** Supporting paragraph below the headline. */
  intro?: string;
  /** Inner content width (any CSS length). */
  maxWidth?: string;
  /** Layout style. */
  layout?: 'stacked' | 'inline' | 'display' | 'uniform';
  /** Inline-layout scale. `lg` is the oversized hero treatment (Newsroom); `md`
   *  (default) is the one-line sentence size used by Contact. */
  size?: 'md' | 'lg';
  /** Render a soft brand halo behind the headline (Newsroom hero). */
  glow?: boolean;
}
const {
  eyebrow,
  lead,
  display,
  intro,
  maxWidth = '1200px',
  layout = 'stacked',
  size = 'md',
  glow = false,
}: Props = Astro.props;
---

<section class="masthead" data-layout={layout} data-size={size} style={`--mw: ${maxWidth}`}>
  {glow && <div class="glow" aria-hidden="true" />}
  <div class="wrap">
    {
      eyebrow && (
        <div class="eb">
          <span class="rule" aria-hidden="true" />
          <span class="eb-text">{eyebrow}</span>
          <span class="rule" aria-hidden="true" />
        </div>
      )
    }
    <h1 class="display">
      {lead && <span class="lead">{lead}</span>}
      <span class="serif">{display}</span>
    </h1>
    {intro && <p class="intro">{intro}</p>}
  </div>
</section>

<style>
  .masthead {
    position: relative;
    padding: 56px 0;
    text-align: center;
  }
  /* Soft brand halo behind the headline (opt-in via `glow`). */
  .glow {
    position: absolute;
    left: 50%;
    top: 40px;
    transform: translateX(-50%);
    width: min(680px, 92vw);
    height: 340px;
    background: var(--masthead-glow);
    pointer-events: none;
    z-index: 0;
  }
  .wrap {
    position: relative;
    z-index: 1;
    max-width: var(--mw);
    margin: 0 auto;
    padding: 0 32px;
  }
  .eb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 28px;
    color: var(--color-muted-foreground);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }
  .rule {
    width: 60px;
    height: 1px;
    background: var(--color-border);
  }
  .display {
    margin: 0;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  /* Stacked (default): lead block sits above the oversized serif display block. */
  [data-layout='stacked'] .lead {
    display: block;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(36px, 6vw, 64px);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--color-muted-foreground);
  }
  [data-layout='stacked'] .serif {
    display: block;
    margin-top: 4px;
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 500;
    font-size: clamp(56px, 11vw, 128px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-brand-emphasis);
  }

  /* Inline: one sentence on a single line, serif word painted brand-green.
     Deliberately NOT `white-space: nowrap`. A headline too long for its container
     would overflow rather than wrap, and `text-align: center` pins overflowing text
     to the start edge, so it spills right and reads as off-centre against the rest
     of the page. Wrapping keeps it centred; size the container (`maxWidth`) so the
     sentence still lands on one line at the widths you care about. */
  [data-layout='inline'] .display {
    font-size: clamp(28px, 5.2vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  [data-layout='inline'] .lead {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--color-foreground);
  }
  [data-layout='inline'] .serif {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 700;
    color: var(--color-brand-emphasis);
  }
  /* Inline `lg` — the oversized Newsroom hero scale; lead reads lighter. */
  [data-layout='inline'][data-size='lg'] .display {
    font-size: clamp(40px, 9vw, 88px);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  [data-layout='inline'][data-size='lg'] .lead {
    font-weight: 300;
  }

  /* Uniform: the whole headline at one size in one color. `lead` and `display` are
     rendered as inline siblings so a sentence split across the two props still reads
     and wraps as a single continuous line of type. */
  [data-layout='uniform'] .display {
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: clamp(36px, 5.4vw, 68px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
  }
  [data-layout='uniform'] .lead,
  [data-layout='uniform'] .serif {
    display: inline;
    font: inherit;
    color: inherit;
  }
  [data-layout='uniform'] .lead::after {
    content: ' ';
  }

  /* Display: single oversized serif-italic line (no lead). */
  [data-layout='display'] .serif {
    display: block;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(56px, 9vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-foreground);
  }

  .intro {
    margin: 28px auto 0;
    max-width: 56ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }
  [data-layout='inline'] .intro {
    margin-top: 22px;
  }
</style>
