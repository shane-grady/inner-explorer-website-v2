---
// Partner logos, each the name in type until a logo is supplied (with permission).
// `row`: "Trusted in districts including", the label beside one row of names (Home).
// `wall`: a centered label over wrapping logo cells, grayscale until hovered, each optionally
// linked to its coverage (About's partners and press). Two cells a row below md; an odd last
// cell centers.
// `marquee`: a centered label over the names in type, scrolling in a loop under faded edges
// (Research's partners). It pauses on hover, with its pause button, or with a page's
// `[data-motion-paused]`; under reduced motion it is a still, wrapping row.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../ui/Icon.astro';

interface Partner {
  name: string;
  logo?: ImageMetadata;
  /** Wall: the logo's largest box in px, as the board sizes each logo to balance the row. */
  logoSize?: { w: number; h: number };
  /** Wall: set the name in type beside the logo (a mark without a wordmark). */
  showName?: boolean;
  /** Wall: a typeset name in Inter 900, as the board sets "People" (its 800 resolves to 900). */
  heavy?: boolean;
  /** Wall: a small line under the logo ("Chicago"). */
  caption?: string;
  /** Wall: the coverage this cell links to, opened in a new tab. */
  href?: string;
  /** Wall: the link's accessible name; "(opens in a new tab)" is appended. */
  linkLabel?: string;
}
interface Props {
  label: string;
  partners: readonly Partner[];
  layout?: 'row' | 'wall' | 'marquee';
  /** Marquee: the pause button's accessible name. */
  pauseLabel?: string;
  /** Wall: the cell width from md up. */
  cell?: 'md' | 'sm';
  class?: string;
}
const {
  label,
  partners,
  layout = 'row',
  pauseLabel = `Pause the ${label.toLowerCase()}`,
  cell = 'md',
  class: className,
}: Props = Astro.props;
const CELL = { md: 'md:basis-54', sm: 'md:basis-45' } as const;
const labelId = `logos-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

{
  layout === 'marquee' ? (
    <div class:list={['flex flex-col items-center gap-5 md:gap-6', className]} data-marquee>
      <div class="relative">
        <p id={labelId} class="m-0 type-eyebrow text-foreground-muted">
          {label}
        </p>
        <button
          type="button"
          class="group ie-icon-btn ie-icon-btn-sm absolute top-1/2 left-full ml-3 -translate-y-1/2"
          aria-label={pauseLabel}
          aria-pressed="false"
          hidden
          data-marquee-pause
        >
          <Icon name="pause" size={16} class="group-aria-pressed:hidden" />
          <Icon name="play" size={16} class="hidden group-aria-pressed:block" />
        </button>
      </div>
      <div class="ie-marquee">
        <ul class="ie-marquee-track m-0 list-none p-0" aria-labelledby={labelId}>
          {[...partners, ...partners].map((partner, i) => (
            <li
              class="type-card-title-md text-foreground-muted"
              aria-hidden={i >= partners.length ? 'true' : undefined}
            >
              {partner.name}
            </li>
          ))}
        </ul>
      </div>
    </div>
  ) : layout === 'row' ? (
    <div
      class:list={[
        'flex flex-col items-start gap-3 lg:flex-row lg:items-center lg:gap-10',
        className,
      ]}
    >
      <p class="m-0 shrink-0 type-eyebrow text-foreground">{label}</p>
      <ul class="m-0 flex list-none flex-wrap items-center gap-x-5 gap-y-2 p-0 lg:grow lg:justify-between">
        {partners.map((partner) => (
          <li class="type-card-title-md text-foreground-secondary">
            {partner.logo ? (
              <Image class="h-8 w-auto" src={partner.logo} alt={partner.name} height={64} />
            ) : (
              partner.name
            )}
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class:list={['flex flex-col gap-4 md:gap-6', className]}>
      <p id={labelId} class="m-0 text-center type-eyebrow text-foreground">
        {label}
      </p>
      <ul
        class="ie-logo-wall m-0 flex list-none flex-wrap justify-center gap-2 p-0 md:gap-x-6 md:gap-y-4"
        aria-labelledby={labelId}
      >
        {partners.map((partner) => {
          const body = (
            <>
              {partner.logo && (
                <Image
                  src={partner.logo}
                  alt={partner.showName ? '' : partner.name}
                  style={
                    partner.logoSize &&
                    `--logo-w: ${partner.logoSize.w}px; --logo-h: ${partner.logoSize.h}px`
                  }
                  height={(partner.logoSize?.h ?? 40) * 2}
                />
              )}
              {(!partner.logo || partner.showName) && (
                <span class:list={['type-lead-lg', partner.heavy ? 'font-black' : 'font-bold']}>
                  {partner.name}
                </span>
              )}
              {partner.caption && <span class="type-tag">{partner.caption}</span>}
            </>
          );
          return (
            <li class:list={['flex h-16 md:h-18', CELL[cell]]}>
              {partner.href ? (
                <a
                  class:list={[
                    'ie-logo-link flex grow items-center justify-center gap-1 text-foreground-muted',
                    partner.caption && 'flex-col',
                  ]}
                  href={partner.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${partner.linkLabel ?? partner.name} (opens in a new tab)`}
                >
                  {body}
                </a>
              ) : (
                <div class="flex grow items-center justify-center gap-2 text-foreground-muted">
                  {body}
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </div>
  )
}

<script>
  // The marquee's pause button: shown once wired, and only while the names can move.
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const root of document.querySelectorAll<HTMLElement>('[data-marquee]')) {
    const pause = root.querySelector<HTMLButtonElement>('[data-marquee-pause]');
    if (!pause || still) continue;
    pause.hidden = false;
    pause.addEventListener('click', () => {
      const paused = pause.getAttribute('aria-pressed') !== 'true';
      pause.setAttribute('aria-pressed', String(paused));
      root.toggleAttribute('data-paused', paused);
    });
  }
</script>
