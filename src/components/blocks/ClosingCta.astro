---
// The closing call to action: an Emerald panel (light + ghost buttons) or a white Raised
// card (primary + secondary), with or without a photo on the right. The page gives it a
// Section; this is the panel. One per page.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import { emphasize } from '../../lib/emphasize';

interface Props {
  tone?: 'emerald' | 'white';
  /** `*words*` are set in the italic display face, as the boards draw "the next story". */
  title: string;
  eyebrow?: string;
  lead?: string;
  primary: { label: string; href: string };
  secondary?: { label: string; href: string };
  image?: { src: ImageMetadata; alt: string };
  id?: string;
}
const {
  tone = 'emerald',
  title,
  eyebrow,
  lead,
  primary,
  secondary,
  image,
  id = 'closing-cta',
}: Props = Astro.props;
const emerald = tone === 'emerald';
---

<section
  aria-labelledby={id}
  class:list={[
    'ie-card grid',
    emerald ? 'bg-brand-surface' : 'ie-card-raised',
    image && 'md:grid-cols-12',
  ]}
  data-on-brand={emerald ? '' : undefined}
>
  <div
    class:list={[
      'flex flex-col items-start justify-center px-cta-padding-x py-cta-padding',
      image && (emerald ? 'md:col-span-6' : 'md:col-span-7'),
    ]}
  >
    {eyebrow && <p class="m-0 mb-4 type-eyebrow text-foreground">{eyebrow}</p>}
    <h2
      id={id}
      class="ie-cta-title m-0 type-section-title text-foreground"
      set:html={emphasize(title)}
    />
    {
      lead && (
        <p class="m-0 mt-5 max-w-measure type-lead text-foreground-secondary md:mt-6">{lead}</p>
      )
    }
    <div class="mt-6 flex flex-col gap-3 self-stretch md:mt-8 md:flex-row md:self-auto">
      <Button variant={emerald ? 'light' : 'primary'} href={primary.href} arrow
        >{primary.label}</Button
      >
      {
        secondary && (
          <Button variant={emerald ? 'ghost' : 'secondary'} href={secondary.href}>
            {secondary.label}
          </Button>
        )
      }
    </div>
  </div>
  {
    image && (
      <div
        class:list={[
          'ie-cta-photo relative order-first h-55 md:order-none md:h-auto md:min-h-130',
          emerald ? 'md:col-span-6' : 'md:col-span-5',
        ]}
      >
        <Image src={image.src} alt={image.alt} width={1040} densities={[1, 2]} />
      </div>
    )
  }
</section>
