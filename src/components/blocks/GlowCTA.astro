---
import Button from '../primitives/Button.astro';
import { editableText, childPrefix, type EditablePrefix } from '../../lib/editable';

// Centered closing CTA: a two-line "duet" headline (bold sans over serif-italic
// brand line) on a soft brand glow rising from the bottom edge, with a primary +
// optional secondary pill button and a small trust line. Light-surface companion
// to the photo-led EditorialCTA / AboutCTA — reusable on home, pricing, etc.

interface Cta {
  label: string;
  href: string;
}
interface Props {
  /** Top headline line — bold sans. */
  sans: string;
  /** Bottom headline line — serif-italic, painted in the deep brand tone. */
  serif: string;
  subtitle?: string;
  primary: Cta;
  secondary?: Cta;
  /** Small reassurance line under the buttons. */
  trust?: string;
  /** CloudCannon path prefix for this block's fields (e.g. 'cta'). Omit on routes
   *  that are not backed by a `pages` collection entry. See lib/editable.ts. */
  editablePrefix?: EditablePrefix;
  /** Field names for the headline/subtitle within `editablePrefix`, for entries that
   *  name them differently (a case study's `cta` object is heading / headingEmphasis /
   *  body). `primary.label` / `secondary.label` are already shared vocabulary. */
  sansKey?: string;
  serifKey?: string;
  subtitleKey?: string;
}
const {
  sans,
  serif,
  subtitle,
  primary,
  secondary,
  trust,
  editablePrefix,
  sansKey = 'sans',
  serifKey = 'serif',
  subtitleKey = 'subtitle',
}: Props = Astro.props;
const primaryPrefix = childPrefix(editablePrefix, 'primary');
const secondaryPrefix = childPrefix(editablePrefix, 'secondary');
---

<section class="glow-cta">
  <div class="glow" aria-hidden="true"></div>
  <div class="inner">
    <h2 class="title">
      <span class="sans" {...editableText(editablePrefix, sansKey)}>{sans}</span>
      <span class="serif" {...editableText(editablePrefix, serifKey)}>{serif}</span>
    </h2>
    {
      subtitle && (
        <p class="sub" {...editableText(editablePrefix, subtitleKey, 'text')}>
          {subtitle}
        </p>
      )
    }
    <div class="actions">
      {
        /* The button's only content is its label, so the region can sit on the
          <a> itself — no extra wrapper element, so non-CMS call sites are unchanged. */
      }
      <Button
        href={primary.href}
        size="lg"
        shape="pill"
        tone="neutral"
        {...editableText(primaryPrefix, 'label')}
      >
        {primary.label}
      </Button>
      {
        secondary && (
          <Button
            href={secondary.href}
            size="lg"
            shape="pill"
            variant="outline"
            tone="neutral"
            {...editableText(secondaryPrefix, 'label')}
          >
            {secondary.label}
          </Button>
        )
      }
    </div>
    {
      trust && (
        <p class="trust" {...editableText(editablePrefix, 'trust')}>
          {trust}
        </p>
      )
    }
  </div>
</section>

<style>
  .glow-cta {
    position: relative;
    padding: clamp(72px, 11vw, 132px) 0;
    text-align: center;
    overflow: hidden;
  }
  .glow {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -40px;
    height: 90%;
    background: var(--newsroom-cta-glow);
    pointer-events: none;
    z-index: 0;
  }
  .inner {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .title {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.02;
    text-wrap: balance;
  }
  .title .sans {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(34px, 5vw, 58px);
    letter-spacing: -0.02em;
    color: var(--color-foreground);
  }
  .title .serif {
    font-family: var(--font-sans);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(38px, 5.6vw, 66px);
    letter-spacing: -0.02em;
    color: var(--color-brand-emphasis);
  }
  .sub {
    margin: 18px auto 0;
    max-width: 480px;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.5;
    color: var(--color-muted-foreground);
    text-wrap: pretty;
  }
  .actions {
    margin-top: 30px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .trust {
    margin: 24px 0 0;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-muted-foreground);
  }
</style>
