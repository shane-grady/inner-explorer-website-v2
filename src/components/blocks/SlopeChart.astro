---
// A slope chart in a Raised card (Mindful Michigan's playback comparison): the title and note,
// two column heads, then a line per place from its first value to its second on a shared
// scale from 0 to `max`. The others are Warm Gray; the highlighted place is Jade, with its
// points and a label at each end (the value under the name below md). One image to assistive
// tech, named by `description`. Lines sit in percentages of the plot, so it stretches with
// the card.
interface Props {
  title: string;
  note?: string;
  description: string;
  columns: readonly [string, string];
  max: number;
  lines: readonly (readonly [number, number])[];
  highlight: {
    name: string;
    values: readonly [number, number];
    labels: readonly [string, string];
  };
  class?: string;
}
const {
  title,
  note,
  description,
  columns,
  max,
  lines,
  highlight,
  class: className,
}: Props = Astro.props;

const pct = (n: number) => `${n.toFixed(2)}%`;
// The two columns' positions across the plot.
const X = [30, 70] as const;
const y = (v: number) => (1 - v / max) * 100;
---

<figure
  class:list={['ie-card ie-card-raised m-0 flex flex-col gap-5 p-6 md:gap-6 md:p-8', className]}
>
  <figcaption class="flex flex-col gap-1">
    <span class="type-card-title-md text-balance text-foreground">{title}</span>
    {note && <span class="type-label leading-normal text-foreground-muted">{note}</span>}
  </figcaption>
  <div role="img" aria-label={description} class="flex flex-col pb-3">
    <div class="relative h-12 md:h-8">
      {
        columns.map((col, i) => (
          <span
            class="ie-plot-mark w-24 text-center type-label font-bold text-foreground md:w-40"
            data-anchor="top"
            style={`--x: ${X[i]}%`}
          >
            {col}
          </span>
        ))
      }
    </div>
    <div class="relative h-slope-plot">
      <svg
        class="absolute inset-0 size-full overflow-visible"
        fill="none"
        stroke-linecap="round"
        aria-hidden="true"
      >
        {
          X.map((x) => (
            <line
              x1={`${x}%`}
              x2={`${x}%`}
              y1="0"
              y2="100%"
              class="stroke-border"
              stroke-width="1"
            />
          ))
        }
        {
          lines.map(([a, b]) => (
            <line
              x1={`${X[0]}%`}
              x2={`${X[1]}%`}
              y1={pct(y(a))}
              y2={pct(y(b))}
              class="stroke-border-control"
              stroke-width="1.5"
            />
          ))
        }
        <line
          x1={`${X[0]}%`}
          x2={`${X[1]}%`}
          y1={pct(y(highlight.values[0]))}
          y2={pct(y(highlight.values[1]))}
          class="stroke-brand"
          stroke-width="3"></line>
        {
          highlight.values.map((v, i) => (
            <circle
              cx={`${X[i]}%`}
              cy={pct(y(v))}
              r="5"
              class="fill-brand stroke-surface"
              stroke-width="2"
            />
          ))
        }
      </svg>
      {
        highlight.labels.map((label, i) => (
          <span
            class:list={[
              'ie-plot-mark type-label leading-normal font-bold whitespace-nowrap text-brand-emphasis',
              i === 0 && 'text-right',
            ]}
            data-anchor={i === 0 ? 'before' : 'after'}
            style={`--x: ${X[i]}%; --y: ${pct(y(highlight.values[i]))}`}
          >
            {highlight.name} <span class="block md:inline">{label}</span>
          </span>
        ))
      }
    </div>
  </div>
</figure>
