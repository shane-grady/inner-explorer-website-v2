---
import { Image } from 'astro:assets';
import Container from '../primitives/Container.astro';
import mark from '../../assets/brand/inner-explorer-mark.png';
import footer from '../../data/footer.json';

interface FooterLink {
  label: string;
  href: string;
}

interface FooterGroup {
  heading: string;
  links: FooterLink[];
}

interface Props {
  tagline?: string;
  groups?: FooterGroup[];
  /** Bottom-bar policy links (privacy policy, and terms when one exists). Kept out
   *  of the nav columns above: a legal notice belongs in the legal row, and every
   *  page needs it reachable in one click from anywhere on the site. */
  legalLinks?: FooterLink[];
  legalStartYear?: number;
  legalName?: string;
  nonprofitLabel?: string;
  closing?: string;
}

const {
  tagline = footer.tagline,
  groups = footer.groups,
  legalLinks = footer.legalLinks,
  legalStartYear = footer.legalStartYear,
  legalName = footer.legalName,
  nonprofitLabel = footer.nonprofitLabel,
  closing = footer.closing,
}: Props = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-card">
  <Container width="wide" class="py-section-md">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_1fr]">
      <div>
        <Image src={mark} alt="" width={36} height={36} class="mb-4" />
        <p
          class="max-w-xs text-sm text-muted-foreground"
          data-editable="text"
          data-prop="@data[footer].tagline"
        >
          {tagline}
        </p>
      </div>
      <div class="contents" data-editable="array" data-prop="@data[footer].groups">
        {
          groups.map((group) => (
            <nav aria-label={group.heading} data-editable="array-item">
              <h2 class="text-xs font-medium tracking-wider text-muted-foreground uppercase">
                <editable-text data-prop="heading">{group.heading}</editable-text>
              </h2>
              <ul class="mt-4 space-y-3" data-editable="array" data-prop="links">
                {group.links.map((link) => (
                  <li data-editable="array-item">
                    <a
                      href={link.href}
                      class="text-sm text-foreground transition-colors hover:text-brand"
                    >
                      <editable-text data-prop="label">{link.label}</editable-text>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>
    <div
      class="mt-12 flex flex-col gap-3 border-t border-border pt-6 text-sm text-muted-foreground sm:flex-row sm:items-center sm:justify-between"
    >
      <div class="flex flex-col gap-x-6 gap-y-3 sm:flex-row sm:items-center">
        <span>
          &copy; {legalStartYear}&ndash;{year}{' '}
          <editable-text data-prop="@data[footer].legalName">{legalName}</editable-text> &middot;{
            ' '
          }
          <editable-text data-prop="@data[footer].nonprofitLabel">{nonprofitLabel}</editable-text>
        </span>
        {
          legalLinks.length > 0 && (
            <nav aria-label="Legal">
              <ul
                class="flex flex-wrap items-center gap-x-6 gap-y-2"
                data-editable="array"
                data-prop="@data[footer].legalLinks"
              >
                {legalLinks.map((link) => (
                  <li data-editable="array-item">
                    <a href={link.href} class="transition-colors hover:text-foreground">
                      <editable-text data-prop="label">{link.label}</editable-text>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
      </div>
      <span data-editable="text" data-prop="@data[footer].closing">{closing}</span>
    </div>
  </Container>
</footer>
