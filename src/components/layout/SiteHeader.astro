---
// The site header: skip link, logo, primary navigation and Sign in (from xl), the Contact button
// at every width (the mobile CTA, in place of a sticky bottom bar), and the menu button (and
// MobileMenu) below xl. Below sm the button's padding and the gaps tighten so the row fits at
// 320 (WCAG reflow). `dark` is the transparent header over a Forest hero (no page uses it now: Research takes the standard header); `overlay`
// lays it over the top of the page's first section, so the hero's video runs under it
// (PageLayout header="dark"). Static, as on the boards.
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Logo from '../ui/Logo.astro';
import MobileMenu from './MobileMenu.astro';
import { contactCta, navCurrent, primaryNav, signIn } from '../../data/navigation';

interface Props {
  dark?: boolean;
  overlay?: boolean;
  /** A static sample on the styleguide: no menu, and a distinct navigation name. */
  sample?: boolean;
}
const { dark = false, overlay = false, sample = false }: Props = Astro.props;
const current = (href: string) => (sample ? undefined : navCurrent(Astro.url.pathname, href));
---

<header
  class:list={[
    'ie-header flex items-center justify-between gap-2 px-section-x',
    overlay ? 'absolute inset-x-0 top-0 z-10' : 'relative',
  ]}
  data-on-brand={dark ? '' : undefined}
>
  {
    !sample && (
      <a class="ie-skip-link ie-btn-primary ie-btn-sm" href="#main">
        Skip to content
      </a>
    )
  }
  <a class="flex min-h-control-sm shrink-0 items-center" href="/" aria-label="Inner Explorer home">
    <Logo reversed={dark} />
  </a>
  <nav
    aria-label={sample ? 'Primary (sample)' : 'Primary'}
    class="hidden items-center gap-8 xl:flex"
  >
    {
      primaryNav.map((link) => (
        <a class="ie-nav" href={link.href} aria-current={current(link.href)}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="flex items-center gap-2 sm:gap-3 xl:gap-6">
    <a class="ie-nav hidden xl:inline-flex" href={signIn.href}>{signIn.label}</a>
    <Button
      variant={dark ? 'ghost' : 'primary'}
      size="sm"
      href={contactCta.href}
      aria-current={current(contactCta.href)}
      class="px-3 sm:px-6"
    >
      {contactCta.label}
    </Button>
    {
      sample ? (
        <span class="ie-menu-btn xl:hidden" aria-hidden="true">
          <Icon name="menu" />
        </span>
      ) : (
        <button
          type="button"
          class="ie-menu-btn xl:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-open
        >
          <Icon name="menu" />
        </button>
      )
    }
  </div>
  {!sample && <MobileMenu />}
</header>
