---
import type { ComponentProps } from 'astro/types';
import EditorialMasthead from '../../components/blocks/EditorialMasthead.astro';

type Props = Pick<
  ComponentProps<typeof EditorialMasthead>,
  'eyebrow' | 'lead' | 'display' | 'intro'
>;
const props = Astro.props as Props;
---

<EditorialMasthead {...props} layout="uniform" maxWidth="900px" editablePrefix="" />
