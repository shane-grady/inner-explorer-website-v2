// Ported from `0c8cac2:src/pages/about.astro`. Its description's "A 501(c)(3) nonprofit." was
// dropped: the board's 2025 hybrid structure makes Inner Explorer, Inc. a company
// (tasks/todo.md › About).
const base = new URL(Astro.site ?? MAIN_SITE).origin;
const aboutLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: content.title,
  url: `${base}/about/`,
  description: content.description,
  mainEntity: {
    '@type': 'Organization',
    name: 'Inner Explorer',
    url: base,
    logo: `${base}/logo.png`,
    foundingDate: '2011',
    description: 'Daily audio-guided mindfulness practices for PreK-12 schools.',
    founder: [
      { '@type': 'Person', name: 'Dr. Laura Bakosh' },
      { '@type': 'Person', name: 'Janice Houlihan' },
    ],
  },
};
---

<PageLayout title={content.title} description={content.description}>
  <JsonLd slot="head" schema={aboutLd} />

  <Section spacing="hero" as="div">
    <div class="grid gap-8 xl:grid-cols-2 xl:items-center xl:gap-20">
      <PageTitle eyebrow={content.hero.eyebrow} title={content.hero.title} lead={content.hero.lead}>
        <Fragment slot="actions">
          <Button href={content.hero.primary.href} arrow>{content.hero.primary.label}</Button>
          <Button variant="secondary" href={content.hero.secondary.href}>
            {content.hero.secondary.label}
          </Button>
        </Fragment>
      </PageTitle>
      <div class="relative flex flex-col">
        <Image
          class="h-70 w-full rounded-sm object-cover xl:h-150"
          style="object-position: 40% 40%"
          src={content.hero.image.src}
          alt={content.hero.image.alt}
          width={1120}
          densities={[1, 2]}
          loading="eager"
        />
        <dl
          class="relative m-0 mx-3 -mt-10 flex flex-col gap-3 rounded-sm bg-surface px-5 py-4 shadow-floating xl:absolute xl:inset-x-6 xl:bottom-6 xl:m-0 xl:flex-row xl:justify-between xl:gap-4 xl:px-6 xl:py-5"
        >
          {
            content.hero.facts.map((fact) => (
              <div class="flex items-baseline justify-between gap-3 xl:flex-col xl:items-start xl:justify-start xl:gap-1">
                <dt class="type-eyebrow text-foreground">{fact.label}</dt>
                <dd class="m-0 type-card-title-sm text-foreground">{fact.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="white" spacing="strip" aria-labelledby="partners-title">
    <h2
      id="partners-title"
      class="m-0 mx-auto max-w-measure-title text-center type-section-title text-foreground"
    >
      {content.partners.title}
    </h2>
    <LogoStrip
      class="mt-9 md:mt-12"
      layout="wall"
      label={content.partners.supporters.label}
      partners={content.partners.supporters.items}
    />
    <LogoStrip
      class="mt-9 md:mt-20"
      layout="wall"
      cell="sm"
      label={content.partners.press.label}
      partners={content.partners.press.items}
    />
  </Section>

  <Section aria-labelledby="journey-title">
    <div class="flex flex-col gap-8 xl:flex-row-reverse xl:items-start xl:gap-24">
      <div class="flex flex-col xl:w-130 xl:shrink-0">
        <p class="m-0 mb-4 type-eyebrow text-foreground md:mb-6">{content.journey.eyebrow}</p>
        <h2 id="journey-title" class="m-0 type-section-title text-foreground">
          {content.journey.title}
        </h2>
        <p class="m-0 mt-5 type-lead text-foreground-secondary md:mt-6">{content.journey.lead}</p>
        <div class="mt-6 flex flex-col gap-4 border-t border-border pt-6 md:mt-8 md:pt-8">
          {
            content.journey.body.map((paragraph) => (
              <p class="m-0 type-body text-foreground-body">{paragraph}</p>
            ))
          }
        </div>
      </div>
      <div class="flex min-w-0 flex-1 flex-col gap-2">
        {
          content.journey.photos.map((photo) => (
            <Image
              class:list={['w-full rounded-sm object-cover', photo.height]}
              style={`object-position: ${photo.position}`}
              src={photo.src}
              alt={photo.alt}
              width={1168}
              densities={[1, 2]}
            />
          ))
        }
      </div>
    </div>
    <div class="mt-8 grid gap-2 md:mt-14 md:grid-cols-2 md:gap-4">
      {
        content.journey.entities.map((entity) => (
          <article
            class="ie-card flex flex-col gap-3 bg-brand-surface px-6 py-7 md:gap-4 md:p-10"
            data-on-brand
          >
            <p class="m-0 type-eyebrow text-foreground">{entity.label}</p>
            <h3 class="m-0 type-card-title-lg text-foreground">{entity.name}</h3>
            <p class="m-0 type-body text-foreground">{entity.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section tone="white" aria-labelledby="beliefs-title">
    <h2 id="beliefs-title" class="m-0 type-section-title text-foreground">
      {content.beliefs.title}
    </h2>
    <div class="mt-7 grid gap-card-gap md:mt-14 lg:grid-cols-3">
      {
        content.beliefs.items.map((item) => (
          <article
            class="ie-card flex flex-col gap-3 bg-brand-surface p-6 md:gap-4 md:p-8"
            data-on-brand
          >
            <p class="m-0 type-eyebrow text-foreground">{item.number}</p>
            <h3 class="m-0 type-card-title-md text-foreground">{item.title}</h3>
            <p class="m-0 type-body text-foreground">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section class="xl:py-30" aria-labelledby="research-title">
    <div class="grid gap-7 xl:grid-cols-2 xl:items-center xl:gap-24">
      <div class="flex flex-col">
        <p class="m-0 mb-4 type-eyebrow text-brand-emphasis md:mb-6">{content.research.eyebrow}</p>
        <h2 id="research-title" class="m-0 type-section-title-sm text-foreground">
          {content.research.title}
        </h2>
        <p
          class="m-0 mt-5 max-w-measure-narrow type-lead text-foreground-body md:mt-6 xl:type-intro"
        >
          {content.research.lead}
        </p>
        <div class="mt-7 flex flex-col md:mt-8 md:flex-row">
          <Button variant="secondary" href={content.research.cta.href}>
            {content.research.cta.label}
          </Button>
        </div>
      </div>
      <ul class="m-0 flex list-none flex-col gap-2 p-0">
        {
          content.research.stats.map((stat) => (
            <li
              class="ie-card flex flex-col gap-2 bg-brand-surface px-6 py-7 md:flex-row md:items-center md:gap-6 md:px-8"
              data-on-brand
            >
              <p class="m-0 font-sans type-stat-sm font-bold text-foreground md:w-44 md:shrink-0">
                {stat.value}
              </p>
              <p class="m-0 type-lead leading-snug font-bold text-foreground xl:type-stat-label">
                {stat.label}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section tone="white" aria-labelledby="team-title">
    <div class="flex flex-col gap-4 md:items-center md:gap-5 md:text-center">
      <h2 id="team-title" class="m-0 max-w-measure-title type-section-title text-brand-emphasis">
        {content.team.title}
      </h2>
      <p class="m-0 max-w-measure-note type-lead text-foreground-secondary">{content.team.lead}</p>
    </div>
    <div class="mt-7 grid gap-2 md:mt-14 xl:grid-cols-2">
      {
        content.team.leaders.map((leader) => (
          <article class="ie-card ie-card-tint flex">
            <Image
              class="h-44 w-34 shrink-0 object-cover md:h-75 md:w-60"
              style="object-position: center 25%"
              src={leader.photo}
              alt={`Portrait of ${leader.name}`}
              width={480}
              densities={[1]}
            />
            <div class="flex flex-col justify-end gap-2 p-5 md:p-8">
              <p class="m-0 mb-2 type-eyebrow text-foreground">{leader.label}</p>
              <h3 class="m-0 type-card-title-lg text-foreground">{leader.name}</h3>
              <p class="m-0 type-list text-foreground-body">{leader.role}</p>
            </div>
          </article>
        ))
      }
    </div>
    <ul
      class="m-0 mt-7 grid list-none grid-cols-2 gap-x-2 gap-y-6 p-0 md:mt-14 md:grid-cols-4 xl:grid-cols-8 xl:gap-y-2"
    >
      {
        content.team.members.map((member) => (
          <li class="flex flex-col gap-3">
            <Image
              class="h-50 w-full rounded-sm object-cover xl:h-45"
              style="object-position: center 25%"
              src={member.photo}
              alt={`Portrait of ${member.name}`}
              width={340}
              densities={[1, 2]}
            />
            <div class="flex flex-col gap-1">
              <p class="m-0 type-card-title-sm text-foreground">{member.name}</p>
              <p class="m-0 type-label text-foreground-muted">{member.role}</p>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="mt-7 flex flex-col gap-5 border-t border-border pt-8 md:mt-14 md:gap-6 md:pt-12">
      <h3 class="m-0 type-card-title-lg text-foreground">{content.team.advisoryTitle}</h3>
      <ul class="m-0 grid list-none gap-card-gap p-0 md:grid-cols-2 xl:grid-cols-4">
        {
          content.team.advisors.map((advisor) => (
            <Card
              as="li"
              class="px-5 py-4 md:px-6 md:py-5"
              title={advisor.name}
              titleSize="sm"
              titleAs="h4"
            >
              {advisor.role && <p class="m-0 type-small text-foreground-muted">{advisor.role}</p>}
            </Card>
          ))
        }
      </ul>
    </div>
  </Section>

  <Section>
    <ClosingCta
      title={content.cta.title}
      lead={content.cta.lead}
      primary={content.cta.primary}
      secondary={content.cta.secondary}
      image={content.cta.image}
    />
  </Section>
</PageLayout>
