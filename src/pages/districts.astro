---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import CinematicHero from '../components/blocks/CinematicHero.astro';
import EditorialCTA from '../components/blocks/EditorialCTA.astro';
import EditorialLede from '../components/blocks/districts/EditorialLede.astro';
import DistrictTrustStrip from '../components/blocks/districts/DistrictTrustStrip.astro';
import FieldReports from '../components/blocks/districts/FieldReports.astro';
import ByTheNumbers from '../components/blocks/districts/ByTheNumbers.astro';
import DayInside from '../components/blocks/districts/DayInside.astro';
import VoicesSelector from '../components/blocks/districts/VoicesSelector.astro';
import StandardsAlignment from '../components/blocks/districts/StandardsAlignment.astro';
import CompareTable from '../components/blocks/districts/CompareTable.astro';
import FundingGuide from '../components/blocks/districts/FundingGuide.astro';
import ImplementationTimeline from '../components/blocks/districts/ImplementationTimeline.astro';
import SecurityPrivacy from '../components/blocks/districts/SecurityPrivacy.astro';
import FAQAccordion from '../components/blocks/districts/FAQAccordion.astro';

// ── Page content ────────────────────────────────────────────────────────────
//
// The copy — and every photograph — lives in src/content/pages/districts.yml (the
// `pages` collection) so CloudCannon can read and write it. Only the copy moved:
// the art direction, the animation, and the JSON-LD below are still built here.
// Photography is stand-ins reused from the About page; see tasks/todo.md.
// `editablePrefix` threads each block's data path down to its fields; see
// src/lib/editable.ts.

const entry = await getEntry('pages', 'districts');
if (!entry || entry.data._schema !== 'districts') {
  throw new Error('Missing or malformed src/content/pages/districts.yml');
}
const {
  hero,
  lede,
  trustStrip,
  fieldReports,
  byTheNumbers,
  dayInside,
  voices,
  standards,
  compare,
  funding,
  implementation,
  security,
  faq,
  cta,
  pageTitle,
  pageDescription,
} = entry.data;

const base = new URL(Astro.site ?? 'https://www.innerexplorer.com').origin;
const districtsLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: `${base}/districts`,
  description: pageDescription,
  audience: {
    '@type': 'EducationalAudience',
    audienceType: 'PreK-12 school district leaders',
  },
  about: {
    '@type': 'Service',
    name: 'Inner Explorer for Districts',
    provider: {
      '@type': 'Organization',
      name: 'Inner Explorer',
      url: base,
      logo: `${base}/logo.png`,
    },
  },
};
---

<PageLayout title={pageTitle} description={pageDescription} flushTop>
  <JsonLd slot="head" schema={districtsLd} />

  <div class="appearance-light">
    <CinematicHero
      eyebrow={hero.eyebrow}
      serialChips={hero.serialChips}
      headlineLines={hero.headlineLines}
      lede={hero.lede}
      primaryCta={hero.primaryCta}
      stats={hero.stats}
      image={hero.image}
      imageAlt={hero.imageAlt}
      height="tall"
      editablePrefix="hero"
    />
    <EditorialLede
      eyebrow={lede.eyebrow}
      bodyHtml={lede.bodyHtml}
      attribution={lede.attribution}
      editablePrefix="lede"
    />
    <DistrictTrustStrip
      caption={trustStrip.caption}
      districts={trustStrip.districts}
      editablePrefix="trustStrip"
    />
    <FieldReports
      eyebrow={fieldReports.eyebrow}
      title={fieldReports.title}
      intro={fieldReports.intro}
      link={fieldReports.link}
      reports={fieldReports.reports}
      editablePrefix="fieldReports"
    />
    <ByTheNumbers
      eyebrow={byTheNumbers.eyebrow}
      title={byTheNumbers.title}
      intro={byTheNumbers.intro}
      primary={byTheNumbers.primary}
      small={byTheNumbers.small}
      image={byTheNumbers.image}
      imageAlt={byTheNumbers.imageAlt}
      imageCaption={byTheNumbers.imageCaption}
      citations={byTheNumbers.citations}
      editablePrefix="byTheNumbers"
    />
    <DayInside
      eyebrow={dayInside.eyebrow}
      titleLines={dayInside.titleLines}
      intro={dayInside.intro}
      parts={dayInside.parts}
      editablePrefix="dayInside"
    />
    <VoicesSelector
      eyebrow={voices.eyebrow}
      title={voices.title}
      intro={voices.intro}
      voices={voices.voices}
      editablePrefix="voices"
    />
    <StandardsAlignment
      eyebrow={standards.eyebrow}
      titleHtml={standards.titleHtml}
      intro={standards.intro}
      competencies={standards.competencies}
      pills={standards.pills}
      editablePrefix="standards"
    />
    <CompareTable
      eyebrow={compare.eyebrow}
      titleHtml={compare.titleHtml}
      intro={compare.intro}
      shortVersion={compare.shortVersion}
      columns={compare.columns}
      rows={compare.rows}
      editablePrefix="compare"
    />
    <FundingGuide
      eyebrow={funding.eyebrow}
      titleHtml={funding.titleHtml}
      intro={funding.intro}
      funding={funding.funding}
      editablePrefix="funding"
    />
    <ImplementationTimeline
      eyebrow={implementation.eyebrow}
      titleHtml={implementation.titleHtml}
      intro={implementation.intro}
      steps={implementation.steps}
      editablePrefix="implementation"
    />
    <SecurityPrivacy
      eyebrow={security.eyebrow}
      titleHtml={security.titleHtml}
      intro={security.intro}
      items={security.items}
      awards={security.awards}
      editablePrefix="security"
    />
    <FAQAccordion
      eyebrow={faq.eyebrow}
      titleHtml={faq.titleHtml}
      intro={faq.intro}
      items={faq.items}
      editablePrefix="faq"
    />
    <EditorialCTA
      eyebrow={cta.eyebrow}
      headlineLines={cta.headlineLines}
      lede={cta.lede}
      primaryCta={cta.primaryCta}
      secondaryCta={cta.secondaryCta}
      assurances={cta.assurances}
      sideCard={cta.sideCard}
      image={cta.image}
      imageAlt={cta.imageAlt}
      editablePrefix="cta"
    />
  </div>
</PageLayout>
