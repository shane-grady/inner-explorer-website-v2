---
// /privacy-policy/ — the canonical home of Inner Explorer's privacy policy.
//
// The policy TEXT is not duplicated here. It lives in one MDX file
// (src/content/help/privacy-policy.mdx), which the Help Center also renders as an
// article, so a legal document has exactly one place to edit and the two surfaces
// cannot drift. That file's frontmatter declares
// `canonicalUrl: https://www.innerexplorer.com/privacy-policy/`, which points search
// engines here so the article does not compete with this page.
//
// The body uses the Help Center's MDX snippets by name. `components` maps <Callout> and
// <HelpTable> (the two it uses) to plain stand-ins, and every other snippet name to a
// generic one that keeps its text visible, so a CMS edit can't break this build.
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Callout from '../components/content/Callout.astro';
import HelpTable from '../components/content/HelpTable.astro';
import Snippet from '../components/content/Snippet.astro';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';
import { MAIN_SITE } from '../lib/site';

const content = {
  title: 'Privacy Policy | Inner Explorer',
  description:
    'Inner Explorer collects no student information. Read what we collect from educator accounts, how it is stored and secured, how long we keep it, and your privacy rights.',
};

const doc = await getEntry('help', 'privacy-policy');
if (!doc) {
  throw new Error('Missing src/content/help/privacy-policy.mdx (the policy source of truth)');
}
const { Content } = await render(doc);
const d = doc.data;

const components = {
  Callout,
  HelpTable,
  Accordion: Snippet,
  ActionLinks: Snippet,
  Card: Snippet,
  CardGrid: Snippet,
  HelpFigure: Snippet,
  HelpVideo: Snippet,
  LinkCards: Snippet,
  Steps: Snippet,
  Step: Snippet,
};

// ── SEO ─────────────────────────────────────────────────────────────────────

const base = new URL(Astro.site ?? MAIN_SITE).origin;
// Trailing slash: the site builds directory-style URLs, so this is the exact string
// Astro emits as this page's canonical, and the exact string the Help Center article
// declares as its own canonical. They have to agree.
const path = '/privacy-policy/';

// `WebPage`, not a "PrivacyPolicy" type — schema.org has no such type, and an invalid
// @type is exactly what a structured-data validator flags. No datePublished: the
// document states its own effective date in its opening table, and duplicating that
// date in metadata would give it a second place to go stale.
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: d.title,
  description: content.description,
  url: `${base}${path}`,
  inLanguage: 'en-US',
  publisher: organizationSchema(Astro.site),
};
const crumbLd = breadcrumbSchema(Astro.site, [
  { name: 'Home', path: '/' },
  { name: d.title, path },
]);
---

<PageLayout title={content.title} description={content.description}>
  <JsonLd schema={pageLd} slot="head" />
  <JsonLd schema={crumbLd} slot="head" />

  <article>
    <h1>{d.title}</h1>
    <p>{d.blurb}</p>
    <Content components={components} />
  </article>
</PageLayout>
