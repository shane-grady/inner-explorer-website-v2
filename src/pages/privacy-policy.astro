---
// /privacy-policy/ — the canonical home of Inner Explorer's privacy policy.
//
// The policy TEXT is not duplicated here. It lives in one MDX file
// (src/content/help/privacy-policy.mdx), which the Help Center also renders as an
// article, so a legal document has exactly one place to edit and the two surfaces
// cannot drift. That file's frontmatter declares
// `canonicalUrl: https://www.innerexplorer.com/privacy-policy/`, which points search
// engines here so the article does not compete with this page.
//
// The body uses the Help Center's MDX snippets by name. `components` gives every tag the
// body actually uses a stand-in: <Callout> and <HelpTable> have plain ones, any other
// (Steps, Accordion, a snippet added later…) gets the generic one that keeps its text
// visible. Links resolve against the article's Help Center URL. So a CMS edit to this
// shared file can't break this build or hide legal text.
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import PageTitle from '../components/ui/PageTitle.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Callout from '../components/content/Callout.astro';
import HelpTable from '../components/content/HelpTable.astro';
import Snippet from '../components/content/Snippet.astro';
import HelpLink from '../components/content/HelpLink.astro';
import { breadcrumbSchema, organizationSchema } from '../lib/schema';
import { MAIN_SITE } from '../lib/site';

const content = {
  title: 'Privacy Policy | Inner Explorer',
  description:
    'Inner Explorer collects no student information. See what we collect from educator accounts, how we store, secure and retain it, and your privacy rights.',
  // The My Bright Moments app (Bright Horizons) has its own policies; its app-store listings
  // link them, and linking them here keeps them reachable on the site (2026-11-03).
  appPolicies: {
    label: 'My Bright Moments app policies',
    lead: 'Using the My Bright Moments app? Read its',
    privacy: { label: 'Privacy Policy', href: '/my-bright-moments/privacy-policy/' },
    and: 'and',
    terms: { label: 'Terms and Conditions', href: '/my-bright-moments/terms/' },
  },
};

const doc = await getEntry('help', 'privacy-policy');
if (!doc) {
  throw new Error('Missing src/content/help/privacy-policy.mdx (the policy source of truth)');
}
const { Content } = await render(doc);
const d = doc.data;

const usedTags = new Set([...(doc.body ?? '').matchAll(/<([A-Z][A-Za-z0-9]*)/g)].map((m) => m[1]));
const components = {
  ...Object.fromEntries([...usedTags].map((tag) => [tag, Snippet])),
  Callout,
  HelpTable,
  a: HelpLink,
};

// ── SEO ─────────────────────────────────────────────────────────────────────

const base = new URL(Astro.site ?? MAIN_SITE).origin;
// Trailing slash: the site builds directory-style URLs, so this is the exact string
// Astro emits as this page's canonical, and the exact string the Help Center article
// declares as its own canonical. They have to agree.
const path = '/privacy-policy/';

// `WebPage`, not a "PrivacyPolicy" type — schema.org has no such type, and an invalid
// @type is exactly what a structured-data validator flags. No datePublished: the
// document states its own effective date in its opening table, and duplicating that
// date in metadata would give it a second place to go stale.
const pageLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: d.title,
  description: content.description,
  url: `${base}${path}`,
  inLanguage: 'en-US',
  publisher: organizationSchema(Astro.site),
};
const crumbLd = breadcrumbSchema(Astro.site, [
  { name: 'Home', path: '/' },
  { name: d.title, path },
]);
---

<PageLayout title={content.title} description={content.description}>
  <JsonLd schema={pageLd} slot="head" />
  <JsonLd schema={crumbLd} slot="head" />

  <Section spacing="hero" as="div">
    <article>
      <PageTitle title={d.title} lead={d.blurb} />
      <div class="ie-prose mt-8 max-w-measure-article type-article-body md:mt-12">
        <Content components={components} />
      </div>
      <aside
        aria-label={content.appPolicies.label}
        class="ie-prose mt-12 max-w-measure-article border-t border-border pt-8 type-article-body"
      >
        <p>
          {content.appPolicies.lead}{' '}
          <a href={content.appPolicies.privacy.href}>{content.appPolicies.privacy.label}</a>{' '}
          {content.appPolicies.and}{' '}
          <a href={content.appPolicies.terms.href}>{content.appPolicies.terms.label}</a>.
        </p>
      </aside>
    </article>
  </Section>
</PageLayout>
