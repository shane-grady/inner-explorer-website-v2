                </g>
              </g>
              <g
                clip-path="url(#brain-clip)"
                fill="none"
                class="stroke-border-control"
                stroke-opacity="0.4"
                stroke-width="1.6"
                stroke-linecap="round"
              >
                <path d="M 166 206 C 206 192 250 182 300 160 C 322 150 340 150 356 156"></path>
                <path
                  d="M 278 34 C 266 52 284 66 272 84 C 262 100 278 114 266 132 C 256 148 266 160 254 174"
                ></path>
                <path d="M 246 40 C 236 58 252 70 240 88 C 230 104 244 118 232 136"></path>
                <path d="M 308 42 C 296 60 314 74 302 92 C 292 108 306 120 296 138"></path>
                <path d="M 124 150 C 142 138 160 146 176 132 C 190 120 206 124 218 112"></path>
                <path d="M 132 108 C 150 96 168 104 182 90 C 194 80 208 84 220 74"></path>
                <path d="M 116 186 C 130 178 146 184 160 176"></path>
                <path d="M 322 70 C 340 84 360 78 378 94 C 394 108 410 104 424 120"></path>
                <path d="M 318 118 C 338 110 356 122 374 116 C 392 110 408 122 426 142"></path>
                <path d="M 346 168 C 364 160 384 168 404 162 C 418 158 428 166 436 176"></path>
                <path d="M 190 236 C 224 226 262 222 296 212 C 314 206 326 206 340 210"></path>
                <path d="M 204 254 C 232 248 262 246 290 238"></path>
                <path d="M 364 196 C 380 186 398 192 414 184"></path>
                <path d="M 196 60 C 208 72 222 66 232 56"></path>
              </g>
              <path
                d="M 104 178 C 90 128 118 80 170 56 C 218 34 286 28 342 44 C 396 60 438 100 444 150 C 448 184 430 208 402 216 C 374 222 352 226 330 234 C 306 246 280 262 244 264 C 206 266 172 254 154 230 C 146 220 150 208 166 204 C 146 206 116 200 104 178 Z"
                fill="none"
                class="stroke-on-brand-muted"
                stroke-opacity="0.92"
                stroke-width="2.2"
                stroke-linejoin="round"></path>
              <g data-brain-only="stressed">
                <circle
                  cx="214"
                  cy="226"
                  r="14"
                  fill="none"
                  class="ie-brain-pulse stroke-coral-300"
                  stroke-width="1.6"
                  filter="url(#brain-ring)"></circle>
                <circle
                  cx="214"
                  cy="226"
                  r="13"
                  class="fill-coral-300"
                  opacity="0.35"
                  filter="url(#brain-ring)"></circle>
                <circle cx="214" cy="226" r="7" class="fill-coral-300"></circle>
                <circle cx="142" cy="110" r="6" class="fill-border-control" opacity="0.55"></circle>
              </g>
              <g data-brain-only="mindful">
                <circle cx="214" cy="226" r="7" class="fill-border-control" opacity="0.55"></circle>
                <circle
                  cx="142"
                  cy="110"
                  r="12"
                  class="fill-green-300"
                  opacity="0.35"
                  filter="url(#brain-ring)"></circle>
                <circle cx="142" cy="110" r="6" class="fill-green-300"></circle>
              </g>
              <path
                d="M 138 106 L 84 62 L 18 62"
                fill="none"
                class="stroke-on-brand-muted"
                stroke-opacity="0.45"
                stroke-width="1"></path>
              <text
                x="18"
                y="37"
                font-size="15"
                font-weight="700"
                class="fill-on-brand-muted"
                data-brain-only="stressed">{brain.pfc.name}</text
              >
              <text
                x="18"
                y="37"
                font-size="15"
                font-weight="700"
                class="fill-on-brand-accent"
                data-brain-only="mindful">{brain.pfc.name}</text
              >
              <text x="18" y="55" font-size="13" font-weight="500" class="fill-border-control"
                >{brain.pfc.role}</text
              >
              <path
                d="M 210 233 L 190 292 L 104 292"
                fill="none"
                class="stroke-on-brand-muted"
                stroke-opacity="0.45"
                stroke-width="1"></path>
              <text
                x="104"
                y="309"
                font-size="15"
                font-weight="700"
                class="fill-coral-300"
                data-brain-only="stressed">{brain.amygdala.name}</text
              >
              <text
                x="104"
                y="309"
                font-size="15"
                font-weight="700"
                class="fill-on-brand-muted"
                data-brain-only="mindful">{brain.amygdala.name}</text
              >
              <text x="104" y="327" font-size="13" font-weight="500" class="fill-border-control"
                >{brain.amygdala.role}</text
              >
            </svg>
          </div>
          <div
            class="ie-segmented ie-segmented-on-brand lg:w-86"
            role="group"
            aria-label={brain.group}
            hidden
            data-brain-switch
          >
            <button
              type="button"
              class="group"
              aria-pressed="true"
              data-alarm
              data-brain-set="stressed"
            >
              <span
                class="size-2 rounded-full bg-coral-600 group-aria-pressed:bg-on-brand"
                aria-hidden="true"></span>{brain.stressed.label}
            </button>
            <button type="button" class="group" aria-pressed="false" data-brain-set="mindful">
              <span
                class="size-2 rounded-full bg-green-300 group-aria-pressed:bg-on-brand"
                aria-hidden="true"></span>{brain.mindful.label}
            </button>
          </div>
        </div>
      </div>

      <button
        type="button"
        class="ie-chip absolute right-5 bottom-5 border-border-on-brand bg-brand-surface-deep text-on-brand lg:right-8 lg:bottom-7"
        hidden
        data-motion-toggle
      >
        <span class="inline-flex items-center gap-2" data-motion-when="playing">
          <Icon name="pause" size={16} />{hero.pause}
        </span>
        <span class="inline-flex items-center gap-2" data-motion-when="paused" hidden>
          <Icon name="play" size={16} />{hero.play}
        </span>
      </button>
    </section>

    <Section tone="forest" class="border-t border-on-brand-wash lg:py-30">
      <div class="grid items-end gap-8 lg:flex lg:gap-18">
        <p class="m-0 type-section-title tracking-tight text-balance text-foreground lg:basis-7/12">
          {statement.text}
        </p>
        <div class="flex flex-col lg:basis-5/12">
          <p class="m-0 max-w-115 type-lead text-foreground-secondary">{statement.lead}</p>
          <ArrowLink
            href={statement.link.href}
            light
            icon="arrow-down"
            class="mt-2 self-start text-on-brand-accent"
          >
            {statement.link.label}
          </ArrowLink>
        </div>
      </div>
    </Section>

    {/* Explore: three jump cards. */}
    <Section id="explore" aria-labelledby="explore-title" class="lg:pb-24">
      <p class="m-0 type-eyebrow text-brand-emphasis">{explore.eyebrow}</p>
      <h2 id="explore-title" class="m-0 mt-4 type-section-title text-foreground lg:type-page-title">
        {explore.title}
      </h2>
      <nav aria-label={explore.nav} class="mt-7 lg:mt-12">
        <ul class="m-0 grid list-none gap-2 p-0 lg:grid-cols-3 lg:gap-4">
          {
            explore.items.map((item) => (
              <li class="ie-card ie-card-raised flex gap-3 p-4 lg:min-h-65 lg:flex-col lg:gap-0 lg:p-7">
                <span class="w-8 shrink-0 pt-0.5 type-small font-bold text-brand-emphasis tabular-nums lg:w-auto lg:pt-0">
                  {item.number}
                </span>
                <div class="flex min-w-0 grow flex-col lg:mt-5">
                  <h3 class="m-0 type-card-title-md text-foreground lg:type-card-title-lg">
                    <a class="ie-card-link" href={item.href}>
                      {item.title}
                    </a>
                  </h3>
                  <p class="m-0 mt-1 type-label text-foreground-body lg:mt-3 lg:type-list">
                    {item.text}
                  </p>
                  <span
                    class="mt-3 inline-flex items-center gap-2 type-label font-bold text-brand-emphasis lg:mt-auto lg:pt-6 lg:type-small lg:font-bold"
                    aria-hidden="true"
                  >
                    {explore.jump}
                    <Icon name="arrow-down" size={16} />
                  </span>
                </div>
              </li>
            ))
          }
        </ul>
      </nav>
    </Section>

    {/* 01 The evidence. */}
    <Section id="evidence" tone="white" aria-labelledby="evidence-title">
      <div class="grid gap-5 lg:flex lg:items-end lg:gap-18">
        <div class="lg:basis-7/12">
          <p class="m-0 flex items-center gap-2.5 type-eyebrow text-brand-emphasis">
            <span>{evidence.number}</span>
            <span class="h-px w-6 bg-current opacity-50" aria-hidden="true"></span>
            {evidence.eyebrow}
          </p>
          <h2
            id="evidence-title"
            class="m-0 mt-4 type-section-title text-foreground lg:type-page-title"
          >
            {evidence.title}
          </h2>
          <p class="m-0 mt-5">
            <span class="ie-tag bg-brand-subtle type-tag text-on-brand-subtle">
              <FeatureIcon name="check-circle" size={16} class="text-brand-emphasis" />
              {evidence.badge}
            </span>
          </p>
        </div>
        <p class="m-0 type-intro text-foreground-body lg:basis-5/12">{evidence.lead}</p>
      </div>

      <div class="mt-12 lg:mt-18">
        <h3 class="m-0 type-card-title-lg text-foreground">{evidence.outcomes.title}</h3>
        <p class="m-0 mt-2 max-w-measure-wide type-body text-foreground-body">
          {evidence.outcomes.lead}
        </p>
        <div class="mt-6 grid gap-3 lg:mt-8 lg:grid-cols-3 lg:gap-4">
          {
            evidence.outcomes.groups.map((group) => (
              <article class="ie-card ie-card-raised flex flex-col p-5 lg:p-8">
                <p class="m-0 type-eyebrow text-foreground">{group.eyebrow}</p>
                <h4 class="m-0 mt-3 type-card-title-md text-balance text-foreground">
                  {group.title}
                </h4>
                <p class="m-0 mt-2 mb-4 type-small text-foreground-body lg:mt-3 lg:mb-6">
                  {group.text}
                </p>
                <ul class="m-0 mb-auto list-none p-0">
                  {group.claims.map((claim) => (
                    <li class="flex items-center gap-2.5 border-t border-border py-3.5">
                      <Icon name="check-circle" size={22} class="text-icon-accent" />
                      <span class="flex flex-col gap-0.5">
                        <span class="type-card-title-sm text-foreground">{claim.text}</span>
                        <a
                          class="inline-flex items-center gap-1 self-start type-label text-brand-emphasis"
                          href={claim.href}
                        >
                          {claim.cite}
                          <Icon name="arrow-down" size={12} />
                        </a>
                      </span>
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </div>

      <div
        class="mt-12 flex flex-col gap-4 lg:mt-20 lg:flex-row lg:items-end lg:justify-between lg:gap-8"
      >
        <div>
          <h3 class="m-0 type-card-title-lg text-foreground">{evidence.studies.title}</h3>
          <p class="m-0 mt-2 type-body text-foreground-body">{evidence.studies.lead}</p>
          <ul class="m-0 mt-4 flex list-none flex-wrap gap-x-5 gap-y-2 p-0">
            {
              evidence.studies.legend.map((key) => (
                <li class="inline-flex items-center gap-2 type-label text-foreground-secondary">
                  <span class:list={['ie-swatch', TONE_SWATCH[key.tone]]} aria-hidden="true" />
                  {key.label}
                </li>
              ))
            }
          </ul>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-3 lg:gap-3.5" data-work-prompt hidden>
          <span class="type-small text-foreground-body">{evidence.studies.prompt}</span>
          <button
            type="button"
            class="ie-chip"
            role="switch"
            aria-checked="false"
            data-work-switch="evidence"
          >
            Show our work<span class="ie-switch-track" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <p
        class="m-0 mt-6 flex items-center justify-end gap-2 type-label font-bold text-brand-emphasis md:hidden"
        aria-hidden="true"
      >
        {evidence.studies.swipe}
        <Icon name="arrow-right" size={16} />
      </p>
      <ul
        class="-mx-section-x mt-3 flex snap-x snap-mandatory scroll-px-section-x list-none gap-3 overflow-x-auto px-section-x pb-4 md:mx-0 md:mt-8 md:grid md:grid-cols-2 md:overflow-visible md:px-0 md:pb-0 lg:grid-cols-3 lg:gap-4"
        aria-label={evidence.studies.title}
      >
        {
          evidence.studies.items.map((study) => (
            <li class="flex w-72 shrink-0 snap-start md:w-auto">
              <EvidenceCard
                id={`study-${study.id}`}
                aria-label={study.title}
                class="grow"
                tag={study.tag}
