          <div class="grid gap-4 border-t border-border pt-5 md:grid-cols-2 md:gap-8">
            {
              evidence.review.lists.map((list) => (
                <div>
                  <p class="m-0 mb-2.5 type-breadcrumb text-on-brand-accent">{list.title}</p>
