        </div>
        <figure
          class="ie-card ie-card-floating m-0 flex flex-col gap-6 p-5 lg:basis-7/12 lg:p-8"
          data-wall
        >
          <div
            class="ie-segmented"
            role="group"
            aria-label={science.wall.group}
            hidden
            data-wall-switch
          >
            <button type="button" aria-pressed="true" data-wall-set="sand">
              {science.wall.sand.label}
            </button>
            <button type="button" aria-pressed="false" data-wall-set="foundation">
              {science.wall.foundation.label}
            </button>
          </div>
          {
            (['sand', 'foundation'] as const).map((state) => (
              <div
                class="relative h-65"
                role="img"
                aria-label={science.wall[state].alt}
                hidden={state === 'foundation'}
                data-wall-figure={state}
              >
                <div class="grid grid-cols-3 gap-x-3 gap-y-2 px-1 pt-9.5">
                  {wallBlocks.map((block) => (
                    <div
                      class="ie-wall-block relative flex h-18 items-center justify-center rounded-sm border border-border-control bg-surface px-2 text-center type-label leading-tight font-bold text-foreground-secondary shadow-raised md:px-3.5 md:type-small md:leading-snug md:font-bold"
                      style={
                        state === 'sand'
                          ? `--dx: ${block.dx}px; --dy: ${block.dy}px; --tilt: ${block.tilt}deg`
                          : undefined
                      }
                    >
                      {state === 'sand' && block.crack && (
                        <svg
                          viewBox="0 0 100 40"
                          preserveAspectRatio="none"
                          class="absolute inset-0 size-full"
                          aria-hidden="true"
                        >
                          <polyline
                            points={
                              block.crack === 'start'
                                ? '6,0 10,12 5,22 9,40'
                                : '94,0 89,14 95,24 90,40'
                            }
                            fill="none"
                            class="stroke-coral-600"
                            stroke-width="2"
                            vector-effect="non-scaling-stroke"
