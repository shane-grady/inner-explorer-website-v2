    </Section>

    {/* 03 A fair question. */}
    <Section id="questions" aria-labelledby="objection-title">
      <div class="grid gap-10 lg:flex lg:items-center lg:gap-18">
        <div class="flex flex-col items-start lg:basis-5/12">
          <p class="m-0 flex items-center gap-2.5 type-eyebrow text-brand-emphasis">
            <span>{questions.number}</span>
            <span class="h-px w-6 bg-current opacity-50" aria-hidden="true"></span>
            {questions.eyebrow}
          </p>
          <h2 id="objection-title" class="m-0 mt-4 type-section-title text-foreground">
            {questions.title}
          </h2>
          <p class="m-0 mt-6 max-w-140 type-lead font-bold text-foreground">{questions.lead}</p>
          <div class="mt-7 flex flex-wrap items-center gap-3.5" data-work-prompt hidden>
            <span class="type-small text-foreground-body">{questions.prompt}</span>
            <button
              type="button"
              class="ie-chip"
              role="switch"
              aria-checked="false"
              data-work-switch="questions"
            >
              Show our work<span class="ie-switch-track" aria-hidden="true"></span>
            </button>
          </div>
          <p class="m-0 mt-5 max-w-140 type-body text-foreground-body" data-work="questions">
            {questions.more}<sup class="ml-0.5 font-bold"
              ><a class="text-brand-emphasis no-underline" href={`#cite-${questions.moreCite}`}
                >{questions.moreCite}</a
              ></sup
            >
          </p>
          <Button
            variant="secondary"
            href={questions.cta.href}
            arrow
            block
            class="mt-7 md:w-auto lg:mt-8"
          >
            {questions.cta.label}
          </Button>
        </div>
        <figure class="ie-card ie-card-floating m-0 flex flex-col gap-6 p-5 lg:basis-7/12 lg:p-9">
          {
            questions.dose.series.map((series, s) => (
              <>
                {s > 0 && <div class="h-px bg-border" aria-hidden="true" />}
                <div class="flex flex-col gap-1.5">
                  <span class="inline-flex items-center gap-2 type-small leading-tight font-bold text-foreground-secondary">
                    <span class:list={['size-2 rounded-full', DOSE_DOT[series.tone]]} />
                    {series.name}
                    {'cite' in series && (
                      <sup>
                        <a class="text-brand-emphasis no-underline" href={`#cite-${series.cite}`}>
                          {series.cite}
                        </a>
                      </sup>
                    )}
                  </span>
                  <span
                    class:list={[
                      'type-section-title font-black tracking-tight',
                      series.tone === 'brand' ? 'text-brand-emphasis' : 'text-foreground',
                    ]}
                  >
                    {series.title}
                  </span>
                  <span class="type-small text-foreground-body">{series.text}</span>
                  {[18, 36].map((columns) => {
                    const grid = waffle(columns, series.practiced);
                    return (
                      <svg
                        viewBox={`0 0 ${grid.width} ${grid.height}`}
                        width={grid.width}
                        height={grid.height}
                        class:list={[
                          'mt-2.5 h-auto max-w-full',
                          columns === 36 ? 'hidden md:block' : 'block md:hidden',
                        ]}
                        role="img"
                        aria-label={series.alt}
                      >
                        {grid.days.map((day) =>
                          day.practiced ? (
                            <rect
                              x={day.x}
                              y={day.y}
                              width="13"
                              height="13"
                              rx="2"
                              class={DOSE_FILL[series.tone]}
                            />
                          ) : (
                            <rect
                              x={day.x + 0.5}
                              y={day.y + 0.5}
                              width="12"
                              height="12"
                              rx="2"
                              class="fill-surface stroke-border-input"
                              stroke-width="1"
                            />
                          ),
                        )}
                      </svg>
                    );
                  })}
                </div>
              </>
            ))
          }
          <figcaption class="type-label text-foreground-muted">{questions.dose.caption}</figcaption>
        </figure>
      </div>
    </Section>

    {/* The AI moment. */}
    <Section id="ai" tone="forest" aria-labelledby="ai-title">
      <p class="m-0 type-eyebrow text-on-brand-accent">{ai.eyebrow}</p>
      <h2 id="ai-title" class="m-0 mt-4 type-section-title text-foreground lg:type-page-title">
        {ai.title[0]}<br />{ai.title[1]}
      </h2>
      <div
        class="mt-10 grid gap-8 border-t border-border pt-12 lg:mt-14 lg:flex lg:items-start lg:gap-18"
      >
        <div class="flex flex-col items-start lg:basis-5/12">
          <p class="m-0 type-intro leading-relaxed text-foreground-secondary">{ai.text}</p>
          <Button
            variant="light"
