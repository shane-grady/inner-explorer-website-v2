        name: 'Maximizing mindful learning: An innovative mindful awareness intervention improves elementary students’ quarterly grades',
        authors: ['L. Bakosh', 'R. Snow', 'J. Houlihan', 'J. Tobias', 'C. Barbosa-Leiker'],
        year: '2016',
        periodical: 'Mindfulness',
      },
      {
        id: 'S2',
        name: 'Audio-guided mindfulness training in schools and its salutary effect on school attainment: Contributing to theory, practice, and policy',
        authors: ['L. Bakosh', 'J. Houlihan', 'J. Tobias'],
        year: '2018',
        periodical: 'Learning & Instruction',
      },
      {
        id: 'S3',
        name: 'A randomized controlled trial of a brief daily mindfulness intervention in 39 Head Start classrooms',
        authors: ['L. Lopez'],
        year: '2020',
        publisher: 'University of South Florida',
      },
      {
        id: 'S4',
        name: 'Determining the degree to which active use of mindfulness with elementary students affects their annual state test scores in math',
        authors: ['A. Stager'],
        year: '2022',
        publisher: 'University of La Verne',
      },
      {
        id: 'S5',
        name: 'An analysis of the impact of the Inner Explorer mindfulness program on academic growth of elementary students',
        authors: ['R. Dunlap'],
        year: '2023',
        publisher: 'University of North Carolina at Charlotte',
      },
      {
        id: 'S6',
        name: 'At-home use of app-based mindfulness for children: A randomized active-controlled trial',
        authors: ['I. Treves'],
        year: '2023',
        periodical: 'Mindfulness',
      },
      {
        id: 'S7',
        name: 'Mindfulness-based school interventions: A systematic review of outcome evidence quality by study design',
        authors: ['M. L. Phan', 'T. L. Renshaw', 'H. J. Nuske'],
        year: '2022',
        periodical: 'Mindfulness',
      },
    ],
  },
} as const;

const TONE_SWATCH = { emerald: 'text-brand-emphasis', vibrant: 'text-icon-accent' } as const;
const TILE = {
  cyan: 'bg-cyan-200',
  green: 'bg-green-100',
  yellow: 'bg-yellow-200',
  orange: 'bg-orange-200',
  tint: 'bg-tint',
} as const;

// The dose waffles: 180 days, 13px squares on a 16px pitch, 36 a row from md and 18 below.
const DAYS = 180;
const waffle = (columns: number, practiced: readonly number[] | 'all') => ({
  width: columns * 16 - 3,
  height: Math.ceil(DAYS / columns) * 16 - 3,
  days: Array.from({ length: DAYS }, (_, i) => ({
    x: (i % columns) * 16,
    y: Math.floor(i / columns) * 16,
    practiced: practiced === 'all' || practiced.includes(i),
  })),
});
const DOSE_FILL = { alarm: 'fill-coral-600', brand: 'fill-brand' } as const;
const DOSE_DOT = { alarm: 'bg-coral-600', brand: 'bg-icon-accent' } as const;

interface Citation {
  id: string;
  text: string;
  em?: string;
  after?: string;
  href?: string;
}
interface WallBlock {
  label: string;
  dx: number;
  dy: number;
  tilt: number;
  crack?: 'start' | 'end';
}
const citationGroups: readonly { title: string; items: readonly Citation[] }[] =
  content.citations.groups;
const wallBlocks: readonly WallBlock[] = content.science.wall.blocks;
const citationUrl = (id: string) =>
  citationGroups.flatMap((g) => g.items).find((c) => c.id === id)?.href;

const base = new URL(Astro.site ?? MAIN_SITE).origin;
const researchLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'The Research Behind Inner Explorer',
  name: content.title,
  description: content.description,
  url: `${base}/research/`,
  inLanguage: 'en-US',
  datePublished: '2026-05-28',
  about: 'Mindfulness research in PreK–12 schools',
  publisher: {
    '@type': 'Organization',
    name: 'Inner Explorer',
    url: base,
    logo: `${base}/logo.png`,
  },
  citation: content.citations.studies.map((study) => ({
    '@type': 'ScholarlyArticle',
    name: study.name,
    author: study.authors.map((name) => ({ '@type': 'Person', name })),
    datePublished: study.year,
    ...('periodical' in study
      ? { isPartOf: { '@type': 'Periodical', name: study.periodical } }
      : { publisher: { '@type': 'Organization', name: study.publisher } }),
    ...(citationUrl(study.id) ? { url: citationUrl(study.id) } : {}),
  })),
};

const { hero, statement, explore, evidence, science, questions, ai, cta, citations } = content;
const { brain } = hero;
---

<PageLayout title={content.title} description={content.description} header="dark">
  <JsonLd slot="head" schema={researchLd} />

  <div data-research>
    {/* Hero: the line-art brain over dimmed neuron footage, under the dark header. */}
    <section
      aria-labelledby="hero-title"
      class="relative overflow-hidden bg-brand-surface-deep px-section-x pt-(--header-height-mobile) xl:pt-(--header-height)"
      data-on-brand
    >
      <Image
        src={neurons}
        alt=""
        class="absolute inset-0 size-full object-cover opacity-26"
        loading="eager"
      />
      <video
        class="absolute inset-0 size-full object-cover opacity-26"
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
        data-hero-video
      >
        <source src={hero.video} type="video/mp4" />
      </video>
      <div class="ie-hero-scrim absolute inset-0" aria-hidden="true"></div>
      <div class="ie-hero-scrim-figure absolute inset-0" aria-hidden="true"></div>

      <div
        class="relative mx-auto grid max-w-page items-center gap-7 pt-8 pb-22 lg:min-h-205 lg:grid-cols-2 lg:gap-12 lg:pt-10 lg:pb-24"
      >
        <div class="flex min-w-0 flex-col">
          <h1 id="hero-title" class="m-0 type-page-title text-foreground">
            {hero.title[0]}<br />{hero.title[1]}<br />{hero.title[2]}{' '}
            <span class="text-green-300"
              ><span class="relative inline-block pb-4.5"
                >{hero.emphasis}<span
                  class="ie-accent-bar absolute inset-x-0 bottom-0"
                  aria-hidden="true"></span></span
              >.</span
            >
          </h1>
          <p class="m-0 mt-7 max-w-135 type-lead-lg text-balance text-foreground-secondary">
            {hero.lead}
          </p>
          <div class="mt-7 flex flex-col gap-3 md:flex-row lg:mt-10">
            <Button href={hero.primary.href} arrow>{hero.primary.label}</Button>
            <Button variant="ghost" href={hero.secondary.href}>{hero.secondary.label}</Button>
          </div>
        </div>

        <div class="flex min-w-0 flex-col items-center gap-7">
          <div class="w-full max-w-87.5 lg:max-w-150" data-brain="stressed">
            <svg
              viewBox="0 0 520 344"
              class="block h-auto w-full overflow-visible font-sans"
              role="img"
              aria-label={brain.stressed.alt}
              data-brain-figure
              data-alt-stressed={brain.stressed.alt}
              data-alt-mindful={brain.mindful.alt}
            >
              <defs>
                <clipPath id="brain-clip">
                  <path
                    d="M 104 178 C 90 128 118 80 170 56 C 218 34 286 28 342 44 C 396 60 438 100 444 150 C 448 184 430 208 402 216 C 374 222 352 226 330 234 C 306 246 280 262 244 264 C 206 266 172 254 154 230 C 146 220 150 208 166 204 C 146 206 116 200 104 178 Z"
                  ></path>
                </clipPath>
                <radialGradient id="brain-pfc" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0" class="ie-stop-leaf" stop-opacity="1"></stop>
                  <stop offset="0.2" class="ie-stop-leaf" stop-opacity="0.82"></stop>
                  <stop offset="0.45" class="ie-stop-leaf" stop-opacity="0.42"></stop>
                  <stop offset="0.7" class="ie-stop-leaf" stop-opacity="0.14"></stop>
                  <stop offset="1" class="ie-stop-leaf" stop-opacity="0"></stop>
                </radialGradient>
                <radialGradient id="brain-amy" cx="0.5" cy="0.5" r="0.5">
                  <stop offset="0" class="ie-stop-alarm" stop-opacity="1"></stop>
                  <stop offset="0.2" class="ie-stop-alarm" stop-opacity="0.8"></stop>
                  <stop offset="0.45" class="ie-stop-alarm-fade" stop-opacity="0.4"></stop>
                  <stop offset="0.7" class="ie-stop-alarm-fade" stop-opacity="0.12"></stop>
                  <stop offset="1" class="ie-stop-alarm-fade" stop-opacity="0"></stop>
                </radialGradient>
                <filter
                  id="brain-soft"
                  x="-50%"
                  y="-50%"
                  width="200%"
                  height="200%"
                  color-interpolation-filters="sRGB"
                >
                  <feGaussianBlur stdDeviation="8"></feGaussianBlur>
                </filter>
                <filter id="brain-ring" x="-50%" y="-50%" width="200%" height="200%">
                  <feGaussianBlur stdDeviation="1.2"></feGaussianBlur>
                </filter>
              </defs>
              <path
                d="M 290 254 C 300 276 304 298 300 330 C 310 336 322 336 330 330 C 326 302 328 276 334 248 Z"
                class="fill-green-800 stroke-on-brand-muted"
                stroke-opacity="0.6"
                stroke-width="2"
                stroke-linejoin="round"></path>
              <path
                d="M 326 232 C 334 258 364 276 398 272 C 430 268 446 244 436 220 C 428 204 410 206 392 214 C 370 222 346 226 326 232 Z"
                class="fill-green-800 stroke-on-brand-muted"
                stroke-opacity="0.75"
                stroke-width="2"
                stroke-linejoin="round"></path>
              <g
                fill="none"
                class="stroke-on-brand-muted"
                stroke-opacity="0.35"
                stroke-width="1.5"
                stroke-linecap="round"
              >
                <path d="M 338 246 C 362 250 398 250 430 236"></path>
                <path d="M 346 258 C 370 262 404 260 432 248"></path>
                <path d="M 360 268 C 384 272 410 268 428 258"></path>
              </g>
              <path
                d="M 104 178 C 90 128 118 80 170 56 C 218 34 286 28 342 44 C 396 60 438 100 444 150 C 448 184 430 208 402 216 C 374 222 352 226 330 234 C 306 246 280 262 244 264 C 206 266 172 254 154 230 C 146 220 150 208 166 204 C 146 206 116 200 104 178 Z"
                class="fill-green-800"></path>
              <g clip-path="url(#brain-clip)">
                <g data-brain-only="stressed">
                  <ellipse
                    cx="160"
                    cy="118"
                    rx="120"
                    ry="104"
                    fill="url(#brain-pfc)"
                    filter="url(#brain-soft)"
                    opacity="0.08"></ellipse>
                  <circle
                    cx="214"
                    cy="226"
                    r="58"
                    fill="url(#brain-amy)"
                    filter="url(#brain-soft)"
                    opacity="1"></circle>
                </g>
                <g data-brain-only="mindful">
                  <ellipse
                    cx="160"
                    cy="118"
                    rx="120"
                    ry="104"
                    fill="url(#brain-pfc)"
                    filter="url(#brain-soft)"
                    opacity="0.62"></ellipse>
                  <circle
                    cx="214"
                    cy="226"
                    r="26"
                    fill="url(#brain-amy)"
