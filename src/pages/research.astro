      <div class="ie-card mt-8 p-5 lg:mt-12 lg:p-12" data-work="science">
        <p class="m-0 type-eyebrow text-brand-emphasis">{science.deeper.eyebrow}</p>
        <div class="mt-6 grid gap-5 md:grid-cols-2 md:gap-x-14 md:gap-y-6">
          {
            science.deeper.paragraphs.map((paragraph) => (
              <p class="m-0 type-body text-foreground-body">{paragraph}</p>
            ))
          }
        </div>
        <div id="pause" class="mt-10 border-t border-border-control pt-12 lg:mt-14">
          <p class="m-0 type-eyebrow text-brand-emphasis">{science.pause.eyebrow}</p>
          <h3 class="m-0 mt-3 type-card-title-lg text-foreground lg:type-section-title-sm">
            {science.pause.title}
          </h3>
          <ol class="m-0 mt-7 list-none p-0">
            {
              science.pause.steps.map((step, i) => (
                <li class="grid gap-3 border-t border-border py-7 md:grid-cols-12 md:gap-6">
                  <span
                    class:list={[
                      'font-sans type-stat-sm font-black tracking-tight tabular-nums md:col-span-1',
                      i === science.pause.steps.length - 1 ? 'text-brand' : 'text-foreground',
                    ]}
                  >
                    {step.number}
                  </span>
                  <h4 class="m-0 type-card-title-md text-foreground md:col-span-4">{step.title}</h4>
                  <p class="m-0 type-body text-foreground-body md:col-span-7">{step.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="m-0 mt-4 type-label text-foreground-muted">
            {science.pause.note.before}<sup class="ml-0.5 font-bold"
              >{
                science.pause.note.cites.map((cite, i) => (
                  <>
                    {i > 0 && ', '}
                    <a class="text-brand-emphasis no-underline" href={`#cite-${cite}`}>
                      {cite}
                    </a>
                  </>
                ))
              }</sup
            >{science.pause.note.after}
          </p>
        </div>
      </div>

      <div
        class="mt-14 grid gap-8 border-t border-border-control pt-14 lg:mt-24 lg:flex lg:items-start lg:gap-16"
      >
        <div class="lg:basis-5/12">
          <p class="m-0 type-eyebrow text-brand-emphasis">{science.layer.eyebrow}</p>
          <h3 class="m-0 mt-3 type-section-title text-balance text-foreground">
            {science.layer.title[0]}<br />{science.layer.title[1]}
          </h3>
          <div class="mt-7 flex flex-col gap-4 lg:gap-3.5">
            {
              science.layer.more.map((paragraph) => (
                <p class="m-0 type-body text-foreground-body" data-work="science">
