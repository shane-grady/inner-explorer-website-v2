    <Section tone="white" class="lg:py-24">
      <ClosingCta layout="inline" align="center" balance title={cta.title} primary={cta.primary} />
    </Section>

    {/* Full citations: collapsed under a fade until shown (whole without JS). */}
    <Section id="citations" tone="white" aria-labelledby="cit-title" class="lg:py-24">
      <div class="grid gap-6 md:grid-cols-2 md:items-end md:gap-16">
        <h2 id="cit-title" class="m-0 type-section-title-sm text-foreground">{citations.title}</h2>
        <p class="m-0 type-small text-foreground-muted">{citations.note}</p>
      </div>
      <div
        id="citations-list"
        class="ie-collapse pt-10"
        style="--collapse-height: var(--collapse-height-sm); --collapse-fade: var(--collapse-fade-sm)"
        data-collapse
      >
        <div class="grid gap-10 border-t border-border pt-10 md:grid-cols-2 md:gap-16">
          {
            citationGroups.map((group) => (
              <div>
                <h3 class="m-0 type-card-title-sm text-foreground">{group.title}</h3>
                <ol class="m-0 mt-3 flex list-none flex-col gap-2.5 p-0">
                  {group.items.map((item) => (
                    <li
                      id={`cite-${item.id}`}
                      class="flex scroll-mt-6 gap-2 type-label leading-normal text-foreground-body"
                    >
                      <span class="w-8 shrink-0 font-bold text-brand-emphasis">{item.id}</span>
                      <span class="min-w-0">
                        {item.text}
                        {item.em && <em>{item.em}</em>}
                        {item.after}
                        {item.href && (
                          <>
                            {' '}
                            <a
                              class="inline-flex items-baseline gap-0.5 font-bold text-brand-emphasis"
                              href={item.href}
                            >
                              {citations.link}
                              <span class="sr-only"> to {item.id}</span>
                              <Icon name="arrow-up-right" size={12} />
                            </a>
                          </>
                        )}
                      </span>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
        </div>
      </div>
      <div class="mt-6 flex justify-center">
        <button
          type="button"
          class="group ie-chip"
          aria-controls="citations-list"
          aria-expanded="true"
          hidden
          data-collapse-toggle
          data-expand={citations.show}
          data-collapse-label={citations.hide}
        >
          <span data-collapse-text>{citations.hide}</span>
          <Icon name="chevron-down" class="text-brand group-data-open:rotate-180" />
        </button>
      </div>
    </Section>
  </div>
</PageLayout>

<script>
  // Research: Pause motion (the footage, the brain's pulse, the marquee), the brain and wall
  // switches, the three "Show our work" switches and the citations collapse. Without JS the
  // details and citations render whole and the controls stay hidden.
  const root = document.querySelector<HTMLElement>('[data-research]');
  if (root) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let flip: number | undefined;

    // The brain: Stressed or Mindful; it flips to Mindful once by itself unless touched.
    const brain = root.querySelector<HTMLElement>('[data-brain]');
    const figure = root.querySelector<SVGElement>('[data-brain-figure]');
    const brainSwitch = root.querySelector<HTMLElement>('[data-brain-switch]');
    const setBrain = (state: string) => {
      if (!brain || !figure || !brainSwitch) return;
      brain.dataset.brain = state;
      figure.setAttribute(
        'aria-label',
        figure.dataset[`alt${state[0].toUpperCase()}${state.slice(1)}`] ?? '',
      );
      for (const b of brainSwitch.querySelectorAll<HTMLButtonElement>('[data-brain-set]'))
        b.setAttribute('aria-pressed', String(b.dataset.brainSet === state));
    };
    if (brainSwitch) {
      brainSwitch.hidden = false;
      brainSwitch.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-brain-set]');
        if (!button) return;
        window.clearTimeout(flip);
        setBrain(button.dataset.brainSet ?? 'stressed');
      });
    }

    // Motion: the footage plays unless paused or reduced motion is set.
    const video = root.querySelector<HTMLVideoElement>('[data-hero-video]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-motion-toggle]');
    const setPaused = (paused: boolean) => {
      root.toggleAttribute('data-motion-paused', paused);
      for (const label of toggle?.querySelectorAll<HTMLElement>('[data-motion-when]') ?? [])
        label.hidden = label.dataset.motionWhen !== (paused ? 'paused' : 'playing');
      if (paused) {
        window.clearTimeout(flip);
        video?.pause();
      } else {
        video?.play().catch(() => undefined);
      }
    };
    if (toggle) {
      toggle.hidden = false;
      toggle.addEventListener('click', () => setPaused(!root.hasAttribute('data-motion-paused')));
    }
    if (still) {
      setBrain('mindful');
      setPaused(true);
    } else {
      setPaused(false);
      flip = window.setTimeout(() => setBrain('mindful'), 3200);
    }

    // The wall: on sand or on a foundation.
    const wall = root.querySelector<HTMLElement>('[data-wall]');
    const wallSwitch = wall?.querySelector<HTMLElement>('[data-wall-switch]');
    if (wall && wallSwitch) {
      wallSwitch.hidden = false;
      wallSwitch.addEventListener('click', (event) => {
        const button = (event.target as Element).closest<HTMLButtonElement>('[data-wall-set]');
        if (!button) return;
        for (const b of wallSwitch.querySelectorAll<HTMLButtonElement>('[data-wall-set]'))
          b.setAttribute('aria-pressed', String(b === button));
        for (const f of wall.querySelectorAll<HTMLElement>('[data-wall-figure]'))
          f.hidden = f.dataset.wallFigure !== button.dataset.wallSet;
      });
    }

    // Show our work: each switch reveals its section's details.
    for (const prompt of root.querySelectorAll<HTMLElement>('[data-work-prompt]')) {
      const button = prompt.querySelector<HTMLButtonElement>('[data-work-switch]');
      if (!button) continue;
      const details = root.querySelectorAll<HTMLElement>(
        `[data-work="${button.dataset.workSwitch}"]`,
      );
      const show = (on: boolean) => {
        button.setAttribute('aria-checked', String(on));
        for (const d of details) d.hidden = !on;
      };
      prompt.hidden = false;
      show(false);
      button.addEventListener('click', () => show(button.getAttribute('aria-checked') !== 'true'));
    }

    // Citations: collapsed under a fade (from 35%); a citation link, the hash or focus under the
    // fade opens it.
    const panel = root.querySelector<HTMLElement>('[data-collapse]');
    const collapse = root.querySelector<HTMLButtonElement>('[data-collapse-toggle]');
    const collapseText = collapse?.querySelector('[data-collapse-text]');
    if (panel && collapse && collapseText) {
      const setCollapsed = (collapsed: boolean) => {
        panel.toggleAttribute('data-collapsed', collapsed);
        collapse.setAttribute('aria-expanded', String(!collapsed));
        collapse.toggleAttribute('data-open', !collapsed);
        collapseText.textContent = collapsed
          ? (collapse.dataset.expand ?? '')
          : (collapse.dataset.collapseLabel ?? '');
      };
      collapse.hidden = false;
      setCollapsed(!window.location.hash.startsWith('#cite-'));
      collapse.addEventListener('click', () => {
        const expanding = panel.hasAttribute('data-collapsed');
        setCollapsed(!expanding);
        if (!expanding) panel.scrollIntoView({ block: 'nearest' });
      });
      panel.addEventListener('focusin', (event) => {
        if (!panel.hasAttribute('data-collapsed') || !(event.target instanceof Element)) return;
        const box = panel.getBoundingClientRect();
        if (event.target.getBoundingClientRect().bottom > box.top + box.height * 0.35)
          setCollapsed(false);
      });
      root.addEventListener('click', (event) => {
        if ((event.target as Element).closest('a[href^="#cite-"]')) setCollapsed(false);
      });
    }
  }
</script>
