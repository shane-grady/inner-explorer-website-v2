                ) : (
                  <div class="absolute inset-x-0 bottom-0 flex h-16 items-center justify-center gap-3.5 rounded-sm bg-brand-surface px-6">
                    <Logo reversed size="sm" class="hidden md:block" />
                    <span class="type-card-title-sm text-on-brand md:type-body md:font-bold">
                      {science.wall.foundation.base}
                    </span>
                  </div>
                )}
              </div>
            ))
          }
          <blockquote class="m-0 p-0">
