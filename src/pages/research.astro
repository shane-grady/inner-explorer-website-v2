            {evidence.district.link.label}
          </ArrowLink>
        </div>
        <figure class="ie-card ie-card-floating m-0 flex flex-col gap-5 p-5 lg:basis-7/12 lg:p-8">
          <figcaption
            class="flex items-center justify-between gap-2 type-card-title-sm text-foreground"
          >
            {evidence.district.figure.title}
            <span class="ie-tag type-tag text-foreground-secondary"
              >{evidence.district.figure.tag}</span
