          <p class="m-0 border-t border-border pt-3.5 type-label text-foreground-muted">
            {evidence.district.figure.source}
          </p>
        </figure>
      </div>

      <div
        class="ie-card mt-2 grid gap-4 bg-background p-5 lg:flex lg:items-start lg:gap-16 lg:p-12"
      >
        <div class="lg:basis-5/12">
