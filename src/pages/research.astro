          </figcaption>
          <ul class="m-0 grid list-none gap-2 p-0 md:grid-cols-3">
            {
              evidence.district.figure.tiles.map((tile) => (
                <li class:list={['flex flex-col gap-1.5 rounded-sm p-5', TILE[tile.tone]]}>
