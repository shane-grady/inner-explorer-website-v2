---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import IntroScroll from '../components/blocks/intro/IntroScroll.astro';

import LiveNow from '../components/blocks/home/LiveNow.astro';
import WhyNow from '../components/blocks/home/WhyNow.astro';
import AudienceToggle from '../components/blocks/home/AudienceToggle.astro';
import HowItWorks from '../components/blocks/home/HowItWorks.astro';
import GradeBands from '../components/blocks/home/GradeBands.astro';
import Proof from '../components/blocks/home/Proof.astro';
import Stories from '../components/blocks/home/Stories.astro';
import SampleListen from '../components/blocks/home/SampleListen.astro';
import Funding from '../components/blocks/home/Funding.astro';
import BringItCTA from '../components/blocks/home/BringItCTA.astro';

// ── Page content ────────────────────────────────────────────────────────────
//
// The copy — including the scroll-intro's, which used to live inside
// blocks/intro/IntroScroll.astro — is in src/content/pages/home.yml (the `pages`
// collection) so CloudCannon can read and write it. Only the copy moved: the pinned
// stage's progress maths, the SVG path draw, the Lenis controller, the reveal
// observer, and every photograph imported at build time stay in code. Photography is
// now referenced by repo-relative path in the YAML and resolved by the schema's
// `image()` (the pattern `caseStudies` uses). `editablePrefix` threads each block's
// data path down to its fields; see src/lib/editable.ts.
//

const entry = await getEntry('pages', 'home');
if (!entry || entry.data._schema !== 'home') {
  throw new Error('Missing or malformed src/content/pages/home.yml');
}
const {
  intro,
  liveNow,
  whyNow,
  audiences,
  howItWorks,
  gradeBands,
  proof,
  stories,
  sample,
  funding,
  bringIt,
  pageTitle,
  pageDescription,
} = entry.data;

// ── SEO ─────────────────────────────────────────────────────────────────────

const base = new URL(Astro.site ?? 'https://www.innerexplorer.com').origin;
const homeLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: `${base}/`,
  description: pageDescription,
  about: {
    '@type': 'Service',
    name: 'Inner Explorer',
    serviceType: 'Daily audio-guided mindfulness for PreK-12 schools',
    provider: {
      '@type': 'Organization',
      name: 'Inner Explorer',
      url: base,
      logo: `${base}/logo.png`,
    },
    audience: { '@type': 'EducationalAudience', audienceType: 'PreK-12 schools and districts' },
  },
};
---

<PageLayout title={pageTitle} description={pageDescription} flushTop>
  <JsonLd slot="head" schema={homeLd} />

  <div class="appearance-light">
    {/* SPLASH — the scroll-driven intro carries the page's single visible <h1>. */}
    <IntroScroll
      headline={intro.headline}
      lede={intro.lede}
      cta={intro.cta}
      imageAlt={intro.imageAlt}
      balanceLabel={intro.balanceLabel}
      problem={intro.problem}
      solution={intro.solution}
      editablePrefix="intro"
    />

    <LiveNow
      eyebrow={liveNow.eyebrow}
      headingLead={liveNow.headingLead}
      headingAccent={liveNow.headingAccent}
      captions={liveNow.captions}
      stats={liveNow.stats}
      editablePrefix="liveNow"
    />
    <WhyNow
      eyebrow={whyNow.eyebrow}
      manifesto={whyNow.manifesto}
      stats={whyNow.stats}
      editablePrefix="whyNow"
    />
    <AudienceToggle
      eyebrow={audiences.eyebrow}
      headingLead={audiences.headingLead}
      headingAccent={audiences.headingAccent}
      educator={audiences.educator}
      district={audiences.district}
      editablePrefix="audiences"
    />
    <HowItWorks
      eyebrow={howItWorks.eyebrow}
      headingLead={howItWorks.headingLead}
      headingAccent={howItWorks.headingAccent}
      steps={howItWorks.steps}
      editablePrefix="howItWorks"
    />
    <GradeBands
      eyebrow={gradeBands.eyebrow}
      headingLead={gradeBands.headingLead}
      headingAccent={gradeBands.headingAccent}
      bands={gradeBands.bands}
      editablePrefix="gradeBands"
    />
    <Proof
      eyebrow={proof.eyebrow}
      headingLead={proof.headingLead}
      headingAccent={proof.headingAccent}
      intro={proof.intro}
      hero={proof.hero}
      trendLabel={proof.trendLabel}
      trend={proof.trend}
      support={proof.support}
      pills={proof.pills}
      editablePrefix="proof"
    />
    <Stories
      badge={stories.badge}
      headlineTop={stories.headlineTop}
      headlineBottom={stories.headlineBottom}
      body={stories.body}
      cta={stories.cta}
      portraits={stories.portraits}
      statCards={stories.statCards}
      editablePrefix="stories"
    />
    <SampleListen
      eyebrow={sample.eyebrow}
      headingLead={sample.headingLead}
      headingAccent={sample.headingAccent}
      body={sample.body}
      disclaimer={sample.disclaimer}
      audioSrc={sample.audioSrc}
      captionsSrc={sample.captionsSrc}
      durationSec={sample.durationSec}
      trackTitle={sample.trackTitle}
      trackEyebrow={sample.trackEyebrow}
      editablePrefix="sample"
    />
    <Funding
      eyebrow={funding.eyebrow}
      headingLead={funding.headingLead}
      headingAccent={funding.headingAccent}
      intro={funding.intro}
      cards={funding.cards}
      editablePrefix="funding"
    />
    <BringItCTA
      eyebrow={bringIt.eyebrow}
      headingTop={bringIt.headingTop}
      headingBottom={bringIt.headingBottom}
      body={bringIt.body}
      primaryCta={bringIt.primaryCta}
      secondaryCta={bringIt.secondaryCta}
      pills={bringIt.pills}
      chip={bringIt.chip}
      image={bringIt.image}
      imageAlt={bringIt.imageAlt}
      editablePrefix="bringIt"
    />
  </div>
</PageLayout>

<style is:global>
  /* Scroll-reveal (home). Opt-in only when JS is present (html[data-js-ready], set by
     lib/intersect.ts) so no-JS/SEO readers see fully-rendered content. Honors
     prefers-reduced-motion via the global rule in global.css. Per-element stagger via
     an inline --reveal-delay. */
  html[data-js-ready] [data-home-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s var(--ease-out) var(--reveal-delay, 0ms),
      transform 0.7s var(--ease-out) var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  html[data-js-ready] [data-home-reveal].in {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { observe } from '../lib/intersect';
  observe('[data-home-reveal]', { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
</script>
