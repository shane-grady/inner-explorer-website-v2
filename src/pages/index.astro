---

<PageLayout title={pageTitle} description={pageDescription} flushTop>
  <JsonLd slot="head" schema={homeLd} />

  <div class="appearance-light">
    {/* SPLASH — the scroll-driven intro carries the page's single visible <h1>. */}
    <IntroScroll />

    <LiveNow
      eyebrow={liveNow.eyebrow}
      headingLead={liveNow.headingLead}
      headingAccent={liveNow.headingAccent}
      captions={liveNow.captions}
      stats={liveNow.stats}
    />
    <WhyNow eyebrow={whyNow.eyebrow} manifesto={whyNow.manifesto} stats={whyNow.stats} />
    <AudienceToggle
      eyebrow={audiences.eyebrow}
      headingLead={audiences.headingLead}
      headingAccent={audiences.headingAccent}
      educator={audiences.educator}
      district={audiences.district}
    />
    <HowItWorks
      eyebrow={howItWorks.eyebrow}
      headingLead={howItWorks.headingLead}
      headingAccent={howItWorks.headingAccent}
      steps={howItWorks.steps}
    />
    <GradeBands
      eyebrow={gradeBands.eyebrow}
      headingLead={gradeBands.headingLead}
      headingAccent={gradeBands.headingAccent}
      bands={gradeBands.bands}
    />
    <Proof
      eyebrow={proof.eyebrow}
      headingLead={proof.headingLead}
      headingAccent={proof.headingAccent}
      intro={proof.intro}
      hero={proof.hero}
      trendLabel={proof.trendLabel}
      trend={proof.trend}
      support={proof.support}
      pills={proof.pills}
    />
    <Stories
      badge={stories.badge}
      headlineTop={stories.headlineTop}
      headlineBottom={stories.headlineBottom}
      body={stories.body}
      cta={stories.cta}
      portraits={stories.portraits}
      statCards={stories.statCards}
    />
    <SampleListen
      eyebrow={sample.eyebrow}
      headingLead={sample.headingLead}
      headingAccent={sample.headingAccent}
      body={sample.body}
      disclaimer={sample.disclaimer}
      audioSrc={sample.audioSrc}
      captionsSrc={sample.captionsSrc}
      durationSec={sample.durationSec}
      trackTitle={sample.trackTitle}
      trackEyebrow={sample.trackEyebrow}
    />
    <Funding
      eyebrow={funding.eyebrow}
      headingLead={funding.headingLead}
      headingAccent={funding.headingAccent}
      intro={funding.intro}
      cards={funding.cards}
    />
    <BringItCTA
      eyebrow={bringIt.eyebrow}
      headingTop={bringIt.headingTop}
      headingBottom={bringIt.headingBottom}
      body={bringIt.body}
      primaryCta={bringIt.primaryCta}
      secondaryCta={bringIt.secondaryCta}
      pills={bringIt.pills}
      chip={bringIt.chip}
      image={bringIt.image}
      imageAlt={bringIt.imageAlt}
    />
  </div>
</PageLayout>

<style is:global>
  /* Scroll-reveal (home). Opt-in only when JS is present (html[data-js-ready], set by
     lib/intersect.ts) so no-JS/SEO readers see fully-rendered content. Honors
     prefers-reduced-motion via the global rule in global.css. Per-element stagger via
     an inline --reveal-delay. */
  html[data-js-ready] [data-home-reveal] {
    opacity: 0;
    transform: translateY(26px);
    transition:
      opacity 0.7s var(--ease-out) var(--reveal-delay, 0ms),
      transform 0.7s var(--ease-out) var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }
  html[data-js-ready] [data-home-reveal].in {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { observe } from '../lib/intersect';
  observe('[data-home-reveal]', { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
</script>
