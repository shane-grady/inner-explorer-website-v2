---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import PlatformHero from '../components/blocks/platform/PlatformHero.astro';
import TrustLogos from '../components/blocks/platform/TrustLogos.astro';
import PlatformTrio from '../components/blocks/platform/PlatformTrio.astro';
import FeatureSection from '../components/blocks/platform/FeatureSection.astro';
import SignOn from '../components/blocks/platform/SignOn.astro';
import ImpactStories from '../components/blocks/platform/ImpactStories.astro';
import OutcomesExplorer from '../components/blocks/platform/OutcomesExplorer.astro';
import Safety from '../components/blocks/platform/Safety.astro';
import LatestUpdates from '../components/blocks/platform/LatestUpdates.astro';
import PlatformCTA from '../components/blocks/platform/PlatformCTA.astro';

// ── Page content ────────────────────────────────────────────────────────────
//
// The copy lives in src/content/pages/platform.yml (the `pages` collection) so
// CloudCannon can read and write it. Only the copy moved — the product mockups
// (hero showcase, trio shots, FeatureVisual cards, the SSO card) are `aria-hidden`
// illustrations and stay in the blocks, as does the JSON-LD below. `editablePrefix`
// threads each block's data path down to its fields; see src/lib/editable.ts.
//
// Stats, customer names, district logos, and the research citations are still
// illustrative — swap for verified figures and official assets before publishing
// (see tasks/todo.md).

const entry = await getEntry('pages', 'platform');
if (!entry || entry.data._schema !== 'platform') {
  throw new Error('Missing or malformed src/content/pages/platform.yml');
}
const {
  hero,
  trust,
  trio,
  classroom,
  district,
  home,
  signOn,
  impact,
  research,
  safety,
  updates,
  cta,
  pageTitle,
  pageDescription,
} = entry.data;

const base = new URL(Astro.site ?? 'https://www.innerexplorer.com').origin;
const platformLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  url: `${base}/platform`,
  description: pageDescription,
  isPartOf: { '@type': 'WebSite', name: 'Inner Explorer', url: base },
  about: {
    '@type': 'ItemList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Classroom app' },
      { '@type': 'ListItem', position: 2, name: 'District dashboard' },
      { '@type': 'ListItem', position: 3, name: 'Home family app' },
    ],
  },
};
---

<PageLayout title={pageTitle} description={pageDescription} flushTop>
  <JsonLd slot="head" schema={platformLd} />

  <div class="appearance-light">
    <PlatformHero {...hero} editablePrefix="hero" />
    <TrustLogos {...trust} editablePrefix="trust" />
    <PlatformTrio {...trio} editablePrefix="trio" />
    <FeatureSection {...classroom} editablePrefix="classroom" />
    <FeatureSection {...district} editablePrefix="district" />
    <FeatureSection {...home} editablePrefix="home" />
    <SignOn {...signOn} editablePrefix="signOn" />
    <ImpactStories {...impact} editablePrefix="impact" />
    <OutcomesExplorer {...research} editablePrefix="research" />
    <Safety {...safety} editablePrefix="safety" />
    <LatestUpdates {...updates} editablePrefix="updates" />
    <PlatformCTA {...cta} editablePrefix="cta" />
  </div>
</PageLayout>
