---
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import HubSpotForm from '../components/integrations/HubSpotForm.astro';
import { HELP_SITE, MAIN_SITE } from '../lib/site';

const content = {
  title: 'Contact Inner Explorer | Daily Mindfulness for Schools',
  description:
    'Reach the Inner Explorer team to learn how daily mindfulness could support your school community. Send a message and hear back within one business day.',
  heading: 'Get in touch',
  lead: 'Send us a note and a member of our team will reach out within one business day.',
  confirmation:
    'Thank you for reaching out. We just sent a confirmation to your inbox, and someone from our team will follow up to find a time to talk.',
  supportEmail: 'support@innerexplorer.com',
  helpCenterHref: `${HELP_SITE}/`,
  support: {
    heading: 'Already using Inner Explorer?',
    text: 'Our support team can help with your account, your login, or anything happening in the classroom.',
    // "Email <supportEmail> or browse the <Help Center>."
    emailLead: 'Email',
    helpCenterLead: 'or browse the',
    helpCenterLabel: 'Help Center',
  },
};

// HubSpot owns the form's fields, labels and dropdown options. What lives here is form
// IDENTITY — configuration, not copy: changing these would silently break lead capture.
// The form is built and version-controlled by scripts/hubspot-contact-form.mjs; these
// ids are public, like Intercom's app id.
const hubspot = {
  portalId: '44976911',
  formId: '48e37214-69e4-479f-b03b-1ae2ab5dfbd4',
  region: 'na1',
};

const base = new URL(Astro.site ?? MAIN_SITE).origin;
const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: content.title,
  url: `${base}/contact/`,
  description: content.description,
  mainEntity: {
    '@type': 'Organization',
    name: 'Inner Explorer',
    url: base,
    logo: `${base}/logo.png`,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: content.supportEmail,
        areaServed: 'US',
        availableLanguage: ['English', 'Spanish'],
      },
    ],
  },
};
---

<PageLayout title={content.title} description={content.description}>
  <JsonLd slot="head" schema={contactLd} />

  <h1>{content.heading}</h1>
  <p>{content.lead}</p>
  <HubSpotForm
    portalId={hubspot.portalId}
    formId={hubspot.formId}
    region={hubspot.region}
    confirmation={content.confirmation}
    supportEmail={content.supportEmail}
    helpCenterHref={content.helpCenterHref}
  />

  <h2>{content.support.heading}</h2>
  <p>{content.support.text}</p>
  <p>
    {content.support.emailLead}
    <a href={`mailto:${content.supportEmail}`}>{content.supportEmail}</a>
    {content.support.helpCenterLead}
    <a href={content.helpCenterHref}>{content.support.helpCenterLabel}</a>.
  </p>
</PageLayout>
