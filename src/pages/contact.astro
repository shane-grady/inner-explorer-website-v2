---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import EditorialMasthead from '../components/blocks/EditorialMasthead.astro';
import ContactCard from '../components/blocks/ContactCard.astro';
import DemoForm from '../components/blocks/contact/DemoForm.astro';
import EmailCard from '../components/blocks/contact/EmailCard.astro';

// ── Page content ────────────────────────────────────────────────────────
//
// The copy lives in src/content/pages/contact.yml (the `pages` collection) so
// CloudCannon can read and write it. Only the copy moved — the ambient layout, the
// clipboard/toast script, and the JSON-LD below are still built here.
// `editablePrefix` threads each block's data path down to its fields; see
// src/lib/editable.ts.

const entry = await getEntry('pages', 'contact');
if (!entry || entry.data._schema !== 'contact') {
  throw new Error('Missing or malformed src/content/pages/contact.yml');
}
const { hero, form, email, pageTitle, pageDescription } = entry.data;

// Form configuration, not copy — the state list never changes, and 50 rows in the
// CMS would bury the handful of fields on this page that editors do change.
const states = [
  { value: 'AL', label: 'AL' },
  { value: 'AK', label: 'AK' },
  { value: 'AZ', label: 'AZ' },
  { value: 'AR', label: 'AR' },
  { value: 'CA', label: 'CA' },
  { value: 'CO', label: 'CO' },
  { value: 'CT', label: 'CT' },
  { value: 'DE', label: 'DE' },
  { value: 'FL', label: 'FL' },
  { value: 'GA', label: 'GA' },
  { value: 'HI', label: 'HI' },
  { value: 'ID', label: 'ID' },
  { value: 'IL', label: 'IL' },
  { value: 'IN', label: 'IN' },
  { value: 'IA', label: 'IA' },
  { value: 'KS', label: 'KS' },
  { value: 'KY', label: 'KY' },
  { value: 'LA', label: 'LA' },
  { value: 'ME', label: 'ME' },
  { value: 'MD', label: 'MD' },
  { value: 'MA', label: 'MA' },
  { value: 'MI', label: 'MI' },
  { value: 'MN', label: 'MN' },
  { value: 'MS', label: 'MS' },
  { value: 'MO', label: 'MO' },
  { value: 'MT', label: 'MT' },
  { value: 'NE', label: 'NE' },
  { value: 'NV', label: 'NV' },
  { value: 'NH', label: 'NH' },
  { value: 'NJ', label: 'NJ' },
  { value: 'NM', label: 'NM' },
  { value: 'NY', label: 'NY' },
  { value: 'NC', label: 'NC' },
  { value: 'ND', label: 'ND' },
  { value: 'OH', label: 'OH' },
  { value: 'OK', label: 'OK' },
  { value: 'OR', label: 'OR' },
  { value: 'PA', label: 'PA' },
  { value: 'RI', label: 'RI' },
  { value: 'SC', label: 'SC' },
  { value: 'SD', label: 'SD' },
  { value: 'TN', label: 'TN' },
  { value: 'TX', label: 'TX' },
  { value: 'UT', label: 'UT' },
  { value: 'VT', label: 'VT' },
  { value: 'VA', label: 'VA' },
  { value: 'WA', label: 'WA' },
  { value: 'WV', label: 'WV' },
  { value: 'WI', label: 'WI' },
  { value: 'WY', label: 'WY' },
];

const base = new URL(Astro.site ?? 'https://www.innerexplorer.com').origin;
const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: pageTitle,
  url: `${base}/contact`,
  description: pageDescription,
  mainEntity: {
    '@type': 'Organization',
    name: 'Inner Explorer',
    url: base,
    logo: `${base}/logo.png`,
    contactPoint: [
      {
        '@type': 'ContactPoint',
        contactType: 'customer support',
        email: email.items[0]?.email,
        areaServed: 'US',
        availableLanguage: ['English', 'Spanish'],
      },
    ],
  },
};
---

<PageLayout title={pageTitle} description={pageDescription}>
  <JsonLd slot="head" schema={contactLd} />

  <div class="appearance-light contact-page">
    <div class="ambient" aria-hidden="true"></div>

    <EditorialMasthead
      lead={hero.lead}
      display={hero.display}
      intro={hero.intro}
      layout="inline"
      maxWidth="960px"
      editablePrefix="hero"
    />

    <div class="shell">
      <div class="stack">
        <ContactCard
          tone="primary"
          badge={form.badge}
          title={form.title}
          blurb={form.blurb}
          editablePrefix="form"
        >
          <svg
            slot="icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="16" rx="2"></rect>
            <path d="M8 3v4M16 3v4M3 11h18"></path>
          </svg>
          <DemoForm
            roles={form.roles}
            states={states}
            submitLabel={form.submitLabel}
            confirmation={form.confirmation}
            editablePrefix="form"
          />
        </ContactCard>

        <ContactCard tone="subtle" title={email.title} blurb={email.blurb} editablePrefix="email">
          <svg
            slot="icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path d="m3 7 9 6 9-6"></path>
          </svg>
          <EmailCard emails={email.items} editablePrefix="email">
            You can also find answers to common questions in the <a href={email.helpCenterHref}
              >Help Center</a
            >.
          </EmailCard>
        </ContactCard>
      </div>
    </div>

    <output id="contact-toast" aria-live="polite" class="toast">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.4"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <polyline points="20 6 9 17 4 12"></polyline>
      </svg>
      <span data-toast-msg>Copied</span>
    </output>
  </div>
</PageLayout>

<style>
  .contact-page {
    position: relative;
    isolation: isolate;
    padding-bottom: 96px;
  }

  /* Soft ambient atmosphere: fixed full-viewport glow behind everything. Light
     greens at top corners + a warm amber bloom, very subtle. Mirrors the handoff
     body::before but tinted through token surfaces. */
  .ambient {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    background:
      radial-gradient(
        60% 50% at 12% 8%,
        color-mix(in oklab, var(--color-brand) 14%, transparent),
        transparent 60%
      ),
      radial-gradient(
        45% 40% at 92% 14%,
        color-mix(in oklab, var(--color-accent) 12%, transparent),
        transparent 60%
      ),
      radial-gradient(
        55% 45% at 80% 95%,
        color-mix(in oklab, var(--color-brand) 10%, transparent),
        transparent 60%
      );
  }

  .shell {
    max-width: 880px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .stack {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  /* Toast: fixed, slides up on .show, honors prefers-reduced-motion. */
  .toast {
    position: fixed;
    left: 50%;
    bottom: 32px;
    transform: translate(-50%, 80px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    background: var(--color-foreground);
    color: var(--color-background);
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    box-shadow: var(--shadow-lg);
    opacity: 0;
    pointer-events: none;
    transition:
      transform var(--dur) var(--ease-out),
      opacity var(--dur) var(--ease-out);
    z-index: 50;
  }
  .toast.show {
    transform: translate(-50%, 0);
    opacity: 1;
  }
  .toast svg {
    width: 16px;
    height: 16px;
  }

  @media (prefers-reduced-motion: reduce) {
    .toast {
      transform: translate(-50%, 0);
      transition: opacity var(--dur) var(--ease-out);
    }
  }

  @media (max-width: 720px) {
    .shell {
      padding: 0 18px;
    }
  }
</style>

<script>
  // Page-wide copy-to-clipboard + toast coordinator. Any element with
  // [data-copy] copies its value, flashes the toast, and (for buttons that
  // own a .is-copied affordance) toggles their state briefly.
  const toast = document.getElementById('contact-toast');
  const toastMsg = toast?.querySelector<HTMLElement>('[data-toast-msg]');
  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  const showToast = (message: string) => {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.classList.add('show');
    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove('show'), 1800);
  };

  const writeToClipboard = async (text: string): Promise<boolean> => {
    if (navigator.clipboard?.writeText) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        /* fall through to legacy path */
      }
    }
    // Legacy path for older iOS Safari and headless environments.
    const ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'absolute';
    ta.style.left = '-9999px';
    document.body.appendChild(ta);
    ta.select();
    let ok = false;
    try {
      ok = document.execCommand('copy');
    } catch {
      /* swallow; `ok` stays false */
    }
    document.body.removeChild(ta);
    return ok;
  };

  document.querySelectorAll<HTMLElement>('[data-copy]').forEach((el) => {
    el.addEventListener('click', async (event) => {
      event.preventDefault();
      const value = el.getAttribute('data-copy') ?? '';
      const label = el.getAttribute('data-copy-label') ?? value;
      const ok = await writeToClipboard(value);
      if (ok) {
        showToast(`${label} copied`);
        // If this button has a paired .is-copied affordance, flash it.
        if (el.classList.contains('copy-btn')) {
          el.classList.add('is-copied');
          setTimeout(() => el.classList.remove('is-copied'), 2000);
        }
      }
    });
  });
</script>
