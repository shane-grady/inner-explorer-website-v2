---
// Case Studies, from the FINAL V boards Case-Studies-Desktop and Case-Studies-Mobile. The
// cards come from the caseStudies collection: only stories already built are listed. The
// boards' outcome filter chips are held back until there are enough stories to filter; the
// stories keep their tags, and the chip row and its script are in git history (3e8f96b). CTA
// labels verbatim ("Talk to our team"), per the site-wide CTA item.
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Section from '../../components/ui/Section.astro';
import PageTitle from '../../components/ui/PageTitle.astro';
import Button from '../../components/ui/Button.astro';
import StoryCard from '../../components/blocks/StoryCard.astro';
import ClosingCta from '../../components/blocks/ClosingCta.astro';
import { caseStudyHeadline, caseStudyHref, getCaseStudies } from '../../lib/case-studies';
import { MAIN_SITE } from '../../lib/site';

const content = {
  title: 'Case Studies — Real Results from Schools & Districts | Inner Explorer',
  description:
    "Real schools, measured results: how districts and schools use Inner Explorer's daily mindfulness to cut behavioral incidents and build calmer classrooms.",
  hero: {
    eyebrow: 'Case studies',
    title: 'Real Results from\n*Real Schools*',
    lead: 'See how schools across the country made daily mindfulness part of the school day, and the gains they measured in behavior, focus, and academics.',
    primary: { label: 'Talk to our team', href: '/contact/' },
    secondary: { label: 'See the research', href: '/research/' },
  },
  browse: {
    title: 'All case studies',
    showing: 'Showing',
    one: 'story',
    many: 'stories',
  },
  cta: {
    title: 'Your school could be *the next story*',
    lead: 'See what a daily mindfulness practice could do for your classrooms.',
    primary: { label: 'Contact us', href: '/contact/' },
    secondary: { label: 'See the research', href: '/research/' },
  },
} as const;

const stories = await getCaseStudies();
const count = (n: number) =>
  `${content.browse.showing} ${n} ${n === 1 ? content.browse.one : content.browse.many}`;

const base = new URL(Astro.site ?? MAIN_SITE).origin;
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: content.title,
  url: `${base}/case-studies/`,
  description: content.description,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: stories.length,
    itemListElement: stories.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: caseStudyHeadline(s),
      url: `${base}${caseStudyHref(s)}`,
    })),
  },
};
---

<PageLayout title={content.title} description={content.description}>
  <JsonLd slot="head" schema={collectionLd} />

  <Section spacing="hero">
    <PageTitle
      layout="split"
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      lead={content.hero.lead}
    >
      <Fragment slot="actions">
        <Button href={content.hero.primary.href} arrow>{content.hero.primary.label}</Button>
        <Button href={content.hero.secondary.href} variant="secondary">
          {content.hero.secondary.label}
        </Button>
      </Fragment>
    </PageTitle>
  </Section>

  <Section class="pt-0" aria-labelledby="browse-title">
    <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between md:gap-8">
      <h2 id="browse-title" class="m-0 type-section-title text-foreground">
        {content.browse.title}
      </h2>
      <p class="m-0 type-label text-foreground-muted">{count(stories.length)}</p>
    </div>
    <ul class="m-0 mt-4 grid list-none gap-6 p-0 md:mt-8 md:grid-cols-2 lg:grid-cols-3">
      {
        stories.map((s) => (
          <li>
            <StoryCard
              href={caseStudyHref(s)}
              image={s.data.card.image ?? s.data.image}
              level={s.data.level}
              name={s.data.name}
              place={s.data.place}
              stat={s.data.card.stat}
              statLabel={s.data.card.label}
            />
          </li>
        ))
      }
    </ul>
  </Section>

  <Section class="pt-0">
    <ClosingCta
      layout="inline"
      title={content.cta.title}
      lead={content.cta.lead}
      primary={content.cta.primary}
      secondary={content.cta.secondary}
    />
  </Section>
</PageLayout>
