---
// /newsroom/ — from the FINAL V Newsroom boards (Newsroom-Desktop, Newsroom-Mobile). The split
// title, the promoted articles (`promoted` 1–3; else the newest) as the featured card and the
// two beside it, then every other story under type filters: articles from the news collection (src/content/news/), the
// research resources and the press coverage below. The boards' placeholder cards (a video,
// a generic resource, a press release) and their cards for posts that don't exist are not
// built (tasks/todo.md); a filter shows only when its type has stories.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Section from '../../components/ui/Section.astro';
import PageTitle from '../../components/ui/PageTitle.astro';
import Icon from '../../components/ui/Icon.astro';
import MediaCard from '../../components/blocks/MediaCard.astro';
import ClosingCta from '../../components/blocks/ClosingCta.astro';
import { breadcrumbSchema, collectionPageSchema } from '../../lib/schema';
import { readingTime } from '../../lib/reading-time';
import { getNews, newsPath, newsroomCta, shortDate, topStories } from '../../lib/news';
import cnn from '../../assets/images/about/logos/cnn.png';
import edweek from '../../assets/images/about/logos/education-week.png';
import npr from '../../assets/images/about/logos/npr.png';
import fox from '../../assets/images/about/logos/fox-news.png';
import ap from '../../assets/images/about/logos/associated-press.png';
import mindful from '../../assets/images/about/logos/mindful.png';
import fortune from '../../assets/images/about/logos/fortune.png';
import nbc from '../../assets/images/about/logos/nbc.png';
import mindfulNation from '../../assets/images/newsroom/logos/mindful-nation-uk.png';
import people from '../../assets/images/newsroom/logos/people.png';

type StoryType = 'article' | 'resource' | 'press';
interface Resource {
  title: string;
  kind: string;
  excerpt: string;
  meta: string[];
  /** Its publication year: where it falls in "Browse all stories" (newest first). */
  year: number;
  href: string;
  /** The tile drawn as the card's media: a source, a figure and comparison bars. */
  stat: {
    source: string;
    value: string;
    caption: string;
    bars: { label: string; width: string; ours?: boolean; gain?: string }[];
  };
}
interface Press {
  outlet: string;
  logo?: ImageMetadata;
  city?: string;
  format: 'Video' | 'Article' | 'Report';
  title: string;
  action: string;
  href: string;
}

const content = {
  title: 'Newsroom: Insights and News from Inner Explorer',
  description:
    'Research, perspectives, and news exploring mindfulness, learning, and the future of education.',
  hero: {
    eyebrow: 'Newsroom',
    title: 'Insights and News from *Inner Explorer*',
    lead: 'Research, perspectives, and news exploring mindfulness, learning, and the future of education.',
  },
  featured: { label: 'Featured stories', badge: 'Featured', action: 'Read the article' },
  picks: 'Also worth reading',
  browse: {
    title: 'Browse all stories',
    filterLabel: 'Filter by type',
    sort: 'Newest first',
    show: 'Show all stories',
    hide: 'Show fewer stories',
    showing: 'Showing {n} stories',
  },
  types: {
    article: { kicker: 'Article', filter: 'Articles' },
    resource: { kicker: 'Resource', filter: 'Resources' },
    press: { kicker: 'Press', filter: 'Press' },
  } satisfies Record<StoryType, { kicker: string; filter: string }>,
  all: 'All',
  newTab: '(opens in a new tab)',
  // Research resources as the board draws them (figures: tasks/todo.md); each links to its
  // study on the Research page.
  resources: [
    {
      title: 'At-home use of app-based mindfulness',
      kind: 'RCT',
      excerpt: 'Randomized controlled trial, published in the journal Mindfulness.',
      meta: ['Treves et al.', '2023'],
      year: 2023,
      href: '/research/#study-s6',
      stat: {
        source: 'MIT McGovern Institute',
        value: '−28%',
        caption: 'lower student stress',
        bars: [
          { label: 'Active control', width: '100%' },
          { label: 'Inner Explorer', width: '72%', ours: true },
        ],
      },
    },
    {
      title: 'An analysis of the impact of Inner\u00a0Explorer on academic growth',
      kind: 'Doctoral study',
      excerpt: 'Published doctoral research; journal publication forthcoming.',
      meta: ['Dunlap et al.', '2023'],
      year: 2023,
      href: '/research/#study-s5',
      stat: {
        source: 'UNC Charlotte',
        value: '+22–26.6%',
        caption: 'math and reading, special education',
        bars: [
          { label: 'Comparison group', width: '79.37%' },
          { label: 'Inner Explorer', width: '96.83%', ours: true, gain: '3.17%' },
        ],
      },
    },
  ] satisfies Resource[] as Resource[],
  // Press coverage as the board draws it, its links included (tasks/todo.md); Education
  // Week's newsletter tracking parameters are dropped.
  press: [
    {
      outlet: 'CNN',
      logo: cnn,
      format: 'Video',
      title: 'Why Mindfulness in Schools',
      action: 'Watch on CNN',
      href: 'https://video.snapstream.net/Play/8dzvIOOavfKofuR2wLCFXR?accessToken=bm9dmt8bm8edl',
    },
    {
      outlet: 'Education Week',
      logo: edweek,
      format: 'Article',
      title: 'In the Race to Build Smarter AI, We Forgot to Build Smarter Humans',
      action: 'Read on Education Week',
      href: 'https://www.edweek.org/technology/opinion-in-the-race-to-build-smarter-ai-we-forgot-to-build-smarter-humans/2026/07',
    },
    {
      outlet: 'Mindful Nation UK',
      logo: mindfulNation,
      format: 'Report',
      title: 'Mindful Nation UK report',
      action: 'Read the report on Mindful Nation UK',
      href: 'https://www.themindfulnessinitiative.org/mindful-nation-report',
    },
    {
      outlet: 'NPR',
      logo: npr,
      format: 'Article',
      title: 'To help these school kids deal with trauma, mindfulness lessons over the loudspeaker',
      action: 'Read on NPR',
      href: 'https://www.npr.org/sections/health-shots/2024/01/26/1227056527/to-help-these-school-kids-deal-with-trauma-mindfulness-lessons-over-the-loudspea',
    },
    {
      outlet: 'Fox News',
      logo: fox,
      format: 'Article',
      title: 'More US schools are taking breaks for meditation. Teachers say it helps students',
      action: 'Read on Fox News',
      href: 'https://fox2now.com/news/national/ap-more-us-schools-are-taking-breaks-for-meditation-teachers-say-it-helps-students-mental-health/',
    },
    {
      outlet: 'Associated Press',
      logo: ap,
      format: 'Article',
      title:
        'More US schools are taking breaks for meditation. Teachers say it helps students’ mental health',
      action: 'Read on Associated Press',
      href: 'https://apnews.com/article/back-to-school-mental-health-mindfulness-5f73bbd3324ad4e9e9723b5c49fa1616',
    },
    {
      outlet: 'Mindful',
      logo: mindful,
      format: 'Article',
      title: 'Using Mindfulness to Reduce Bullying',
      action: 'Read on Mindful',
      href: 'https://www.mindful.org/using-mindfulness-to-reduce-bullying/',
    },
    {
      outlet: 'Fortune',
      logo: fortune,
      format: 'Article',
      title:
        'More schools use meditation to help students: ‘when I calm myself down, I realize I am an excellent scholar’',
      action: 'Read on Fortune',
      href: 'https://fortune.com/2024/08/04/schools-meditation-mindfulness-yoga-students-education-cdc-mental-health/',
    },
    {
      outlet: 'NBC',
      logo: nbc,
      city: 'Chicago',
      format: 'Video',
      title: 'Matt Rodrigues visits Bright Horizons',
      action: 'Watch on NBC Chicago',
      href: 'https://www.nbcchicago.com/video/top-videos-home/matt-rodrigues-visits-bright-horizons/3767637/',
    },
    {
      outlet: 'NBC',
      logo: nbc,
      city: 'Atlanta',
      format: 'Video',
      title:
        'Clayton County Schools helping students understand feeling through ‘mindful awareness’',
      action: 'Watch on NBC Atlanta',
      href: 'https://www.11alive.com/article/news/local/clayton-county-public-schools-bringing-mindful-awareness-classroom/85-e38f45a7-daa9-414b-885b-5026f429b03c',
    },
    {
      outlet: 'MN Physicians Magazine',
      format: 'Article',
      title: 'Improving pediatric health: A new tool for school classrooms',
      action: 'Read on MN Physicians Magazine',
      href: 'https://www.mnphy.com/0725-story-one-improving--pediatric-health-simone-hardeman-jones-laura-bakosh',
    },
    {
      outlet: 'People',
      logo: people,
      format: 'Article',
      title: 'Meditation Breaks in School Can Improve Students’ Mental Health',
      action: 'Read on People',
      href: 'https://people.com/meditation-in-school-helps-kids-mental-health-georgia-8690265',
    },
  ] satisfies Press[],
  cta: newsroomCta,
};

const posts = await getNews();
const [featured, ...picks] = topStories(posts);
const articleCard = (post: (typeof posts)[number]) => ({
  title: post.data.cardTitle ?? post.data.title,
  href: newsPath(post),
  kicker: [content.types.article.kicker, post.data.category],
  meta: [readingTime(post.body), shortDate(post.data.pubDate)],
  image: {
    src: post.data.heroImage,
    fit: post.data.heroImageFit,
    position: post.data.heroImagePosition,
  },
});

// "Browse all stories": every other article and the resources, newest first (a resource by its
// year), as the board draws it without the stories above; the press coverage is its own filter
// (the board's All shows no coverage).
const top = new Set([featured, ...picks]);
const stories = [
  ...posts
    .filter((post) => !top.has(post))
    .map((post) => ({ type: 'article' as const, post, date: post.data.pubDate.getTime() })),
  ...content.resources.map((item) => ({
    type: 'resource' as const,
    item,
    date: Date.UTC(item.year, 0, 1),
  })),
].sort((a, b) => b.date - a.date);
const types = (['article', 'resource', 'press'] as const).filter(
  (type) =>
    (type === 'article' && stories.some((story) => story.type === 'article')) ||
    (type === 'resource' && content.resources.length) ||
    (type === 'press' && content.press.length),
);

const path = '/newsroom/';
const schemas = [
  collectionPageSchema(Astro.site, {
    path,
    name: content.title,
    description: content.description,
    items: posts.map((post) => ({ name: post.data.title, path: newsPath(post) })),
  }),
  breadcrumbSchema(Astro.site, [
    { name: 'Home', path: '/' },
    { name: content.hero.eyebrow, path },
  ]),
];
---

<PageLayout title={content.title} description={content.description}>
  {schemas.map((schema) => <JsonLd schema={schema} slot="head" />)}

  <Section spacing="hero" class="lg:pb-section-y">
    <PageTitle
      layout="split"
      splitLead="narrow"
      eyebrow={content.hero.eyebrow}
      title={content.hero.title}
      lead={content.hero.lead}
    />

    {
      featured && (
        <div class="mt-8 grid gap-10 lg:mt-18 lg:grid-cols-12 lg:gap-6">
          <section aria-label={content.featured.label} class="flex lg:col-span-8">
            <MediaCard
              variant="featured"
              class="grow"
              {...articleCard(featured)}
              excerpt={featured.data.description}
              badge={content.featured.badge}
              action={content.featured.action}
            />
          </section>
          {picks.length > 0 && (
            <section aria-labelledby="picks-title" class="flex flex-col lg:col-span-4 lg:gap-4">
              <h2 id="picks-title" class="m-0 mb-2 type-eyebrow text-foreground lg:mb-0">
                {content.picks}
              </h2>
              {picks.map((post) => (
                <MediaCard
                  variant="compact"
                  class={picks.length > 1 ? 'lg:grow' : undefined}
                  {...articleCard(post)}
                />
              ))}
            </section>
          )}
        </div>
      )
    }
  </Section>

  <Section tone="white" aria-labelledby="browse-title">
    <div class="flex flex-col gap-6 lg:gap-8" data-stories>
      <h2 id="browse-title" class="m-0 type-section-title text-foreground">
        {content.browse.title}
      </h2>

      <div
        class="flex flex-col items-start gap-4 lg:flex-row lg:items-center lg:justify-between lg:gap-6"
      >
        <div
          class="ie-chip-row -mr-section-x self-stretch pr-section-x md:mr-0 md:pr-0 lg:self-auto"
          role="group"
          aria-label={content.browse.filterLabel}
          hidden
          data-filters
        >
          <button type="button" class="ie-chip" aria-pressed="true" data-filter="all">
            {content.all}
          </button>
          {
            types.map((type) => (
              <button type="button" class="ie-chip" aria-pressed="false" data-filter={type}>
                {content.types[type].filter}
              </button>
            ))
          }
        </div>
        <p class="m-0 type-label text-foreground-muted lg:pb-4">{content.browse.sort}</p>
      </div>
      <p class="sr-only" aria-live="polite" data-filter-status={content.browse.showing}></p>

      <div
        id="stories-list"
        class="ie-collapse overflow-hidden"
        style="--collapse-height: var(--collapse-height-stories); --collapse-fade: var(--collapse-fade-stories)"
        data-collapse
      >
        <ul
          class="m-0 grid list-none gap-12 p-0 md:grid-cols-2 md:gap-x-8 md:gap-y-14 lg:grid-cols-3"
        >
          {
            stories.map((story) =>
              story.type === 'article' ? (
                <li class="flex" data-type="article">
                  <MediaCard
                    {...articleCard(story.post)}
                    excerpt={story.post.data.description}
                    class="grow"
                  />
                </li>
              ) : (
                <li class="flex" data-type="resource">
                  <MediaCard
                    class="grow"
                    title={story.item.title}
                    href={story.item.href}
                    kicker={[content.types.resource.kicker, story.item.kind]}
                    excerpt={story.item.excerpt}
                    meta={story.item.meta}
                    tallMedia
                  >
                    <div
                      slot="media"
                      class="flex size-full flex-col justify-between gap-4 bg-cyan-200 p-6"
                    >
                      <p class="m-0 type-eyebrow text-foreground">{story.item.stat.source}</p>
                      <div class="flex flex-col gap-4">
                        <p class="m-0 flex flex-wrap items-baseline gap-x-3 gap-y-2">
                          <span class="font-display type-stat-md font-medium whitespace-nowrap text-foreground">
                            {story.item.stat.value}
                          </span>
                          <span class="max-w-45 type-label text-foreground">
                            {story.item.stat.caption}
                          </span>
                        </p>
                        <div class="flex flex-col gap-2" aria-hidden="true">
                          {story.item.stat.bars.map((bar) => (
                            <div class="flex">
                              <span
                                class:list={[
                                  'flex h-8 w-(--w) items-center px-3 type-label font-bold whitespace-nowrap',
                                  bar.ours
                                    ? 'bg-cyan-600 text-on-brand'
                                    : 'rounded-sm bg-surface text-foreground',
                                  bar.ours && (bar.gain ? 'rounded-l-sm' : 'rounded-sm'),
                                ]}
                                style={`--w: ${bar.width}`}
                              >
                                {bar.label}
                              </span>
                              {bar.gain && (
                                <span
                                  class="h-8 w-(--w) rounded-r-sm bg-cyan-400"
                                  style={`--w: ${bar.gain}`}
                                />
                              )}
                            </div>
                          ))}
                        </div>
                      </div>
                    </div>
                  </MediaCard>
                </li>
              ),
            )
          }
          {
            content.press.map((item) => (
              <li class="flex" data-type="press">
                <MediaCard
                  class="grow"
                  title={item.title}
                  href={item.href}
                  external
                  kicker={[content.types.press.kicker, item.format]}
                  action={item.action}
                >
                  <div
                    slot="media"
                    class="flex size-full flex-col items-center justify-center gap-2 rounded-sm border border-border bg-tint p-6"
                  >
                    {item.logo ? (
                      <Image
                        src={item.logo}
                        alt={item.outlet}
                        height={112}
                        class="h-auto max-h-11 w-auto max-w-38 object-contain lg:max-h-14 lg:max-w-50"
                      />
                    ) : (
                      <p class="m-0 text-center type-card-title-md text-foreground-muted md:type-card-title-lg">
                        {item.outlet}
                      </p>
                    )}
                    {item.city && (
                      <p class="m-0 type-label font-bold tracking-wide text-foreground-muted lg:type-card-title-sm lg:tracking-wide">
                        {item.city}
                      </p>
                    )}
                  </div>
                </MediaCard>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="-mt-2 mb-6 flex justify-center">
        <button
          type="button"
          class="group ie-chip"
          aria-controls="stories-list"
          aria-expanded="true"
          hidden
          data-collapse-toggle
          data-expand={content.browse.show}
          data-collapse-label={content.browse.hide}
        >
          <span data-collapse-text>{content.browse.hide}</span>
          <Icon name="chevron-down" size={16} class="text-brand group-data-open:rotate-180" />
        </button>
      </div>

      <ClosingCta
        layout="inline"
        eyebrow={content.cta.eyebrow}
        title={content.cta.title}
        lead={content.cta.lead}
        primary={content.cta.primary}
        align="center"
        balance
        id="newsroom-cta"
      />
    </div>
  </Section>
</PageLayout>

<script>
  // Newsroom: the type filters and "Show all stories". Without JS every story shows (the
  // press coverage too), with no filters and no collapse.
  const root = document.querySelector<HTMLElement>('[data-stories]');
  const filters = root?.querySelector<HTMLElement>('[data-filters]');
  const panel = root?.querySelector<HTMLElement>('[data-collapse]');
  const toggle = root?.querySelector<HTMLButtonElement>('[data-collapse-toggle]');
  const toggleText = toggle?.querySelector('[data-collapse-text]');
  const status = root?.querySelector<HTMLElement>('[data-filter-status]');
  if (root && filters && panel && toggle && toggleText) {
    const items = [...panel.querySelectorAll<HTMLElement>('[data-type]')];
    const chips = [...filters.querySelectorAll<HTMLButtonElement>('[data-filter]')];

    const setCollapsed = (collapsed: boolean) => {
      panel.toggleAttribute('data-collapsed', collapsed);
      toggle.setAttribute('aria-expanded', String(!collapsed));
      toggle.toggleAttribute('data-open', !collapsed);
      toggleText.textContent = collapsed
        ? (toggle.dataset.expand ?? '')
        : (toggle.dataset.collapseLabel ?? '');
    };
    // Collapse only a list that runs past the fold; a short one shows whole, with no toggle.
    const fit = () => {
      setCollapsed(true);
      const overflows = panel.scrollHeight > panel.clientHeight + 1;
      toggle.hidden = !overflows;
      if (!overflows) setCollapsed(false);
    };

    // All: every story but the press coverage, as the board draws it.
    const show = (type: string) => {
      let shown = 0;
      for (const item of items) {
        const on = type === 'all' ? item.dataset.type !== 'press' : item.dataset.type === type;
        item.hidden = !on;
        if (on) shown++;
      }
      for (const chip of chips)
        chip.setAttribute('aria-pressed', String(chip.dataset.filter === type));
      fit();
      return shown;
    };

    filters.hidden = false;
    show('all');
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const shown = show(chip.dataset.filter ?? 'all');
        if (status)
          status.textContent = (status.dataset.filterStatus ?? '').replace('{n}', String(shown));
      });
    }
    toggle.addEventListener('click', () => {
      const expanding = panel.hasAttribute('data-collapsed');
      setCollapsed(!expanding);
      if (!expanding) panel.scrollIntoView({ block: 'nearest' });
    });
    // Focus under the fade opens the list.
    panel.addEventListener('focusin', () => {
      if (panel.hasAttribute('data-collapsed')) setCollapsed(false);
    });
    window.addEventListener('resize', () => {
      if (panel.hasAttribute('data-collapsed') || toggle.hidden) fit();
    });
  }
</script>
