type StoryType = 'article' | 'video' | 'resource' | 'press';
interface Video {
  title: string;
  /** The kicker's second part, one of the articles' categories. */
  topic: string;
  excerpt: string;
  /** Its YouTube publish date: where it falls in "Browse all stories". */
  date: string;
  /** Its running time, "m:ss". */
  length: string;
  href: string;
  /** A YouTube thumbnail frame, cropped to the card's 3:2. */
  poster: ImageMetadata;
  /** Closed captions on YouTube: shows the CC mark. */
  captions: boolean;
}
interface Resource {
  title: string;
  /** The format: "Toolkit", "Research brief". */
  kind: string;
  excerpt: string;
  /** Its publication year: where it falls in "Browse all stories" (newest first; a tie keeps
   *  this order). */
  year: number;
  href: string;
  /** The asset preview from the landing page's hero, shown on brand green. */
  cover: ImageMetadata;
}
interface Press {
  outlet: string;
  logo?: ImageMetadata;
  city?: string;
  format: 'Video' | 'Article' | 'Report';
  title: string;
  action: string;
  href: string;
}

