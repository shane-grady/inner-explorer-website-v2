              <FeatureIcon name={point.icon} disc />
              <div class="flex min-w-0 flex-col gap-2">
                <h3 class="m-0 type-card-title-md text-foreground">{point.title}</h3>
                <p class="m-0 max-w-140 type-body text-pretty text-foreground-body">{point.text}</p>
              </div>
            </div>,
          ])
        }
      </div>
    </div>
    <div
      class="ie-card ie-card-tint mt-10 flex flex-col items-start gap-5 px-5 py-6 lg:mt-14 lg:flex-row lg:items-center lg:justify-between lg:gap-10 lg:px-10 lg:py-8"
