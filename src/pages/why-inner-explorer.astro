        <p class="m-0 max-w-measure type-lead text-foreground-secondary">{content.cta.lead}</p>
        <div class="mt-3 flex flex-col gap-3 self-stretch md:flex-row md:self-auto">
          <Button variant="light" href={content.cta.primary.href} arrow>
            {content.cta.primary.label}
