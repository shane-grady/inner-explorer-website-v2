  <Section tone="white" id="mtss" aria-labelledby="mtss-title">
    <p class="m-0 type-eyebrow text-foreground">{content.mtss.eyebrow}</p>
    <h2
      id="mtss-title"
      class="m-0 mt-4 max-w-measure-note type-section-title text-balance text-foreground"
    >
      {content.mtss.title}
    </h2>
    <div class="mt-10 flex flex-col gap-10 lg:mt-14 lg:flex-row lg:items-start lg:gap-16">
      <figure
        class="m-0 flex justify-center lg:w-135 lg:shrink-0"
        aria-label={content.mtss.figureLabel}
      >
        {
          (['mobile', 'desktop'] as const).map((size) => {
            const p = PYRAMID[size];
            return (
              <svg
                class:list={[
                  'block h-auto w-full overflow-visible font-sans font-bold',
                  size === 'mobile' ? 'max-w-87.5 lg:hidden' : 'max-lg:hidden',
                ]}
                width={p.width}
                height={p.height}
                viewBox={`0 0 ${p.width} ${p.height}`}
                aria-hidden="true"
              >
                {p.bands.map((band) => {
                  const b = BAND[band.tier];
                  const [eyebrowY, ...wordY] = band.lines;
                  return (
                    <g>
                      <polygon
                        class={b.shape}
                        points={band.points}
                        stroke-width="6"
                        stroke-linejoin="round"
                      />
                      <text
                        class={b.ink}
                        x={p.width / 2}
                        y={eyebrowY}
                        text-anchor="middle"
                        font-size={p.eyebrowSize}
                        letter-spacing="1.2"
                      >
                        TIER {band.tier}
                      </text>
                      {b.words.map((word, w) => (
                        <text
                          class={b.ink}
                          x={p.width / 2}
                          y={wordY[w]}
                          text-anchor="middle"
                          font-size={p.titleSize}
                        >
                          {word}
                        </text>
                      ))}
                    </g>
                  );
                })}
              </svg>
            );
          })
        }
      </figure>
      <ol
        class="m-0 flex min-w-0 flex-1 list-none flex-col p-0"
        aria-label={content.mtss.tiersLabel}
      >
        {
          content.mtss.tiers.map((tier) => (
            <li
              class:list={[
                'flex items-start gap-4 border-t border-border py-5 lg:items-center lg:gap-6 lg:border-t-0 lg:py-0',
                TIER_HEIGHT[tier.number],
              ]}
            >
              <span
                class:list={[
                  'flex size-8 shrink-0 items-center justify-center rounded-sm type-card-title-sm lg:size-12 lg:rounded-md lg:type-card-title-md',
                  TIER_COLOR[tier.number],
                ]}
                aria-hidden="true"
              >
                {tier.number}
              </span>
              <div class="flex flex-col gap-2">
                <p class="m-0 type-eyebrow text-foreground">{tier.eyebrow}</p>
                <h3 class="m-0 type-card-title-md text-foreground">{tier.title}</h3>
                <p class="m-0 mt-0.5 max-w-140 type-body text-pretty text-foreground-body lg:max-w-measure">
                  {tier.text}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div
      class="ie-card ie-card-raised mt-10 flex flex-col gap-5 px-5 py-6 lg:mt-14 lg:flex-row lg:items-center lg:gap-12 lg:p-10"
    >
      <div class="flex flex-col gap-2 lg:flex-4">
        <p class="m-0 type-eyebrow text-foreground">{content.mtss.foundation.eyebrow}</p>
        <h3 class="m-0 type-card-title-lg text-foreground">
          {
            content.mtss.foundation.title
              .split('\n')
              .map((line, i) => (i === 0 ? line : [<br />, line]))
          }
        </h3>
      </div>
      <Checklist
        class="border-t border-border pt-5 lg:flex-8 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10"
        items={content.mtss.foundation.items}
        columns={3}
        size="sm"
        strong
      />
    </div>
  </Section>

