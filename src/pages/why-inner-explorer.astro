  <Section tone="white" id="before-you-choose" aria-labelledby="before-you-choose-title">
    <div class="flex flex-col gap-6 lg:grid lg:grid-cols-2 lg:items-end lg:gap-20">
      <div>
        <p class="m-0 type-eyebrow text-foreground">{content.questions.eyebrow}</p>
        <h2
