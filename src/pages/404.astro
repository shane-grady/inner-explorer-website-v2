---
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/ui/Section.astro';
import PageTitle from '../components/ui/PageTitle.astro';
import Button from '../components/ui/Button.astro';
import { HELP_SITE } from '../lib/site';

const content = {
  title: 'Page not found | Inner Explorer',
  description: "We can't find that page.",
  heading: 'Page not found',
  lead: "We can't find that page.",
  links: [
    { label: 'Go to the home page', href: '/' },
    { label: 'Visit the Help Center', href: `${HELP_SITE}/` },
  ],
};
---

<PageLayout title={content.title} description={content.description} noindex>
  <Section spacing="hero" as="div">
    <PageTitle title={content.heading} lead={content.lead}>
      <Fragment slot="actions">
        {
          content.links.map((link, i) => (
            <Button href={link.href} variant={i === 0 ? 'primary' : 'secondary'}>
              {link.label}
            </Button>
          ))
        }
      </Fragment>
    </PageTitle>
  </Section>
</PageLayout>
