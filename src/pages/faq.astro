---
import { getEntry } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import EditableFAQMasthead from '../cloudcannon/components/EditableFAQMasthead.astro';
import FAQSection from '../components/blocks/FAQSection.astro';
import EditableFAQPricing from '../cloudcannon/components/EditableFAQPricing.astro';
import EditableFAQQuotes from '../cloudcannon/components/EditableFAQQuotes.astro';
import FAQSidebar from '../components/blocks/support/FAQSidebar.astro';

// ── Page content ────────────────────────────────────────────────────────────
//
// The copy lives in src/content/pages/faq.yml (the `pages` collection) so
// CloudCannon can read and write it. Only the copy moved — the layout, the sidebar
// wiring, and the JSON-LD below are still built here. `editablePrefix` threads each
// block's data path down to its fields; see src/lib/editable.ts.

const entry = await getEntry('pages', 'faq');
if (!entry || entry.data._schema !== 'faq') {
  throw new Error('Missing or malformed src/content/pages/faq.yml');
}
const { hero, sections, pricing, closer, pageTitle, pageDescription } = entry.data;

const sidebarSections = sections.map(({ id, label }) => ({ id, label }));

// ── SEO ─────────────────────────────────────────────────────────────────────

const base = new URL(Astro.site ?? 'https://www.innerexplorer.com').origin;

const stripTags = (html: string): string => html.replace(/<[^>]*>/g, '');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  url: `${base}/faq`,
  name: pageTitle,
  description: pageDescription,
  mainEntity: sections.flatMap((sec) =>
    sec.items.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.aHtml ? stripTags(item.aHtml) : (item.a ?? ''),
      },
    })),
  ),
};
---

<PageLayout title={pageTitle} description={pageDescription}>
  <JsonLd slot="head" schema={faqSchema} />

  <editable-component data-component="faq-masthead" data-prop="hero">
    <EditableFAQMasthead {...hero} />
  </editable-component>

  <div class="support-shell">
    <FAQSidebar sections={sidebarSections} />
    {/* Keep the array/component boundary outside the registered renderer. */}
    <main id="faq-main" data-editable="array" data-prop="sections">
      {
        sections.map((sec) => (
          <div data-editable="array-item" data-component="faq-section" data-id={sec.id}>
            <FAQSection id={sec.id} title={sec.title} items={sec.items} editablePrefix="" />
          </div>
        ))
      }
    </main>
  </div>

  <editable-component data-component="faq-pricing" data-prop="pricing">
    <EditableFAQPricing {...pricing} />
  </editable-component>

  <editable-component data-component="faq-quotes" data-prop="closer">
    <EditableFAQQuotes {...closer} />
  </editable-component>
</PageLayout>

<style>
  .support-shell {
    max-width: 1320px;
    margin: 0 auto;
    padding: 24px 32px 80px;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 80px;
    align-items: start;
  }

  @media (max-width: 880px) {
    .support-shell {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 16px 20px 60px;
    }
  }
</style>
