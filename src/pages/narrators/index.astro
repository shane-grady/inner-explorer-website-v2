---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import { editableText } from '../../lib/editable';

import MeetStudioHero from '../../components/blocks/narrator/MeetStudioHero.astro';
import MetaStrip from '../../components/blocks/MetaStrip.astro';
import CollectionToolbar from '../../components/blocks/CollectionToolbar.astro';
import NarratorWall from '../../components/blocks/narrator/NarratorWall.astro';
import MomentsRail from '../../components/blocks/MomentsRail.astro';
import SplitCTA from '../../components/blocks/SplitCTA.astro';

// ── Page content ────────────────────────────────────────────────────────────
//
// The copy lives in src/content/pages/narrators-index.yml (the `pages` collection)
// so CloudCannon can read and write it — including the three Studio Moments photos,
// which are `image()` fields resolved from repo-relative paths. Only the copy moved;
// the wall, the derived meta figures, and the JSON-LD below are still built here.
// `editablePrefix` threads each block's data path down to its fields; see
// src/lib/editable.ts.

const entry = await getEntry('pages', 'narrators-index');
if (!entry || entry.data._schema !== 'narrators-index') {
  throw new Error('Missing or malformed src/content/pages/narrators-index.yml');
}
const { hero, metaStrip, toolbar, momentsRail, coda, pageTitle, pageDescription } = entry.data;

// ── Data layer — narrators collection (CMS seam) ────────────────────────────

// Pull every published narrator that has a wall portrait — narrators without a
// `photo` can't render on the wall (the card needs one); drafts are excluded.
const entries = await getCollection('narrators', ({ data }) => !data.draft && !!data.photo);
const narrators = entries
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    slug: entry.id.replace(/\.[^.]+$/, ''),
    ...entry.data,
    // Narrow `photo` from `ImageMetadata | undefined` to `ImageMetadata` for
    // downstream components (the filter above guarantees presence).
    photo: entry.data.photo!,
  }));

// ── Meta-strip rows — derived figures + authored labels ─────────────────────
//
// Three of the five figures are computed from the collection above, so they carry no
// `editablePrefix`-bound value: a region must resolve to a field in the entry, and
// these have none. Each row hands MetaStrip the path to its own object so the label
// and qualifier stay editable either way.

const totalPractices = narrators.reduce((sum, n) => sum + (n.practiceCount ?? 0), 0);
const distinctLangs = new Set(narrators.flatMap((n) => n.langs ?? []));
const meta = [
  {
    value: String(narrators.length),
    ...metaStrip.narrators,
    editablePrefix: 'metaStrip.narrators',
  },
  { ...metaStrip.universalLangs, editablePrefix: 'metaStrip.universalLangs', valueEditable: true },
  {
    value: String(distinctLangs.size),
    ...metaStrip.totalLangs,
    editablePrefix: 'metaStrip.totalLangs',
  },
  {
    value: totalPractices.toLocaleString('en-US'),
    ...metaStrip.practices,
    editablePrefix: 'metaStrip.practices',
  },
  // Schools listening — no data source yet, so the figure is authored copy too.
  { ...metaStrip.schools, editablePrefix: 'metaStrip.schools', valueEditable: true },
];

// ── SEO ─────────────────────────────────────────────────────────────────────

const base = new URL(Astro.site ?? 'https://www.innerexplorer.com').origin;
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: `${base}/narrators`,
  description: pageDescription,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: narrators.length,
    itemListElement: narrators.map((n, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Person',
        name: n.name,
        url: `${base}/narrators/${n.slug}`,
        ...(n.role ? { jobTitle: n.role } : {}),
        worksFor: {
          '@type': 'Organization',
          name: 'Inner Explorer',
          url: base,
        },
      },
    })),
  },
};
---

<PageLayout title={pageTitle} description={pageDescription} flushTop>
  <JsonLd slot="head" schema={collectionLd} />

  <div class="appearance-light">
    <MeetStudioHero
      eyebrow={hero.eyebrow}
      cornerLabel={hero.cornerLabel}
      headlineSans={hero.headlineSans}
      headlineSerif={hero.headlineSerif}
      subtitleHtml={hero.subtitleHtml}
      primary={hero.primary}
      secondary={hero.secondary}
      editablePrefix="hero"
    />

    <MetaStrip items={meta} cols={5} ariaLabel={metaStrip.ariaLabel} />

    {/* `headingHtml` carries inline markup, so it stays sidebar-editable. */}
    <CollectionToolbar headingHtml={toolbar.headingHtml}>
      <div class="tb-search" aria-hidden="true">
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span {...editableText('toolbar', 'searchLabel')}>{toolbar.searchLabel}</span>
      </div>
      <button class="tb-filter" type="button" aria-disabled="true">
        <span {...editableText('toolbar', 'filterLabel')}>{toolbar.filterLabel}</span>
        <b>·</b> all {narrators.length}
        <svg
          width="11"
          height="11"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
    </CollectionToolbar>

    <div id="wall"><NarratorWall narrators={narrators} /></div>

    <MomentsRail
      headingHtml={momentsRail.headingHtml}
      lede={momentsRail.lede}
      moments={momentsRail.moments}
      editablePrefix="momentsRail"
    />

    <SplitCTA
      eyebrow={coda.eyebrow}
      quoteHtml={coda.quoteHtml}
      attribution={coda.attribution}
      attributionStrong={coda.attributionStrong}
      cardHeading={coda.cardHeading}
      cardBody={coda.cardBody}
      primary={coda.primary}
      secondary={coda.secondary}
      editablePrefix="coda"
    />
  </div>
</PageLayout>

<style>
  /* Toolbar pill controls — visual-only for phase 1 (search/filter behaviour
     is a follow-up). Slotted into <CollectionToolbar />. */
  .tb-search,
  .tb-filter {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 38px;
    padding: 0 16px;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background: var(--color-card);
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-muted-foreground);
    cursor: default;
  }
  .tb-search {
    min-width: 230px;
  }
  .tb-filter {
    color: var(--color-foreground);
    cursor: pointer;
  }
  .tb-filter b {
    font-weight: 600;
  }
</style>
