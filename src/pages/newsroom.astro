---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import EditorialMasthead from '../components/blocks/EditorialMasthead.astro';
import NewsroomFilters from '../components/blocks/newsroom/NewsroomFilters.astro';
import StoryGrid from '../components/blocks/newsroom/StoryGrid.astro';
import GlowCTA from '../components/blocks/GlowCTA.astro';
import { readingTime } from '../lib/reading-time';
import type { Category, Cover, Story } from '../components/blocks/newsroom/types';

// ── Newsroom stories — sourced from the content collections, never hardcoded ────
// Every card links to a real, published page: the district/school case studies and
// the blog articles. Add a case study or a post and it shows up here automatically
// (the collections are the CMS seam), so the newsroom can't drift from what exists.

const pageTitle = 'Newsroom — Inner Explorer';
const pageDescription =
  'The latest research, announcements, and lessons from the Inner Explorer community.';

const isoDate = (d: Date) => d.toISOString().slice(0, 10);
const toMinutes = (value: string) => parseInt(value, 10) || 5;

// "Popular" has no analytics behind it yet, so it stands in for editorial
// prominence: flagship case studies rank above articles, newest first within each.
// ("Newest" sorts by the real publish date, independently.)
const DAY_MS = 86_400_000;
const prominence = (cat: Category, date: Date) =>
  Math.round(date.getTime() / DAY_MS) + (cat === 'case-study' ? 100_000 : 0);

const caseStudies = await getCollection('caseStudies', ({ data }) => !data.draft);
const caseStudyStories: Story[] = caseStudies.map((cs) => {
  const date = cs.data.publishedDate ?? cs.data.updatedDate ?? new Date();
  return {
    id: `case-study/${cs.id}`,
    cat: 'case-study',
    catLabel: 'Case study',
    title: `${cs.data.meta.titleLead} ${cs.data.meta.titleEmphasis}`,
    excerpt: cs.data.meta.dek,
    date: isoDate(date),
    read: toMinutes(cs.data.meta.readingTime ?? ''),
    pop: prominence('case-study', date),
    href: `/case-studies/${cs.id}/`,
    cover: { kind: 'photo', photo: cs.data.meta.heroImage },
  };
});

const posts = await getCollection('blog', ({ data }) => !data.draft);
const articleStories: Story[] = posts.map((post, i) => {
  const { data, body } = post;
  // Posts with a hero image use it; the rest get an on-brand generative cover
  // tagged with the post's own category.
  const cover: Cover = data.heroImage
    ? { kind: 'photo', photo: data.heroImage }
    : { kind: 'mesh', tone: (['a', 'b', 'c'] as const)[i % 3], eyebrow: data.category };
  return {
    id: `blog/${post.id}`,
    cat: 'article',
    catLabel: 'Article',
    title: data.title,
    excerpt: data.description,
    date: isoDate(data.pubDate),
    read: toMinutes(data.readingTime ?? readingTime(body ?? '')),
    pop: prominence('article', data.pubDate),
    href: `/blog/${post.id}/`,
    cover,
  };
});

// Newest first for the default (unfiltered, "Newest") view.
const stories: Story[] = [...caseStudyStories, ...articleStories].sort((a, b) =>
  b.date.localeCompare(a.date),
);

// Filter tabs: "All" plus only the content types that actually have stories, so no
// empty tab ever renders.
const CATEGORY_LABELS: Record<Category, string> = {
  'case-study': 'Case studies',
  article: 'Articles',
  announcement: 'Announcements',
  research: 'Research',
  press: 'Press releases',
};
const CATEGORY_ORDER: Category[] = ['case-study', 'article', 'announcement', 'research', 'press'];
const present = new Set(stories.map((s) => s.cat));
const categories = [
  { id: 'all' as const, label: 'All' },
  ...CATEGORY_ORDER.filter((c) => present.has(c)).map((c) => ({
    id: c,
    label: CATEGORY_LABELS[c],
  })),
];

// ── SEO — CollectionPage + ItemList (mirrors /narrators) ────────────────────
const base = new URL(Astro.site ?? 'https://www.innerexplorer.org').origin;
const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  url: `${base}/newsroom`,
  description: pageDescription,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: stories.length,
    itemListElement: stories.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.title,
    })),
  },
};
---

<PageLayout title={pageTitle} description={pageDescription} flushTop>
  <JsonLd slot="head" schema={collectionLd} />

  <div class="appearance-light page-wash">
    <EditorialMasthead
      layout="inline"
      size="lg"
      glow
      lead="Our"
      display="Newsroom"
      intro="The latest research, announcements, and lessons from the Inner Explorer community."
    />

    <NewsroomFilters categories={categories} total={stories.length} />

    <StoryGrid stories={stories} cols={4} initial={12} step={8} />

    <GlowCTA
      sans="Calm classrooms"
      serif="start with you"
      subtitle="Bring daily, research-backed mindfulness to every student in your school."
      primary={{ label: 'Contact us', href: '/contact' }}
      secondary={{ label: 'Take a tour', href: '/educators' }}
      trust="Trusted by 50,000+ educators across 8,000 schools"
    />
  </div>
</PageLayout>

<style>
  /* The page rides on the site's standard gray surface, painted by `.appearance-light`
     (var(--background)) like the rest of the marketing pages — no bespoke wash. flushTop
     drops the layout's default nav clearance, so this top padding gives the masthead room
     to breathe below the floating nav (the band still fills to the top edge, so no dark
     body seam shows behind it). */
  .page-wash {
    padding-top: clamp(72px, 8vw, 112px);
  }
</style>

<script>
  // Newsroom controller (progressive enhancement): wires the filter tabs, sort
  // toggle, live count, and "Load more" to the cards via data-attributes. With no
  // JS, every card renders unfiltered and the button/empty-state stay hidden.
  const grid = document.querySelector<HTMLElement>('[data-news-grid]');
  const gridInner = grid?.querySelector<HTMLElement>('.grid');

  if (grid && gridInner) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-cat]'));
    const loadMore = grid.querySelector<HTMLButtonElement>('[data-load-more]');
    const empty = grid.querySelector<HTMLElement>('[data-empty]');
    const initial = Number(grid.dataset.initial) || 12;
    const step = Number(grid.dataset.step) || 8;

    const tabs = Array.from(document.querySelectorAll<HTMLElement>('[data-filter]'));
    const sorts = Array.from(document.querySelectorAll<HTMLElement>('[data-sort]'));
    const countEl = document.querySelector<HTMLElement>('[data-count]');

    let activeCat = 'all';
    let sortMode = 'newest';
    let limit = initial;

    const render = () => {
      const list = cards
        .filter((c) => activeCat === 'all' || c.dataset.cat === activeCat)
        .sort((a, b) =>
          sortMode === 'newest'
            ? (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '')
            : Number(b.dataset.pop) - Number(a.dataset.pop),
        );

      // Reorder matched cards into sorted order; hide the rest.
      list.forEach((c) => gridInner.appendChild(c));
      cards.forEach((c) => (c.hidden = !list.includes(c)));
      // Clamp the visible matched set to the current limit.
      list.forEach((c, i) => (c.hidden = i >= limit));

      const total = list.length;
      if (countEl) countEl.textContent = `${total} ${total === 1 ? 'story' : 'stories'}`;
      if (loadMore) loadMore.hidden = total <= limit;
      if (empty) empty.hidden = total > 0;
    };

    render();

    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        activeCat = tab.dataset.filter ?? 'all';
        limit = initial;
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('on', on);
          t.setAttribute('aria-pressed', String(on));
        });
        render();
      }),
    );

    sorts.forEach((btn) =>
      btn.addEventListener('click', () => {
        sortMode = btn.dataset.sort ?? 'newest';
        sorts.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('on', on);
          b.setAttribute('aria-pressed', String(on));
        });
        render();
      }),
    );

    loadMore?.addEventListener('click', () => {
      limit += step;
      render();
    });
  }
</script>
