---
import { getCollection, render } from 'astro:content';
import HelpSiteLayout from '../layouts/HelpSiteLayout.astro';
import JsonLd from '../../src/components/seo/JsonLd.astro';
import HelpShell from '../../src/components/blocks/help/HelpShell.astro';
import ArticleToc from '../../src/components/blocks/blog/ArticleToc.astro';
import Breadcrumb from '../../src/components/primitives/Breadcrumb.astro';
import HelpActions from '../../src/components/blocks/help/HelpActions.astro';
import HelpPrint from '../../src/components/blocks/help/HelpPrint.astro';
import PrevNext from '../../src/components/blocks/help/PrevNext.astro';
import {
  buildHelpNav,
  flatHelpOrder,
  groupLabel,
  helpHref,
  helpRootHref,
} from '../../src/lib/help';
import { readingTime } from '../../src/lib/reading-time';
import { ogImageHref } from '../lib/og-card';
import { organizationSchema } from '../../src/lib/schema';
import { HELP_SITE, MAIN_SITE } from '../../src/lib/site';

export async function getStaticPaths() {
  const entries = await getCollection('help', ({ data }) => !data.draft);
  const nav = buildHelpNav(entries);
  const order = flatHelpOrder(entries);
  return entries.map((entry) => {
    const i = order.findIndex((o) => o.slug === entry.id);
    return {
      params: { slug: entry.id },
      props: {
        entry,
        nav,
        prev: i > 0 ? order[i - 1] : undefined,
        next: i >= 0 && i < order.length - 1 ? order[i + 1] : undefined,
      },
    };
  });
}

const { entry, nav, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const tocItems = headings.filter((h) => h.depth === 2).map((h) => ({ slug: h.slug, text: h.text }));
const reading = d.readingTime ?? readingTime(entry.body);
const groupName = groupLabel(d.group);

const pageTitle = d.seoTitle ?? `${d.title} | Help Center | Inner Explorer`;
const pageDescription = d.seoDescription ?? d.blurb;
const ogImage = ogImageHref(entry.id);
const ogImageAlt = `Inner Explorer Help Center: ${d.title}`;

// Articles live at the root of the help subdomain; "Home" in the structured data
// is the marketing site on the apex domain.
const base = new URL(Astro.site ?? HELP_SITE).origin;
const path = helpHref(entry.id);

// Breadcrumb stays two-level (Help Center / page); the section is shown by the green
// eyebrow below, so repeating it as a non-clickable crumb would just be redundant.
const crumbs = [{ label: 'Help Center', href: helpRootHref }, { label: d.title }];

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: pageDescription,
  image: `${base}${ogImage}`,
  inLanguage: 'en-US',
  mainEntityOfPage: `${base}${path}`,
  isPartOf: { '@type': 'WebSite', name: 'Inner Explorer Help Center', url: `${base}/` },
  publisher: organizationSchema(MAIN_SITE),
};
const crumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${MAIN_SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Help Center', item: `${base}/` },
    { '@type': 'ListItem', position: 3, name: d.title, item: `${base}${path}` },
  ],
};
---

<HelpSiteLayout
  title={pageTitle}
  description={pageDescription}
  type="article"
  image={ogImage}
  imageAlt={ogImageAlt}
  canonical={d.canonicalUrl}
>
  <JsonLd schema={articleLd} slot="head" />
  <JsonLd schema={crumbLd} slot="head" />

  <div class="appearance-light">
    <HelpShell groups={nav} activeSlug={entry.id} showToc={tocItems.length > 0}>
      <article class="help-article">
        <HelpPrint url={`${base}${path}`} section={groupName} />
        <Breadcrumb items={crumbs} class="help-article-crumb" />
        <p class="help-article-eyebrow">{groupName}</p>
        <h1 class="help-article-title" data-editable="text" data-prop="title">{d.title}</h1>
        <p class="help-article-meta">{reading} read</p>
        <div class="help-article-divider"></div>

        <div class="prose-help" data-editable="text" data-type="block" data-prop="@content">
          <Content />
        </div>

        <PrevNext prev={prev} next={next} />
      </article>

      <Fragment slot="toc">
        <ArticleToc items={tocItems} label="On this page" numbered={false} />
        <HelpActions />
      </Fragment>
    </HelpShell>
  </div>
</HelpSiteLayout>

<style>
  .help-article {
    animation: helpArticleFade 0.4s var(--ease-out) both;
  }
  @keyframes helpArticleFade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  /* `:global` because the class lands on the Breadcrumb component's root node, which
     doesn't carry this page's scope attribute — a plain `.help-article-crumb` selector
     wouldn't match it (so the gap would collapse). */
  :global(.help-article-crumb) {
    margin-bottom: 26px;
  }
  .help-article-eyebrow {
    margin: 0 0 14px;
    font-size: 12px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand);
  }
  .help-article-title {
    margin: 0;
    font-family: var(--font-display);
    font-style: normal;
    font-weight: 400;
    font-size: clamp(2.1rem, 1.7rem + 2vw, 2.875rem);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--color-foreground);
  }
  .help-article-meta {
    margin: 18px 0 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1;
    color: var(--color-muted-foreground);
  }
  .help-article-divider {
    height: 1px;
    margin-top: 30px;
    background: var(--color-border);
  }
</style>
