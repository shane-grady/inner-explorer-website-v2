---
// Help-site 404 — calm, minimal, and always offers the two ways forward:
// back to the Help Center home, or over to the main marketing site.
import HelpSiteLayout from '../layouts/HelpSiteLayout.astro';
import { MAIN_SITE } from '../../src/lib/site';
import { helpRootHref } from '../../src/lib/help';

const mainSiteLabel = new URL(MAIN_SITE).host.replace(/^www\./, '');
---

<HelpSiteLayout
  title="Page not found — Help Center — Inner Explorer"
  description="We can't find that guide. Take a breath — your way back is right here."
  noindex
>
  <div class="mx-auto flex max-w-2xl flex-col items-start gap-6 px-6 py-24">
    <p class="m-0 text-xs font-bold tracking-widest text-brand uppercase">
      Page not found · Error 404
    </p>
    <h1 class="m-0 font-display text-4xl text-foreground">This guide slipped beyond our map.</h1>
    <p class="m-0 text-lg leading-relaxed text-muted-foreground">
      Take a breath — the guide you're looking for may have moved. Browse the Help Center home, or
      head back to the main site.
    </p>
    <p class="m-0 flex flex-wrap gap-6 text-sm font-medium">
      <a class="text-brand-emphasis hover:underline" href={helpRootHref}>Help Center home</a>
      <a class="text-brand-emphasis hover:underline" href={MAIN_SITE}>{mainSiteLabel}</a>
    </p>
  </div>
</HelpSiteLayout>
