---
// Help-article callout — a brand-tinted aside for tips, notes, and "good to know"
// asides. Body comes from the slot so it can carry inline markdown/links. Used as an
// in-article MDX module on /help/<slug>.
type CalloutType = 'tip' | 'note' | 'good';
interface Props {
  type?: CalloutType;
  /** Override the auto label (defaults from `type`). */
  label?: string;
  /**
   * Promotes the aside from a quiet note to a signposted one: renders a
   * sentence-case heading in place of the micro eyebrow. Use when the callout
   * answers a question readers arrive with (and usually pair it with an
   * `<ActionLinks>` in the body).
   */
  heading?: string;
}
const labels: Record<CalloutType, string> = {
  tip: 'Tip',
  note: 'Note',
  good: 'Good to know',
};
const { type = 'tip', label, heading }: Props = Astro.props;
---

<aside class="callout">
  {
    heading ? (
      <p class="callout-heading">{heading}</p>
    ) : (
      <div class="callout-label">{label ?? labels[type]}</div>
    )
  }
  <div class="callout-body"><slot /></div>
</aside>

<style>
  .callout {
    margin: 1.75rem 0;
    padding: 18px 20px;
    background: var(--color-brand-subtle);
    border: 1px solid color-mix(in oklab, var(--color-brand) 24%, transparent);
    border-radius: var(--radius-md);
  }
  .callout-label {
    margin-bottom: 7px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-emphasis);
  }
  .callout-heading {
    margin: 0 0 6px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--color-brand-emphasis);
  }
  .callout-body {
    font-size: 15.5px;
    line-height: 1.65;
    color: var(--color-foreground);
  }
  /* The slot wraps prose in <p>; flatten the first/last margins so padding controls it. */
  .callout-body :global(p) {
    margin: 0;
  }
  .callout-body :global(p + p) {
    margin-top: 0.7em;
  }
  /* ActionLinks sets its own margin for standalone use in prose; inside the tighter
     callout padding that reads as a gap, so pull it in. */
  .callout-body :global(.help-action-links) {
    margin-top: 16px;
  }
</style>
