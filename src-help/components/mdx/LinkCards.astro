---
// A vertical list of link cards (title + subtitle + arrow) — used for the audience
// chooser ("Who it's for") and other "pick a path" sections. Each item links to
// another guide or page.
interface Item {
  title: string;
  sub: string;
  href: string;
}
interface Props {
  items: Item[];
}
const { items }: Props = Astro.props;
---

<div class="help-linkcards">
  {
    items.map((it) => (
      <a class="help-linkcard" href={it.href}>
        <span class="help-linkcard-text">
          <span class="help-linkcard-title">{it.title}</span>
          <span class="help-linkcard-sub">{it.sub}</span>
        </span>
        <svg
          class="help-linkcard-arrow"
          width="17"
          height="17"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    ))
  }
</div>

<style>
  .help-linkcards {
    margin: 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .help-linkcard {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 15px 18px;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out);
  }
  .help-linkcard:hover {
    border-color: color-mix(in oklab, var(--color-brand) 45%, transparent);
    box-shadow: var(--shadow-md);
  }
  .help-linkcard-title {
    display: block;
    font-size: 15.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-foreground);
  }
  .help-linkcard-sub {
    display: block;
    margin-top: 2px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--color-muted-foreground);
  }
  .help-linkcard-arrow {
    flex: 0 0 auto;
    color: var(--color-brand);
  }
</style>
