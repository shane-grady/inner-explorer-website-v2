---
// GA4 (gtag.js). Rendered once in BaseLayout <head>, only when the caller has
// already decided this is a real production request — see BaseLayout for the
// PUBLIC_GA_MEASUREMENT_ID / build-context gating.
//
// One deliberate deviation from Google's raw snippet: window.dataLayer/gtag are assigned
// explicitly. Astro processes scripts using define:vars as modules, and top-level
// declarations in a module aren't implicitly global — other components need `window.gtag`
// to log their own events.
//
// Page views use GA4's own defaults: `config` sends the first one, and the data stream's
// enhanced measurement ("page changes based on browser history events", on by default)
// counts each ClientRouter navigation. Verified 2026-10-12: with a manual `astro:page-load`
// page_view as well, every client-side navigation was counted twice. If that enhanced
// measurement setting is ever turned off, navigations stop being counted; restore a manual
// page_view on `astro:page-load` (skipping the first) instead.
//
// The netlify.app check below guards against the *.netlify.app staging mirror,
// which serves this exact same production build (see
// netlify/edge-functions/noindex-netlify-host.ts) and shouldn't count as real
// traffic any more than it should be indexed.
interface Props {
  measurementId: string;
}
const { measurementId } = Astro.props;
---

<script define:vars={{ measurementId }}>
  // CloudCannon sets inEditorMode before page scripts run. Keep both the tracker
  // request and all events out of the Visual Editor iframe.
  if (!window.inEditorMode && !location.hostname.endsWith('.netlify.app')) {
    window.dataLayer = window.dataLayer || [];
    // `arguments`, never a rest-param array: gtag.js runs only Arguments objects as gtag
    // commands. A plain array is read as a data-layer method call and silently dropped, so
    // `config` and every event would never be sent.
    window.gtag = function () {
      // eslint-disable-next-line prefer-rest-params
      window.dataLayer.push(arguments);
    };
    window.gtag('js', new Date());
    window.gtag('config', measurementId);

    const tracker = document.createElement('script');
    tracker.async = true;
    tracker.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
    document.head.appendChild(tracker);
  }
</script>
