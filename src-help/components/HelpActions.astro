---
// "Save this guide" actions in the right rail — Save as PDF / Print. Both trigger the
// browser print dialog (print → "Save as PDF" is the native path); a print stylesheet
// on the page strips the chrome so the article prints cleanly. Progressive enhancement:
// the buttons only do anything with JS, so they're hidden when JS is unavailable.
---

<div class="help-actions" data-help-actions hidden>
  <p class="help-actions-label">Save this guide</p>
  <div class="help-actions-btns">
    <button type="button" class="help-action help-action--primary" data-print>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" x2="12" y1="15" y2="3"></line>
      </svg>
      <span>Save as PDF</span>
    </button>
    <button type="button" class="help-action help-action--ghost" data-print>
      <svg
        width="16"
        height="16"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M6 9V2h12v7"></path>
        <path d="M6 18H4a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-2"></path>
        <rect x="6" y="14" width="12" height="8" rx="1"></rect>
      </svg>
      <span>Print</span>
    </button>
  </div>
</div>

<style>
  .help-actions {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--color-border);
  }
  .help-actions-label {
    margin: 0 0 12px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-muted-foreground);
  }
  .help-actions-btns {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .help-action {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    height: 42px;
    padding: 0 14px;
    border-radius: var(--radius-sm);
    font-size: 13.5px;
    font-weight: 600;
    line-height: 1;
    text-align: left;
    cursor: pointer;
    transition:
      transform var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      background var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  .help-action span {
    flex: 1;
  }
  .help-action--primary {
    border: 1px solid color-mix(in oklab, var(--color-white) 18%, transparent);
    background:
      linear-gradient(
        165deg,
        color-mix(in oklab, var(--color-white) 22%, transparent),
        transparent 46%
      ),
      var(--color-brand);
    color: var(--color-brand-foreground);
    box-shadow: var(--shadow-md);
  }
  .help-action--primary:hover {
    transform: translateY(-1px);
    background:
      linear-gradient(
        165deg,
        color-mix(in oklab, var(--color-white) 26%, transparent),
        transparent 46%
      ),
      var(--color-brand-emphasis);
    box-shadow: var(--shadow-lg);
  }
  .help-action--ghost {
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-foreground);
  }
  .help-action--ghost:hover {
    transform: translateY(-1px);
    border-color: color-mix(in oklab, var(--color-brand) 45%, transparent);
    color: var(--color-brand-emphasis);
    background: var(--color-brand-subtle);
  }
  .help-action:active {
    transform: translateY(0) scale(0.985);
  }
</style>

<script>
  function bindHelpActions() {
    document.querySelectorAll<HTMLElement>('[data-help-actions]').forEach((el) => {
      el.hidden = false;
    });
    document.querySelectorAll<HTMLButtonElement>('[data-print]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => window.print());
    });
  }
  document.addEventListener('astro:page-load', bindHelpActions);
</script>
